{
 "covers": {"nx_create_extract": ["body", "face", "region"]},
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [20, 10]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "ext", "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 30}}},
  {"call": "nx_find_geometry", "setup": true, "save": "top", "args": {"kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "bot", "args": {"kind": "face", "geometry_type": "plane", "normal": [0, 0, -1], "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "side", "args": {"kind": "face", "geometry_type": "plane", "normal": [0, -1, 0], "order": "lowest", "axis": "y", "limit": 1}},
  {"call": "nx_create_extract", "save": "eb", "args": {"kind": "body", "objects": ["$ext.data.bodies.0.id"]}, "expect": {"mutation_outcome": "committed", "data.volume": {"close": 6000, "tol": 1e-06}, "data.face_count": 6, "data.features": {"count": 1}, "data.features.0.name": {"matches": "^EXTRACT_BODY"}, "data.bodies": {"count": 1}, "data.associative": true}},
  {"call": "nx_create_extract", "save": "ebt", "args": {"kind": "body", "objects": ["$ext.data.bodies.0.id"], "at_timestamp": true}, "expect": {"mutation_outcome": "committed", "data.volume": {"close": 6000, "tol": 1e-06}, "data.at_timestamp": true}},
  {"call": "nx_create_extract", "save": "ebn", "args": {"kind": "body", "objects": ["$ext.data.bodies.0.id"], "associative": false}, "expect": {"mutation_outcome": "committed", "data.volume": {"close": 6000, "tol": 1e-06}, "data.associative": false}},
  {"call": "nx_create_extract", "save": "ef", "args": {"kind": "face", "objects": ["$top.data.items.0.id"]}, "expect": {"mutation_outcome": "committed", "data.area": {"close": 200, "tol": 1e-06}, "data.face_count": 1, "data.features.0.name": {"matches": "^EXTRACT_FACE"}}},
  {"call": "nx_create_extract", "args": {"kind": "face", "objects": ["$top.data.items.0.id", "$side.data.items.0.id"]}, "expect": {"mutation_outcome": "committed", "data.area": {"close": 800, "tol": 1e-06}, "data.face_count": 2}},
  {"call": "nx_create_extract", "args": {"kind": "face", "objects": ["$top.data.items.0.id", "$bot.data.items.0.id"]}, "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/objects/1", "mutation_outcome": "not_started"}},
  {"call": "nx_create_extract", "args": {"kind": "face", "objects": ["$top.data.items.0.id", "$side.data.items.0.id", "$bot.data.items.0.id"]}, "expect": {"mutation_outcome": "committed", "data.area": {"close": 1000, "tol": 1e-06}, "data.face_count": 3, "data.bodies": {"count": 1}}},
  {"call": "nx_create_extract", "args": {"kind": "region", "objects": ["$top.data.items.0.id"], "boundary": ["$bot.data.items.0.id"]}, "expect": {"mutation_outcome": "committed", "data.area": {"close": 2000, "tol": 1e-06}, "data.face_count": 5, "data.features.0.name": {"matches": "^EXTRACT_REGION"}}},
  {"call": "nx_create_extract", "args": {"kind": "body", "objects": ["$top.data.items.0.id"]}, "expect": {"error.code": "NX_WRONG_KIND", "error.field": "/objects/0", "mutation_outcome": "not_started"}},
  {"call": "nx_create_extract", "args": {"kind": "region", "objects": ["$top.data.items.0.id", "$bot.data.items.0.id"], "boundary": ["$bot.data.items.0.id"]}, "expect": {"error.field": "/objects", "mutation_outcome": "not_started"}},
  {"call": "nx_create_extract", "args": {"kind": "region", "objects": ["$top.data.items.0.id"]}, "expect": {"error.field": "/boundary", "mutation_outcome": "not_started"}},
  {"call": "nx_create_extract", "args": {"kind": "region", "objects": ["$top.data.items.0.id"], "boundary": ["$top.data.items.0.id"]}, "expect": {"error.field": "/boundary/0", "mutation_outcome": "not_started"}},
  {"call": "nx_create_extract", "args": {"kind": "face", "objects": ["$top.data.items.0.id"], "boundary": ["$bot.data.items.0.id"]}, "expect": {"error.field": "/boundary", "mutation_outcome": "not_started"}},
  {"call": "nx_create_extract", "args": {"kind": "body", "objects": ["$ext.data.bodies.0.id"], "associative": false, "at_timestamp": true}, "expect": {"error.field": "/at_timestamp", "mutation_outcome": "not_started"}},
  {"call": "nx_create_sketch", "setup": true, "save": "cut", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$cut.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [5, 5]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$cut.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$cut.data.sketch.id", "end": {"type": "distance", "value": 10}, "combine": {"operation": "subtract", "targets": ["$ext.data.bodies.0.id"]}}},
  {"call": "nx_edit_feature", "setup": true, "args": {"feature": "$ext.data.feature.id", "parameters": [{"name": "distance", "value": 45}]}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$eb.data.bodies.0.id"]}, "expect": {"data.volume": {"close": 8750, "tol": 1e-06}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$ebt.data.bodies.0.id"]}, "expect": {"data.volume": {"close": 9000, "tol": 1e-06}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$ebn.data.bodies.0.id"]}, "expect": {"data.volume": {"close": 6000, "tol": 1e-06}}}
 ]
}
