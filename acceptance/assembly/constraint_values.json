{
 "covers": {"nx_create_assembly_constraint": ["distance", "angle", "touch"], "nx_edit_assembly_constraint": [], "nx_set_component_pose": ["relative"]},
 "fixture": "fixtures/parts_files_block_mm.prt",
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "A", "args": {"path": "$fixture", "name": "A"}},
  {"call": "nx_create_component", "setup": true, "save": "B", "args": {"part": "$part", "path": "$fixture", "name": "B", "pose": {"translation": [100, 0, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "C", "args": {"part": "$part", "path": "$fixture", "name": "C", "pose": {"translation": [0, 60, 0]}}},
  {"call": "nx_find_geometry", "setup": true, "save": "Apx", "args": {"owner": "$A.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [1, 0, 0], "order": "highest", "axis": "x", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "Amy", "args": {"owner": "$A.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, -1, 0], "order": "lowest", "axis": "y", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "Bmx", "args": {"owner": "$B.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [-1, 0, 0], "order": "lowest", "axis": "x", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "Cmy", "args": {"owner": "$C.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, -1, 0], "order": "lowest", "axis": "y", "limit": 1}},
  {"call": "nx_create_assembly_constraint", "setup": true, "args": {"type": "fix", "component": "$A.data.component.id"}},
  {"call": "nx_create_assembly_constraint", "args": {"type": "distance", "component": "$B.data.component.id", "geometry": "$Bmx.data.items.0.id", "target_component": "$A.data.component.id", "target_geometry": "$Apx.data.items.0.id", "value": "45 deg"}, "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/value", "mutation_outcome": "not_started"}},
  {"call": "nx_create_assembly_constraint", "save": "dist", "args": {"type": "distance", "component": "$B.data.component.id", "geometry": "$Bmx.data.items.0.id", "target_component": "$A.data.component.id", "target_geometry": "$Apx.data.items.0.id", "value": "10 mm"}, "expect": {"mutation_outcome": "committed", "data.type": "distance", "data.status": "Solved", "data.value": {"close": 10, "tol": 1e-09}, "data.offset": {"close": 10, "tol": 1e-06}, "data.moved.0.name": "B", "data.moved.0.translation": {"close": [50, 0, 0], "tol": 1e-06}, "warnings": {"count": 0}}},
  {"call": "nx_edit_assembly_constraint", "args": {"constraint": "$dist.data.constraint.id", "value": -10}, "expect": {"mutation_outcome": "committed", "data.status": "Solved", "data.value": {"close": -10, "tol": 1e-09}, "data.offset": {"close": -10, "tol": 1e-06}, "data.moved.0.translation": {"close": [30, 0, 0], "tol": 1e-06}, "warnings.0.message": {"matches": "overlap"}}},
  {"call": "nx_edit_assembly_constraint", "args": {"constraint": "$dist.data.constraint.id", "value": "-0.5 in"}, "expect": {"mutation_outcome": "committed", "data.value": {"close": -12.7, "tol": 1e-09}, "data.offset": {"close": -12.7, "tol": 1e-06}, "data.moved.0.translation": {"close": [27.3, 0, 0], "tol": 1e-06}}},
  {"call": "nx_edit_assembly_constraint", "args": {"constraint": "$dist.data.constraint.id", "value": "30 deg"}, "expect": {"error.field": "/value", "mutation_outcome": "not_started"}},
  {"call": "nx_create_assembly_constraint", "args": {"type": "touch", "component": "$B.data.component.id", "geometry": "$Bmx.data.items.0.id", "target_component": "$A.data.component.id", "target_geometry": "$Apx.data.items.0.id"}, "expect": {"error.code": "NX_CONSTRAINT_UNSATISFIED", "mutation_outcome": "rolled_back", "error.details.others": {"count": 1}, "error.details.others.0.type": "distance", "error.details.type": "touch"}},
  {"call": "nx_edit_assembly_constraint", "setup": true, "args": {"constraint": "$dist.data.constraint.id", "suppressed": true}},
  {"call": "nx_create_assembly_constraint", "args": {"type": "touch", "component": "$B.data.component.id", "geometry": "$Bmx.data.items.0.id", "target_component": "$A.data.component.id", "target_geometry": "$Apx.data.items.0.id"}, "expect": {"mutation_outcome": "committed", "data.status": "Solved", "data.offset": {"close": 0, "tol": 1e-06}, "data.moved.0.translation": {"close": [40, 0, 0], "tol": 1e-06}}},
  {"call": "nx_create_assembly_constraint", "args": {"type": "angle", "component": "$C.data.component.id", "geometry": "$Cmy.data.items.0.id", "target_component": "$A.data.component.id", "target_geometry": "$Amy.data.items.0.id", "value": "30deg"}, "expect": {"mutation_outcome": "committed", "data.type": "angle", "data.status": "Solved", "data.value": {"close": 30, "tol": 1e-09}}},
  {"call": "nx_measure_angle", "args": {"first": "$Cmy.data.items.0.id", "second": "$Amy.data.items.0.id"}, "expect": {"data.angle": {"close": 30, "tol": 1e-06}}},
  {"call": "nx_create_assembly_constraint", "args": {"type": "angle", "component": "$C.data.component.id", "geometry": "$Cmy.data.items.0.id", "target_component": "$A.data.component.id", "target_geometry": "$Amy.data.items.0.id", "value": "10 mm"}, "expect": {"error.field": "/value", "mutation_outcome": "not_started"}},
  {"call": "nx_set_expression", "setup": true, "args": {"part": "$part", "name": "gap_d", "formula": "15", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "D", "args": {"part": "$part", "path": "$fixture", "name": "D", "pose": {"translation": [0, -150, 0]}}},
  {"call": "nx_find_geometry", "setup": true, "save": "Dpy", "args": {"owner": "$D.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, 1, 0], "order": "highest", "axis": "y", "limit": 1}},
  {"call": "nx_create_assembly_constraint", "save": "gap", "args": {"type": "distance", "component": "$D.data.component.id", "geometry": "$Dpy.data.items.0.id", "target_component": "$A.data.component.id", "target_geometry": "$Amy.data.items.0.id", "value": "gap_d * 2"}, "expect": {"mutation_outcome": "committed", "data.status": "Solved", "data.value": {"close": 30, "tol": 1e-09}, "data.measured": {"close": 30, "tol": 1e-06}, "data.moved.0.name": "D"}},
  {"call": "nx_edit_assembly_constraint", "args": {"constraint": "$gap.data.constraint.id", "value": "gap_d"}, "expect": {"mutation_outcome": "committed", "data.value": {"close": 15, "tol": 1e-09}, "data.measured": {"close": 15, "tol": 1e-06}}},
  {"call": "nx_edit_assembly_constraint", "args": {"constraint": "$gap.data.constraint.id", "value": "no_such_expression"}, "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/value", "mutation_outcome": "not_started"}},
  {"call": "nx_set_component_pose", "args": {"component": "$D.data.component.id", "mode": "relative", "translation": [0, -5, 0]}, "expect": {"error.code": "NX_CONSTRAINT_UNSATISFIED", "error.retry": "after_fix", "error.details.constraints": {"count": 1}, "error.details.constraints.0.type": "distance", "mutation_outcome": "rolled_back"}},
  {"call": "nx_set_component_pose", "args": {"component": "$A.data.component.id", "mode": "relative", "translation": [5, 0, 0]}, "expect": {"mutation_outcome": "committed", "data.moved": {"count": 2}, "warnings.0.message": {"matches": "fix constraint"}}}
 ]
}
