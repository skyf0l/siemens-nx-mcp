   "expect": {
    "data.group.count": 1
   }
  },
  {
   "call": "nx_create_component_group",
   "args": {
    "part": "$part",
    "name": "propulsion",
    "components": [
     "$ENGINE.data.component.id",
     "$BATTERY.data.component.id"
