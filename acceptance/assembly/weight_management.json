{
 "covers": {
  "nx_set_component_mass": [],
  "nx_create_component_group": [],
  "nx_list_component_groups": [],
  "nx_edit_component_group": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$run/wm_engine.prt",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
