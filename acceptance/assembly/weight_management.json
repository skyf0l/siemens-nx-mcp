     "tol": 1e-06
    },
    "data.total.center_of_gravity": {
     "close": [
      527.6707530647985,
      343.7828371278459,
      537.7408056042032
     ],
     "tol": 1e-06
    },
    "data.rows": {
     "contains": {
      "name": "BATTERY",
      "source": "asserted_component"
     }
    }
   }
  },
  {
   "call": "nx_undo_operation",
