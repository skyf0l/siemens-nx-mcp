   "expect": {
    "mutation_outcome": "committed",
    "data.mass": {
     "close": 70,
     "tol": 1e-06
    },
    "data.center_of_gravity": {
     "close": [
      1600,
      550,
      480
     ],
     "tol": 1e-06
    },
    "data.previous.mass": {
     "close": 60,
     "tol": 1e-06
    },
    "warnings.0.code": "NX_NOTE"
   }
  },
  {
   "call": "nx_set_component_mass",
   "setup": true,
   "args": {
    "part": "$part",
    "component": "$BATTERY.data.component.id",
    "mass": 60
   }
  },
  {
   "call": "nx_set_component_mass",
   "args": {
    "part": "$part",
    "component": "$ENGINE.data.component.id",
    "mass": 350,
    "level": "part"
