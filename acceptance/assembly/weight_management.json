   },
   "expect": {
    "mutation_outcome": "committed",
    "data.group.name": "Propulsion",
    "data.group.count": 1,
    "data.group.members.0.name": "ENGINE",
    "data.replaced": false
   }
  },
  {
   "call": "nx_create_component_group",
   "args": {
    "part": "$part",
    "name": "PROPULSION",
    "components": [
     "$BATTERY.data.component.id"
    ]
   },
   "expect": {
    "error.code": "NX_ALREADY_EXISTS",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_create_component_group",
   "args": {
    "part": "$part",
    "name": "Electrical",
    "components": [
     "$BATTERY.data.component.id"
    ]
