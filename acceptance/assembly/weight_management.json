    "data.items.0.name": "Propulsion",
    "data.items.0.count": 2,
    "data.items.1.name": "Electrical",
    "data.items.0.system": false
   }
  },
  {
   "call": "nx_list_component_groups",
   "args": {
    "part": "$part",
    "include_system": true,
    "with_members": false
