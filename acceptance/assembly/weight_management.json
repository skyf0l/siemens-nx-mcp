   "expect": {
    "data.mass": {
     "close": 350,
     "tol": 1e-06
    },
    "data.level": "part",
    "data.part": "wm_engine.prt",
    "data.center_of_gravity": null
   }
  },
  {
   "call": "nx_measure_assembly_mass",
   "args": {
    "part": "$part"
   },
   "expect": {
    "data.total.mass": {
     "close": 410,
     "tol": 1e-06
    },
    "data.total.center_of_gravity": {
     "close": [
      490.2439024390244,
      336.5853658536585,
      539.7560975609756
     ],
     "tol": 1e-06
    },
    "data.rows": {
     "contains": {
      "name": "ENGINE",
      "source": "asserted_part"
     }
    }
   }
  },
  {
   "call": "nx_set_component_mass",
   "args": {
    "part": "$part",
    "component": "$ENGINE.data.component.id",
    "mass": 360,
    "center": [
     300,
     300,
     600
    ],
    "level": "part"
   },
   "expect": {
    "data.previous.mass": {
     "close": 350,
     "tol": 1e-06
    },
    "data.center_of_gravity": {
     "close": [
      300,
      300,
      600
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_measure_assembly_mass",
   "args": {
    "part": "$part",
    "components": [
     "$ENGINE.data.component.id"
    ]
   },
   "expect": {
    "data.total.mass": {
     "close": 360,
     "tol": 1e-06
    },
    "data.total.center_of_gravity": {
     "close": [
      300,
      300,
      600
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_set_component_mass",
   "args": {
    "part": "$part",
    "component": "$ENGINE.data.component.id",
    "level": "part",
    "clear": true
   },
   "expect": {
    "data.cleared": true,
    "data.previous.mass": {
     "close": 360,
     "tol": 1e-06
    },
    "data.mass": null
   }
  },
  {
   "call": "nx_set_component_mass",
   "args": {
    "part": "$part",
    "component": "$ENGINE.data.component.id",
    "level": "part",
    "clear": true
   },
   "expect": {
    "data.cleared": false,
    "warnings.0.code": "NX_NO_EFFECT"
   }
  },
  {
   "call": "nx_measure_assembly_mass",
   "args": {
    "part": "$part"
   },
   "expect": {
    "data.total.mass": {
     "close": 342.6,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_set_component_mass",
   "args": {
    "part": "$part",
    "component": "$BATTERY.data.component.id",
    "clear": true,
    "mass": 1
   },
   "expect": {
    "error.field": "/clear",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_set_component_mass",
   "args": {
    "part": "$part",
    "component": "$BATTERY.data.component.id"
   },
   "expect": {
    "error.field": "/mass",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_create_component_group",
   "args": {
    "part": "$part",
    "name": "Propulsion",
    "components": [
     "$ENGINE.data.component.id"
