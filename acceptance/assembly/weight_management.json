   "expect": {
    "data.items": {
     "count": 6
    },
    "data.items.0.system": true,
    "data.items.0.members": {
     "count": 0
    }
   }
  },
  {
   "call": "nx_measure_assembly_mass",
   "args": {
    "part": "$part",
    "group_by": "component_group"
   },
   "expect": {
    "data.groups": {
     "count": 2
    },
    "data.groups.0.name": "Propulsion",
    "data.groups.0.rows": 1,
    "data.groups.0.mass": {
     "close": 282.6,
     "tol": 1e-06
    },
    "data.groups.1.name": "Electrical",
    "warnings": {
     "contains": {
      "code": "NX_NOTE"
     }
    }
   }
  },
  {
   "call": "nx_set_component_mass",
