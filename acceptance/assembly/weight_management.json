    "material": {
     "custom": {
      "name": "WM_STEEL",
      "density": 7850
     }
    }
   }
  },
  {
   "call": "nx_save_part",
   "setup": true,
   "args": {
    "part": "wm_engine"
   }
  },
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$run/wm_battery.prt",
    "units": "mm"
   }
  },
  {
   "call": "nx_save_part",
   "setup": true,
   "args": {
    "part": "wm_battery"
   }
  },
  {
