   },
   "expect": {
    "data.replaced": true,
    "data.group.count": 2,
    "data.group.name": "Propulsion"
   }
  },
  {
   "call": "nx_create_component_group",
   "args": {
    "part": "$part",
    "name": "AllComponents",
