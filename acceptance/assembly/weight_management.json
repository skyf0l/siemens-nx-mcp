    "data.rows": {
     "contains": {
      "name": "BATTERY",
      "source": "none"
     }
    }
   }
  },
  {
   "call": "nx_set_component_mass",
   "setup": true,
   "args": {
    "part": "$part",
    "component": "$BATTERY.data.component.id",
    "mass": 60,
    "center": [
     1600,
     550,
     480
    ]
   }
  },
  {
   "call": "nx_set_component_mass",
   "args": {
    "part": "$part",
    "component": "$BATTERY.data.component.id",
    "mass": 70
