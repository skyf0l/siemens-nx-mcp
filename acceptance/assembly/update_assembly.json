{
 "covers": {
  "nx_update_assembly": []
 },
 "fixture": "fixtures/parts_files_block_mm.prt",
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "pin", "args": {"path": "$run/upd/asm_upd_pin.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 5}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "ext", "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 20}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "save": "asm", "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_update_assembly", "args": {},
   "expect": {"error.code": "NX_WRONG_PART_CONTEXT", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component", "setup": true, "save": "P", "args": {"path": "$run/upd/asm_upd_pin.prt", "name": "P"}},
  {"call": "nx_create_component", "setup": true, "save": "B", "args": {"path": "$fixture", "name": "B", "pose": {"translation": [-20, -10, 50]}}},
  {"call": "nx_find_geometry", "setup": true, "save": "Ptop", "args": {"owner": "$P.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "Bbot", "args": {"owner": "$B.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, -1], "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "ep", "args": {"owner": "$P.data.component.id", "kind": "edge", "geometry_type": "circle", "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "eb", "args": {"owner": "$B.data.component.id", "kind": "edge", "geometry_type": "line", "near": [20, 0, 60], "order": "nearest", "limit": 1}},
  {"call": "nx_create_assembly_constraint", "setup": true, "args": {"type": "fix", "component": "$P.data.component.id"}},
  {"call": "nx_create_assembly_constraint", "setup": true, "save": "touch", "args": {"type": "touch", "component": "$B.data.component.id", "geometry": "$Bbot.data.items.0.id", "target_component": "$P.data.component.id", "target_geometry": "$Ptop.data.items.0.id"}},
  {"call": "nx_list_components", "args": {"name_contains": "B", "include_poses": true},
   "expect": {"data.items.0.translation": {"close": [-20, -10, 20], "tol": 1e-6}}},
  {"call": "nx_create_explosion", "setup": true, "save": "ex", "args": {"name": "E1"}},
  {"call": "nx_edit_explosion", "setup": true, "args": {"explosion": "$ex.data.explosion.id", "placements": [
     {"component": "$B.data.component.id", "pose": {"translation": [-20, -10, 60]}}]}},
  {"call": "nx_create_explosion_trace", "setup": true, "save": "tr", "args": {"explosion": "$ex.data.explosion.id", "start_edge": "$ep.data.items.0.id", "end_edge": "$eb.data.items.0.id"}},
  {"call": "nx_create_drawing_sheet", "setup": true, "save": "sh", "args": {"name": "SHT1", "size": "a3", "projection": "third_angle"}},
  {"call": "nx_create_drawing_view", "setup": true, "save": "view", "args": {"type": "base", "sheet": "$sh.data.sheet.id", "orientation": "front", "position": [200, 150], "scale": 1}},
  {"call": "nx_activate_drawing_sheet", "setup": true, "args": {}},
  {"call": "nx_activate_part", "setup": true, "args": {"part": "$pin.data.part.id", "display": false}},
  {"call": "nx_edit_feature", "setup": true, "args": {"feature": "$ext.data.feature.id", "parameters": [{"name": "distance", "value": 30}]}},
  {"call": "nx_activate_part", "setup": true, "args": {"part": "$asm.data.part.id"}},
  {"call": "nx_update_assembly", "args": {},
   "expect": {"mutation_outcome": "committed", "data.constraints": {"count": 2}, "data.constraints.0.status": "Solved",
              "data.constraints.1.status": "Solved", "data.traces": {"count": 1}, "data.traces.0.kind": "traceline",
              "data.views": {"count": 1}, "data.views.0.kind": "drawing_view",
              "data.retained": {"count": 0}, "data.documentation_complete": true}},
  {"call": "nx_list_components", "args": {"name_contains": "B", "include_poses": true},
   "expect": {"data.items.0.translation": {"close": [-20, -10, 30], "tol": 1e-6}}},
  {"call": "nx_edit_explosion_trace", "args": {"trace": "$tr.data.trace.id", "start_offset": 1},
   "expect": {"data.start.2": {"close": 30, "tol": 1e-6}, "data.end.2": {"close": 80, "tol": 1e-6}}},
  {"call": "nx_edit_assembly_constraint", "setup": true, "args": {"constraint": "$touch.data.constraint.id", "suppressed": true}},
  {"call": "nx_update_assembly", "args": {},
   "expect": {"mutation_outcome": "committed", "data.constraints": {"count": 1}, "data.documentation_complete": true}}
 ]
}
