{
 "covers": {
  "nx_create_reference_set": [],
  "nx_create_wave_link": ["body", "face"]
 },
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "pa", "args": {"path": "$run/cc/cc_pin.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 5}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "ext", "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 20}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "save": "pq", "args": {"path": "$run/cc/cc_plate.prt", "units": "mm"}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "$pq.data.part.id"}},
  {"call": "nx_create_part", "setup": true, "save": "asm", "args": {"path": "$part", "units": "mm", "display": true}},
  {"call": "engineer", "args": {"code": "from nx_mcp.kit import parts as kp\nservices.host._remember_model()  # the development tool's own undo mark is no engineer edit\np = [x for x in session.Parts if str(x.Leaf).lower().startswith('assembly_component_context') and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nkp.show(NXOpen, session.Parts, p)\nresult = p.Leaf"}, "intent": "Acceptance: the engineer looks at assembly_component_context.prt (a tab click, no edit): it is the displayed part whatever NX showed before (engineer tab guard)", "expect": {"ok": true, "data.noticed": false}},
  {"call": "nx_create_component", "setup": true, "save": "P", "args": {"part": "$part", "path": "$run/cc/cc_pin.prt", "name": "P"}},
  {"call": "nx_create_component", "setup": true, "save": "Q", "args": {"part": "$part", "path": "$run/cc/cc_plate.prt", "name": "Q", "pose": {"translation": [100, 0, 0], "rotation": [[0, -1, 0], [1, 0, 0], [0, 0, 1]]}}},
  {"call": "nx_find_geometry", "setup": true, "save": "Pb", "args": {"owner": "$P.data.component.id", "kind": "body", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "Ptop", "args": {"owner": "$P.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "Pbot", "args": {"owner": "$P.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, -1], "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "Pcyl", "args": {"owner": "$P.data.component.id", "kind": "face", "geometry_type": "cylinder", "limit": 1}},
  {"call": "nx_create_wave_link", "save": "lb", "args": {"kind": "body", "sources": ["$P.data.component.id"], "target": "$Q.data.component.id"},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 1570.796327, "tol": 1e-06}, "data.bodies": {"count": 1}, "data.features.0.name": {"matches": "^LINKED_BODY"}}},
  {"call": "nx_list_parts", "args": {"active_only": true},
   "expect": {"data.items": {"count": 1}, "data.items.0.work": true, "data.items.0.display": true, "data.items.0.path": {"matches": "assembly_component_context"}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$lb.data.bodies.0.id"]}, "expect": {"data.volume": {"close": 1570.796327, "tol": 1e-06}}},
  {"call": "nx_create_wave_link", "args": {"kind": "face", "sources": ["$Ptop.data.items.0.id", "$Pbot.data.items.0.id"], "target": "$Q.data.component.id"},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/sources/1", "mutation_outcome": "not_started"}},
  {"call": "nx_create_wave_link", "args": {"kind": "face", "sources": ["$Ptop.data.items.0.id", "$Pcyl.data.items.0.id", "$Pbot.data.items.0.id"], "target": "$Q.data.component.id"},
   "expect": {"mutation_outcome": "committed", "data.area": {"close": 785.398163, "tol": 1e-06}, "data.bodies": {"count": 1}}},
  {"call": "nx_create_wave_link", "args": {"kind": "body", "sources": ["$P.data.component.id"], "target": "$P.data.component.id"},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/sources/0", "mutation_outcome": "not_started"}},
  {"call": "nx_create_reference_set", "args": {"name": "BODYONLY", "objects": ["$Pb.data.items.0.id"], "component": "$P.data.component.id"},
   "expect": {"mutation_outcome": "committed", "data.member_count": 1, "data.members.0.kind": "body", "data.reference_set.name": "BODYONLY"}},
  {"call": "nx_create_reference_set", "args": {"name": "BODY2", "objects": ["$ext.data.bodies.0.id"], "component": "$P.data.component.id"},
   "expect": {"mutation_outcome": "committed", "data.member_count": 1}},
  {"call": "nx_create_reference_set", "args": {"name": "bodyonly", "objects": ["$ext.data.bodies.0.id"], "component": "$P.data.component.id"},
   "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
  {"call": "nx_create_reference_set", "args": {"name": "X", "objects": ["$Pb.data.items.0.id"], "component": "$Q.data.component.id"},
   "expect": {"error.code": "NX_WRONG_OWNER", "error.field": "/objects/0", "mutation_outcome": "not_started"}},
  {"call": "nx_list_parts", "args": {"active_only": true},
   "expect": {"data.items": {"count": 1}, "data.items.0.path": {"matches": "assembly_component_context"}}},
  {"call": "nx_edit_component", "args": {"components": ["$P.data.component.id"], "reference_set": "BODYONLY"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$Pb.data.items.0.id"]}, "expect": {"data.volume": {"close": 1570.796327, "tol": 1e-06}}}
 ]
}
