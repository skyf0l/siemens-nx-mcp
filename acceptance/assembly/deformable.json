{
 "covers": {
  "nx_create_deformable_definition": [],
  "nx_set_component_deformation": [],
  "nx_update_assembly": [],
  "nx_create_component_mirror": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/dfm_strut.prt", "units": "mm"}},
  {"call": "nx_set_expression", "setup": true, "args": {"part": "dfm_strut", "name": "extension", "formula": "100", "units": "mm"}},
  {"call": "nx_set_expression", "setup": true, "args": {"part": "dfm_strut", "name": "rod_d", "formula": "12", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "args": {"part": "dfm_strut", "shape": "cylinder", "diameter": 30, "height": 200}},
  {"call": "nx_create_primitive", "setup": true, "args": {"part": "dfm_strut", "shape": "cylinder", "origin": [0, 0, 200], "diameter": "rod_d", "height": "extension"}},
  {"call": "nx_create_deformable_definition",
   "args": {"part": "dfm_strut", "name": "STRUT_DEFORM", "expressions": [{"expression": "extension", "min": 50, "max": 150}, {"expression": "rod_d"}]},
   "expect": {"mutation_outcome": "committed", "data.feature.kind": "feature", "data.expressions": {"count": 2},
              "data.expressions.0.expression.name": "extension", "data.expressions.0.value": {"close": 100, "tol": 1e-9},
              "data.expressions.0.min": {"close": 50, "tol": 1e-9}, "data.expressions.0.max": {"close": 150, "tol": 1e-9},
              "data.expressions.0.units": "mm", "data.expressions.1.expression.name": "rod_d",
              "data.expressions.1.value": {"close": 12, "tol": 1e-9}, "data.member_features": 3}},
  {"call": "nx_create_deformable_definition",
   "args": {"part": "dfm_strut", "expressions": [{"expression": "extension"}]},
   "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started", "error.details.feature.kind": "feature",
              "error.details.ranges.extension": {"close": [50, 150], "tol": 1e-9}}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "dfm_strut"}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "A", "args": {"part": "$part", "path": "$run/dfm_strut.prt", "name": "strut_a"}},
  {"call": "nx_create_component", "setup": true, "save": "B", "args": {"part": "$part", "path": "$run/dfm_strut.prt", "name": "strut_b", "pose": {"translation": [100, 0, 0]}}},
  {"call": "nx_set_expression", "setup": true, "args": {"part": "$part", "name": "hatch_ext", "formula": "90", "units": "mm"}},
  {"call": "nx_set_component_deformation",
   "args": {"part": "$part", "component": "$A.data.component.id", "values": [{"expression": "extension", "value": 200}]},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/values/0/value", "mutation_outcome": "not_started"}},
  {"call": "nx_set_component_deformation", "save": "defA",
   "args": {"part": "$part", "component": "$A.data.component.id", "values": [{"expression": "extension", "value": 150}]},
   "expect": {"mutation_outcome": "committed", "data.created": true, "data.feature.kind": "feature",
              "data.values.0.expression": "extension", "data.values.0.value": {"close": 150, "tol": 1e-9},
              "data.values.0.part_value": {"close": 100, "tol": 1e-9}, "data.values.0.units": "mm",
              "data.bodies": {"count": 2},
              "data.bounds.low": {"close": [-15, -15, 0], "tol": 1e-6}, "data.bounds.high": {"close": [15, 15, 350], "tol": 1e-6}}},
  {"call": "nx_set_component_deformation",
   "args": {"part": "$part", "component": "$A.data.component.id", "values": [{"expression": "extension", "value": 80}, {"expression": "rod_d", "value": 20}]},
   "expect": {"mutation_outcome": "committed", "data.created": false, "data.feature.id": "$defA.data.feature.id",
              "data.values.0.value": {"close": 80, "tol": 1e-9}, "data.values.1.value": {"close": 20, "tol": 1e-9},
              "data.values.1.part_value": {"close": 12, "tol": 1e-9},
              "data.bounds.high": {"close": [15, 15, 280], "tol": 1e-6}}},
  {"call": "nx_set_component_deformation",
   "args": {"part": "$part", "component": "$A.data.component.id", "values": [{"expression": "extension", "value": "12 cm"}]},
   "expect": {"mutation_outcome": "committed", "data.values.0.value": {"close": 120, "tol": 1e-9},
              "data.bounds.high": {"close": [15, 15, 320], "tol": 1e-6}}},
  {"call": "nx_set_component_deformation",
   "args": {"part": "$part", "component": "$A.data.component.id", "values": [{"expression": "extension", "value": "70 deg"}]},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/values/0/value", "mutation_outcome": "not_started"}},
  {"call": "nx_set_component_deformation",
   "args": {"part": "$part", "component": "$A.data.component.id", "values": [{"expression": "extension", "value": "hatch_ext +"}]},
   "expect": {"error.code": "NX_INVALID_FORMULA", "error.field": "/values/0/value", "mutation_outcome": "not_started"}},
  {"call": "nx_set_component_deformation", "save": "defB",
   "args": {"part": "$part", "component": "$B.data.component.id", "values": [{"expression": "extension", "value": "hatch_ext + 10"}]},
   "expect": {"mutation_outcome": "committed", "data.created": true, "data.values.0.formula": "hatch_ext + 10",
              "data.values.0.value": {"close": 100, "tol": 1e-9},
              "data.bounds.low": {"close": [85, -15, 0], "tol": 1e-6}, "data.bounds.high": {"close": [115, 15, 300], "tol": 1e-6}}},
  {"call": "nx_set_expression", "args": {"part": "$part", "name": "hatch_ext", "formula": "40"},
   "expect": {"data.value": {"close": 40, "tol": 1e-9}}},
  {"call": "nx_update_model", "args": {"part": "$part"}, "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_measure_bounds", "args": {"part": "$part", "bodies": ["$defB.data.bodies.0.id", "$defB.data.bodies.1.id"]},
   "expect": {"data.size": {"close": [30, 30, 250], "tol": 1e-6}, "data.min": {"close": [85, -15, 0], "tol": 1e-6}}},
  {"call": "nx_set_component_deformation",
   "args": {"part": "$part", "component": "$B.data.component.id", "values": [{"expression": "extension", "value": "hatch_ext + 500"}]},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/values/0/value", "mutation_outcome": "not_started",
              "error.message": {"matches": "540"}}},
  {"call": "nx_measure_bounds", "args": {"part": "$part", "bodies": ["$defB.data.bodies.0.id", "$defB.data.bodies.1.id"]},
   "expect": {"data.size": {"close": [30, 30, 250], "tol": 1e-6}}},
  {"call": "nx_set_expression", "args": {"part": "$part", "name": "hatch_ext", "formula": "200"},
   "expect": {"data.value": {"close": 200, "tol": 1e-9}}},
  {"call": "nx_update_assembly", "args": {"part": "$part"},
   "expect": {"mutation_outcome": "committed", "warnings.0.message": {"matches": "extension = 210 lies outside its range"}}},
  {"call": "nx_set_expression", "setup": true, "args": {"part": "$part", "name": "hatch_ext", "formula": "40"}},
  {"call": "nx_create_component_mirror", "args": {"part": "$part", "components": ["$B.data.component.id"], "plane": "yz"},
   "expect": {"mutation_outcome": "committed", "data.components.0.mirrored.name": "STRUT_B_MIRROR",
              "data.components.0.mirrored.translation": {"close": [-100, 0, 0], "tol": 1e-6},
              "warnings.0.message": {"matches": "is deformed"}}},
  {"call": "nx_list_objects", "args": {"part": "dfm_strut", "kind": "expression", "name_contains": "extension"},
   "expect": {"data.items.0.name": "extension", "data.items.0.details.value": {"close": 100, "tol": 1e-9}}}
 ]
}
