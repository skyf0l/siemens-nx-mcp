{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "pin", "args": {"path": "$run/mda/mda_pin.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "args": {"shape": "block", "length": 10, "width": 10, "height": 20, "part": "mda_pin"}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "$pin.data.part.id"}},
  {"call": "nx_create_part", "setup": true, "save": "asm", "args": {"path": "$run/mda/mda_asm.prt", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "P1", "args": {"part": "mda_asm", "path": "$run/mda/mda_pin.prt", "name": "PIN1"}},
  {"call": "nx_create_component", "setup": true, "save": "P2", "args": {"part": "mda_asm", "path": "$run/mda/mda_pin.prt", "name": "PIN2", "pose": {"translation": [50, 0, 0]}}},
  {"call": "nx_create_explosion", "setup": true, "save": "ex", "args": {"part": "mda_asm", "name": "E1", "placements": [{"component": "$P2.data.component.id", "offset": [0, 0, 30]}]}},
  {"call": "nx_find_geometry", "setup": true, "save": "e1", "args": {"owner": "$P1.data.component.id", "kind": "edge", "geometry_type": "line", "near": [10, 5, 20], "order": "nearest", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "e2", "args": {"owner": "$P2.data.component.id", "kind": "edge", "geometry_type": "line", "near": [50, 5, 20], "order": "nearest", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "b2", "args": {"owner": "$P2.data.component.id", "kind": "body", "limit": 1}},
  {"call": "nx_create_explosion_trace", "setup": true, "save": "tr", "args": {"explosion": "$ex.data.explosion.id", "start_edge": "$e1.data.items.0.id", "end_edge": "$e2.data.items.0.id"}},
  {"call": "nx_set_explosion_display", "setup": true, "args": {"explosion": "$ex.data.explosion.id"}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "$asm.data.part.id"}},

  {"call": "nx_get_explosion", "save": "shown", "args": {"explosion": "$ex.data.explosion.id", "limit": 50},
   "intent": "Acceptance: the explosion read while its assembly is displayed (the reference for the background read)",
   "expect": {"ok": true, "page.total": 2, "data.views": {"count": 1}, "data.views.0.kind": "modeling_view", "data.traces": {"count": 1},
              "data.components": {"contains": {"component": {"name": "PIN2"}, "translation": [50.0, 0.0, 30.0], "assembled_translation": [50.0, 0.0, 0.0]}}}},
  {"call": "nx_measure_bounds", "args": {"bodies": ["$b2.data.items.0.id"]},
   "intent": "Acceptance: the displayed exploded assembly warns that positions are the assembled ones",
   "expect": {"ok": true, "warnings": {"contains": {"code": "NX_NOTE"}}, "warnings.0.message": {"matches": "^Explosion E1 is displayed"},
              "data.min": {"close": [50, 0, 0], "tol": 1e-06}, "data.max": {"close": [60, 10, 20], "tol": 1e-06}}},

  {"call": "nx_create_part", "setup": true, "save": "front", "args": {"path": "$run/mda/mda_front.prt", "units": "mm", "display": true}},
  {"call": "engineer", "args": {"code": "from nx_mcp.kit import parts as kp\nservices.host._remember_model()  # the development tool's own undo mark is no engineer edit\np = [x for x in session.Parts if str(x.Leaf).lower().startswith('mda_front') and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nkp.show(NXOpen, session.Parts, p)\nresult = p.Leaf"}, "intent": "Acceptance: the engineer looks at mda_front.prt (a tab click, no edit): it is the displayed part whatever NX showed before (engineer tab guard)", "expect": {"ok": true, "data.noticed": false}},
  {"call": "nx_create_primitive", "setup": true, "save": "fblk", "args": {"shape": "block", "length": 40, "width": 20, "height": 10, "part": "mda_front"}},

  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id", "limit": 50},
   "intent": "Acceptance: the explosion of a background assembly reads the same views, traces and positions as displayed",
   "expect": {"ok": true, "part.file": "mda_asm.prt", "page.total": 2, "data.views": {"count": 1}, "data.views.0.id": "$shown.data.views.0.id",
              "data.traces": {"count": 1}, "data.traces.0.id": "$tr.data.trace.id",
              "data.components": {"contains": {"component": {"name": "PIN2"}, "translation": [50.0, 0.0, 30.0], "assembled_translation": [50.0, 0.0, 0.0]}}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},

  {"call": "nx_export_assembly", "args": {"part": "mda_asm", "path": "$run/mda/clone", "prefix": "c_"},
   "intent": "Acceptance: a clone of a background assembly; the display never changes",
   "expect": {"mutation_outcome": "committed", "part.file": "mda_asm.prt", "data.format": "clone", "data.file_count": 2}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_export_assembly", "args": {"part": "mda_asm", "path": "$run/mda/clone2", "prefix": "d_", "activate": true},
   "intent": "Acceptance: activate on a background assembly is refused (the display comes back after the call)",
   "expect": {"ok": false, "error.code": "NX_WRONG_PART_CONTEXT", "error.field": "/activate", "mutation_outcome": "not_started"}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},

  {"call": "nx_activate_part", "setup": true, "args": {"part": "$asm.data.part.id", "display": true}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id"},
   "intent": "Acceptance: the explosion is still shown in the displayed assembly",
   "expect": {"data.views": {"count": 1}}},
  {"call": "nx_measure_bounds", "args": {"bodies": ["$fblk.data.bodies.0.id"]},
   "intent": "Acceptance: bounds of a background part's body while an exploded assembly is displayed: no explosion warning",
   "expect": {"ok": true, "part.file": "mda_front.prt", "warnings": {"count": 0},
              "data.min": {"close": [0, 0, 0], "tol": 1e-06}, "data.max": {"close": [40, 20, 10], "tol": 1e-06}}},
  {"call": "nx_activate_part", "setup": true, "args": {"part": "$front.data.part.id", "display": true}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},

  {"call": "nx_delete_objects", "args": {"objects": ["$tr.data.trace.id"]},
   "intent": "Acceptance: a traceline of a background assembly deleted",
   "expect": {"ok": true, "mutation_outcome": "committed", "part.file": "mda_asm.prt", "data.deleted.0.kind": "traceline"}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id"},
   "intent": "Acceptance: the trace is gone, the explosion stays",
   "expect": {"data.traces": {"count": 0}, "data.views": {"count": 1}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},

  {"call": "nx_delete_objects", "args": {"objects": ["$ex.data.explosion.id"]},
   "intent": "Acceptance: an explosion still shown in a view of the background assembly is refused, as when displayed",
   "expect": {"ok": false, "error.code": "NX_IN_USE", "error.details.views": {"count": 1}, "mutation_outcome": "rolled_back"}},
  {"call": "nx_set_explosion_display", "args": {"part": "mda_asm"},
   "intent": "Acceptance: the background assembly's view back to the assembled state",
   "expect": {"mutation_outcome": "committed", "part.file": "mda_asm.prt"}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id"},
   "expect": {"data.views": {"count": 0}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_delete_objects", "args": {"objects": ["$ex.data.explosion.id"]},
   "intent": "Acceptance: an explosion of a background assembly deleted (display-bound kind: displayed for the call)",
   "expect": {"ok": true, "mutation_outcome": "committed", "part.file": "mda_asm.prt", "data.deleted.0.kind": "explosion"}},
  {"call": "nx_list_objects", "args": {"part": "mda_asm", "kind": "explosion"},
   "intent": "Acceptance: the explosion is gone",
   "expect": {"data.items": {"count": 0}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "intent": "Acceptance: the engineer's display and work part are back",
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}}
 ]
}
