{
 "covers": {
  "nx_create_component": ["from_file", "new_in_context"],
  "nx_edit_component": []
 },
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/nc/nc_pin.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "psk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$psk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 5}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$psk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true,
   "args": {"sketch": "$psk.data.sketch.id", "end": {"type": "distance", "value": 20}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "P1",
   "args": {"part": "$part", "path": "$run/nc/nc_pin.prt", "name": "P1"}},
  {"call": "nx_create_component", "save": "P2",
   "args": {"part": "$part", "mode": "from_file", "path": "$run/nc/nc_pin.prt", "name": "P2",
            "pose": {"translation": [50, 0, 0], "rotation": [[0, -1, 0], [1, 0, 0], [0, 0, 1]]}},
   "expect": {"mutation_outcome": "committed", "data.component.name": "P2",
              "data.component.translation": {"close": [50, 0, 0], "tol": 1e-06},
              "data.component.rotation.0.1": {"close": -1, "tol": 1e-09},
              "data.part_path": {"matches": "nc_pin\\.prt$"}}},
  {"call": "nx_create_sketch", "setup": true, "save": "bsk", "args": {"part": "$part", "placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$bsk.data.sketch.id",
            "curves": [{"type": "rectangle", "corner1": [100, 0], "corner2": [120, 10]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$bsk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "ext",
   "args": {"sketch": "$bsk.data.sketch.id", "end": {"type": "distance", "value": 5}}},
  {"call": "nx_create_component",
   "save": "empty",
   "args": {"part": "$part", "mode": "new_in_context", "new_path": "$run/nc/nc_empty.prt", "name": "EMPTY",
            "pose": {"translation": [0, 40, 0], "rotation": [[0, -1, 0], [1, 0, 0], [0, 0, 1]]}},
   "expect": {"mutation_outcome": "committed", "data.component.name": "EMPTY",
              "data.component.translation": {"close": [0, 40, 0], "tol": 1e-06},
              "data.component.rotation.0.1": {"close": -1, "tol": 1e-09},
              "data.part_path": {"matches": "nc_empty\\.prt$"}, "data.units": "mm",
              "data.moved_bodies": 0, "data.part.kind": "part"}},
  {"call": "nx_edit_component",
   "args": {"part": "$part", "components": ["$empty.data.component.id"], "replace_with": "$run/nc/nc_pin.prt"},
   "expect": {"error.code": "NX_UNSAVED_PART", "error.field": "/components/0",
              "error.hint": {"matches": "nc_empty\\.prt"}, "mutation_outcome": "not_started"}},
  {"call": "nx_create_component",
   "save": "nc",
   "args": {"mode": "new_in_context", "new_path": "$run/nc/nc_plate.prt", "name": "PLATE",
            "pose": {"translation": [100, 0, 0]}, "objects_to_move": ["$ext.data.bodies.0.id"]},
   "expect": {"mutation_outcome": "committed", "data.component.name": "PLATE",
              "data.component.translation": {"close": [100, 0, 0], "tol": 1e-06},
              "data.moved_bodies": 1}},
  {"call": "nx_find_geometry",
   "args": {"owner": "$nc.data.component.id", "kind": "face", "geometry_type": "plane",
            "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1},
   "expect": {"data.items": {"count": 1},
              "data.items.0.center": {"close": [110, 5, 5], "tol": 1e-06}}},
  {"call": "nx_save_part", "args": {"part": "$nc.data.part.id"},
   "expect": {"ok": true, "data.changed_files": {"count": 1}}},
  {"call": "nx_create_component",
   "args": {"part": "$part", "mode": "new_in_context", "new_path": "$run/nc/nc_plate.prt"},
   "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component",
   "args": {"part": "$part", "mode": "new_in_context", "path": "$run/nc/nc_pin.prt", "new_path": "$run/nc/nc_x.prt"},
   "expect": {"error.field": "/path", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component",
   "args": {"mode": "new_in_context", "new_path": "$run/nc/nc_y.prt",
            "objects_to_move": ["$P1.data.component.id"]},
   "expect": {"error.field": "/objects_to_move/0", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_component",
   "args": {"components": ["$P2.data.component.id"], "make_unique": "$run/nc/nc_pin_u.prt"},
   "expect": {"mutation_outcome": "committed",
              "data.components.0.part_path": {"matches": "nc_pin_u\\.prt$"},
              "data.components.0.name": "NC_PIN_U",
              "data.components.0.translation": {"close": [50, 0, 0], "tol": 1e-06}}},
  {"call": "nx_list_components", "args": {"part": "$part", "name_contains": "NC_PIN_U"},
   "expect": {"page.total": 1, "data.items.0.part_path": {"matches": "nc_pin_u\\.prt$"}}},
  {"call": "nx_list_components", "args": {"part": "$part", "name_contains": "P1"},
   "expect": {"data.items.0.part_path": {"matches": "nc_pin\\.prt$"}}},
  {"call": "nx_edit_component",
   "args": {"components": ["$P1.data.component.id", "$P2.data.component.id"],
            "make_unique": "$run/nc/nc_pin_v.prt"},
   "expect": {"error.field": "/make_unique", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_component",
   "args": {"components": ["$P1.data.component.id"], "make_unique": "$run/nc/nc_pin_u.prt"},
   "expect": {"error.field": "/make_unique", "mutation_outcome": "not_started"}}
 ]
}
