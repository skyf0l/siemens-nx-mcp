{
 "covers": {
  "nx_create_clearance_set": [],
  "nx_run_clearance_set": [],
  "nx_list_clearance_sets": [],
  "nx_delete_clearance_set": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/cs_cube.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "args": {"part": "cs_cube", "length": 100, "width": 100, "height": 100}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "cs_cube"}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "A", "args": {"part": "$part", "path": "$run/cs_cube.prt", "name": "A"}},
  {"call": "nx_create_component", "setup": true, "save": "B", "args": {"part": "$part", "path": "$run/cs_cube.prt", "name": "B", "pose": {"translation": [90, 0, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "C", "args": {"part": "$part", "path": "$run/cs_cube.prt", "name": "C", "pose": {"translation": [-105, 0, 0]}}},
  {"call": "nx_create_clearance_set", "save": "er",
   "args": {"part": "$part", "name": "ER", "clearance": 10},
   "expect": {"mutation_outcome": "committed",
              "data.clearance_set.name": "ER", "data.clearance_set.between": "components",
              "data.clearance_set.clearance": {"close": 10, "tol": 1e-9},
              "data.clearance_set.method": "exact",
              "data.summary.version": 1, "data.summary.checked_pairs": 3,
              "data.summary.hard": 1, "data.summary.soft": 1, "data.summary.touching": 0,
              "data.interferences": {"count": 2},
              "data.interferences.0.type": "hard",
              "data.interferences.0.overlap_volume": {"close": 100000, "tol": 1e-3},
              "data.interferences.0.overlap_box.min": {"close": [90, 0, 0], "tol": 1e-6},
              "data.interferences.0.overlap_box.max": {"close": [100, 100, 100], "tol": 1e-6},
              "data.interferences.0.depth": {"close": 12.218, "tol": 0.01},
              "data.interferences.1.type": "soft",
              "data.interferences.1.distance": {"close": 5, "tol": 1e-6}}},
  {"call": "nx_create_clearance_set",
   "args": {"part": "$part", "name": "er"},
   "expect": {"error.code": "NX_ALREADY_EXISTS", "error.field": "/name", "error.details.existing": "ER",
              "mutation_outcome": "not_started"}},
  {"call": "nx_create_clearance_set",
   "args": {"part": "$part", "name": "BODIES", "between": "bodies", "objects": ["$A.data.component.id"],
            "against": ["$B.data.component.id", "$C.data.component.id"],
            "exclude": [["$A.data.component.id", "$C.data.component.id"]], "clearance": 10},
   "expect": {"mutation_outcome": "committed", "data.clearance_set.between": "bodies",
              "data.clearance_set.objects": 1, "data.clearance_set.against": 2,
              "data.summary.pairs": 2, "data.summary.excluded_pairs": 1,
              "data.summary.hard": 1, "data.summary.soft": 0,
              "data.interferences": {"count": 1}, "data.interferences.0.objects.0.kind": "body",
              "data.interferences.0.overlap_volume": {"close": 100000, "tol": 1e-3}}},
  {"call": "nx_set_component_pose", "setup": true,
   "args": {"part": "$part", "component": "$C.data.component.id", "mode": "absolute", "translation": [-100, 0, 0]}},
  {"call": "nx_run_clearance_set",
   "args": {"part": "$part", "name": "er", "overlap": false},
   "expect": {"mutation_outcome": "committed", "data.summary.version": 2,
              "data.summary.hard": 1, "data.summary.soft": 0, "data.summary.touching": 1,
              "data.interferences": {"count": 2}, "data.interferences.1.type": "touching",
              "data.interferences.1.new": true, "data.interferences.0.new": false,
              "data.interferences.1.previous_type": "soft", "data.cleared": {"count": 0}}},
  {"call": "nx_set_component_pose", "setup": true,
   "args": {"part": "$part", "component": "$C.data.component.id", "mode": "absolute", "translation": [-150, 0, 0]}},
  {"call": "nx_run_clearance_set",
   "args": {"part": "$part", "name": "ER", "overlap": false},
   "expect": {"mutation_outcome": "committed", "data.summary.version": 3, "data.summary.touching": 0,
              "data.interferences": {"count": 1}, "data.interferences.0.type": "hard",
              "data.cleared": {"count": 1}, "data.cleared.0.previous_type": "touching",
              "data.cleared.0.objects": {"count": 2}}},
  {"call": "nx_list_clearance_sets", "args": {"part": "$part"},
   "expect": {"ok": true, "data.items": {"count": 2}, "data.items.0.name": "BODIES",
              "data.items.1.name": "ER", "data.items.1.last_run.version": 3,
              "data.items.1.last_run.touching": 0}},
  {"call": "nx_delete_clearance_set", "args": {"part": "$part", "name": "bodies"},
   "expect": {"mutation_outcome": "committed", "data.deleted": "BODIES", "data.remaining": ["ER"]}},
  {"call": "nx_run_clearance_set", "args": {"part": "$part", "name": "BODIES"},
   "expect": {"error.code": "NX_NOT_FOUND", "mutation_outcome": "not_started"}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/cs_empty.prt", "units": "mm"}},
  {"call": "nx_list_clearance_sets", "args": {"part": "cs_empty"},
   "expect": {"ok": true, "data.items": {"count": 0}, "warnings.0.code": "NX_NOTE"}}
 ]
}
