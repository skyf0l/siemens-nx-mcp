{
 "covers": {
  "nx_create_assembly_cut": [],
  "nx_create_arrangement": [],
  "nx_set_arrangement_component": [],
  "nx_edit_arrangement": ["set_default"]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/cut_deck.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "args": {"part": "cut_deck", "length": 400, "width": 300, "height": 10}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "cut_deck"}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/cut_trunk.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "args": {"part": "cut_trunk", "length": 100, "width": 80, "height": 60}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "cut_trunk"}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "DECK", "args": {"part": "$part", "path": "$run/cut_deck.prt", "name": "DECK"}},
  {"call": "nx_create_component", "setup": true, "save": "TRUNK", "args": {"part": "$part", "path": "$run/cut_trunk.prt", "name": "TRUNK", "pose": {"translation": [150, 110, -20]}}},
  {"call": "nx_create_assembly_cut",
   "args": {"part": "$part", "targets": ["$DECK.data.component.id"], "tools": ["$DECK.data.component.id"]},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/tools/0", "mutation_outcome": "not_started"}},
  {"call": "nx_create_arrangement", "setup": true, "args": {"part": "$part", "name": "OPEN", "activate": true}},
  {"call": "nx_set_arrangement_component", "setup": true,
   "args": {"part": "$part", "arrangement": "OPEN", "component": "$TRUNK.data.component.id", "pose": {"translation": [150, 110, -20]}}},
  {"call": "nx_create_assembly_cut",
   "args": {"part": "$part", "targets": ["$DECK.data.component.id"], "tools": ["$TRUNK.data.component.id"]},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/tools/0", "error.details.active": "OPEN",
              "error.details.default": "Arrangement 1", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_arrangement", "setup": true, "args": {"part": "$part", "arrangement": "OPEN", "action": "set_default"}},
  {"call": "nx_create_assembly_cut", "save": "cut",
   "args": {"part": "$part", "targets": ["$DECK.data.component.id"], "tools": ["$TRUNK.data.component.id"]},
   "expect": {"mutation_outcome": "committed", "data.feature.kind": "feature",
              "data.targets": {"count": 1}, "data.targets.0.component.name": "DECK",
              "data.targets.0.volume_before": {"close": 1200000, "tol": 1e-6},
              "data.targets.0.volume_after": {"close": 1120000, "tol": 1e-6},
              "data.targets.0.removed": {"close": 80000, "tol": 1e-6},
              "data.tools.0.name": "TRUNK", "data.bodies": {"count": 1}}},
  {"call": "nx_create_assembly_cut",
   "args": {"part": "$part", "targets": ["$DECK.data.component.id"], "tools": ["$TRUNK.data.component.id"]},
   "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/targets/0", "error.details.cuts": {"count": 1},
              "error.details.cuts.0.id": "$cut.data.feature.id", "error.details.bodies.0.id": "$cut.data.bodies.0.id",
              "mutation_outcome": "not_started"}},
  {"call": "nx_check_model", "args": {"part": "$part"},
   "expect": {"ok": true}},
  {"call": "nx_create_component", "setup": true, "save": "FAR", "args": {"part": "$part", "path": "$run/cut_deck.prt", "name": "FAR", "pose": {"translation": [2000, 0, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "FAR2", "args": {"part": "$part", "path": "$run/cut_deck.prt", "name": "FAR2", "pose": {"translation": [3000, 0, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "TFAR", "args": {"part": "$part", "path": "$run/cut_trunk.prt", "name": "T_FAR", "pose": {"translation": [5000, 0, -20]}}},
  {"call": "nx_create_component", "setup": true, "save": "T3", "args": {"part": "$part", "path": "$run/cut_trunk.prt", "name": "T3", "pose": {"translation": [2150, 110, -20]}}},
  {"call": "nx_create_component", "setup": true, "save": "T4", "args": {"part": "$part", "path": "$run/cut_trunk.prt", "name": "T4", "pose": {"translation": [3440, 270, -20], "rotation": {"axis": "z", "angle": 45}}}},
  {"call": "nx_create_assembly_cut", "intent": "No tool reaches the target", "args": {"part": "$part", "targets": ["$FAR.data.component.id"], "tools": ["$TFAR.data.component.id"]}, "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/tools", "error.details.targets": {"count": 1}, "mutation_outcome": "not_started"}},
  {"call": "nx_create_assembly_cut", "intent": "One of two targets is not reached", "args": {"part": "$part", "targets": ["$FAR.data.component.id", "$FAR2.data.component.id"], "tools": ["$T3.data.component.id"]}, "expect": {"mutation_outcome": "committed", "data.targets": {"count": 2}, "data.targets.0.removed": {"close": 80000, "tol": 1e-06}, "data.targets.0.volume_after": {"close": 1120000, "tol": 1e-06}, "data.targets.1.removed": {"close": 0, "tol": 1e-09}, "data.targets.1.volume_after": {"close": 1200000, "tol": 1e-06}, "data.bodies": {"count": 1}, "warnings": {"contains": {"code": "NX_NO_EFFECT"}}}},
  {"call": "nx_create_assembly_cut", "intent": "A turned tool whose box meets the target's but whose solid misses it", "args": {"part": "$part", "targets": ["$FAR2.data.component.id"], "tools": ["$T4.data.component.id"]}, "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/tools", "error.nx_code": 3545001, "mutation_outcome": "rolled_back"}}
 ]
}
