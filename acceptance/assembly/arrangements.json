{
 "covers": {
  "nx_create_arrangement": [],
  "nx_edit_arrangement": ["activate", "rename", "set_default", "delete"],
  "nx_set_arrangement_component": [],
  "nx_list_arrangements": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/arr_deck.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "args": {"part": "arr_deck", "length": 400, "width": 300, "height": 10}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "arr_deck"}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/arr_hatch.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "args": {"part": "arr_hatch", "length": 100, "width": 80, "height": 5}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "arr_hatch"}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "DECK", "args": {"part": "$part", "path": "$run/arr_deck.prt", "name": "DECK"}},
  {"call": "nx_create_component", "setup": true, "save": "HATCH", "args": {"part": "$part", "path": "$run/arr_hatch.prt", "name": "HATCH", "pose": {"translation": [150, 110, 10]}}},
  {"call": "nx_list_arrangements", "save": "first", "args": {"part": "$part"},
   "expect": {"data.items": {"count": 1}, "data.items.0.active": true, "data.items.0.suppressed": {"count": 0},
              "data.components": {"count": 2}, "data.components.1.name": "HATCH",
              "data.components.1.translation": {"close": [150, 110, 10], "tol": 1e-6}}},
  {"call": "nx_create_arrangement", "args": {"part": "$part", "name": "OPEN"},
   "expect": {"mutation_outcome": "committed", "data.arrangement.name": "OPEN", "data.arrangement.active": false,
              "data.arrangements": {"count": 2}}},
  {"call": "nx_create_arrangement", "args": {"part": "$part", "name": "open"},
   "expect": {"error.code": "NX_ALREADY_EXISTS", "error.details.arrangement": "OPEN", "mutation_outcome": "not_started"}},
  {"call": "nx_set_arrangement_component",
   "args": {"part": "$part", "arrangement": "OPEN", "component": "$HATCH.data.component.id",
            "pose": {"translation": [150, 110, 15], "rotation": {"axis": "x", "angle": 90}}},
   "expect": {"mutation_outcome": "committed", "data.varied": true, "data.suppressed": false,
              "data.component.translation": {"close": [150, 110, 15], "tol": 1e-6},
              "data.component.rotation": {"close": [[1, 0, 0], [0, 0, -1], [0, 1, 0]], "tol": 1e-6},
              "data.arrangement.active": false}},
  {"call": "nx_set_arrangement_component",
   "args": {"part": "$part", "arrangement": "OPEN", "component": "$DECK.data.component.id", "suppressed": true},
   "expect": {"mutation_outcome": "committed", "data.suppressed": true}},
  {"call": "nx_undo_operation", "args": {"part": "$part", "mode": "compensate"},
   "expect": {"ok": true, "data.compensated": true, "data.restored.0": {"matches": "back to unsuppressed"}}},
  {"call": "nx_set_arrangement_component", "setup": true,
   "args": {"part": "$part", "arrangement": "OPEN", "component": "$DECK.data.component.id", "suppressed": true}},
  {"call": "nx_list_arrangements", "args": {"part": "$part"},
   "expect": {"data.items": {"count": 2}, "data.items.0.active": true, "data.items.1.name": "OPEN",
              "data.items.1.suppressed": {"count": 1}, "data.items.1.suppressed.0.name": "DECK", "data.items.1.suppressed.0.kind": "component", "data.items.0.suppressed": {"count": 0},
              "data.components.1.varied": true, "data.components.0.varied": false,
              "data.components.1.translation": {"close": [150, 110, 10], "tol": 1e-6},
              "data.components.1.rotation": {"close": [[1, 0, 0], [0, 1, 0], [0, 0, 1]], "tol": 1e-6},
              "data.components.0.suppressed": false}},
  {"call": "nx_edit_arrangement", "args": {"part": "$part", "arrangement": "open", "action": "activate"},
   "expect": {"mutation_outcome": "committed", "data.arrangement.active": true,
              "data.components.1.translation": {"close": [150, 110, 15], "tol": 1e-6},
              "data.components.1.rotation": {"close": [[1, 0, 0], [0, 0, -1], [0, 1, 0]], "tol": 1e-6},
              "data.components.0.suppressed": true}},
  {"call": "nx_edit_arrangement", "args": {"part": "$part", "arrangement": "OPEN", "action": "delete"},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/arrangement", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_arrangement", "args": {"part": "$part", "arrangement": "OPEN", "action": "rename", "new_name": "HATCH_OPEN"},
   "expect": {"mutation_outcome": "committed", "data.arrangement.name": "HATCH_OPEN", "data.previous_name": "OPEN"}},
  {"call": "nx_undo_operation", "args": {"part": "$part", "mode": "compensate"},
   "expect": {"ok": true, "data.compensated": true, "data.restored.0": {"matches": "renamed back to OPEN"}}},
  {"call": "nx_edit_arrangement", "setup": true, "args": {"part": "$part", "arrangement": "OPEN", "action": "rename", "new_name": "HATCH_OPEN"}},
  {"call": "nx_edit_arrangement", "args": {"part": "$part", "arrangement": "HATCH_OPEN", "action": "set_default"},
   "expect": {"mutation_outcome": "committed", "data.arrangement.default": true}},
  {"call": "nx_create_arrangement", "args": {"part": "$part", "name": "SHUT", "copy_from": "$first.data.items.0.name", "activate": true},
   "expect": {"mutation_outcome": "committed", "data.arrangement.active": true, "data.arrangements": {"count": 3},
              "data.components.1.translation": {"close": [150, 110, 10], "tol": 1e-6},
              "data.components.0.suppressed": false}},
  {"call": "nx_edit_arrangement", "args": {"part": "$part", "arrangement": "SHUT", "action": "set_default"},
   "expect": {"data.arrangement.default": true}},
  {"call": "nx_edit_arrangement", "args": {"part": "$part", "arrangement": "HATCH_OPEN", "action": "delete"},
   "expect": {"mutation_outcome": "committed", "data.arrangements": {"count": 2}, "data.arrangement.name": "HATCH_OPEN"}}
 ]
}
