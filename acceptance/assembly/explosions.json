{
 "covers": {
  "nx_create_explosion": [],
  "nx_edit_explosion": [],
  "nx_get_explosion": [],
  "nx_set_explosion_display": [],
  "nx_create_explosion_trace": [],
  "nx_edit_explosion_trace": [],
  "nx_export_explosion_animation": []
 },
 "fixture": "fixtures/parts_files_block_mm.prt",
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/exp/asm_exp_pin.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 5}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 20}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/exp/asm_exp_sub.prt", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "args": {"path": "$run/exp/asm_exp_pin.prt", "name": "PA"}},
  {"call": "nx_create_component", "setup": true, "args": {"path": "$fixture", "name": "PB", "pose": {"translation": [30, 0, 0]}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "A", "args": {"path": "$fixture", "name": "A"}},
  {"call": "nx_create_component", "setup": true, "save": "B", "args": {"path": "$fixture", "name": "B", "pose": {"translation": [60, 0, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "S", "args": {"path": "$run/exp/asm_exp_sub.prt", "name": "SUB", "pose": {"translation": [0, 50, 0]}}},
  {"call": "nx_list_components", "setup": true, "save": "pa", "args": {"name_contains": "PA"}},
  {"call": "nx_create_explosion", "save": "ex", "args": {"name": "E1"},
   "expect": {"mutation_outcome": "committed", "data.explosion.kind": "explosion", "data.explosion.name": "E1",
              "data.component_count": 5, "data.views": {"count": 1}, "data.views.0.kind": "modeling_view", "data.components": {"count": 5},
              "warnings": {"contains": {"code": "NX_NO_EFFECT"}}}},
  {"call": "nx_create_explosion", "args": {"name": "e1"},
   "expect": {"error.code": "NX_NAME_CONFLICT", "error.field": "/name", "mutation_outcome": "not_started",
              "error.details.existing.kind": "explosion", "error.details.existing.name": "E1"}},
  {"call": "nx_create_explosion", "args": {"name": "E2 "},
   "expect": {"error.category": "invalid_argument", "error.field": "/name", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex.data.explosion.id", "placements": [
     {"component": "$A.data.component.id", "pose": {"translation": [0, 0, 30]}},
     {"component": "$B.data.component.id", "pose": {"translation": [60, 0, 20]}},
     {"component": "$S.data.component.id", "pose": {"translation": [0, 50, 50]}},
     {"component": "$pa.data.items.0.id", "pose": {"translation": [0, 50, 100], "rotation": [[0, -1, 0], [1, 0, 0], [0, 0, 1]]}}]},
   "expect": {"mutation_outcome": "committed", "data.components": {"count": 4},
              "data.components.0.translation": {"close": [0, 0, 30], "tol": 1e-6},
              "data.components.0.assembled_translation": {"close": [0, 0, 0], "tol": 1e-9},
              "data.components.3.component.path": "SUB/PA",
              "data.components.3.translation": {"close": [0, 50, 100], "tol": 1e-6},
              "data.components.3.rotation": {"close": [[0, -1, 0], [1, 0, 0], [0, 0, 1]], "tol": 1e-9},
              "data.components.3.assembled_translation": {"close": [0, 50, 0], "tol": 1e-9},
              "data.moved_count": 5}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id", "limit": 50},
   "expect": {"page.total": 5, "page.returned": 5,
              "data.components": {"contains": {"component": {"name": "PB"}, "translation": [30.0, 50.0, 50.0], "assembled_translation": [30.0, 50.0, 0.0]}},
              "data.traces": {"count": 0}}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id", "offset": 1, "limit": 2},
   "expect": {"page.total": 5, "page.returned": 2, "page.next_offset": 3}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex.data.explosion.id", "placements": [
     {"component": "$B.data.component.id", "pose": {"translation": [60, 0, 20]}}]},
   "expect": {"mutation_outcome": "committed", "data.moved_count": 0}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex.data.explosion.id"},
   "expect": {"error.category": "invalid_argument", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex.data.explosion.id", "reset_components": ["$A.data.component.id"], "placements": [
     {"component": "$A.data.component.id", "pose": {"translation": [1, 0, 0]}}]},
   "expect": {"error.field": "/placements/0/component", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex.data.explosion.id", "placements": [
     {"component": "$A.data.component.id", "pose": {"translation": [1, 0, 0], "rotation": [[1, 0, 0], [0, 1, 0], [0, 0, -1]]}}]},
   "expect": {"error.field": "/placements/0/pose/rotation", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$A.data.component.id", "reset_components": ["$A.data.component.id"]},
   "expect": {"error.category": "wrong_kind", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex.data.explosion.id", "reset_components": ["$S.data.component.id"]},
   "expect": {"mutation_outcome": "committed", "data.components.0.translation": {"close": [0, 50, 0], "tol": 1e-9}}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id", "limit": 50},
   "expect": {"data.components": {"contains": {"component": {"name": "PB"}, "translation": [30.0, 50.0, 0.0]}},
              "data.components.0.assembled_translation": {"count": 3}}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id", "limit": 50},
   "expect": {"data.components": {"contains": {"component": {"name": "PA"}, "translation": [0.0, 50.0, 50.0]}}}},
  {"call": "nx_find_geometry", "setup": true, "save": "ea", "args": {"owner": "$A.data.component.id", "kind": "edge", "geometry_type": "line", "near": [20, 20, 10], "order": "nearest", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "eb", "args": {"owner": "$B.data.component.id", "kind": "edge", "geometry_type": "line", "near": [100, 10, 10], "order": "nearest", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "fa", "args": {"owner": "$A.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_create_explosion_trace", "save": "tr", "args": {"explosion": "$ex.data.explosion.id", "start_edge": "$ea.data.items.0.id", "end_edge": "$eb.data.items.0.id", "start_percent": 0, "end_percent": 100},
   "expect": {"mutation_outcome": "committed", "data.trace.kind": "traceline", "data.explosion.name": "E1",
              "data.start": {"close": [0, 20, 40], "tol": 1e-6}, "data.end": {"close": [100, 0, 30], "tol": 1e-6},
              "data.trace.name": "TRACE1", "data.start_edge.kind": "edge", "data.end_edge.kind": "edge",
              "data.end_percent": {"close": 100, "tol": 1e-9}, "data.start_direction": {"close": [0, 0, 1], "tol": 1e-12},
              "changes.created": {"count_kind": {"traceline": 1}}}},
  {"call": "nx_create_explosion_trace", "args": {"explosion": "$ex.data.explosion.id", "start_edge": "$fa.data.items.0.id", "end_edge": "$eb.data.items.0.id"},
   "expect": {"error.category": "wrong_kind", "mutation_outcome": "not_started"}},
  {"call": "nx_create_explosion_trace", "args": {"explosion": "$ex.data.explosion.id", "start_edge": "$ea.data.items.0.id", "end_edge": "$eb.data.items.0.id", "start_percent": 150},
   "expect": {"error.category": "invalid_argument", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_explosion_trace", "args": {"trace": "$tr.data.trace.id", "start_percent": 50, "end_offset": 3},
   "expect": {"mutation_outcome": "committed", "data.start": {"close": [20, 20, 40], "tol": 1e-6},
              "data.end": {"close": [100, 0, 30], "tol": 1e-6}, "data.end_offset": {"close": 3, "tol": 1e-9},
              "data.trace.name": "TRACE1", "data.start_percent": {"close": 50, "tol": 1e-9}}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex.data.explosion.id", "placements": [
     {"component": "$A.data.component.id", "pose": {"translation": [0, 0, 60]}}]},
   "expect": {"mutation_outcome": "committed", "data.components.0.translation": {"close": [0, 0, 60], "tol": 1e-6}}},
  {"call": "nx_edit_explosion_trace", "args": {"trace": "$tr.data.trace.id", "start_offset": 2},
   "expect": {"mutation_outcome": "committed", "data.start": {"close": [20, 20, 70], "tol": 1e-6},
              "data.start_offset": {"close": 2, "tol": 1e-9}, "data.end_offset": {"close": 3, "tol": 1e-9}}},
  {"call": "nx_edit_explosion_trace", "args": {"trace": "$tr.data.trace.id"},
   "expect": {"error.category": "invalid_argument", "mutation_outcome": "not_started"}},
  {"call": "nx_set_explosion_display", "args": {"explosion": "$ex.data.explosion.id"},
   "expect": {"mutation_outcome": "committed", "data.view_kind": "modeling_view", "data.view.kind": "modeling_view",
              "data.explosion.name": "E1"}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id"},
   "expect": {"data.views": {"count": 1}, "data.views.0.kind": "modeling_view", "data.traces": {"count": 1}}},
  {"call": "nx_set_explosion_display", "args": {"explosion": "$ex.data.explosion.id", "drawing_view": "$A.data.component.id", "model_view": "$A.data.component.id"},
   "expect": {"error.field": "/model_view", "mutation_outcome": "not_started"}},
  {"call": "nx_export_explosion_animation", "save": "anim", "args": {"explosion": "$ex.data.explosion.id", "path": "$run/exp/anim.html", "frames": 3, "fps": 2, "width": 320, "height": 240},
   "expect": {"mutation_outcome": "committed", "data.frame_count": 3, "data.frames": {"count": 3}, "data.width": 320,
              "data.trace_count": 1,
              "data.frames.1.fraction": {"close": 0.5, "tol": 1e-9}, "data.path": {"matches": "exp/anim\\.html$"},
              "data.sha256": {"matches": "^[0-9a-f]{64}$"}}},
  {"call": "nx_download_file", "args": {"path": "$run/exp/anim.html"},
   "expect": {"data.sha256": {"matches": "^[0-9a-f]{64}$"}, "data.size": {"close": 0, "tol": 1e9}}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id", "limit": 50},
   "expect": {"data.components": {"contains": {"component": {"name": "A"}, "translation": [0.0, 0.0, 60.0], "assembled_translation": [0.0, 0.0, 0.0]}},
              "data.views": {"count": 1}}},
  {"call": "nx_export_explosion_animation", "args": {"explosion": "$ex.data.explosion.id", "path": "$run/exp/anim.html", "frames": 2},
   "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
  {"call": "nx_export_explosion_animation", "args": {"explosion": "$ex.data.explosion.id", "path": "$run/exp/anim.txt", "frames": 2},
   "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "mutation_outcome": "not_started"}},
  {"call": "nx_export_explosion_animation", "args": {"explosion": "$ex.data.explosion.id", "path": "$run/exp/anim2.html", "frames": 1},
   "expect": {"error.category": "invalid_argument", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex.data.explosion.id", "placements": [
     {"component": "$A.data.component.id", "offset": [0, 0, 15]},
     {"component": "$S.data.component.id", "offset": [0, 0, 40]},
     {"component": "$pa.data.items.0.id", "offset": [0, 0, 10]}]},
   "expect": {"mutation_outcome": "committed", "data.components": {"count": 3},
              "data.components.0.translation": {"close": [0, 0, 15], "tol": 1e-6},
              "data.components.1.translation": {"close": [0, 50, 40], "tol": 1e-6},
              "data.components.2.translation": {"close": [0, 50, 50], "tol": 1e-6},
              "data.components.2.rotation": {"close": [[1, 0, 0], [0, 1, 0], [0, 0, 1]], "tol": 1e-9},
              "data.components.2.assembled_translation": {"close": [0, 50, 0], "tol": 1e-9},
              "data.moved_count": 4}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex.data.explosion.id", "placements": [
     {"component": "$A.data.component.id", "offset": [0, 0, 15]}]},
   "expect": {"mutation_outcome": "committed", "data.moved_count": 0}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex.data.explosion.id", "placements": [
     {"component": "$A.data.component.id", "offset": [0, 0, 1], "pose": {"translation": [0, 0, 1]}}]},
   "expect": {"error.field": "/placements/0", "mutation_outcome": "not_started"}},
  {"call": "nx_set_explosion_display", "args": {},
   "expect": {"mutation_outcome": "committed", "data.view_kind": "modeling_view"}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id"},
   "expect": {"data.views": {"count": 0}}},
  {"call": "nx_create_explosion", "save": "ex2", "args": {"name": "E2", "display": false, "placements": [{"component": "$B.data.component.id", "offset": [0, 0, 25]}]},
   "expect": {"mutation_outcome": "committed", "data.views": {"count": 0}, "data.moved_count": 1,
              "data.placed.0.translation": {"close": [60, 0, 25], "tol": 1e-6}}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex.data.explosion.id", "display": false, "placements": [{"component": "$B.data.component.id", "offset": [0, 0, 35]}]},
   "expect": {"mutation_outcome": "committed", "data.views": {"count": 0}, "data.moved_count": 1,
              "data.components.0.translation": {"close": [60, 0, 35], "tol": 1e-6}}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id"},
   "expect": {"data.views": {"count": 0}}},
  {"call": "nx_edit_explosion", "args": {"explosion": "$ex2.data.explosion.id", "placements": [{"component": "$A.data.component.id", "offset": [0, 0, 45]}]},
   "expect": {"mutation_outcome": "committed", "data.views": {"count": 1}, "data.views.0.kind": "modeling_view",
              "data.components.0.translation": {"close": [0, 0, 45], "tol": 1e-6}}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex2.data.explosion.id"},
   "expect": {"data.views": {"count": 1}, "data.views.0.kind": "modeling_view"}},
  {"call": "nx_create_explosion", "save": "ex3", "args": {"name": "E3"},
   "expect": {"mutation_outcome": "committed", "data.views": {"count": 1}, "data.views.0.kind": "modeling_view"}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex2.data.explosion.id"},
   "expect": {"data.views": {"count": 0}}},
  {"call": "nx_set_explosion_display", "args": {},
   "expect": {"mutation_outcome": "committed", "data.view_kind": "modeling_view"}}
 ]
}
