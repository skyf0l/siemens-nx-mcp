{
 "covers": {
  "nx_create_component_pattern": [],
  "nx_edit_component_pattern": []
 },
 "fixture": "fixtures/parts_files_block_mm.prt",
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "A", "args": {"path": "$fixture", "name": "A"}},
  {"call": "nx_create_component", "setup": true, "save": "B", "args": {"part": "$part", "path": "$fixture", "name": "B", "pose": {"translation": [60, 0, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "S", "args": {"part": "$part", "path": "$fixture", "name": "S", "pose": {"translation": [0, 200, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "T", "args": {"part": "$part", "path": "$fixture", "name": "T", "pose": {"translation": [0, -300, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "U", "args": {"part": "$part", "path": "$fixture", "name": "U", "pose": {"translation": [0, -500, 0]}}},
  {"call": "nx_create_component_pattern", "args": {"component": "$T.data.component.id", "layout": {"linear": {"direction": "-x", "count": 3, "spacing": "50 mm"}}},
   "expect": {"mutation_outcome": "committed", "data.layout": "linear", "data.count": 3, "data.spacing": {"close": 50, "tol": 1e-9},
              "data.components": {"count": 3}, "data.components.0.translation": {"close": [0, -300, 0], "tol": 1e-9}}},
  {"call": "nx_create_component_pattern", "args": {"component": "$U.data.component.id", "layout": {"circular": {"axis": "z", "count": 2, "angle": "180deg"}}},
   "expect": {"mutation_outcome": "committed", "data.layout": "circular", "data.count": 2, "data.angle": {"close": 180, "tol": 1e-9},
              "data.components": {"count": 2}}},
  {"call": "nx_create_component_pattern", "save": "lin", "args": {"component": "$A.data.component.id", "layout": {"linear": {"direction": [0, 0, 1], "count": 3, "spacing": 20, "direction2": [0, -1, 0], "count2": 2, "spacing2": 40}}},
   "expect": {"mutation_outcome": "committed", "data.associative": true, "data.layout": "linear", "data.count": 3,
              "data.spacing": {"close": 20, "tol": 1e-9}, "data.count2": 2, "data.spacing2": {"close": 40, "tol": 1e-9},
              "data.components": {"count": 6}, "data.components.0.name": "A",
              "data.components.0.translation": {"close": [0, 0, 0], "tol": 1e-9}, "data.pattern.kind": "component_pattern"}},
  {"call": "nx_list_components", "args": {"part": "$part", "name_contains": "A"},
   "expect": {"page.total": 6}},
  {"call": "nx_edit_component_pattern", "save": "lin2", "args": {"pattern": "$lin.data.pattern.id", "count": 2, "spacing": 25},
   "expect": {"mutation_outcome": "committed", "data.replaced": false, "data.count": 2, "data.spacing": {"close": 25, "tol": 1e-9},
              "data.count2": 2, "data.components": {"count": 4}}},
  {"call": "nx_edit_component_pattern", "args": {"pattern": "$lin2.data.pattern.id", "angle": 30},
   "expect": {"error.field": "/angle", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_component_pattern", "args": {"pattern": "$lin2.data.pattern.id", "count": 101},
   "expect": {"error.category": "invalid_argument", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_component_pattern", "args": {"pattern": "$lin2.data.pattern.id"},
   "expect": {"error.category": "invalid_argument", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_component_pattern", "save": "lin3", "args": {"pattern": "$lin2.data.pattern.id", "count2": 1, "spacing": 30},
   "expect": {"mutation_outcome": "committed", "data.replaced": true, "data.count": 2, "data.spacing": {"close": 30, "tol": 1e-9},
              "data.components": {"count": 2}, "warnings.0.code": "NX_UPDATE_WARNING"}},
  {"call": "nx_edit_component_pattern", "args": {"pattern": "$lin3.data.pattern.id", "count2": 2},
   "expect": {"error.code": "NX_UNSUPPORTED_OPTION", "error.field": "/count2", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_component_pattern", "args": {"pattern": "$lin3.data.pattern.id", "spacing2": 5},
   "expect": {"error.field": "/spacing2", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component_pattern", "save": "circ", "args": {"component": "$B.data.component.id", "layout": {"circular": {"axis": {"origin": [0, 0, 0], "direction": [0, 0, 1]}, "count": 3, "angle": 90}}},
   "expect": {"mutation_outcome": "committed", "data.layout": "circular", "data.count": 3, "data.angle": {"close": 90, "tol": 1e-9},
              "data.components": {"count": 3}, "data.components.0.translation": {"close": [60, 0, 0], "tol": 1e-9}}},
  {"call": "nx_edit_component_pattern", "args": {"pattern": "$circ.data.pattern.id", "count": 4, "angle": 60},
   "expect": {"mutation_outcome": "committed", "data.count": 4, "data.angle": {"close": 60, "tol": 1e-9}, "data.components.3.kind": "component",
              "data.components": {"contains": {"translation": [-60, 0, 0], "rotation": [[-1, 0, 0], [0, -1, 0], [0, 0, 1]]}}}},
  {"call": "nx_edit_component_pattern", "args": {"pattern": "$circ.data.pattern.id", "count": 7},
   "expect": {"error.field": "/angle", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_component_pattern", "args": {"pattern": "$circ.data.pattern.id", "spacing": 5},
   "expect": {"error.field": "/spacing", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component_pattern", "args": {"component": "$S.data.component.id", "associative": false, "layout": {"linear": {"direction": [1, 0, 0], "count": 3, "spacing": 50}}},
   "expect": {"mutation_outcome": "committed", "data.associative": false, "data.components": {"count": 3},
              "data.components.1.name": "S_2", "data.components.1.translation": {"close": [50, 200, 0], "tol": 1e-9},
              "data.components.2.translation": {"close": [100, 200, 0], "tol": 1e-9}, "changes.created": {"count_kind": {"component": 2}}}},
  {"call": "nx_create_component_pattern", "args": {"component": "$S.data.component.id", "associative": false, "layout": {"circular": {"axis": {"principal": "z"}, "count": 2, "angle": 180}}},
   "expect": {"mutation_outcome": "committed", "data.components": {"count": 2},
              "data.components.1.translation": {"close": [0, -200, 0], "tol": 1e-9},
              "data.components.1.rotation": {"close": [[-1, 0, 0], [0, -1, 0], [0, 0, 1]], "tol": 1e-9}}},
  {"call": "nx_create_component_pattern", "args": {"component": "$S.data.component.id", "layout": {"linear": {"direction": [1, 0, 0], "count": 2, "spacing": 5, "direction2": [2, 0, 0], "count2": 2, "spacing2": 5}}},
   "expect": {"error.field": "/layout/linear/direction2", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component_pattern", "args": {"component": "$S.data.component.id", "layout": {"linear": {"direction": [1, 0, 0], "count": 2, "spacing": 5, "count2": 2}}},
   "expect": {"error.field": "/layout/linear", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component_pattern", "args": {"component": "$S.data.component.id", "layout": {"linear": {"direction": [1, 0, 0], "count": 2, "spacing": 0}}},
   "expect": {"error.field": "/layout/linear/spacing", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component_pattern", "args": {"component": "$S.data.component.id", "layout": {"circular": {"axis": {"principal": "z"}, "count": 5, "angle": 90}}},
   "expect": {"error.field": "/layout/circular/angle", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component_pattern", "args": {"component": "$S.data.component.id", "layout": {"linear": {"direction": [1, 0, 0], "count": 20, "spacing": 5, "direction2": [0, 1, 0], "count2": 6, "spacing2": 5}}},
   "expect": {"error.code": "NX_TOO_MANY_OBJECTS", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component_pattern", "args": {"component": "$S.data.component.id", "layout": {"linear": {"direction": [0, 0, 0], "count": 2, "spacing": 5}}},
   "expect": {"error.category": "invalid_argument", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_component", "setup": true, "args": {"components": ["$S.data.component.id"], "suppressed": true}},
  {"call": "nx_create_component_pattern", "args": {"component": "$S.data.component.id", "layout": {"linear": {"direction": [1, 0, 0], "count": 2, "spacing": 5}}},
   "expect": {"error.field": "/component", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component_pattern", "args": {"component": "$circ.data.pattern.id", "layout": {"linear": {"direction": [1, 0, 0], "count": 2, "spacing": 5}}},
   "expect": {"error.category": "wrong_kind", "mutation_outcome": "not_started"}}
 ]
}
