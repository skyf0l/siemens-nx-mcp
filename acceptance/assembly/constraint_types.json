{
 "covers": {
  "nx_create_assembly_constraint": ["align_lock", "fit", "bond", "center_1_2", "center_2_2"]
 },
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/ct/ct_pin.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "psk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$psk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 5}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$psk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true,
   "args": {"sketch": "$psk.data.sketch.id", "end": {"type": "distance", "value": 20}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/ct/ct_blk.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "bsk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$bsk.data.sketch.id",
            "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$bsk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true,
   "args": {"sketch": "$bsk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "A",
   "args": {"path": "$run/ct/ct_blk.prt", "name": "A"}},
  {"call": "nx_create_component", "setup": true, "save": "B",
   "args": {"path": "$run/ct/ct_blk.prt", "name": "B", "pose": {"translation": [7, 50, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "C",
   "args": {"path": "$run/ct/ct_blk.prt", "name": "C", "pose": {"translation": [0, 100, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "P1",
   "args": {"path": "$run/ct/ct_pin.prt", "name": "P1", "pose": {"translation": [3, -30, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "P2",
   "args": {"path": "$run/ct/ct_pin.prt", "name": "P2", "pose": {"translation": [100, 40, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "P3",
   "args": {"path": "$run/ct/ct_pin.prt", "name": "P3", "pose": {"translation": [150, 0, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "P4",
   "args": {"path": "$run/ct/ct_pin.prt", "name": "P4", "pose": {"translation": [200, 30, 5]}}},
  {"call": "nx_find_geometry", "setup": true, "save": "Amx",
   "args": {"owner": "$A.data.component.id", "kind": "face", "geometry_type": "plane",
            "normal": [-1, 0, 0], "order": "lowest", "axis": "x", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "Apx",
   "args": {"owner": "$A.data.component.id", "kind": "face", "geometry_type": "plane",
            "normal": [1, 0, 0], "order": "highest", "axis": "x", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "Bmx",
   "args": {"owner": "$B.data.component.id", "kind": "face", "geometry_type": "plane",
            "normal": [-1, 0, 0], "order": "lowest", "axis": "x", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "Bpx",
   "args": {"owner": "$B.data.component.id", "kind": "face", "geometry_type": "plane",
            "normal": [1, 0, 0], "order": "highest", "axis": "x", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "P1c",
   "args": {"owner": "$P1.data.component.id", "kind": "face", "geometry_type": "cylinder", "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "P1e",
   "args": {"owner": "$P1.data.component.id", "kind": "edge", "geometry_type": "circle",
            "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "P2c",
   "args": {"owner": "$P2.data.component.id", "kind": "face", "geometry_type": "cylinder", "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "P3c",
   "args": {"owner": "$P3.data.component.id", "kind": "face", "geometry_type": "cylinder", "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "P4c",
   "args": {"owner": "$P4.data.component.id", "kind": "face", "geometry_type": "cylinder", "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_create_assembly_constraint", "setup": true, "args": {"type": "fix", "component": "$A.data.component.id"}},
  {"call": "nx_create_assembly_constraint", "setup": true, "args": {"type": "fix", "component": "$P3.data.component.id"}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "center_2_2", "component": "$B.data.component.id",
            "geometry": "$Bmx.data.items.0.id", "geometry2": "$Bpx.data.items.0.id",
            "target_component": "$A.data.component.id",
            "target_geometry": "$Amx.data.items.0.id", "target_geometry2": "$Apx.data.items.0.id"},
   "expect": {"mutation_outcome": "committed", "data.type": "center_2_2", "data.status": "Solved",
              "data.references": {"count": 4}, "data.moved": {"count": 1}, "data.moved.0.name": "B",
              "data.moved.0.translation": {"close": [0, 50, 0], "tol": 1e-06}}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "center_1_2", "component": "$P1.data.component.id",
            "geometry": "$P1c.data.items.0.id",
            "target_component": "$A.data.component.id",
            "target_geometry": "$Amx.data.items.0.id", "target_geometry2": "$Apx.data.items.0.id"},
   "expect": {"mutation_outcome": "committed", "data.type": "center_1_2", "data.status": "Solved",
              "data.references": {"count": 3}, "data.moved.0.name": "P1",
              "data.moved.0.translation": {"close": [20, -30, 0], "tol": 1e-06}}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "align_lock", "component": "$P2.data.component.id",
            "geometry": "$P2c.data.items.0.id",
            "target_component": "$P3.data.component.id", "target_geometry": "$P3c.data.items.0.id"},
   "expect": {"mutation_outcome": "committed", "data.type": "align_lock", "data.status": "Solved",
              "data.moved": {"count": 1}, "data.moved.0.name": "P2",
              "data.moved.0.translation.0": {"close": 150, "tol": 1e-06},
              "data.moved.0.translation.1": {"close": 0, "tol": 1e-06}}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "fit", "component": "$P4.data.component.id",
            "geometry": "$P4c.data.items.0.id",
            "target_component": "$P3.data.component.id", "target_geometry": "$P3c.data.items.0.id"},
   "expect": {"mutation_outcome": "committed", "data.type": "fit", "data.status": "Solved",
              "data.moved": {"count": 1}, "data.moved.0.name": "P4",
              "data.moved.0.translation.0": {"close": 150, "tol": 1e-06},
              "data.moved.0.translation.1": {"close": 0, "tol": 1e-06}}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "bond", "component": "$C.data.component.id", "target_component": "$A.data.component.id"},
   "expect": {"mutation_outcome": "committed", "data.type": "bond", "data.status": "Solved",
              "data.moved": {"count": 0}, "data.references": {"count": 2},
              "data.references.0.component.name": "C"}},
  {"call": "nx_list_components", "args": {"include_poses": true, "name_contains": "C"},
   "expect": {"page.total": 1, "data.items.0.translation": {"close": [0, 100, 0], "tol": 1e-06}}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "fit", "component": "$P4.data.component.id",
            "geometry": "$P1e.data.items.0.id",
            "target_component": "$P3.data.component.id", "target_geometry": "$P3c.data.items.0.id"},
   "expect": {"error.field": "/geometry", "mutation_outcome": "not_started"}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "fit", "component": "$P1.data.component.id",
            "geometry": "$P1e.data.items.0.id",
            "target_component": "$P3.data.component.id", "target_geometry": "$P3c.data.items.0.id"},
   "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/geometry", "mutation_outcome": "not_started"}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "center_1_2", "component": "$B.data.component.id",
            "geometry": "$Bmx.data.items.0.id",
            "target_component": "$A.data.component.id", "target_geometry": "$Amx.data.items.0.id"},
   "expect": {"error.field": "/target_geometry2", "mutation_outcome": "not_started"}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "bond", "component": "$C.data.component.id", "target_component": "$A.data.component.id",
            "alignment": "same"},
   "expect": {"error.field": "/alignment", "mutation_outcome": "not_started"}}
 ]
}
