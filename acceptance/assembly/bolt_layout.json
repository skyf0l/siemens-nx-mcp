{
 "covers": {
  "nx_create_assembly_constraint": ["fix", "concentric", "touch", "align_lock"],
  "nx_create_explosion": [],
  "nx_create_component_pattern": []
 },
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/bl/bl_pin.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "psk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$psk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 5}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$psk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$psk.data.sketch.id", "end": {"type": "distance", "value": 20}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/bl/bl_blk.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "bsk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$bsk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$bsk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$bsk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "A", "args": {"path": "$run/bl/bl_blk.prt", "name": "A"}},
  {"call": "nx_create_component", "setup": true, "save": "P1", "args": {"path": "$run/bl/bl_pin.prt", "name": "P1", "pose": {"translation": [100, 0, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "P2", "args": {"path": "$run/bl/bl_pin.prt", "name": "P2", "pose": {"translation": [200, 0, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "P3", "args": {"path": "$run/bl/bl_pin.prt", "name": "P3", "pose": {"translation": [300, 30, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "S", "args": {"path": "$run/bl/bl_pin.prt", "name": "S", "pose": {"translation": [60, 0, 50]}}},
  {"call": "nx_create_component", "setup": true, "save": "T", "args": {"path": "$run/bl/bl_pin.prt", "name": "T", "pose": {"translation": [60, 0, 100]}}},
  {"call": "nx_find_geometry", "setup": true, "save": "P1e", "args": {"owner": "$P1.data.component.id", "kind": "edge", "geometry_type": "circle", "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "P2e", "args": {"owner": "$P2.data.component.id", "kind": "edge", "geometry_type": "circle", "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "P1t", "args": {"owner": "$P1.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "P2b", "args": {"owner": "$P2.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, -1], "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "P1c", "args": {"owner": "$P1.data.component.id", "kind": "face", "geometry_type": "cylinder", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "P3c", "args": {"owner": "$P3.data.component.id", "kind": "face", "geometry_type": "cylinder", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "P3b", "args": {"owner": "$P3.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, -1], "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "At", "args": {"owner": "$A.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_create_assembly_constraint", "args": {"type": "fix", "component": "$A.data.component.id"},
   "expect": {"mutation_outcome": "committed", "data.status": "Solved"}},
  {"call": "nx_create_assembly_constraint", "args": {"type": "fix", "component": "$P1.data.component.id"},
   "expect": {"mutation_outcome": "committed", "data.status": "Solved"}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "concentric", "component": "$P2.data.component.id", "geometry": "$P2e.data.items.0.id",
            "target_component": "$P1.data.component.id", "target_geometry": "$P1e.data.items.0.id"},
   "expect": {"mutation_outcome": "committed", "data.type": "concentric", "data.status": "Solved",
              "data.moved": {"count": 1}, "data.moved.0.name": "P2",
              "data.moved.0.translation": {"close": [100, 0, 20], "tol": 1e-06}}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "touch", "component": "$P2.data.component.id", "geometry": "$P2b.data.items.0.id",
            "target_component": "$P1.data.component.id", "target_geometry": "$P1t.data.items.0.id"},
   "expect": {"mutation_outcome": "committed", "data.status": "Solved", "data.moved": {"count": 0}, "data.offset": {"close": 0, "tol": 1e-06}}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "touch", "component": "$P2.data.component.id", "geometry": "$P2b.data.items.0.id",
            "target_component": "$A.data.component.id", "target_geometry": "$At.data.items.0.id"},
   "expect": {"error.code": "NX_CONSTRAINT_UNSATISFIED", "error.hint": {"matches": "align_lock"},
              "error.details.others": {"count": 2}, "mutation_outcome": "rolled_back"}},
  {"call": "nx_list_components", "args": {"include_poses": true, "name_contains": "P2"},
   "expect": {"page.total": 1, "data.items.0.translation": {"close": [100, 0, 20], "tol": 1e-06}}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "align_lock", "component": "$P3.data.component.id", "geometry": "$P3c.data.items.0.id",
            "target_component": "$P1.data.component.id", "target_geometry": "$P1c.data.items.0.id"},
   "expect": {"mutation_outcome": "committed", "data.status": "Solved",
              "data.moved.0.translation.0": {"close": 100, "tol": 1e-06},
              "data.moved.0.translation.1": {"close": 0, "tol": 1e-06}}},
  {"call": "nx_create_assembly_constraint",
   "args": {"type": "touch", "component": "$P3.data.component.id", "geometry": "$P3b.data.items.0.id",
            "target_component": "$A.data.component.id", "target_geometry": "$At.data.items.0.id"},
   "expect": {"mutation_outcome": "committed", "data.status": "Solved", "warnings": {"count": 0},
              "data.moved.0.translation": {"close": [100, 0, 10], "tol": 1e-06}}},
  {"call": "nx_create_explosion", "args": {"name": "PLAIN"},
   "expect": {"mutation_outcome": "committed", "warnings.0.code": "NX_NO_EFFECT"}},
  {"call": "nx_create_explosion", "save": "ex",
   "args": {"name": "EXB", "placements": [{"component": "$P2.data.component.id", "offset": [0, 0, 40]},
                                          {"component": "$P3.data.component.id", "pose": {"translation": [100, 50, 10]}}]},
   "expect": {"mutation_outcome": "committed", "warnings": {"count": 0}, "data.moved_count": 2,
              "data.placed.0.translation": {"close": [100, 0, 60], "tol": 1e-06},
              "data.placed.0.assembled_translation": {"close": [100, 0, 20], "tol": 1e-06},
              "data.placed.1.translation": {"close": [100, 50, 10], "tol": 1e-06}}},
  {"call": "nx_get_explosion", "args": {"explosion": "$ex.data.explosion.id", "limit": 10},
   "expect": {"page.total": 6}},
  {"call": "nx_create_explosion", "args": {"name": "BAD", "placements": [{"component": "$P2.data.component.id", "offset": [0, 0, 1]}, {"component": "$P2.data.component.id", "offset": [0, 0, 2]}]},
   "expect": {"error.field": "/placements/1/component", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component_pattern", "args": {"component": "$S.data.component.id", "layout": {"circular": {"axis": "z", "count": 4, "angle": 90, "span": true}}},
   "expect": {"mutation_outcome": "committed", "data.angle": {"close": 30, "tol": 1e-09}, "data.count": 4, "data.components": {"count": 4}}},
  {"call": "nx_create_component_pattern", "args": {"component": "$T.data.component.id", "associative": false, "layout": {"circular": {"axis": "z", "count": 4, "angle": "360 deg", "span": true}}},
   "expect": {"mutation_outcome": "committed", "data.angle": {"close": 90, "tol": 1e-09}, "data.components": {"count": 4},
              "data.components.1.translation": {"close": [0, 60, 100], "tol": 1e-06},
              "data.components.2.translation": {"close": [-60, 0, 100], "tol": 1e-06}}},
  {"call": "nx_create_component_pattern", "args": {"component": "$T.data.component.id", "layout": {"circular": {"axis": "z", "count": 3, "angle": 400, "span": true}}},
   "expect": {"error.field": "/layout/circular/angle", "mutation_outcome": "not_started"}}
 ]
}
