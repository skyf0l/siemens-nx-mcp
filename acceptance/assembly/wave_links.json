{
 "covers": {"nx_create_wave_link": ["body", "face", "curve", "datum", "sketch"]},
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "pa", "args": {"path": "$run/wl/wl_a.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "save": "cv", "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [20, 10]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "ext", "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 30}}},
  {"call": "nx_find_geometry", "setup": true, "save": "top", "args": {"kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_create_datum_plane", "setup": true, "save": "dp", "args": {"method": "offset", "reference": "$top.data.items.0.id", "distance": 5}},
  {"call": "nx_create_datum_axis", "setup": true, "save": "da", "args": {"method": "point_direction", "origin": [5, 5, 0], "direction": [0, 0, 1]}},
  {"call": "nx_create_datum_csys", "setup": true, "save": "dc", "args": {"origin": [10, 5, 10], "x_axis": [1, 0, 0], "y_axis": [0, 1, 0]}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "save": "pb", "args": {"path": "$run/wl/wl_b.prt", "units": "mm"}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "$pb.data.part.id"}},
  {"call": "nx_create_part", "setup": true, "save": "asm", "args": {"path": "$part", "units": "mm", "display": true}},
  {"call": "engineer", "args": {"code": "from nx_mcp.kit import parts as kp\nservices.host._remember_model()  # the development tool's own undo mark is no engineer edit\np = [x for x in session.Parts if str(x.Leaf).lower().startswith('assembly_wave_links') and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nkp.show(NXOpen, session.Parts, p)\nresult = p.Leaf"}, "intent": "Acceptance: the engineer looks at assembly_wave_links.prt (a tab click, no edit): it is the displayed part whatever NX showed before (engineer tab guard)", "expect": {"ok": true, "data.noticed": false}},
  {"call": "nx_create_component", "setup": true, "save": "A", "args": {"part": "$part", "path": "$run/wl/wl_a.prt", "name": "A"}},
  {"call": "nx_create_component", "setup": true, "save": "B", "args": {"part": "$part", "path": "$run/wl/wl_b.prt", "name": "B", "pose": {"translation": [100, 0, 0], "rotation": [[0, -1, 0], [1, 0, 0], [0, 0, 1]]}}},
  {"call": "nx_find_geometry", "setup": true, "save": "Atop", "args": {"owner": "$A.data.component.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "Aedge", "args": {"owner": "$A.data.component.id", "kind": "edge", "geometry_type": "line", "near": [10, 0, 30], "order": "nearest", "limit": 1}},
  {"call": "nx_create_wave_link", "args": {"kind": "body", "sources": ["$ext.data.bodies.0.id"], "component": "$A.data.component.id"}, "expect": {"error.code": "NX_WRONG_PART_CONTEXT", "error.details.targets": {"count": 2}, "mutation_outcome": "not_started"}},
  {"call": "nx_activate_part", "setup": true, "args": {"part": "$pb.data.part.id", "display": false}},
  {"call": "nx_create_wave_link", "save": "lb", "args": {"kind": "body", "sources": ["$ext.data.bodies.0.id"], "component": "$A.data.component.id"}, "expect": {"mutation_outcome": "committed", "data.volume": {"close": 6000, "tol": 1e-06}, "data.features": {"count": 1}, "data.features.0.name": {"matches": "^LINKED_BODY"}, "data.bodies": {"count": 1}, "data.sources.0.kind": "body", "data.associative": true}},
  {"call": "nx_create_wave_link", "save": "lbt", "args": {"kind": "body", "sources": ["$ext.data.bodies.0.id"], "component": "$A.data.component.id", "at_timestamp": true}, "expect": {"mutation_outcome": "committed", "data.volume": {"close": 6000, "tol": 1e-06}, "data.at_timestamp": true}},
  {"call": "nx_create_wave_link", "save": "lbn", "args": {"kind": "body", "sources": ["$ext.data.bodies.0.id"], "component": "$A.data.component.id", "associative": false}, "expect": {"mutation_outcome": "committed", "data.volume": {"close": 6000, "tol": 1e-06}, "data.associative": false}},
  {"call": "nx_create_wave_link", "args": {"kind": "face", "sources": ["$Atop.data.items.0.id"]}, "expect": {"mutation_outcome": "committed", "data.area": {"close": 200, "tol": 1e-06}, "data.features.0.name": {"matches": "^LINKED_FACE"}, "data.bodies": {"count": 1}}},
  {"call": "nx_create_wave_link", "args": {"kind": "curve", "sources": ["$cv.data.curves.0.curve.id", "$cv.data.curves.1.curve.id"], "component": "$A.data.component.id"}, "expect": {"mutation_outcome": "committed", "data.length": {"close": 30, "tol": 1e-06}, "data.objects": {"count": 2}, "data.features.0.name": {"matches": "^LINKED_CURVE"}}},
  {"call": "nx_create_wave_link", "args": {"kind": "curve", "sources": ["$Aedge.data.items.0.id"]}, "expect": {"mutation_outcome": "committed", "data.length": {"close": 20, "tol": 1e-06}, "data.sources.0.kind": "edge", "data.objects": {"count": 1}}},
  {"call": "nx_create_wave_link", "args": {"kind": "datum", "sources": ["$dp.data.datum_plane.id", "$da.data.datum_axis.id", "$dc.data.datum_csys.id"], "component": "$A.data.component.id"}, "expect": {"mutation_outcome": "committed", "data.features": {"count": 3}, "data.objects": {"count_kind": {"datum_plane": 1, "datum_axis": 1, "datum_csys": 1}}, "data.datums.0.origin.2": {"close": 35, "tol": 1e-06}, "data.datums.0.normal": {"close": [0, 0, 1], "tol": 1e-09}, "data.datums.1.origin.0": {"close": 5, "tol": 1e-06}, "data.datums.1.origin.1": {"close": 5, "tol": 1e-06}, "data.datums.1.direction": {"close": [0, 0, 1], "tol": 1e-09}, "data.datums.2.origin": {"close": [10, 5, 10], "tol": 1e-06}, "data.datums.2.axes.0": {"close": [1, 0, 0], "tol": 1e-09}, "data.datums.2.axes.2": {"close": [0, 0, 1], "tol": 1e-09}}},
  {"call": "nx_create_wave_link", "args": {"kind": "sketch", "sources": ["$sk.data.sketch.id"], "component": "$A.data.component.id"}, "expect": {"mutation_outcome": "committed", "data.length": {"close": 60, "tol": 1e-06}, "data.objects": {"count": 4}, "data.features.0.name": {"matches": "^LINKED_SKETCH"}}},
  {"call": "nx_create_wave_link", "args": {"kind": "face", "sources": ["$ext.data.bodies.0.id"], "component": "$A.data.component.id"}, "expect": {"error.code": "NX_WRONG_KIND", "error.field": "/sources/0", "mutation_outcome": "not_started"}},
  {"call": "nx_create_wave_link", "args": {"kind": "body", "sources": ["$ext.data.bodies.0.id"]}, "expect": {"mutation_outcome": "committed", "data.volume": {"close": 6000, "tol": 1e-06}, "data.sources": {"count": 1}, "data.sources.0.name": {"matches": "^A/"}}},
  {"call": "nx_create_wave_link", "args": {"kind": "body", "sources": ["$A.data.component.id"]}, "expect": {"mutation_outcome": "committed", "data.volume": {"close": 6000, "tol": 1e-06}, "data.bodies": {"count": 1}, "data.sources": {"count": 1}, "data.sources.0.kind": "body", "data.sources.0.name": {"matches": "^A/"}}},
  {"call": "nx_create_wave_link", "args": {"kind": "face", "sources": ["$A.data.component.id"]}, "expect": {"error.code": "NX_WRONG_KIND", "error.field": "/sources/0", "mutation_outcome": "not_started"}},
  {"call": "nx_create_wave_link", "args": {"kind": "body", "sources": ["$lb.data.bodies.0.id"], "component": "$B.data.component.id"}, "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/sources/0", "mutation_outcome": "not_started"}},
  {"call": "nx_create_wave_link", "args": {"kind": "body", "sources": ["$ext.data.bodies.0.id"], "component": "$B.data.component.id"}, "expect": {"error.code": "NX_WRONG_OWNER", "error.field": "/sources/0", "mutation_outcome": "not_started"}},
  {"call": "nx_create_wave_link", "args": {"kind": "body", "sources": ["$ext.data.bodies.0.id"], "component": "$A.data.component.id", "associative": false, "at_timestamp": true}, "expect": {"error.field": "/at_timestamp", "mutation_outcome": "not_started"}},
  {"call": "nx_activate_part", "setup": true, "args": {"part": "$pa.data.part.id", "display": false}},
  {"call": "nx_create_sketch", "setup": true, "save": "cut", "args": {"part": "wl_a", "placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$cut.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [5, 5]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$cut.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$cut.data.sketch.id", "end": {"type": "distance", "value": 10}, "combine": {"operation": "subtract", "targets": ["$ext.data.bodies.0.id"]}}},
  {"call": "nx_edit_feature", "setup": true, "args": {"feature": "$ext.data.feature.id", "parameters": [{"name": "distance", "value": 45}]}},
  {"call": "nx_activate_part", "setup": true, "args": {"part": "$asm.data.part.id"}},
  {"call": "nx_update_assembly", "args": {"part": "$part"}, "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$lb.data.bodies.0.id"]}, "expect": {"data.volume": {"close": 8750, "tol": 1e-06}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$lbt.data.bodies.0.id"]}, "expect": {"data.volume": {"close": 9000, "tol": 1e-06}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$lbn.data.bodies.0.id"]}, "expect": {"data.volume": {"close": 6000, "tol": 1e-06}}}
 ]
}
