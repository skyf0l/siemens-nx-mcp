{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "front", "args": {"path": "$run/ma/ma_front.prt", "units": "mm"}},
  {"call": "nx_create_part", "setup": true, "save": "pin", "args": {"path": "$run/ma/ma_pin.prt", "units": "mm", "display": false}},
  {"call": "nx_create_primitive", "setup": true, "save": "pblk", "args": {"shape": "block", "length": 10, "width": 10, "height": 20, "part": "ma_pin"}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "$pin.data.part.id"}},
  {"call": "nx_create_part", "setup": true, "save": "asm", "args": {"path": "$run/ma/ma_asm.prt", "units": "mm", "display": false}},

  {"call": "nx_create_component", "save": "P1", "args": {"part": "ma_asm", "path": "$run/ma/ma_pin.prt", "name": "PIN1"},
   "intent": "Acceptance: a component added to a background assembly (quiet work part)",
   "expect": {"mutation_outcome": "committed", "part.file": "ma_asm.prt", "part.from": "part"}},
  {"call": "nx_create_component", "save": "P2", "args": {"part": "ma_asm", "path": "$run/ma/ma_pin.prt", "name": "PIN2", "pose": {"translation": [50, 0, 0]}},
   "expect": {"mutation_outcome": "committed", "part.file": "ma_asm.prt"}},
  {"call": "nx_create_component", "save": "ctx", "args": {"part": "ma_asm", "mode": "new_in_context", "new_path": "$run/ma/ma_ctx.prt", "name": "CTX", "pose": {"translation": [0, 40, 0]}},
   "intent": "Acceptance: new_in_context in a background assembly",
   "expect": {"mutation_outcome": "committed", "part.file": "ma_asm.prt", "data.units": "mm"}},
  {"call": "nx_list_parts", "args": {},
   "intent": "Acceptance: the engineer's display never moved",
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_list_components", "args": {"part": "ma_asm"},
   "expect": {"ok": true, "part.file": "ma_asm.prt", "data.items": {"count": 3}}},

  {"call": "nx_find_geometry", "save": "p1body", "args": {"owner": "$P1.data.component.id", "kind": "body", "limit": 1},
   "intent": "Acceptance: occurrence geometry of a background assembly (a bound read)",
   "expect": {"data.items": {"count": 1}, "part.file": "ma_asm.prt"}},
  {"call": "nx_create_reference_set", "args": {"name": "PINSET", "objects": ["$p1body.data.items.0.id"], "component": "$P1.data.component.id"},
   "intent": "Acceptance: a reference set in a component's part (working_in: display mode on the assembly)",
   "expect": {"mutation_outcome": "committed", "part.file": "ma_asm.prt", "part.from": "refs"}},
  {"call": "nx_list_parts", "args": {},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_create_wave_link", "save": "link", "args": {"kind": "body", "sources": ["$p1body.data.items.0.id"], "target": "$ctx.data.component.id"},
   "intent": "Acceptance: a WAVE link into a target component of a background assembly (display mode)",
   "expect": {"mutation_outcome": "committed", "part.file": "ma_asm.prt", "data.volume": {"close": 2000, "tol": 1e-06}}},
  {"call": "nx_list_parts", "args": {},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_create_explosion", "save": "ex", "args": {"part": "ma_asm", "name": "E1", "placements": [{"component": "$P2.data.component.id", "offset": [0, 0, 30]}]},
   "intent": "Acceptance: an explosion of a background assembly (display mode)",
   "expect": {"mutation_outcome": "committed", "part.file": "ma_asm.prt"}},
  {"call": "nx_set_explosion_display", "args": {"explosion": "$ex.data.explosion.id"},
   "intent": "Acceptance: the explosion shown on the background assembly, then the display comes back",
   "expect": {"mutation_outcome": "committed", "part.file": "ma_asm.prt"}},
  {"call": "nx_set_explosion_display", "args": {"part": "ma_asm"},
   "expect": {"mutation_outcome": "committed", "part.file": "ma_asm.prt"}},
  {"call": "nx_set_component_pose", "args": {"component": "$P2.data.component.id", "mode": "absolute", "translation": [60, 0, 0]},
   "intent": "Acceptance: a component pose by ref in a background assembly (quiet)",
   "expect": {"mutation_outcome": "committed", "part.file": "ma_asm.prt"}},
  {"call": "nx_list_parts", "args": {},
   "intent": "Acceptance: after all assembly variants the engineer's display and work part are intact",
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}}
 ]
}
