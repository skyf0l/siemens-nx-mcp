{
 "covers": {
  "nx_create_component": [],
  "nx_list_components": [],
  "nx_set_component_pose": ["absolute", "relative"],
  "nx_edit_component": [],
  "nx_create_reference_set": []
 },
 "fixture": "fixtures/parts_files_block_mm.prt",
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/cmp/asm_cmp_pin.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 5}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 20}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_open_part", "setup": true, "args": {"path": "$fixture"}},
  {"call": "nx_list_objects", "setup": true, "save": "body", "args": {"kind": "body"}},
  {"call": "nx_create_reference_set", "args": {"name": "SOLID", "objects": ["$body.data.items.0.id"]},
   "expect": {"mutation_outcome": "committed", "data.member_count": 1, "data.members.0.kind": "body"}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_upload_file", "setup": true,
   "args": {"path": "$run/cmp/other/assembly_components_parts_files_block_mm.prt", "data_base64": "eA==", "offset": 0, "total_size": 1,
            "sha256": "2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881"}},
  {"call": "nx_create_part", "setup": true, "save": "asm", "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "save": "A", "args": {"path": "$fixture", "name": "a"},
   "expect": {"mutation_outcome": "committed", "data.component.kind": "component", "data.component.name": "A",
              "data.component.path": "A", "data.component.translation": {"close": [0, 0, 0], "tol": 1e-9},
              "data.component.rotation": {"close": [[1, 0, 0], [0, 1, 0], [0, 0, 1]], "tol": 1e-9},
              "data.part_path": {"matches": "assembly_components_parts_files_block_mm\\.prt$"}}},
  {"call": "nx_create_component", "save": "B", "args": {"path": "$fixture", "name": "B", "pose": {"translation": [60, 0, 0], "rotation": [[0, -1, 0], [1, 0, 0], [0, 0, 1]]}},
   "expect": {"mutation_outcome": "committed", "data.component.translation": {"close": [60, 0, 0], "tol": 1e-6},
              "data.component.rotation": {"close": [[0, -1, 0], [1, 0, 0], [0, 0, 1]], "tol": 1e-9}}},
  {"call": "nx_create_component", "save": "P", "args": {"path": "$run/cmp/asm_cmp_pin.prt", "name": "P", "pose": {"translation": [20, 10, 30], "rotation": [[1, 0, 0], [0, 0, -1], [0, 1, 0]]}},
   "expect": {"mutation_outcome": "committed", "data.component.translation": {"close": [20, 10, 30], "tol": 1e-6},
              "data.part_path": {"matches": "asm_cmp_pin\\.prt$"}}},
  {"call": "nx_create_component", "args": {"path": "$run/cmp/missing.prt"},
   "expect": {"error.code": "NX_FILE_NOT_FOUND", "error.field": "/path", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component", "args": {"path": "$run/cmp/other/assembly_components_parts_files_block_mm.prt"},
   "expect": {"error.code": "NX_NAME_CONFLICT", "error.field": "/path", "mutation_outcome": "not_started"}},
  {"call": "nx_create_component", "args": {"path": "$fixture", "pose": {"translation": [0, 0, 0], "rotation": [[1, 0, 0], [0, 1, 0], [0, 0, -1]]}},
   "expect": {"error.category": "invalid_argument", "error.field": "/pose/rotation", "mutation_outcome": "not_started"}},
  {"call": "nx_list_components", "args": {"include_poses": true},
   "expect": {"page.total": 3, "data.items": {"count": 3}, "data.items.2.path": "A", "data.items.2.depth": 0,
              "data.items.2.load_state": "fully_loaded", "data.items.2.suppressed": false,
              "data.items.2.reference_set": "Entire Part",
              "data.items.2.part_path": {"matches": "assembly_components_parts_files_block_mm\\.prt$"},
              "data.items.1.translation": {"close": [60, 0, 0], "tol": 1e-6},
              "data.items.0.path": "P",
              "data.items.0.rotation": {"close": [[1, 0, 0], [0, 0, -1], [0, 1, 0]], "tol": 1e-9}}},
  {"call": "nx_list_components", "args": {"limit": 1, "offset": 1},
   "expect": {"page.total": 3, "page.returned": 1, "page.next_offset": 2, "data.items.0.name": "B"}},
  {"call": "nx_list_components", "args": {"name_contains": "p"},
   "expect": {"page.total": 1, "data.items.0.name": "P"}},
  {"call": "nx_set_component_pose", "args": {"component": "$B.data.component.id", "mode": "absolute", "translation": [30, 10, 0], "rotation": [[0, -1, 0], [1, 0, 0], [0, 0, 1]]},
   "expect": {"mutation_outcome": "committed", "data.component.translation": {"close": [30, 10, 0], "tol": 1e-6},
              "data.component.rotation": {"close": [[0, -1, 0], [1, 0, 0], [0, 0, 1]], "tol": 1e-9},
              "data.previous.translation": {"close": [60, 0, 0], "tol": 1e-6}}},
  {"call": "nx_set_component_pose", "args": {"component": "$B.data.component.id", "mode": "absolute", "translation": [30, 10, 0], "rotation": [[0, -1, 0], [1, 0, 0], [0, 0, 1]]},
   "expect": {"mutation_outcome": "committed", "data.component.translation": {"close": [30, 10, 0], "tol": 1e-6},
              "data.previous.translation": {"close": [30, 10, 0], "tol": 1e-6}}},
  {"call": "nx_set_component_pose", "args": {"component": "$B.data.component.id", "mode": "relative", "translation": [5, 0, 0], "rotation": [[0, -1, 0], [1, 0, 0], [0, 0, 1]]},
   "expect": {"mutation_outcome": "committed", "data.component.translation": {"close": [35, 10, 0], "tol": 1e-6},
              "data.component.rotation": {"close": [[-1, 0, 0], [0, -1, 0], [0, 0, 1]], "tol": 1e-9}}},
  {"call": "nx_set_component_pose", "args": {"component": "$B.data.component.id", "mode": "relative", "translation": [0, 0, 7]},
   "expect": {"data.component.translation": {"close": [35, 10, 7], "tol": 1e-6},
              "data.component.rotation": {"close": [[-1, 0, 0], [0, -1, 0], [0, 0, 1]], "tol": 1e-9}}},
  {"call": "nx_set_component_pose", "args": {"component": "$B.data.component.id", "mode": "absolute", "translation": [60, 0, 0]},
   "expect": {"data.component.translation": {"close": [60, 0, 0], "tol": 1e-6},
              "data.component.rotation": {"close": [[1, 0, 0], [0, 1, 0], [0, 0, 1]], "tol": 1e-9}}},
  {"call": "nx_set_component_pose", "args": {"component": "$B.data.component.id", "mode": "absolute", "translation": [0, 0, 0], "rotation": [[2, 0, 0], [0, 1, 0], [0, 0, 1]]},
   "expect": {"error.category": "invalid_argument", "error.field": "/rotation", "mutation_outcome": "not_started"}},
  {"call": "nx_set_component_pose", "args": {"component": "$asm.data.part.id", "mode": "absolute", "translation": [0, 0, 0]},
   "expect": {"error.category": "wrong_kind", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_component", "args": {"components": ["$B.data.component.id"], "name": "B2", "reference_set": "SOLID"},
   "expect": {"mutation_outcome": "committed", "data.components.0.name": "B2", "data.components.0.reference_set": "SOLID",
              "data.components.0.translation": {"close": [60, 0, 0], "tol": 1e-6}}},
  {"call": "nx_edit_component", "args": {"components": ["$B.data.component.id", "$P.data.component.id"], "suppressed": true},
   "expect": {"mutation_outcome": "committed", "data.components": {"count": 2}, "data.components.0.suppressed": true,
              "data.components.1.suppressed": true, "data.components.1.translation": {"close": [20, 10, 30], "tol": 1e-6}}},
  {"call": "nx_list_components", "args": {"suppressed": true},
   "expect": {"page.total": 2}},
  {"call": "nx_edit_component", "args": {"components": ["$B.data.component.id", "$P.data.component.id"], "suppressed": false},
   "expect": {"mutation_outcome": "committed", "data.components.0.suppressed": false, "data.components.1.suppressed": false}},
  {"call": "nx_edit_component", "args": {"components": ["$B.data.component.id"], "replace_with": "$run/cmp/asm_cmp_pin.prt"},
   "expect": {"mutation_outcome": "committed", "data.components.0.part_path": {"matches": "asm_cmp_pin\\.prt$"},
              "data.components.0.translation": {"close": [60, 0, 0], "tol": 1e-6}}},
  {"call": "nx_edit_component", "args": {"components": ["$B.data.component.id"], "reference_set": "SOLID"},
   "expect": {"error.code": "NX_NOT_FOUND", "error.field": "/reference_set", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_component", "args": {"components": ["$B.data.component.id"], "replace_with": "$fixture", "reference_set": "SOLID"},
   "expect": {"mutation_outcome": "committed", "data.components.0.reference_set": "SOLID",
              "data.components.0.part_path": {"matches": "assembly_components_parts_files_block_mm\\.prt$"}}},
  {"call": "nx_edit_component", "args": {"components": ["$A.data.component.id", "$B.data.component.id"], "name": "X"},
   "expect": {"error.field": "/name", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_component", "args": {"components": ["$A.data.component.id"]},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "mutation_outcome": "not_started"}},
  {"call": "nx_list_components", "args": {"include_poses": true},
   "expect": {"page.total": 3, "data.items.1.name": "B2", "data.items.1.reference_set": "SOLID",
              "data.items.1.translation": {"close": [60, 0, 0], "tol": 1e-6}, "data.items.0.suppressed": false}},
  {"call": "nx_create_reference_set", "args": {"name": "ASM_A", "objects": ["$A.data.component.id"]},
   "expect": {"mutation_outcome": "committed", "data.member_count": 1, "data.members": {"count": 1},
              "data.members.0.name": "A", "data.members.0.kind": "component", "data.reference_set.kind": "reference_set"}},
  {"call": "nx_create_reference_set", "args": {"name": "asm_a", "objects": ["$B.data.component.id"]},
   "expect": {"error.code": "NX_ALREADY_EXISTS", "error.field": "/name", "mutation_outcome": "not_started"}},
  {"call": "nx_create_reference_set", "args": {"name": "Empty", "objects": ["$B.data.component.id"]},
   "expect": {"error.category": "invalid_argument", "error.field": "/name", "mutation_outcome": "not_started"}},
  {"call": "nx_create_reference_set", "args": {"name": "TWICE", "objects": ["$B.data.component.id", "$B.data.component.id"]},
   "expect": {"error.category": "invalid_argument", "mutation_outcome": "not_started"}},
  {"call": "nx_create_reference_set", "args": {"name": "ASM_BP", "objects": ["$B.data.component.id", "$P.data.component.id"]},
   "expect": {"mutation_outcome": "committed", "data.member_count": 2}}
 ]
}
