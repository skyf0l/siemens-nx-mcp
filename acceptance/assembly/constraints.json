    },
    "data.moved.0.rotation.0.0": {
     "close": 0.7071068,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_edit_assembly_constraint",
   "args": {
    "constraint": "$fix.data.constraint.id",
    "value": 3
