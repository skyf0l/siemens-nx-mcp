{
  "covers": {"nx_create_sketch_dimensions": ["length", "horizontal", "vertical", "distance", "radius", "diameter", "angle",
                                            "parallel_distance", "perpendicular_distance"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [
       {"type": "line", "start": [0, 0], "end": [10, 0]},
       {"type": "circle", "center": [60, 0], "radius": 5},
       {"type": "circle", "center": [100, 0], "radius": 3},
       {"type": "line", "start": [0, 20], "end": [10, 25]},
       {"type": "line", "start": [0, 40], "end": [3, 48]},
       {"type": "line", "start": [0, 60], "end": [5, 60]},
       {"type": "line", "start": [20, 70], "end": [25, 70]},
       {"type": "line", "start": [0, 100], "end": [10, 100]},
       {"type": "line", "start": [0, 105], "end": [10, 115]},
       {"type": "line", "start": [0, 130], "end": [20, 130]},
       {"type": "line", "start": [0, 140], "end": [20, 140]},
       {"type": "line", "start": [0, 170], "end": [20, 170]},
       {"type": "circle", "center": [10, 180], "radius": 2}]}},
    {"call": "nx_create_sketch_dimensions", "save": "d",
     "args": {"sketch": "$sk.data.sketch.id", "dimensions": [
       {"kind": "length", "first": "$c.data.curves.0.curve.id", "value": 40, "origin": [20, -5]},
       {"kind": "radius", "first": "$c.data.curves.1.curve.id", "value": 8},
       {"kind": "diameter", "first": "$c.data.curves.2.curve.id", "value": 14},
       {"kind": "horizontal", "first": "$c.data.curves.3.curve.id", "value": 15},
       {"kind": "vertical", "first": "$c.data.curves.4.curve.id", "value": 12},
       {"kind": "distance", "first": {"curve": "$c.data.curves.5.curve.id", "point": "end"},
        "second": {"curve": "$c.data.curves.6.curve.id", "point": "start"}, "value": 20},
       {"kind": "angle", "first": "$c.data.curves.7.curve.id", "second": "$c.data.curves.8.curve.id", "value": 60},
       {"kind": "parallel_distance", "first": "$c.data.curves.9.curve.id", "second": "$c.data.curves.10.curve.id", "value": 15},
       {"kind": "perpendicular_distance", "first": "$c.data.curves.11.curve.id",
        "second": {"curve": "$c.data.curves.12.curve.id", "point": "center"}, "value": 12},
       {"kind": "horizontal", "first": {"curve": "$c.data.curves.5.curve.id", "point": "start"},
        "second": {"curve": "$c.data.curves.6.curve.id", "point": "end"}},
       {"kind": "vertical", "first": {"curve": "$c.data.curves.5.curve.id", "point": "mid"},
        "second": {"curve": "$c.data.curves.6.curve.id", "point": "mid"}, "reference": true}]},
     "expect": {"mutation_outcome": "committed", "data.dimensions": {"count": 11},
                "data.dimensions.0.value_before": {"close": 10, "tol": 1e-9}, "data.dimensions.0.measured": {"close": 40, "tol": 1e-6},
                "data.dimensions.0.expression.value": {"close": 40, "tol": 1e-9}, "data.dimensions.0.expression.units": "mm",
                "data.dimensions.0.expression.name": {"matches": "^p[0-9]+$"}, "data.dimensions.0.dimension.kind": "sketch_constraint",
                "data.dimensions.1.measured": {"close": 8, "tol": 1e-6}, "data.dimensions.2.measured": {"close": 14, "tol": 1e-6},
                "data.dimensions.3.measured": {"close": 15, "tol": 1e-6}, "data.dimensions.4.measured": {"close": 12, "tol": 1e-6},
                "data.dimensions.5.measured": {"close": 20, "tol": 1e-6}, "data.dimensions.6.measured": {"close": 60, "tol": 1e-6},
                "data.dimensions.6.expression.units": "deg",
                "data.dimensions.7.measured": {"close": 15, "tol": 1e-6}, "data.dimensions.8.measured": {"close": 12, "tol": 1e-6},
                "data.dimensions.9.kind": "horizontal", "data.dimensions.9.reference": false, "data.dimensions.10.reference": true,
                "data.status.state": "under_constrained"}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry"]},
     "expect": {"data.curves.0.length": {"close": 40, "tol": 1e-6}, "data.curves.1.radius": {"close": 8, "tol": 1e-6},
                "data.curves.2.radius": {"close": 7, "tol": 1e-6}}},
    {"call": "nx_set_expression", "setup": true,
     "args": {"name": "$d.data.dimensions.0.expression.name", "formula": "50"}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry"]},
     "expect": {"data.curves.0.length": {"close": 50, "tol": 1e-6}}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$sk.data.sketch.id", "dimensions": [{"kind": "length", "first": "$c.data.curves.0.curve.id", "value": 30}]},
     "expect": {"error.category": "solver_failed", "mutation_outcome": "rolled_back"}},
    {"call": "nx_list_objects", "setup": true, "save": "s2", "args": {"kind": "sketch"}},
    {"call": "nx_get_sketch", "setup": true, "save": "g", "args": {"sketch": "$s2.data.items.0.id", "include": ["geometry"]}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$s2.data.items.0.id", "dimensions": [{"kind": "angle", "first": "$g.data.curves.7.curve.id",
       "second": "$g.data.curves.8.curve.id", "value": 180}]},
     "expect": {"error.field": "/dimensions/0/value", "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$s2.data.items.0.id", "dimensions": [{"kind": "radius", "first": "$g.data.curves.0.curve.id", "value": 3}]},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/dimensions/0/first"}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$s2.data.items.0.id", "dimensions": [{"kind": "distance", "first": "$g.data.curves.0.curve.id"}]},
     "expect": {"error.category": "invalid_argument", "error.field": "/dimensions/0/first"}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$s2.data.items.0.id", "dimensions": [{"kind": "length", "first": "$g.data.curves.3.curve.id",
       "value": 3, "reference": true}]},
     "expect": {"error.field": "/dimensions/0/value"}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$s2.data.items.0.id", "dimensions": [{"kind": "parallel_distance", "first": "$g.data.curves.7.curve.id",
       "second": "$g.data.curves.8.curve.id", "value": 3}]},
     "expect": {"error.field": "/dimensions/0/second", "error.message": {"contains": "parallel"}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s2.data.items.0.id"}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/sketch_dimensions_inch.prt", "units": "in", "display": true}},
    {"call": "nx_create_sketch", "setup": true, "save": "ik", "args": {"part": "sketch_dimensions_inch", "placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "ic",
     "args": {"sketch": "$ik.data.sketch.id", "curves": [{"type": "line", "start": [0, 0], "end": [1, 0]}]}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$ik.data.sketch.id", "dimensions": [{"kind": "length", "first": "$ic.data.curves.0.curve.id", "value": 1.5}]},
     "expect": {"units.length": "in", "data.dimensions.0.measured": {"close": 1.5, "tol": 1e-9},
                "data.dimensions.0.expression.units": "in"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$ik.data.sketch.id"}}
  ]
}
