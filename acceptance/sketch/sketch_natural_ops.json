{
  "covers": {"nx_create_sketch_constraints": ["horizontal", "vertical", "fixed"],
             "nx_create_sketch_dimensions": ["length", "diameter", "perpendicular_distance"],
             "nx_create_sketch_copy": ["offset"], "nx_create_sketch_corner": ["fillet"],
             "nx_edit_sketch_curves": ["line", "arc", "trim", "extend"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [
       {"type": "line", "start": [0, 50], "end": [10, 50]},
       {"type": "line", "start": [0, 70], "end": [10, 70]},
       {"type": "line", "start": [0, 90], "end": [10, 93]},
       {"type": "line", "start": [60, 50], "end": [60, 60]},
       {"type": "circle", "center": [100, 50], "radius": 5},
       {"type": "line", "start": [0, 120], "end": [40, 120]},
       {"type": "line", "start": [10, 130], "end": [20, 135]},
       {"type": "rectangle", "corner1": [0, -60], "corner2": [40, -40]},
       {"type": "rectangle", "corner1": [100, -60], "corner2": [140, -40]},
       {"type": "line", "start": [200, 0], "end": [240, 0]},
       {"type": "line", "start": [250, 5], "end": [250, 20]},
       {"type": "line", "start": [200, 30], "end": [230, 30]},
       {"type": "line", "start": [250, 20], "end": [250, 40]},
       {"type": "circle", "center": [300, 0], "radius": 5},
       {"type": "line", "start": [300, 30], "end": [310, 30]}]}},
    {"call": "nx_create_sketch_constraints",
     "args": {"sketch": "$sk.data.sketch.id", "constraints": [
       {"type": "Horizontal", "curves": ["$c.data.curves.2.curve.id"]},
       {"type": "fixed", "points": [{"curve": "$c.data.curves.0.curve.id", "point": "start"}]},
       {"type": "Fix", "points": [{"curve": "$c.data.curves.1.curve.id", "point": "end"}]},
       {"type": "vertical", "curves": ["$c.data.curves.3.curve.id"]}]},
     "expect": {"mutation_outcome": "committed", "data.constraints": {"count": 4},
                "data.constraints.0.type": "horizontal", "data.constraints.0.residual": {"close": 0, "tol": 1e-6},
                "data.constraints.1.type": "fixed", "data.constraints.1.constraints": {"count": 1},
                "data.constraints.2.type": "fixed"}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$sk.data.sketch.id", "dimensions": [
       {"kind": "Length", "first": "$c.data.curves.0.curve.id", "value": "25 mm"},
       {"kind": "length", "first": "$c.data.curves.1.curve.id", "value": 25},
       {"kind": "Diameter", "first": "$c.data.curves.4.curve.id", "value": "16 mm"},
       {"kind": "distance", "first": {"curve": "$c.data.curves.6.curve.id", "point": "start"},
        "second": "$c.data.curves.5.curve.id", "value": 12}]},
     "expect": {"mutation_outcome": "committed", "data.dimensions": {"count": 4},
                "data.dimensions.0.kind": "length", "data.dimensions.0.measured": {"close": 25, "tol": 1e-6},
                "data.dimensions.1.measured": {"close": 25, "tol": 1e-6},
                "data.dimensions.2.kind": "diameter", "data.dimensions.2.measured": {"close": 16, "tol": 1e-6},
                "data.dimensions.3.kind": "perpendicular_distance", "data.dimensions.3.measured": {"close": 12, "tol": 1e-6}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry"]},
     "expect": {"data.curves.0.start": {"close": [0, 50], "tol": 1e-6}, "data.curves.0.length": {"close": 25, "tol": 1e-6},
                "data.curves.1.end": {"close": [10, 70], "tol": 1e-6}, "data.curves.1.length": {"close": 25, "tol": 1e-6},
                "data.curves.2.start.1": {"close": 93, "tol": 1e-6}, "data.curves.2.end.1": {"close": 93, "tol": 1e-6},
                "data.curves.4.radius": {"close": 8, "tol": 1e-9}}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "offset", "distance": "2 mm", "side": "inside", "curves": [
       "$c.data.curves.7.curve.id", "$c.data.curves.8.curve.id", "$c.data.curves.9.curve.id", "$c.data.curves.10.curve.id"]},
     "expect": {"mutation_outcome": "committed", "data.side": "inside", "data.curves": {"count": 4},
                "data.measured_distance": {"close": 2, "tol": 1e-6}}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "offset", "distance": 2, "side": "outside", "curves": [
       "$c.data.curves.7.curve.id", "$c.data.curves.8.curve.id", "$c.data.curves.9.curve.id", "$c.data.curves.10.curve.id"]},
     "expect": {"mutation_outcome": "committed", "data.side": "outside", "data.curves": {"count": 4},
                "data.measured_distance": {"close": 2, "tol": 1e-6}}},
    {"call": "nx_edit_sketch_curves",
     "args": {"sketch": "$sk.data.sketch.id", "edits": [
       {"type": "Line", "curve": "$c.data.curves.20.curve.id", "end": [320, 30]},
       {"type": "circle", "curve": "$c.data.curves.19.curve.id", "radius": 8},
       {"type": "extend", "curve": "$c.data.curves.17.curve.id", "boundaries": ["$c.data.curves.18.curve.id"]}]},
     "expect": {"mutation_outcome": "committed",
                "data.edits.0.curves.0.start": {"close": [300, 30], "tol": 1e-6},
                "data.edits.0.curves.0.end": {"close": [320, 30], "tol": 1e-6},
                "data.edits.1.curves.0.center": {"close": [300, 0], "tol": 1e-6},
                "data.edits.1.curves.0.radius": {"close": 8, "tol": 1e-9},
                "data.edits.2.curves.0.start": {"close": [200, 30], "tol": 1e-6},
                "data.edits.2.curves.0.end": {"close": [250, 30], "tol": 1e-6}}},
    {"call": "nx_create_sketch_constraints",
     "args": {"sketch": "$sk.data.sketch.id", "constraints": [{"type": "horizontal", "curves": ["$c.data.curves.3.curve.id"]}]},
     "expect": {"error.category": "solver_failed", "error.message": {"contains": "vertical"},
                "mutation_outcome": "rolled_back"}},
    {"call": "nx_list_objects", "setup": true, "save": "s2", "args": {"kind": "sketch", "name_contains": "SKETCH_000"}},
    {"call": "nx_get_sketch", "setup": true, "save": "g2", "args": {"sketch": "$s2.data.items.0.id", "include": ["geometry"]}},
    {"call": "nx_create_sketch_corner",
     "args": {"sketch": "$s2.data.items.0.id", "first": "$g2.data.curves.11.curve.id", "second": "$g2.data.curves.12.curve.id",
              "kind": "fillet", "radius": 100},
     "expect": {"error.category": "invalid_argument", "error.field": "/radius",
                "error.details.max_radius": {"close": 20, "tol": 1e-6},
                "mutation_outcome": {"matches": "^(not_started|rolled_back)$"}}},
    {"call": "nx_list_objects", "setup": true, "save": "s3", "args": {"kind": "sketch", "name_contains": "SKETCH_000"}},
    {"call": "nx_get_sketch", "setup": true, "save": "g3", "args": {"sketch": "$s3.data.items.0.id", "include": ["geometry"]}},
    {"call": "nx_edit_sketch_curves",
     "args": {"sketch": "$s3.data.items.0.id", "edits": [
       {"type": "trim", "curve": "$g3.data.curves.15.curve.id", "boundaries": ["$g3.data.curves.16.curve.id"], "pick": [205, 0]}]},
     "expect": {"error.category": "invalid_argument", "error.message": {"contains": "No boundary crosses"},
                "error.field": "/edits/0/boundaries", "mutation_outcome": "rolled_back"}},
    {"call": "nx_list_objects", "setup": true, "save": "s4", "args": {"kind": "sketch", "name_contains": "SKETCH_000"}},
    {"call": "nx_get_sketch", "args": {"sketch": "$s4.data.items.0.id", "include": ["geometry"]},
     "expect": {"data.curves.15.start": {"close": [200, 0], "tol": 1e-6}, "data.curves.15.length": {"close": 40, "tol": 1e-6},
                "data.curves.11.length": {"close": 40, "tol": 1e-6}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s4.data.items.0.id"}}
  ]
}
