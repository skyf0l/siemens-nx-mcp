{
  "covers": {"nx_create_sketch_projection": ["project", "intersect"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "base", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$base.data.sketch.id", "curves": [
       {"type": "rectangle", "corner1": [140, -10], "corner2": [160, 10]},
       {"type": "circle", "center": [250, 0], "radius": 5}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$base.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "ext",
     "args": {"sketch": "$base.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top_edge",
     "args": {"kind": "edge", "geometry_type": "line", "near": [150, -10, 10], "order": "nearest", "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "upright",
     "args": {"kind": "edge", "geometry_type": "line", "near": [140, -10, 5], "order": "nearest", "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "circle_edge",
     "args": {"kind": "edge", "geometry_type": "circle", "near": [255, 0, 10], "order": "nearest", "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "near": [150, 0, 10], "order": "nearest", "limit": 1}},
    {"call": "nx_create_sketch", "setup": true, "save": "up", "args": {"placement": {"principal": "xy", "origin": [0, 0, 20]}}},
    {"call": "nx_create_sketch_projection", "save": "p",
     "args": {"sketch": "$up.data.sketch.id", "objects": ["$top_edge.items.0.object.id", "$circle_edge.items.0.object.id"],
              "mode": "project"},
     "expect": {"mutation_outcome": "committed", "frame": "sketch_local", "data.feature.kind": "feature",
                "data.curves": {"count": 2}, "data.curves.0.type": "line",
                "data.curves.0.start.1": {"close": -10, "tol": 1e-6}, "data.curves.0.length": {"close": 20, "tol": 1e-6},
                "data.curves.1.type": "circle", "data.curves.1.center": {"close": [250, 0], "tol": 1e-6},
                "data.curves.1.radius": {"close": 5, "tol": 1e-6}}},
    {"call": "nx_create_sketch_projection",
     "args": {"sketch": "$up.data.sketch.id", "objects": ["$upright.items.0.object.id"], "mode": "project"},
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.nx_code": 674275, "mutation_outcome": "rolled_back"}},
    {"call": "nx_list_objects", "setup": true, "save": "upr", "args": {"kind": "sketch", "name_contains": "SKETCH_001"}},
    {"call": "nx_create_sketch_projection",
     "args": {"sketch": "$upr.data.items.0.id", "objects": ["$top.items.0.object.id"], "mode": "project"},
     "expect": {"error.code": "NX_WRONG_KIND"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$upr.data.items.0.id"}},
    {"call": "nx_find_geometry", "setup": true, "save": "top2",
     "args": {"kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "near": [150, 0, 10], "order": "nearest", "limit": 1}},
    {"call": "nx_create_sketch", "setup": true, "save": "side", "args": {"placement": {"principal": "xz"}}},
    {"call": "nx_create_sketch_projection", "save": "i",
     "args": {"sketch": "$side.data.sketch.id", "objects": ["$top2.items.0.object.id"], "mode": "intersect"},
     "expect": {"mutation_outcome": "committed", "data.feature.kind": "feature", "data.curves": {"count": 1},
                "data.curves.0.type": "line", "data.curves.0.start.1": {"close": 10, "tol": 1e-6},
                "data.curves.0.end.1": {"close": 10, "tol": 1e-6}, "data.curves.0.length": {"close": 20, "tol": 1e-6}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$side.data.sketch.id"}},
    {"call": "nx_edit_feature", "setup": true,
     "args": {"feature": "$ext.data.feature.id", "parameters": [{"name": "end", "value": 15}]}},
    {"call": "nx_list_objects", "setup": true, "save": "sides", "args": {"kind": "sketch", "name_contains": "SKETCH_002"}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sides.data.items.0.id", "include": ["geometry"]},
     "expect": {"data.curves.0.start.1": {"close": 15, "tol": 1e-6}, "data.curves.0.part.start.2": {"close": 15, "tol": 1e-6}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top3",
     "args": {"kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "near": [150, 0, 15], "order": "nearest", "limit": 1}},
    {"call": "nx_create_sketch", "setup": true, "save": "far", "args": {"placement": {"principal": "xz", "origin": [0, 50, 0]}}},
    {"call": "nx_create_sketch_projection",
     "args": {"sketch": "$far.data.sketch.id", "objects": ["$top3.items.0.object.id"], "mode": "intersect"},
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.nx_code": 3680011, "mutation_outcome": "rolled_back"}}
  ]
}
