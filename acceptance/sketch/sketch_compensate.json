{
  "covers": {"nx_create_sketch_constraints": [], "nx_create_sketch_dimensions": [], "nx_create_sketch_corner": ["fillet"],
             "nx_create_sketch_copy": ["offset"], "nx_create_sketch_curves": [], "nx_edit_sketch_curves": ["line"],
             "nx_create_sketch_projection": ["project"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_primitive", "setup": true, "args": {"origin": [0, 100, 0], "length": 20, "width": 10, "height": 5}},
    {"call": "nx_find_geometry", "setup": true, "save": "edge",
     "args": {"kind": "edge", "geometry_type": "line", "near": [10, 100, 5], "order": "nearest", "limit": 1}},
    {"call": "nx_list_objects", "setup": true, "save": "x0", "args": {"kind": "expression"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}, "curves": [
      {"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]},
      {"type": "line", "start": [60, 0], "end": [90, 4]},
      {"type": "line", "start": [60, 10], "end": [90, 10]}]}},
    {"call": "nx_create_sketch_constraints", "save": "hz",
     "args": {"sketch": "$sk.data.sketch.id", "constraints": [{"type": "horizontal", "curves": ["$sk.data.curves.4.id"]}]},
     "expect": {"data.constraints.0.residual": {"close": 0, "tol": 1e-9}}},
    {"call": "nx_undo_operation", "intent": "Acceptance: a constraint is undone by deleting it and setting the moved line back",
     "args": {"operation": "$hz.operation_id", "mode": "compensate"},
     "expect": {"data.compensated": true, "data.restored.0": {"contains": "1 curve(s) set back"}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry", "constraints", "status"]},
     "expect": {"data.curves.4.start": {"close": [60, 0], "tol": 1e-6}, "data.curves.4.end": {"close": [90, 4], "tol": 1e-6},
                "data.constraints": {"count": 4}, "data.status.dof": 16}},
    {"call": "nx_create_sketch_dimensions", "save": "dm",
     "args": {"sketch": "$sk.data.sketch.id", "dimensions": [{"kind": "length", "first": "$sk.data.curves.5.id", "value": 50}]},
     "expect": {"data.dimensions.0.measured": {"close": 50, "tol": 1e-6}}},
    {"call": "nx_undo_operation", "intent": "Acceptance: a dimension is undone with its expression",
     "args": {"operation": "$dm.operation_id", "mode": "compensate"},
     "expect": {"data.compensated": true, "data.restored.0": {"contains": "1 constraint(s) or dimension(s) deleted"}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry", "constraints"]},
     "expect": {"data.curves.5.length": {"close": 30, "tol": 1e-6}, "data.constraints": {"count": 4}}},
    {"call": "nx_create_sketch_corner", "save": "fl",
     "args": {"sketch": "$sk.data.sketch.id", "first": "$sk.data.curves.0.id", "second": "$sk.data.curves.1.id",
              "kind": "fillet", "radius": 5},
     "expect": {"data.corner.radius": {"close": 5, "tol": 1e-9}, "data.trimmed.0.end": {"close": [35, 0], "tol": 1e-6}}},
    {"call": "nx_undo_operation", "intent": "Acceptance: a fillet is undone, the corner and its coincident constraint come back",
     "args": {"operation": "$fl.operation_id", "mode": "compensate"},
     "expect": {"data.compensated": true, "data.restored.0": {"contains": "created again"}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry", "constraints", "status"]},
     "expect": {"data.curves": {"count": 6}, "data.constraints": {"count": 4},
                "data.curves.0.end": {"close": [40, 0], "tol": 1e-6}, "data.curves.1.start": {"close": [40, 0], "tol": 1e-6},
                "data.loops.0.closed": true, "data.status.dof": 16}},
    {"call": "nx_create_sketch_copy", "save": "of",
     "args": {"sketch": "$sk.data.sketch.id", "curves": ["$sk.data.curves.5.id"], "mode": "offset", "distance": 3},
     "expect": {"data.measured_distance": {"close": 3, "tol": 1e-6}}},
    {"call": "nx_undo_operation", "intent": "Acceptance: an offset curve is undone with its offset constraint and expression",
     "args": {"operation": "$of.operation_id", "mode": "compensate"},
     "expect": {"data.compensated": true, "data.restored.0": {"contains": "1 curve(s) deleted"}}},
    {"call": "nx_create_sketch_curves", "save": "add",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "circle", "center": [20, 50], "radius": 4}]},
     "expect": {"data.curves.0.radius": {"close": 4, "tol": 1e-9}}},
    {"call": "nx_edit_sketch_curves", "save": "mv",
     "args": {"sketch": "$sk.data.sketch.id", "edits": [{"type": "line", "curve": "$sk.data.curves.4.id", "end": [95, 8]}]},
     "expect": {"data.edits.0.curves.0.end": {"close": [95, 8], "tol": 1e-6}}},
    {"call": "nx_undo_operation", "intent": "Acceptance: a reshape and an added circle are undone in one undo",
     "args": {"steps": 2, "mode": "compensate"},
     "expect": {"data.compensated": true, "data.undone": {"count": 2}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry", "constraints"]},
     "expect": {"data.curves": {"count": 6}, "data.constraints": {"count": 4},
                "data.curves.4.end": {"close": [90, 4], "tol": 1e-6}}},
    {"call": "nx_list_objects", "args": {"kind": "expression"},
     "intent": "Acceptance: the expressions of the undone dimension and offset are gone",
     "expect": {"page.total": "$x0.page.total"}},
    {"call": "nx_create_sketch_projection", "save": "pj",
     "args": {"sketch": "$sk.data.sketch.id", "objects": ["$edge.data.items.0.id"], "mode": "project"},
     "expect": {"data.curves": {"count": 1}, "data.curves.0.length": {"close": 20, "tol": 1e-6}}},
    {"call": "nx_undo_operation", "intent": "Acceptance: a projection is undone with its projected curve",
     "args": {"operation": "$pj.operation_id", "mode": "compensate"},
     "expect": {"data.compensated": true, "data.restored.0": {"contains": "1 curve(s) deleted"}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry"]},
     "expect": {"data.curves": {"count": 6}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {}}
  ]
}
