{
 "covers": {"nx_create_sketch": ["principal"], "nx_finish_sketch": []},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "a", "args": {"path": "$run/pk/pk_a.prt", "units": "mm"}},
  {"call": "nx_create_part", "setup": true, "save": "b", "args": {"path": "$run/pk/pk_b.prt", "units": "mm", "display": false}},

  {"call": "nx_create_sketch", "save": "ska", "args": {"part": "pk_a", "placement": {"principal": "xy"}, "name": "PK_PROFILE"},
   "intent": "Acceptance: an unfinished sketch in A stays open but is parked: NX has no active sketch between calls",
   "expect": {"mutation_outcome": "committed", "part.file": "pk_a.prt", "data.active": true, "data.parked": true,
              "data.sketch.name": {"matches": "(?i)^pk_profile$"}}},
  {"call": "nx_list_objects", "args": {"part": "pk_a", "kind": "sketch"},
   "expect": {"data.items.0.details.active": true, "data.items.0.details.parked": true}},

  {"call": "nx_create_primitive", "save": "b1", "args": {"part": "pk_b", "shape": "block", "length": 10, "width": 10, "height": 10},
   "intent": "Acceptance: A's open sketch does not block a model call in B",
   "expect": {"mutation_outcome": "committed", "part.file": "pk_b.prt", "data.volume": {"close": 1000, "tol": 1e-06}}},
  {"call": "nx_create_sketch", "save": "skb", "args": {"part": "pk_b", "placement": {"principal": "xy"},
   "curves": [{"type": "rectangle", "corner1": [20, 0], "corner2": [30, 10]}], "finish": true},
   "intent": "Acceptance: B makes and finishes its own sketch while A's is open",
   "expect": {"mutation_outcome": "committed", "part.file": "pk_b.prt", "data.active": false, "data.curves": {"count": 4}}},
  {"call": "nx_create_extrude", "args": {"sketch": "$skb.data.sketch.id", "end": {"type": "distance", "value": 5}},
   "expect": {"mutation_outcome": "committed", "part.file": "pk_b.prt", "data.volume": {"close": 500, "tol": 1e-06}}},
  {"call": "nx_create_primitive", "args": {"part": "pk_a", "shape": "block", "length": 5, "width": 5, "height": 5, "origin": [100, 0, 0]},
   "intent": "Acceptance: A's own model tools still wait for A's sketch to be finished",
   "expect": {"ok": false, "error.code": "NX_SKETCH_ACTIVE", "error.hint": {"contains": "nx_finish_sketch"},
              "mutation_outcome": "not_started"}},

  {"call": "nx_create_sketch_curves", "args": {"sketch": "$ska.data.sketch.id",
   "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]},
   "intent": "Acceptance: curves added to A's parked sketch by its ref, after B's calls",
   "expect": {"mutation_outcome": "committed", "part.file": "pk_a.prt", "data.curves": {"count": 4},
              "data.curves.1.start": {"close": [40, 0], "tol": 1e-09}}},
  {"call": "nx_create_sketch_curves", "args": {"sketch": "$ska.data.sketch.id",
   "curves": [{"type": "circle", "center": [20, 10], "radius": 5}]},
   "expect": {"mutation_outcome": "committed", "data.curves": {"count": 1}, "data.loops": {"count": 2}}},
  {"call": "nx_get_sketch", "args": {"sketch": "$ska.data.sketch.id", "include": ["geometry"]},
   "expect": {"data.active": true, "data.parked": true, "data.curves": {"count": 5}, "part.file": "pk_a.prt"}},
  {"call": "nx_finish_sketch", "args": {"part": "pk_b"},
   "intent": "Acceptance: a finish in B never finishes A's sketch",
   "expect": {"mutation_outcome": "committed", "data.was_active": false, "part.file": "pk_b.prt"}},
  {"call": "nx_finish_sketch", "args": {"sketch": "$ska.data.sketch.id"},
   "intent": "Acceptance: A's parked sketch is finished by its ref",
   "expect": {"mutation_outcome": "committed", "data.was_active": true, "data.curve_count": 5, "part.file": "pk_a.prt"}},
  {"call": "nx_list_objects", "args": {"part": "pk_a", "kind": "sketch"},
   "expect": {"data.items.0.details.active": false}},
  {"call": "nx_create_extrude", "args": {"sketch": "$ska.data.sketch.id", "end": {"type": "distance", "value": 10}},
   "intent": "Acceptance: the finished profile (rectangle with a hole) extrudes in A: 40*20*10 - pi*5^2*10",
   "expect": {"mutation_outcome": "committed", "part.file": "pk_a.prt", "data.volume": {"close": 7214.6018, "tol": 0.001}}},
  {"call": "nx_check_model", "args": {"part": "pk_b"},
   "expect": {"ok": true}}
 ]
}
