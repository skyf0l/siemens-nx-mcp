{
  "covers": {"nx_create_sketch_curves": ["line", "arc", "circle", "ellipse", "rectangle", "polygon", "slot", "rounded_rectangle"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "hx", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "save": "hex",
     "args": {"sketch": "$hx.data.sketch.id", "curves": [{"type": "polygon", "center": [0, 0], "sides": 6, "radius": 20}]},
     "expect": {"mutation_outcome": "committed", "frame": "sketch_local", "data.curves": {"count": 6},
                "data.curves.0.start": {"close": [20, 0], "tol": 1e-9}, "data.curves.0.length": {"close": 20, "tol": 1e-9},
                "data.curves.5.end": {"close": [20, 0], "tol": 1e-9}, "changes.created": {"count_kind": {"curve": 6}}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$hx.data.sketch.id"}},
    {"call": "nx_create_extrude", "args": {"sketch": "$hx.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"data.volume": {"close": 10392.3048454, "tol": 1e-4}}},
    {"call": "nx_create_sketch", "setup": true, "save": "sq", "args": {"placement": {"principal": "xy", "origin": [150, 0, 0]}}},
    {"call": "nx_create_sketch_curves", "save": "sqc",
     "args": {"sketch": "$sq.data.sketch.id", "curves": [
       {"type": "polygon", "center": [0, 0], "sides": 4, "radius": 10, "inscribed": false, "rotation": 45},
       {"type": "line", "start": [-5, 0], "end": [5, 0]}], "construction": true},
     "expect": {"data.curves": {"count": 5}, "data.curves.0.start": {"close": [10, 10], "tol": 1e-9},
                "data.curves.0.construction": true, "data.curves.4.construction": true}},
    {"call": "nx_edit_sketch_curves", "setup": true,
     "args": {"sketch": "$sq.data.sketch.id", "edits": [{"type": "construction", "on": false, "curves": [
       "$sqc.data.curves.0.curve.id", "$sqc.data.curves.1.curve.id", "$sqc.data.curves.2.curve.id",
       "$sqc.data.curves.3.curve.id"]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sq.data.sketch.id"}},
    {"call": "nx_create_extrude", "args": {"sketch": "$sq.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"data.volume": {"close": 4000, "tol": 1e-6}}},
    {"call": "nx_create_sketch", "setup": true, "save": "sl", "args": {"placement": {"principal": "xy", "origin": [0, 100, 0]}}},
    {"call": "nx_create_sketch_curves", "save": "slot",
     "args": {"sketch": "$sl.data.sketch.id", "curves": [{"type": "slot", "center": [0, 0], "width": 30, "height": 10}]},
     "expect": {"data.curves": {"count": 4}, "data.curves.1.type": "arc", "data.curves.1.radius": {"close": 5, "tol": 1e-9},
                "data.curves.1.center": {"close": [10, 0], "tol": 1e-9}, "data.curves.0.start": {"close": [-10, -5], "tol": 1e-9}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sl.data.sketch.id"}},
    {"call": "nx_create_extrude", "args": {"sketch": "$sl.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"data.volume": {"close": 2785.3981634, "tol": 1e-4}}},
    {"call": "nx_create_sketch", "setup": true, "save": "rr", "args": {"placement": {"principal": "xy", "origin": [0, 200, 0]}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$rr.data.sketch.id", "curves": [
       {"type": "rounded_rectangle", "center": [0, 0], "width": 40, "height": 20, "radius": 4},
       {"type": "circle", "center": [0, 0], "radius": 4}]},
     "expect": {"data.curves": {"count": 9}, "data.curves.8.type": "circle", "data.curves.8.length": {"close": 25.1327412, "tol": 1e-6},
                "data.curves.1.type": "arc", "data.curves.1.start_angle": {"close": 270, "tol": 1e-9}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$rr.data.sketch.id"}},
    {"call": "nx_create_extrude", "args": {"sketch": "$rr.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"data.volume": {"close": 7360, "tol": 1e-4}}},
    {"call": "nx_create_sketch", "setup": true, "save": "el", "args": {"placement": {"principal": "xy", "origin": [300, 100, 0]}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$el.data.sketch.id", "curves": [
       {"type": "ellipse", "center": [0, 0], "major_radius": 20, "minor_radius": 10, "rotation": 30},
       {"type": "ellipse", "center": [100, 0], "major_radius": 20, "minor_radius": 10, "rotation": 90, "start_angle": -45, "end_angle": 45},
       {"type": "ellipse", "center": [200, 0], "major_radius": 50, "minor_radius": 1},
       {"type": "arc", "center": [300, 0], "radius": 4, "start_angle": 0, "end_angle": 90}]},
     "expect": {"data.curves.0.type": "ellipse", "data.curves.0.rotation": {"close": 30, "tol": 1e-6},
                "data.curves.0.length": {"close": 96.8844822, "tol": 1e-5},
                "data.curves.1.start": {"close": [108.94427191, 8.94427191], "tol": 1e-6},
                "data.curves.1.end": {"close": [91.05572809, 8.94427191], "tol": 1e-6},
                "data.curves.1.length": {"close": 30.385206, "tol": 1e-5},
                "data.curves.2.length": {"close": 200.191958, "tol": 1e-5},
                "data.curves.3.start": {"close": [304, 0], "tol": 1e-9}, "data.curves.3.end": {"close": [300, 4], "tol": 1e-9}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$el.data.sketch.id", "curves": [{"type": "line", "start": [1, 1], "end": [1, 1]}]},
     "expect": {"error.category": "invalid_argument", "error.field": "/curves/0/end", "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$el.data.sketch.id", "curves": [{"type": "slot", "center": [0, 0], "width": 5, "height": 10}]},
     "expect": {"error.field": "/curves/0/width", "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$el.data.sketch.id", "curves": [{"type": "ellipse", "center": [0, 0], "major_radius": 5, "minor_radius": 6}]},
     "expect": {"error.field": "/curves/0/minor_radius"}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$el.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 3, "start": [0, 0]}]},
     "expect": {"error.field": "/curves/0/start", "error.message": {"contains": "unknown field"}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$el.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [4, 0]}]},
     "expect": {"error.field": "/curves/0/corner2"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$el.data.sketch.id"}},
    {"call": "nx_create_sketch", "setup": true, "save": "rc", "args": {"placement": {"principal": "xz", "origin": [0, 0, 0]}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$rc.data.sketch.id", "curves": [
       {"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}, {"type": "circle", "center": [20, 10], "radius": 4}]},
     "expect": {"data.curves.1.start": {"close": [40, 0], "tol": 1e-9}, "data.curves.4.center": {"close": [20, 10], "tol": 1e-9}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$hx.data.sketch.id", "curves": [{"type": "line", "start": [0, 0], "end": [1, 0]}]},
     "expect": {"error.code": "NX_SKETCH_ACTIVE"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$rc.data.sketch.id"}},
    {"call": "nx_create_extrude", "args": {"sketch": "$rc.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"data.volume": {"close": 7497.3451332, "tol": 1e-4}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$hx.data.sketch.id", "curves": [{"type": "line", "start": [30, 30], "end": [40, 30]}]},
     "expect": {"mutation_outcome": "committed", "data.curves.0.end": {"close": [40, 30], "tol": 1e-9}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$hex.data.curves.0.curve.id", "curves": [{"type": "line", "start": [30, 30], "end": [40, 30]}]},
     "expect": {"error.code": "NX_WRONG_KIND", "mutation_outcome": "not_started"}},
    {"call": "nx_list_objects", "args": {"kind": "sketch", "name_contains": "SKETCH_000"},
     "expect": {"data.items.0.details.active": false}}
  ]
}
