{
  "covers": {"nx_create_sketch": ["principal", "on", "path"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "save": "sk", "args": {"placement": {"principal": "xy"}, "name": "PROFILE"},
     "expect": {"mutation_outcome": "committed", "data.active": true, "data.sketch.kind": "sketch",
                "data.sketch.name": {"matches": "(?i)^profile$"}, "data.feature.kind": "feature",
                "data.frame.origin": {"close": [0, 0, 0], "tol": 1e-9}, "data.frame.x_axis": {"close": [1, 0, 0], "tol": 1e-9},
                "data.frame.y_axis": {"close": [0, 1, 0], "tol": 1e-9}, "data.frame.normal": {"close": [0, 0, 1], "tol": 1e-9},
                "changes.created": {"count_kind": {"sketch": 1}}, "units.length": "mm"}},
    {"call": "nx_create_sketch", "args": {"placement": {"principal": "xz"}},
     "expect": {"error.code": "NX_SKETCH_ACTIVE", "error.hint": {"contains": "nx_finish_sketch"}, "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "ext",
     "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_sketch", "save": "xz", "args": {"placement": {"principal": "xz", "origin": [0, 5, 0], "x_axis": [0, 0, 1]}},
     "expect": {"data.frame.origin": {"close": [0, 5, 0], "tol": 1e-9}, "data.frame.x_axis": {"close": [0, 0, 1], "tol": 1e-9},
                "data.frame.y_axis": {"close": [-1, 0, 0], "tol": 1e-9}, "data.frame.normal": {"close": [0, -1, 0], "tol": 1e-9}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$xz.data.sketch.id"}},
    {"call": "nx_create_sketch", "save": "yz", "args": {"placement": {"principal": "yz"}},
     "expect": {"data.frame.x_axis": {"close": [0, 1, 0], "tol": 1e-9}, "data.frame.y_axis": {"close": [0, 0, 1], "tol": 1e-9},
                "data.frame.normal": {"close": [1, 0, 0], "tol": 1e-9}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$yz.data.sketch.id"}},
    {"call": "nx_create_sketch", "args": {"placement": {"principal": "xy", "x_axis": [0, 0, 1]}},
     "expect": {"error.category": "invalid_argument", "error.field": "/placement/x_axis", "mutation_outcome": "not_started"}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "Z", "limit": 1}},
    {"call": "nx_create_sketch", "save": "onf", "args": {"placement": {"on": "$top.items.0.object.id"}},
     "expect": {"mutation_outcome": "committed", "data.frame.origin": {"close": [0, 0, 10], "tol": 1e-9},
                "data.frame.normal": {"close": [0, 0, 1], "tol": 1e-9}, "data.frame.x_axis": {"close": [1, 0, 0], "tol": 1e-9}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$onf.data.sketch.id"}},
    {"call": "nx_create_sketch", "save": "onx", "args": {"placement": {"on": "$top.items.0.object.id", "x_direction": [0, 1, 0]}},
     "expect": {"data.frame.origin.2": {"close": 10, "tol": 1e-9}, "data.frame.x_axis": {"close": [0, 1, 0], "tol": 1e-9},
                "data.frame.y_axis": {"close": [-1, 0, 0], "tol": 1e-9}, "data.frame.normal": {"close": [0, 0, 1], "tol": 1e-9}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$onx.data.sketch.id"}},
    {"call": "nx_create_sketch", "args": {"placement": {"on": "$top.items.0.object.id", "x_direction": [0, 0, 1]}},
     "expect": {"error.category": "invalid_argument", "error.field": "/placement/x_direction", "changes.references": "preserved"}},
    {"call": "nx_create_sketch", "args": {"placement": {"on": "$ext.data.feature.id"}},
     "expect": {"error.code": "NX_WRONG_KIND", "mutation_outcome": "not_started"}},
    {"call": "nx_create_datum_plane", "setup": true, "save": "dp",
     "args": {"method": "offset", "reference": "$top.items.0.object.id", "distance": 15}},
    {"call": "nx_create_sketch", "save": "od", "args": {"placement": {"on": "$dp.data.datum_plane.id"}, "name": "ON_DATUM"},
     "expect": {"data.frame.origin": {"close": [0, 0, 25], "tol": 1e-9}, "data.frame.normal": {"close": [0, 0, 1], "tol": 1e-9}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$od.data.sketch.id"}},
    {"call": "nx_find_geometry", "setup": true, "save": "edge",
     "args": {"kind": "edge", "geometry_type": "line", "near": [20, 0, 0], "order": "nearest", "limit": 1}},
    {"call": "nx_create_sketch", "save": "p1",
     "args": {"placement": {"path": ["$edge.items.0.object.id"], "help_point": [0, 0, 0], "percent": 50}},
     "expect": {"data.frame.origin": {"close": [20, 0, 0], "tol": 1e-9}, "data.frame.normal": {"close": [1, 0, 0], "tol": 1e-9},
                "data.frame.x_axis": {"close": [0, 1, 0], "tol": 1e-9}, "data.frame.y_axis": {"close": [0, 0, 1], "tol": 1e-9}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$p1.data.sketch.id"}},
    {"call": "nx_create_sketch", "save": "p2",
     "args": {"placement": {"path": ["$edge.items.0.object.id"], "help_point": [0, 0, 0], "percent": 0, "reverse_normal": true}},
     "expect": {"data.frame.origin": {"close": [0, 0, 0], "tol": 1e-9}, "data.frame.normal": {"close": [-1, 0, 0], "tol": 1e-9},
                "data.frame.y_axis": {"close": [0, 0, -1], "tol": 1e-9}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$p2.data.sketch.id"}},
    {"call": "nx_create_sketch", "save": "p3",
     "args": {"placement": {"path": ["$edge.items.0.object.id"], "help_point": [0, 0, 0], "percent": 100,
                            "reverse_axis": true, "orienting_face": "$top.items.0.object.id"}, "name": "PATH_END"},
     "expect": {"data.frame.origin": {"close": [40, 0, 0], "tol": 1e-9}, "data.frame.normal": {"close": [1, 0, 0], "tol": 1e-9},
                "data.sketch.name": {"matches": "(?i)^path_end$"}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$p3.data.sketch.id"}},
    {"call": "nx_create_sketch",
     "args": {"placement": {"path": ["$edge.items.0.object.id"], "help_point": [0, 0, 0], "percent": 150}},
     "expect": {"error.category": "invalid_argument", "error.field": "/placement", "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch",
     "args": {"placement": {"path": ["$top.items.0.object.id"], "help_point": [0, 0, 0]}},
     "expect": {"error.code": "NX_WRONG_KIND"}},
    {"call": "nx_list_objects", "args": {"kind": "sketch"},
     "expect": {"page.total": 9}}
  ]
}
