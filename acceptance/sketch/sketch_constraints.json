{
  "covers": {"nx_create_sketch_constraints": ["fixed", "horizontal", "vertical", "parallel", "perpendicular", "equal_length",
                                             "equal_radius", "concentric", "tangent", "coincident", "midpoint",
                                             "point_on_curve", "symmetric"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [
       {"type": "line", "start": [0, 5], "end": [10, 7]},
       {"type": "line", "start": [0, 0], "end": [10, 0]},
       {"type": "line", "start": [20, 0], "end": [30, 4]},
       {"type": "line", "start": [0, 20], "end": [6, 20]},
       {"type": "circle", "center": [60, 0], "radius": 3},
       {"type": "circle", "center": [80, 0], "radius": 2},
       {"type": "circle", "center": [90, 5], "radius": 1},
       {"type": "line", "start": [0, 30], "end": [10, 32]},
       {"type": "line", "start": [40, 30], "end": [42, 40]},
       {"type": "line", "start": [0, 50], "end": [10, 50]},
       {"type": "line", "start": [12, 52], "end": [20, 60]},
       {"type": "line", "start": [0, -30], "end": [40, -30]},
       {"type": "circle", "center": [20, -27], "radius": 2},
       {"type": "line", "start": [100, 0], "end": [140, 0]},
       {"type": "circle", "center": [105, 7], "radius": 2},
       {"type": "line", "start": [100, -20], "end": [140, -20]},
       {"type": "line", "start": [110, -15], "end": [115, -12]},
       {"type": "line", "start": [-5, -50], "end": [-5, -40]},
       {"type": "line", "start": [4, -49], "end": [4, -41]},
       {"type": "line", "start": [0, -55], "end": [0, -35]},
       {"type": "line", "start": [200, 0], "end": [210, 0]},
       {"type": "line", "start": [200, 10], "end": [210, 10]},
       {"type": "line", "start": [50, 30], "end": [60, 32]}]}},
    {"call": "nx_create_sketch_constraints", "save": "k",
     "args": {"sketch": "$sk.data.sketch.id", "constraints": [
       {"type": "parallel", "curves": ["$c.data.curves.1.curve.id", "$c.data.curves.0.curve.id"]},
       {"type": "perpendicular", "curves": ["$c.data.curves.1.curve.id", "$c.data.curves.2.curve.id"]},
       {"type": "equal_length", "curves": ["$c.data.curves.1.curve.id", "$c.data.curves.3.curve.id"]},
       {"type": "equal_radius", "curves": ["$c.data.curves.4.curve.id", "$c.data.curves.5.curve.id"]},
       {"type": "concentric", "curves": ["$c.data.curves.4.curve.id", "$c.data.curves.6.curve.id"]},
       {"type": "horizontal", "curves": ["$c.data.curves.7.curve.id"]},
       {"type": "vertical", "curves": ["$c.data.curves.8.curve.id"]},
       {"type": "coincident", "points": [{"curve": "$c.data.curves.9.curve.id", "point": "end"},
                                         {"curve": "$c.data.curves.10.curve.id", "point": "start"}]},
       {"type": "tangent", "curves": ["$c.data.curves.11.curve.id", "$c.data.curves.12.curve.id"]},
       {"type": "midpoint", "points": [{"curve": "$c.data.curves.14.curve.id", "point": "center"}],
        "curves": ["$c.data.curves.13.curve.id"]},
       {"type": "point_on_curve", "points": [{"curve": "$c.data.curves.16.curve.id", "point": "start"}],
        "curves": ["$c.data.curves.15.curve.id"]},
       {"type": "symmetric", "curves": ["$c.data.curves.17.curve.id", "$c.data.curves.18.curve.id"],
        "centerline": "$c.data.curves.19.curve.id"},
       {"type": "fixed", "curves": ["$c.data.curves.20.curve.id"]},
       {"type": "fixed", "points": [{"curve": "$c.data.curves.21.curve.id", "point": "start"}]}]},
     "expect": {"mutation_outcome": "committed", "data.constraints": {"count": 14},
                "data.constraints.0.residual": {"close": 0, "tol": 1e-9}, "data.constraints.1.residual": {"close": 0, "tol": 1e-9},
                "data.constraints.2.residual": {"close": 0, "tol": 1e-6}, "data.constraints.3.residual": {"close": 0, "tol": 1e-6},
                "data.constraints.4.residual": {"close": 0, "tol": 1e-6}, "data.constraints.5.residual": {"close": 0, "tol": 1e-6},
                "data.constraints.6.residual": {"close": 0, "tol": 1e-6}, "data.constraints.7.residual": {"close": 0, "tol": 1e-6},
                "data.constraints.8.residual": {"close": 0, "tol": 1e-6}, "data.constraints.9.residual": {"close": 0, "tol": 1e-6},
                "data.constraints.10.residual": {"close": 0, "tol": 1e-6}, "data.constraints.11.residual": {"close": 0, "tol": 1e-6},
                "data.constraints.5.drag_status": "Updated", "data.constraints.9.drag_status": "Updated",
                "data.constraints.12.constraints": {"count": 2}, "data.constraints.13.constraints": {"count": 1},
                "data.constraints.0.constraints.0.kind": "sketch_constraint", "data.status.state": "under_constrained"}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry"]},
     "expect": {"data.curves.5.radius": {"close": 3, "tol": 1e-9}, "data.curves.6.center": {"close": [60, 0], "tol": 1e-6},
                "data.curves.10.start": {"close": [10, 50], "tol": 1e-6}, "data.curves.12.radius": {"close": 2, "tol": 1e-9}, "data.curves.14.radius": {"close": 2, "tol": 1e-9},
                "data.curves.22.start": {"close": [50, 30], "tol": 1e-9}, "data.curves.22.end": {"close": [60, 32], "tol": 1e-9},
                "data.curves.14.center": {"close": [120, 0], "tol": 1e-6}, "data.curves.16.start.1": {"close": -20, "tol": 1e-6},
                "data.curves.18.start": {"close": [5, -50], "tol": 1e-6}, "data.curves.18.end": {"close": [5, -40], "tol": 1e-6},
                "data.curves.3.length": {"close": 10, "tol": 1e-6}}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$sk.data.sketch.id", "dimensions": [{"kind": "length", "first": "$c.data.curves.20.curve.id", "value": 20}]},
     "expect": {"error.category": "solver_failed", "mutation_outcome": "rolled_back"}},
    {"call": "nx_list_objects", "setup": true, "save": "sk2", "args": {"kind": "sketch"}},
    {"call": "nx_get_sketch", "save": "g", "args": {"sketch": "$sk2.data.items.0.id", "include": ["geometry"]},
     "expect": {"data.curves.20.start": {"close": [200, 0], "tol": 1e-9}, "data.curves.20.end": {"close": [210, 0], "tol": 1e-9}}},
    {"call": "nx_create_sketch_constraints",
     "args": {"sketch": "$sk2.data.items.0.id", "constraints": [{"type": "vertical", "curves": ["$g.data.curves.7.curve.id"]}]},
     "expect": {"error.category": "solver_failed", "mutation_outcome": "rolled_back"}},
    {"call": "nx_list_objects", "setup": true, "save": "sk3", "args": {"kind": "sketch"}},
    {"call": "nx_get_sketch", "setup": true, "save": "g3", "args": {"sketch": "$sk3.data.items.0.id", "include": ["geometry"]}},
    {"call": "nx_create_sketch_constraints",
     "args": {"sketch": "$sk3.data.items.0.id", "constraints": [{"type": "parallel", "curves": ["$g3.data.curves.0.curve.id"]}]},
     "expect": {"error.field": "/constraints/0/curves", "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch_constraints",
     "args": {"sketch": "$sk3.data.items.0.id", "constraints": [{"type": "horizontal", "curves": ["$g3.data.curves.4.curve.id"]}]},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/constraints/0/curves/0"}},
    {"call": "nx_create_sketch_constraints",
     "args": {"sketch": "$sk3.data.items.0.id", "constraints": [{"type": "coincident", "points": [
       {"curve": "$g3.data.curves.4.curve.id", "point": "start"}, {"curve": "$g3.data.curves.0.curve.id", "point": "end"}]}]},
     "expect": {"error.field": "/constraints/0/points/0/point"}},
    {"call": "nx_create_sketch_constraints",
     "args": {"sketch": "$sk3.data.items.0.id", "constraints": [{"type": "fixed", "curves": ["$g3.data.curves.0.curve.id"],
       "points": [{"curve": "$g3.data.curves.0.curve.id", "point": "end"}]}]},
     "expect": {"error.field": "/constraints/0/curves"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk3.data.items.0.id"}}
  ]
}
