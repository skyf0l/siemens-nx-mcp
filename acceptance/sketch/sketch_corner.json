{
  "covers": {"nx_create_sketch_corner": ["fillet", "chamfer"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "r",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [50, 0], "corner2": [90, 30]}]}},
    {"call": "nx_create_sketch_corner", "save": "f",
     "args": {"sketch": "$sk.data.sketch.id", "first": "$r.data.curves.0.curve.id", "second": "$r.data.curves.1.curve.id",
              "kind": "fillet", "radius": 5},
     "expect": {"mutation_outcome": "committed", "data.corner.type": "arc", "data.corner.radius": {"close": 5, "tol": 1e-9},
                "data.corner.center": {"close": [85, 5], "tol": 1e-9}, "data.trimmed": {"count": 2},
                "data.trimmed.0.end": {"close": [85, 0], "tol": 1e-9}, "data.trimmed.1.start": {"close": [90, 5], "tol": 1e-9}}},
    {"call": "nx_create_sketch_corner", "save": "ch",
     "args": {"sketch": "$sk.data.sketch.id", "first": "$r.data.curves.2.curve.id", "second": "$r.data.curves.1.curve.id",
              "kind": "chamfer", "distance": 4, "distance2": 6},
     "expect": {"data.corner.type": "line", "data.distances": {"close": [4, 6], "tol": 1e-6},
                "data.corner.start": {"close": [90, 24], "tol": 1e-6}, "data.corner.end": {"close": [86, 30], "tol": 1e-6}}},
    {"call": "nx_create_sketch_corner",
     "args": {"sketch": "$sk.data.sketch.id", "first": "$r.data.curves.3.curve.id", "second": "$r.data.curves.0.curve.id",
              "kind": "chamfer", "distance": 3},
     "expect": {"data.distances": {"close": [3, 3], "tol": 1e-6}, "data.corner.length": {"close": 4.2426407, "tol": 1e-6}}},
    {"call": "nx_create_sketch_corner",
     "args": {"sketch": "$sk.data.sketch.id", "first": "$r.data.curves.3.curve.id", "second": "$r.data.curves.0.curve.id",
              "kind": "fillet", "distance": 3},
     "expect": {"error.field": "/radius", "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch_corner",
     "args": {"sketch": "$sk.data.sketch.id", "first": "$r.data.curves.3.curve.id", "second": "$r.data.curves.3.curve.id",
              "kind": "fillet", "radius": 1},
     "expect": {"error.field": "/second", "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch_corner",
     "args": {"sketch": "$sk.data.sketch.id", "first": "$r.data.curves.2.curve.id", "second": "$r.data.curves.3.curve.id",
              "kind": "fillet", "radius": 100},
     "expect": {"error.category": "invalid_argument", "error.field": "/radius",
                "error.details.max_radius": {"close": 27, "tol": 1e-6},
                "mutation_outcome": {"matches": "^(not_started|rolled_back)$"}}},
    {"call": "nx_list_objects", "setup": true, "save": "again", "args": {"kind": "sketch", "name_contains": "SKETCH_000"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$again.data.items.0.id"}},
    {"call": "nx_create_extrude", "args": {"sketch": "$again.data.items.0.id", "end": {"type": "distance", "value": 10}},
     "expect": {"data.volume": {"close": 11781.3495409, "tol": 1e-4}}},
    {"call": "nx_create_sketch", "setup": true, "save": "la", "args": {"placement": {"principal": "xy", "origin": [0, 100, 0]}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c",
     "args": {"sketch": "$la.data.sketch.id", "curves": [
       {"type": "line", "start": [0, 0], "end": [30, 0]},
       {"type": "arc", "center": [40, 0], "radius": 10, "start_angle": 90, "end_angle": 180},
       {"type": "line", "start": [100, 0], "end": [110, 0]},
       {"type": "arc", "center": [130, 30], "radius": 10, "start_angle": 0, "end_angle": 90}]}},
    {"call": "nx_create_sketch_corner",
     "args": {"sketch": "$la.data.sketch.id", "first": "$c.data.curves.0.curve.id", "second": "$c.data.curves.1.curve.id",
              "kind": "fillet", "radius": 2},
     "expect": {"data.corner.center": {"close": [28.1678404, 2], "tol": 1e-6}, "data.corner.radius": {"close": 2, "tol": 1e-9}}},
    {"call": "nx_create_sketch_corner",
     "args": {"sketch": "$la.data.sketch.id", "first": "$c.data.curves.2.curve.id", "second": "$c.data.curves.3.curve.id",
              "kind": "chamfer", "distance": 2},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch_corner",
     "args": {"sketch": "$la.data.sketch.id", "first": "$c.data.curves.2.curve.id", "second": "$c.data.curves.3.curve.id",
              "kind": "fillet", "radius": 2},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/second", "mutation_outcome": "not_started",
                "error.details.gap": {"close": 42.4264069, "tol": 1e-6}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$la.data.sketch.id"}}
  ]
}
