{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "front", "args": {"path": "$run/mds/mds_front.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "args": {"shape": "block", "length": 40, "width": 20, "height": 10}},
  {"call": "nx_create_part", "setup": true, "save": "back", "args": {"path": "$run/mds/mds_back.prt", "units": "mm", "display": false}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"part": "mds_back", "placement": {"principal": "xy"}, "name": "BG_PICKS"}},
  {"call": "nx_create_sketch_curves", "setup": true, "save": "c", "args": {"sketch": "$sk.data.sketch.id", "curves": [
    {"type": "line", "start": [0, 0], "end": [10, 0]},
    {"type": "line", "start": [12, 2], "end": [20, 8]},
    {"type": "circle", "center": [40, 0], "radius": 5},
    {"type": "circle", "center": [43, 2], "radius": 2},
    {"type": "line", "start": [60, -5], "end": [60, 5]},
    {"type": "line", "start": [55, 0], "end": [65, 0]},
    {"type": "line", "start": [55, 3], "end": [58, 3]}]}},
  {"call": "nx_list_parts", "args": {},
   "intent": "Acceptance: the sketch in the background part left the engineer's display and work part alone",
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},

  {"call": "nx_create_sketch_constraints", "args": {"sketch": "$sk.data.sketch.id", "constraints": [
    {"type": "coincident", "points": [{"curve": "$c.data.curves.0.curve.id", "point": "end"}, {"curve": "$c.data.curves.1.curve.id", "point": "start"}]},
    {"type": "concentric", "curves": ["$c.data.curves.2.curve.id", "$c.data.curves.3.curve.id"]}]},
   "intent": "Acceptance: coincident and concentric (point picks) in a sketch of the background part",
   "expect": {"mutation_outcome": "committed", "part.file": "mds_back.prt", "data.constraints": {"count": 2}}},
  {"call": "nx_list_parts", "args": {},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry"]},
   "intent": "Acceptance: the second line starts at the first one's end; the small circle is centred on the big one",
   "expect": {"part.file": "mds_back.prt", "data.curves": {"count": 7},
              "data.curves.0.end": {"close": [10, 0], "tol": 1e-06},
              "data.curves.1.start": {"close": [10, 0], "tol": 1e-06}, "data.curves.1.end": {"close": [20, 8], "tol": 1e-06},
              "data.curves.2.center": {"close": [40, 0], "tol": 1e-06}, "data.curves.2.radius": {"close": 5, "tol": 1e-09},
              "data.curves.3.center": {"close": [40, 0], "tol": 1e-06}, "data.curves.3.radius": {"close": 2, "tol": 1e-09}}},

  {"call": "nx_edit_sketch_curves", "args": {"sketch": "$sk.data.sketch.id", "edits": [
    {"type": "trim", "curve": "$c.data.curves.5.curve.id", "boundaries": ["$c.data.curves.4.curve.id"], "pick": [62, 0]},
    {"type": "extend", "curve": "$c.data.curves.6.curve.id", "boundaries": ["$c.data.curves.4.curve.id"], "pick": [57, 3]}]},
   "intent": "Acceptance: trim and extend (picks) in a sketch of the background part",
   "expect": {"mutation_outcome": "committed", "part.file": "mds_back.prt",
              "data.edits.0.curves.0.start": {"close": [55, 0], "tol": 1e-06}, "data.edits.0.curves.0.end": {"close": [60, 0], "tol": 1e-06},
              "data.edits.1.curves.0.start": {"close": [55, 3], "tol": 1e-06}, "data.edits.1.curves.0.end": {"close": [60, 3], "tol": 1e-06}}},
  {"call": "nx_list_parts", "args": {},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry"]},
   "intent": "Acceptance: the trimmed line ends at the boundary x = 60, the extended one reaches it",
   "expect": {"data.curves": {"count": 7},
              "data.curves.5.start": {"close": [55, 0], "tol": 1e-06}, "data.curves.5.end": {"close": [60, 0], "tol": 1e-06},
              "data.curves.6.start": {"close": [55, 3], "tol": 1e-06}, "data.curves.6.end": {"close": [60, 3], "tol": 1e-06}}},
  {"call": "nx_finish_sketch", "args": {"sketch": "$sk.data.sketch.id"},
   "expect": {"mutation_outcome": "committed", "part.file": "mds_back.prt", "data.curve_count": 7}},
  {"call": "nx_create_sketch", "setup": true, "save": "xz", "args": {"part": "mds_back", "placement": {"principal": "xz"}, "name": "BG_XZ"}},
  {"call": "nx_create_sketch_curves", "setup": true, "save": "cx", "args": {"sketch": "$xz.data.sketch.id", "curves": [
    {"type": "line", "start": [60, -5], "end": [60, 5]},
    {"type": "line", "start": [55, 0], "end": [65, 0]},
    {"type": "line", "start": [55, 3], "end": [58, 3]}]}},
  {"call": "nx_edit_sketch_curves", "args": {"sketch": "$xz.data.sketch.id", "edits": [
    {"type": "trim", "curve": "$cx.data.curves.1.curve.id", "boundaries": ["$cx.data.curves.0.curve.id"], "pick": [62, 0]},
    {"type": "extend", "curve": "$cx.data.curves.2.curve.id", "boundaries": ["$cx.data.curves.0.curve.id"], "pick": [57, 3]}]},
   "intent": "Acceptance: trim and extend in an xz sketch of the background part (picked in a view that sees the sketch edge-on)",
   "expect": {"mutation_outcome": "committed", "part.file": "mds_back.prt",
              "data.edits.0.curves.0.start": {"close": [55, 0], "tol": 1e-06}, "data.edits.0.curves.0.end": {"close": [60, 0], "tol": 1e-06},
              "data.edits.1.curves.0.start": {"close": [55, 3], "tol": 1e-06}, "data.edits.1.curves.0.end": {"close": [60, 3], "tol": 1e-06}}},
  {"call": "nx_finish_sketch", "args": {"sketch": "$xz.data.sketch.id"},
   "expect": {"mutation_outcome": "committed", "data.curve_count": 3}},
  {"call": "nx_list_parts", "args": {},
   "intent": "Acceptance: the engineer's display and work part are back",
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}}
 ]
}
