{
  "covers": {"nx_create_sketch_copy": ["offset", "mirror"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_datum_axis", "setup": true, "save": "ax",
     "args": {"method": "point_direction", "origin": [0, 0, 50], "direction": [0, 1, 0]}},
    {"call": "nx_create_datum_axis", "setup": true, "save": "zax",
     "args": {"method": "point_direction", "origin": [0, 0, 0], "direction": [0, 0, 1]}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [
       {"type": "polygon", "center": [0, 0], "sides": 6, "radius": 10},
       {"type": "arc", "center": [50, 0], "radius": 10, "start_angle": 0, "end_angle": 90},
       {"type": "line", "start": [0, -60], "end": [30, -60]},
       {"type": "ellipse", "center": [100, 0], "major_radius": 20, "minor_radius": 10},
       {"type": "line", "start": [60, -20], "end": [60, 20]},
       {"type": "line", "start": [70, 30], "end": [90, 35]}]}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "offset", "distance": 2, "curves": [
       "$c.data.curves.0.curve.id", "$c.data.curves.1.curve.id", "$c.data.curves.2.curve.id",
       "$c.data.curves.3.curve.id", "$c.data.curves.4.curve.id", "$c.data.curves.5.curve.id"]},
     "expect": {"mutation_outcome": "committed", "data.side": "right", "data.measured_distance": {"close": 2, "tol": 1e-6},
                "data.curves": {"count": 6}, "frame": "sketch_local"}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "offset", "distance": 2, "side": "left", "curves": [
       "$c.data.curves.0.curve.id", "$c.data.curves.1.curve.id", "$c.data.curves.2.curve.id",
       "$c.data.curves.3.curve.id", "$c.data.curves.4.curve.id", "$c.data.curves.5.curve.id"]},
     "expect": {"data.side": "left", "data.measured_distance": {"close": 2, "tol": 1e-6}}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "offset", "distance": 3, "side": "left", "curves": ["$c.data.curves.6.curve.id"]},
     "expect": {"data.curves.0.type": "arc", "data.curves.0.radius": {"close": 7, "tol": 1e-6},
                "data.curves.0.center": {"close": [50, 0], "tol": 1e-6}}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "offset", "distance": "3 mm", "side": "left", "curves": ["$c.data.curves.7.curve.id"]},
     "expect": {"data.curves.0.start": {"close": [0, -57], "tol": 1e-6}, "data.curves.0.end": {"close": [30, -57], "tol": 1e-6}}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "offset", "distance": 3, "side": "right", "curves": ["$c.data.curves.7.curve.id"]},
     "expect": {"data.curves.0.start.1": {"close": -63, "tol": 1e-6}, "data.side": "right"}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "offset", "distance": 2, "curves": ["$c.data.curves.8.curve.id"]},
     "expect": {"data.measured_distance": {"close": 2, "tol": 0.001}, "warnings.0.code": "NX_APPROXIMATED"}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "mirror", "mirror_line": "$c.data.curves.9.curve.id",
              "curves": ["$c.data.curves.10.curve.id", "$c.data.curves.6.curve.id"]},
     "expect": {"data.curves": {"count": 2}, "data.mirror_line.start": {"close": [60, -20], "tol": 1e-9},
                "data.curves.0.type": "arc", "data.curves.0.center": {"close": [70, 0], "tol": 1e-6}, "data.curves.0.start": {"close": [60, 0], "tol": 1e-6}, "data.curves.1.start": {"close": [50, 30], "tol": 1e-6}, "data.curves.1.end": {"close": [30, 35], "tol": 1e-6}}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "mirror", "mirror_line": "$ax.data.datum_axis.id",
              "curves": ["$c.data.curves.7.curve.id"]},
     "expect": {"data.curves.0.start": {"close": [0, -60], "tol": 1e-6}, "data.curves.0.end": {"close": [-30, -60], "tol": 1e-6}}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "mirror", "mirror_line": "$zax.data.datum_axis.id",
              "curves": ["$c.data.curves.7.curve.id"]},
     "expect": {"error.category": "invalid_argument", "error.field": "/mirror_line"}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "offset", "curves": ["$c.data.curves.7.curve.id"]},
     "expect": {"error.field": "/distance", "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "mirror", "distance": 2, "mirror_line": "$c.data.curves.9.curve.id",
              "curves": ["$c.data.curves.7.curve.id"]},
     "expect": {"error.field": "/distance", "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$sk.data.sketch.id", "mode": "mirror", "mirror_line": "$c.data.curves.7.curve.id",
              "curves": ["$c.data.curves.7.curve.id"]},
     "expect": {"error.field": "/mirror_line", "mutation_outcome": "not_started"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_sketch", "setup": true, "save": "other", "args": {"placement": {"principal": "xy", "origin": [0, 0, 20]}}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$other.data.sketch.id", "mode": "mirror", "mirror_line": "$c.data.curves.9.curve.id",
              "curves": ["$c.data.curves.7.curve.id"]},
     "expect": {"error.category": "wrong_owner", "error.field": "/curves/0"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$other.data.sketch.id"}}
  ]
}
