{
  "covers": {"nx_create_sketch_corner": ["fillet", "chamfer"], "nx_create_sketch_constraints": ["horizontal", "collinear"],
             "nx_create_sketch_dimensions": ["length"], "nx_create_sketch_copy": ["offset"],
             "nx_create_sketch_projection": ["project", "intersect"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "save": "s",
     "args": {"placement": "xy", "name": "SAFE", "finish": true,
              "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 30]}]},
     "expect": {"mutation_outcome": "committed", "data.curves": {"count": 4}}},
    {"call": "nx_create_sketch", "args": {"placement": {"principal": "xy", "origin": [0, 0, 5]}, "name": "safe"},
     "expect": {"error.code": "NX_NAME_CONFLICT", "error.field": "/name", "mutation_outcome": "not_started",
                "error.details.existing": "$s.data.sketch.id"}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$s.data.sketch.id", "curves": [
       {"type": "polygon", "center": [0, 0], "sides": 64, "radius": 4}, {"type": "polygon", "center": [0, 0], "sides": 64, "radius": 5},
       {"type": "polygon", "center": [0, 0], "sides": 64, "radius": 6}, {"type": "polygon", "center": [0, 0], "sides": 64, "radius": 7},
       {"type": "polygon", "center": [0, 0], "sides": 64, "radius": 8}, {"type": "polygon", "center": [0, 0], "sides": 64, "radius": 9},
       {"type": "polygon", "center": [0, 0], "sides": 64, "radius": 10}, {"type": "polygon", "center": [0, 0], "sides": 64, "radius": 11}]},
     "expect": {"error.code": "NX_TOO_MANY_OBJECTS", "error.field": "/curves", "mutation_outcome": "not_started",
                "error.details.adding": 512, "error.details.limit": 500}},
    {"call": "nx_create_sketch_corner", "save": "f",
     "args": {"sketch": "$s.data.sketch.id", "first": "$s.data.curves.0.id", "second": "$s.data.curves.1.id",
              "kind": "fillet", "radius": 5},
     "expect": {"mutation_outcome": "committed", "data.corner.radius": {"close": 5, "tol": 1e-9},
                "data.corner.center": {"close": [35, 5], "tol": 1e-9}}},
    {"call": "nx_create_sketch_corner",
     "args": {"sketch": "$s.data.sketch.id", "first": "$s.data.curves.0.id", "second": "$s.data.curves.1.id",
              "kind": "fillet", "radius": 5},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "error.field": "/second", "mutation_outcome": "not_started",
                "error.details.existing": "$f.data.corner.curve.id", "error.details.gap": {"close": 7.0710678, "tol": 1e-6}}},
    {"call": "nx_set_expression", "setup": true, "args": {"name": "rr", "formula": "40", "units": "mm"}},
    {"call": "nx_create_sketch_corner", "save": "ff",
     "args": {"sketch": "$s.data.sketch.id", "first": "$s.data.curves.1.id", "second": "$s.data.curves.2.id",
              "kind": "fillet", "radius": "rr/10"},
     "expect": {"mutation_outcome": "committed", "data.corner.radius": {"close": 4, "tol": 1e-9},
                "data.corner.center": {"close": [36, 26], "tol": 1e-9}, "data.expression.formula": "rr/10",
                "data.expression.value": {"close": 4, "tol": 1e-9}}},
    {"call": "nx_create_sketch_corner",
     "args": {"sketch": "$s.data.sketch.id", "first": "$s.data.curves.2.id", "second": "$s.data.curves.3.id",
              "kind": "chamfer", "distance": "rr/20"},
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/distance", "mutation_outcome": "not_started"}},

    {"call": "nx_create_sketch", "setup": true, "save": "j",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, 50]}, "name": "JOIN"}},
    {"call": "nx_create_sketch_curves", "save": "jc",
     "args": {"sketch": "$j.data.sketch.id", "connect": true, "curves": [
       {"type": "line", "start": [0, 0], "end": [40, 0]},
       {"type": "line", "start": [40, 0], "end": [40, 20]},
       {"type": "polyline", "points": [[40, 20], [0, 20], [0, 0]]}]},
     "expect": {"mutation_outcome": "committed", "data.connected": 3, "data.loops": {"count": 1},
                "data.loops.0.closed": true, "data.loops.0.curves": 4}},
    {"call": "nx_create_sketch_constraints",
     "args": {"sketch": "$j.data.sketch.id", "constraints": [{"type": "horizontal", "curves": ["$jc.data.curves.0.curve.id"]}]},
     "expect": {"mutation_outcome": "committed", "data.constraints.0.residual": {"close": 0, "tol": 1e-6}}},
    {"call": "nx_create_sketch_constraints",
     "args": {"sketch": "$j.data.sketch.id", "constraints": [{"type": "horizontal", "curves": ["$jc.data.curves.0.curve.id"]}]},
     "expect": {"mutation_outcome": "committed", "data.constraints.0.already_existed": true,
                "data.constraints.0.constraints": {"count": 1}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "xl",
     "args": {"sketch": "$j.data.sketch.id", "curves": [
       {"type": "line", "start": [60, 0], "end": [80, 0]}, {"type": "line", "start": [90, 3], "end": [110, 5]}]}},
    {"call": "nx_create_sketch_constraints",
     "args": {"sketch": "$j.data.sketch.id",
              "constraints": [{"type": "collinear", "curves": ["$xl.data.curves.0.curve.id", "$xl.data.curves.1.curve.id"]}]},
     "expect": {"mutation_outcome": "committed", "data.constraints.0.type": "collinear",
                "data.constraints.0.residual": {"close": 0, "tol": 1e-6}}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$j.data.sketch.id",
              "dimensions": [{"kind": "length", "first": "$xl.data.curves.0.curve.id", "value": "rr/4", "name": "len_a"}]},
     "expect": {"mutation_outcome": "committed", "data.dimensions.0.measured": {"close": 10, "tol": 1e-6},
                "data.dimensions.0.expression.formula": "rr/4", "data.dimensions.0.expression.name": {"matches": "(?i)^len_a$"}}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$j.data.sketch.id",
              "dimensions": [{"kind": "length", "first": "$xl.data.curves.1.curve.id", "name": "LEN_A"}]},
     "expect": {"error.code": "NX_NAME_CONFLICT", "error.field": "/dimensions/0/name", "mutation_outcome": "not_started"}},
    {"call": "nx_edit_sketch_curves",
     "args": {"sketch": "$j.data.sketch.id",
              "edits": [{"type": "line", "curve": "$jc.data.curves.1.curve.id", "end": [40, 25]}]},
     "expect": {"mutation_outcome": "committed", "data.edits.0.curves.0.end": {"close": [40, 25], "tol": 1e-6},
                "data.moved": {"contains": "$jc.data.curves.2.curve.id"}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$s.data.sketch.id"},
     "expect": {"data.curves.0.type": "line",
                "warnings.0.message": {"contains": "another sketch"}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$s.data.sketch.id", "include": ["status"]},
     "expect": {"error.code": "NX_SKETCH_ACTIVE", "error.details.open_sketch": "$j.data.sketch.id"}},
    {"call": "nx_check_sketch", "args": {"sketch": "$j.data.sketch.id"},
     "expect": {"data.state": "under_constrained", "data.trials": {"count": 0},
                "data.note": {"contains": "under-constrained"}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$j.data.sketch.id"}},

    {"call": "nx_create_sketch", "setup": true, "save": "fx",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, 80]}, "name": "FIX",
              "curves": [{"type": "line", "start": [0, 0], "end": [60, 0]}]}},
    {"call": "nx_create_sketch_constraints", "setup": true,
     "args": {"sketch": "$fx.data.sketch.id", "constraints": [{"type": "fixed", "curves": ["$fx.data.curves.0.id"]}]}},
    {"call": "nx_create_sketch_dimensions",
     "args": {"sketch": "$fx.data.sketch.id", "dimensions": [{"kind": "length", "first": "$fx.data.curves.0.id", "value": 70}]},
     "expect": {"error.code": "NX_SKETCH_OVERCONSTRAINED", "error.field": "/dimensions/0",
                "error.hint": {"contains": "reference"}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$fx.data.sketch.id"}},

    {"call": "nx_create_sketch", "setup": true, "save": "o",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, 200]}, "name": "OFF",
              "curves": [{"type": "rounded_rectangle", "center": [0, 0], "width": 40, "height": 30, "radius": 5}]}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$o.data.sketch.id", "mode": "offset", "distance": 5, "side": "inside",
              "curves": ["$o.data.curves.0.id", "$o.data.curves.1.id", "$o.data.curves.2.id", "$o.data.curves.3.id",
                         "$o.data.curves.4.id", "$o.data.curves.5.id", "$o.data.curves.6.id", "$o.data.curves.7.id"]},
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/distance", "mutation_outcome": "not_started",
                "error.details.max_distance": {"close": 5, "tol": 1e-9}}},
    {"call": "nx_create_sketch_copy",
     "args": {"sketch": "$o.data.sketch.id", "mode": "offset", "distance": 2, "side": "inside",
              "curves": ["$o.data.curves.0.id", "$o.data.curves.1.id", "$o.data.curves.2.id", "$o.data.curves.3.id",
                         "$o.data.curves.4.id", "$o.data.curves.5.id", "$o.data.curves.6.id", "$o.data.curves.7.id"]},
     "expect": {"mutation_outcome": "committed", "data.side": "inside", "data.measured_distance": {"close": 2, "tol": 1e-5},
                "data.expression.value": {"close": 2, "tol": 1e-9}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$o.data.sketch.id"}},

    {"call": "nx_create_sketch", "setup": true, "save": "lp",
     "args": {"placement": "xy", "name": "LOOP", "finish": true, "curves": [
       {"type": "rounded_rectangle", "center": [0, 0], "width": 40, "height": 30, "radius": 5},
       {"type": "circle", "center": [0, 0], "radius": 5}]}},
    {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$lp.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_find_geometry", "setup": true, "save": "edge",
     "args": {"kind": "edge", "geometry_type": "line", "near": [0, -15, 10], "order": "nearest", "limit": 1}},
    {"call": "nx_create_sketch", "setup": true, "save": "up", "args": {"placement": {"principal": "xy", "origin": [0, 0, 20]}, "name": "UP"}},
    {"call": "nx_create_sketch_projection",
     "args": {"sketch": "$up.data.sketch.id", "objects": ["$edge.data.items.0.id"]},
     "expect": {"mutation_outcome": "committed", "data.curves": {"count": 1}, "data.curves.0.length": {"close": 30, "tol": 1e-6},
                "data.sources.0.curves": {"count": 1}}},
    {"call": "nx_create_sketch_projection",
     "args": {"sketch": "$up.data.sketch.id", "objects": ["$edge.data.items.0.id"]},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "error.field": "/objects/0", "mutation_outcome": "not_started"}},
    {"call": "nx_get_sketch", "args": {"sketch": "$up.data.sketch.id", "include": ["geometry"]},
     "expect": {"data.curves.0.projected": true, "data.curves.0.source": {"matches": "^e"}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$up.data.sketch.id"}},
    {"call": "nx_find_geometry", "setup": true, "save": "bore",
     "args": {"kind": "face", "geometry_type": "cylinder", "near": [5, 0, 5], "order": "nearest", "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "wall",
     "args": {"kind": "face", "geometry_type": "plane", "normal": [1, 0, 0], "near": [20, 0, 5], "order": "nearest", "limit": 1}},
    {"call": "nx_create_sketch", "setup": true, "save": "cut", "args": {"placement": "xz", "name": "CUT"}},
    {"call": "nx_create_sketch_projection",
     "args": {"sketch": "$cut.data.sketch.id", "objects": ["$bore.data.items.0.id", "$wall.data.items.0.id"]},
     "expect": {"mutation_outcome": "committed", "data.features": {"count": 2}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$cut.data.sketch.id", "include": ["geometry"]},
     "expect": {"data.curves": {"count": 2}, "data.curves.0.projected": true, "data.curves.0.source": {"matches": "^fc:"},
                "data.curves.1.projected": true, "data.curves.1.source": {"matches": "^fc:"}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$cut.data.sketch.id"}}
  ]
}
