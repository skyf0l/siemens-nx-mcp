{
  "covers": {"nx_create_sketch_curves": ["spline"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "op", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "save": "open",
     "intent": "An open spline through five points with a start tangent: one curve, its ends on the first and last points",
     "args": {"sketch": "$op.data.sketch.id",
              "curves": [{"type": "spline", "points": [[0, 0], [10, 3], [25, 4], [40, 2], [50, 0]],
                          "start_tangent": [1, 1]}]},
     "expect": {"mutation_outcome": "committed", "frame": "sketch_local", "data.curves": {"count": 1},
                "data.curves.0.type": "spline", "data.curves.0.start": {"close": [0, 0], "tol": 1e-6},
                "data.curves.0.end": {"close": [50, 0], "tol": 1e-6},
                "data.loops": {"equals": [{"closed": false, "curves": 1, "open_ends": 2}]},
                "changes.created": {"count_kind": {"curve": 1}}}},
    {"call": "nx_create_sketch_curves",
     "intent": "A closed (periodic) spline takes no end tangent: refused before NX",
     "args": {"sketch": "$op.data.sketch.id",
              "curves": [{"type": "spline", "points": [[0, 0], [10, 0], [5, 8]], "closed": true,
                          "end_tangent": [1, 0]}]},
     "expect": {"error.field": "/curves/0/end_tangent", "mutation_outcome": "not_started"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$op.data.sketch.id"}},
    {"call": "nx_create_sketch", "save": "ring",
     "intent": "A one-call profile: a closed spline through 16 points on a circle r 20, finished",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "spline", "closed": true,
                          "points": [[20.0, 0.0], [18.477591, 7.653669], [14.142136, 14.142136], [7.653669, 18.477591],
                                     [0.0, 20.0], [-7.653669, 18.477591], [-14.142136, 14.142136], [-18.477591, 7.653669],
                                     [-20.0, 0.0], [-18.477591, -7.653669], [-14.142136, -14.142136], [-7.653669, -18.477591],
                                     [0.0, -20.0], [7.653669, -18.477591], [14.142136, -14.142136], [18.477591, -7.653669]]}]},
     "expect": {"mutation_outcome": "committed", "data.curves": {"count": 1},
                "data.loops": {"equals": [{"closed": true, "curves": 1}]}}},
    {"call": "nx_create_extrude",
     "intent": "The closed spline is a region: its extrude holds about the circle's area times 10",
     "args": {"sketch": "$ring.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"mutation_outcome": "committed", "data.volume": {"close": 12566.37, "tol": 15}}},
    {"call": "nx_create_sketch", "save": "lens",
     "intent": "An open spline whose last point repeats the first: a closed loop with a sharp joint",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, 50]}, "finish": true,
              "curves": [{"type": "spline", "points": [[0, 0], [10, 4], [20, 0], [10, -4], [0, 0]]}]},
     "expect": {"mutation_outcome": "committed", "data.loops": {"equals": [{"closed": true, "curves": 1}]}}},
    {"call": "nx_check_model", "expect": {"data.healthy": true}}
  ]
}
