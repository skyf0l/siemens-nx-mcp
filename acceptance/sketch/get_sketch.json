{
  "covers": {"nx_get_sketch": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk",
     "args": {"placement": {"principal": "xz", "origin": [0, 0, 10]}, "name": "SIDE"}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [
       {"type": "line", "start": [0, 0], "end": [30, 2]},
       {"type": "arc", "center": [50, 0], "radius": 5, "start_angle": 0, "end_angle": 90}]}},
    {"call": "nx_create_sketch_constraints", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "constraints": [{"type": "horizontal", "curves": ["$c.data.curves.0.curve.id"]}]}},
    {"call": "nx_create_sketch_dimensions", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "dimensions": [{"kind": "length", "first": "$c.data.curves.0.curve.id", "value": 40}]}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id"},
     "expect": {"mutation_outcome": "not_applicable", "data.active": true, "data.sketch.name": {"matches": "(?i)^side$"},
                "data.frame.origin": {"close": [0, 0, 10], "tol": 1e-9}, "data.frame.normal": {"close": [0, -1, 0], "tol": 1e-9},
                "data.curves": {"count": 2}, "data.curves.0.type": "line",
                "data.curves.0.start": {"close": [0, 0], "tol": 1e-9}, "data.curves.0.end": {"close": [40, 0], "tol": 1e-9},
                "data.curves.0.part.end": {"close": [40, 0, 10], "tol": 1e-9}, "data.curves.0.length": {"close": 40, "tol": 1e-9},
                "data.curves.1.type": "arc", "data.curves.1.center": {"close": [50, 0], "tol": 1e-9},
                "data.curves.1.radius": {"close": 5, "tol": 1e-9}, "data.curves.1.start_angle": {"close": 0, "tol": 1e-9},
                "data.curves.1.end_angle": {"close": 90, "tol": 1e-9}, "data.curves.1.part.center": {"close": [50, 0, 10], "tol": 1e-9},
                "data.constraints": {"count": 2}, "data.constraints.0.type": "horizontal",
                "data.constraints.1.type": "parallel_dim", "data.constraints.1.expression.value": {"close": 40, "tol": 1e-9},
                "data.constraints.1.curves": {"count": 1}, "data.status.state": "under_constrained"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["status"]},
     "expect": {"data.active": false, "data.status.state": "under_constrained", "data.frame.origin.2": {"close": 10, "tol": 1e-9}}},
    {"call": "nx_list_objects", "args": {"kind": "sketch"},
     "expect": {"data.items.0.details.active": false}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry"]},
     "expect": {"data.curves": {"count": 2}, "data.curves.0.construction": false}},
    {"call": "nx_create_sketch", "setup": true, "save": "busy", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["status"]},
     "expect": {"error.code": "NX_SKETCH_ACTIVE", "mutation_outcome": "not_applicable"}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry", "constraints"]},
     "expect": {"data.constraints": {"count": 2}, "data.active": false}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$busy.data.sketch.id"}},
    {"call": "nx_get_sketch", "args": {"sketch": "$c.data.curves.0.curve.id"},
     "expect": {"error.code": "NX_WRONG_KIND"}}
  ]
}
