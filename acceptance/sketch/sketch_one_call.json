{
  "covers": {"nx_create_sketch": ["principal"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "save": "solid",
     "intent": "One-call profile sketch: placement, a closed polyline and finish",
     "args": {"placement": {"principal": "xz"}, "name": "ONE_CALL",
              "curves": [{"type": "polyline", "points": [[10, 0], [30, 0], [30, 40], [10, 40]], "closed": true}],
              "finish": true},
     "expect": {"mutation_outcome": "committed", "data.active": false, "data.curves": {"count": 4},
                "data.loops": {"count": 1}, "data.loops.0.closed": true, "data.loops.0.curves": 4,
                "data.frame.normal": {"close": [0, -1, 0], "tol": 1e-9}}},
    {"call": "nx_create_revolve", "save": "rv", "args": {"sketch": "$solid.data.sketch.id", "axis": {"principal": "z"}},
     "intent": "Revolve the one-call profile: pi (30^2 - 10^2) 40",
     "expect": {"data.volume": {"close": 100530.96491487338, "tol": 1e-3}, "data.bodies": {"count": 1}}},
    {"call": "nx_create_sketch", "save": "hollow",
     "intent": "Nested closed loops in one call: a hollow profile",
     "args": {"placement": {"principal": "xz", "origin": [0, 0, 100]},
              "curves": [{"type": "rectangle", "corner1": [10, 0], "corner2": [30, 40]},
                         {"type": "polyline", "points": [[15, 5], [25, 5], [25, 35], [15, 35]], "closed": true}],
              "finish": true},
     "expect": {"data.active": false, "data.curves": {"count": 8}, "data.loops": {"count": 2},
                "data.loops.0.closed": true, "data.loops.0.curves": 4,
                "data.loops.1.closed": true, "data.loops.1.curves": 4}},
    {"call": "nx_create_revolve", "save": "hv",
     "args": {"sketch": "$hollow.data.sketch.id", "axis": {"principal": "z"}, "end_angle": 180},
     "intent": "Revolve the hollow profile half way (open void): pi (800 * 40 - 400 * 30) / 2",
     "expect": {"data.volume": {"close": 31415.926535897932, "tol": 1e-3}, "data.bodies": {"count": 1}}},
    {"call": "nx_create_sketch", "save": "open",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, 200]},
              "curves": [{"type": "polyline", "points": [[0, 0], [40, 0], [40, 10]]}]},
     "expect": {"data.active": true, "data.loops.0.closed": false, "data.loops.0.open_ends": 2}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$open.data.sketch.id"}},
    {"call": "nx_list_objects", "setup": true, "save": "before", "args": {"kind": "sketch"}},
    {"call": "nx_create_sketch",
     "intent": "A bad curve is refused before NX: nothing is created",
     "args": {"placement": {"principal": "xy"},
              "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [10, 10]},
                         {"type": "line", "start": [1, 1], "end": [1, 1]}], "finish": true},
     "expect": {"error.category": "invalid_argument", "error.field": "/curves/1/end", "mutation_outcome": "not_started"}},
    {"call": "nx_list_objects", "args": {"kind": "sketch"}, "expect": {"page.total": 3}},
    {"call": "nx_check_model", "expect": {"data.healthy": true}}
  ]
}
