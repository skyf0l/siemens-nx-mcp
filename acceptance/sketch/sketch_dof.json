{
  "covers": {"nx_get_sketch": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}, "name": "DOF"}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [
       {"type": "line", "start": [0, 0], "end": [40, 0]},
       {"type": "line", "start": [40, 0], "end": [40, 20]},
       {"type": "circle", "center": [20, 10], "radius": 4},
       {"type": "arc", "center": [60, 0], "radius": 5, "start_angle": 0, "end_angle": 90},
       {"type": "circle", "center": [20, 10], "radius": 6}]}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry", "status"]},
     "expect": {"data.status.state": "under_constrained", "data.status.fully_constrained": false,
                "data.status.dof": 19, "data.status.free_curves": 5,
                "data.curves.0.dof": 4, "data.curves.2.dof": 3, "data.curves.3.dof": 5}},
    {"call": "nx_create_sketch_constraints", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "constraints": [
       {"type": "coincident", "points": [{"curve": "$c.data.curves.0.curve.id", "point": "end"}, {"curve": "$c.data.curves.1.curve.id", "point": "start"}]},
       {"type": "horizontal", "curves": ["$c.data.curves.0.curve.id"]},
       {"type": "perpendicular", "curves": ["$c.data.curves.0.curve.id", "$c.data.curves.1.curve.id"]},
       {"type": "concentric", "curves": ["$c.data.curves.2.curve.id", "$c.data.curves.4.curve.id"]},
       {"type": "fixed", "points": [{"curve": "$c.data.curves.0.curve.id", "point": "start"}]},
       {"type": "point_on_curve", "points": [{"curve": "$c.data.curves.3.curve.id", "point": "center"}], "curves": ["$c.data.curves.0.curve.id"]}]}},
    {"call": "nx_create_sketch_dimensions", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "dimensions": [
       {"kind": "length", "first": "$c.data.curves.0.curve.id", "value": 40},
       {"kind": "radius", "first": "$c.data.curves.2.curve.id", "value": 4},
       {"kind": "diameter", "first": "$c.data.curves.4.curve.id", "value": 12},
       {"kind": "horizontal", "first": {"curve": "$c.data.curves.0.curve.id", "point": "start"}, "second": {"curve": "$c.data.curves.2.curve.id", "point": "center"}, "value": 20},
       {"kind": "perpendicular_distance", "first": "$c.data.curves.0.curve.id", "second": {"curve": "$c.data.curves.2.curve.id", "point": "center"}, "value": 10},
       {"kind": "distance", "first": {"curve": "$c.data.curves.1.curve.id", "point": "end"}, "second": {"curve": "$c.data.curves.3.curve.id", "point": "center"}, "reference": true}]}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id"},
     "expect": {"mutation_outcome": "not_applicable",
                "data.status.state": "under_constrained", "data.status.fully_constrained": false,
                "data.status.dof": 5, "data.status.free_curves": 2,
                "data.curves.0.dof": 0, "data.curves.1.dof": 1, "data.curves.2.dof": 0,
                "data.curves.3.dof": 4, "data.curves.4.dof": 0,
                "data.constraints": {"count": 12}}},
    {"call": "nx_create_sketch_constraints", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "constraints": [
       {"type": "fixed", "points": [{"curve": "$c.data.curves.3.curve.id", "point": "start"}]},
       {"type": "fixed", "points": [{"curve": "$c.data.curves.3.curve.id", "point": "end"}]}]}},
    {"call": "nx_create_sketch_dimensions", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "dimensions": [{"kind": "length", "first": "$c.data.curves.1.curve.id", "value": 20}]}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry", "status"]},
     "expect": {"data.status.state": "well_constrained", "data.status.fully_constrained": true,
                "data.status.dof": 0, "data.status.free_curves": 0,
                "data.curves.1.dof": 0, "data.curves.3.dof": 0}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["status"]},
     "expect": {"data.active": false, "data.status.dof": 0, "data.status.fully_constrained": true}},
    {"call": "nx_create_sketch", "setup": true, "save": "pts", "args": {"placement": {"principal": "xy", "origin": [0, 0, 30]}, "name": "POINTS"}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "p",
     "args": {"sketch": "$pts.data.sketch.id", "curves": [
       {"type": "line", "start": [0, 0], "end": [40, 0]},
       {"type": "arc", "center": [20, 3], "radius": 5, "start_angle": 0, "end_angle": 120}]}},
    {"call": "nx_create_sketch_constraints", "setup": true,
     "args": {"sketch": "$pts.data.sketch.id", "constraints": [
       {"type": "point_on_curve", "points": [{"curve": "$p.data.curves.1.curve.id", "point": "center"}], "curves": ["$p.data.curves.0.curve.id"]}]}},
    {"call": "nx_get_sketch", "args": {"sketch": "$pts.data.sketch.id"},
     "expect": {"data.constraints": {"count": 1}, "data.constraints.0.type": "point_on_curve",
                "data.constraints.0.curves": {"count": 2}, "data.constraints.0.geometry": {"count": 2},
                "data.constraints.0.geometry.0.point": "center", "data.constraints.0.geometry.1.point": "curve",
                "data.status.dof": 8, "data.status.free_curves": 2, "data.curves.0.dof": 4, "data.curves.1.dof": 5}},
    {"call": "nx_create_sketch_dimensions", "setup": true,
     "args": {"sketch": "$pts.data.sketch.id", "dimensions": [
       {"kind": "distance", "first": {"curve": "$p.data.curves.0.curve.id", "point": "end"}, "second": {"curve": "$p.data.curves.1.curve.id", "point": "start"}, "reference": true}]}},
    {"call": "nx_get_sketch", "args": {"sketch": "$pts.data.sketch.id", "include": ["constraints", "status"]},
     "expect": {"data.constraints": {"contains": {"type": "parallel_dim", "reference": true}}, "data.constraints.1.type": {"matches": "^(point_on_curve|parallel_dim)$"},
                "data.status.dof": 8}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$pts.data.sketch.id"}}
  ]
}
