{
  "covers": {"nx_create_sketch_curves": ["polyline"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "save": "pf", "args": {"placement": {"principal": "xz"}},
     "expect": {"data.frame.x_axis": {"close": [1, 0, 0], "tol": 1e-9}, "data.frame.y_axis": {"close": [0, 0, 1], "tol": 1e-9},
                "data.frame.normal": {"close": [0, -1, 0], "tol": 1e-9}}},
    {"call": "nx_create_sketch_curves", "save": "pl",
     "args": {"sketch": "$pf.data.sketch.id", "curves": [
       {"type": "polyline", "points": [[10, 0], [30, 0], [30, 5], [20, 15], [10, 15]], "closed": true}]},
     "expect": {"mutation_outcome": "committed", "frame": "sketch_local", "data.curves": {"count": 5},
                "data.curves.0.start": {"close": [10, 0], "tol": 1e-9}, "data.curves.4.end": {"close": [10, 0], "tol": 1e-9},
                "data.curves.3.length": {"close": 10, "tol": 1e-9},
                "data.loops": {"count": 1}, "data.loops.0.closed": true, "data.loops.0.curves": 5,
                "changes.created": {"count_kind": {"curve": 5}}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$pf.data.sketch.id"}},
    {"call": "nx_create_revolve", "save": "rv", "args": {"sketch": "$pf.data.sketch.id", "axis": {"principal": "z"}},
     "expect": {"data.volume": {"close": 29321.531433504733, "tol": 1e-4}, "data.bodies": {"count": 1}}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$rv.data.bodies.0.id"], "precision": "exact"},
     "expect": {"data.min": {"close": [-30, -30, 0], "tol": 1e-4}, "data.max": {"close": [30, 30, 15], "tol": 1e-4}}},
    {"call": "nx_create_sketch", "save": "ch", "args": {"placement": {"principal": "yz", "origin": [100, 0, 0]}},
     "expect": {"data.frame.x_axis": {"close": [0, 1, 0], "tol": 1e-9}, "data.frame.y_axis": {"close": [0, 0, 1], "tol": 1e-9}}},
    {"call": "nx_create_sketch_curves", "detail": "compact",
     "args": {"sketch": "$ch.data.sketch.id", "curves": [
       {"type": "polyline", "points": [[0, 0], [40, 0], [40, 10], [20, 25]]}]},
     "expect": {"data.curves": {"count": 3}, "data.loops": {"count": 1}, "data.loops.0.closed": false,
                "data.loops.0.open_ends": 2, "changes.created": {"count": 0}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$ch.data.sketch.id", "curves": [
       {"type": "polyline", "points": [[20, 25], [0, 10], [0, 0]]},
       {"type": "circle", "center": [20, 8], "radius": 3}]},
     "expect": {"data.curves": {"count": 3}, "data.loops": {"count": 2}, "data.loops.0.closed": true,
                "data.loops.0.curves": 5, "data.loops.1.closed": true, "data.loops.1.curves": 1}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$ch.data.sketch.id"}},
    {"call": "nx_create_extrude", "args": {"sketch": "$ch.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"data.volume": {"close": 6717.256661, "tol": 1e-3}}},
    {"call": "nx_create_sketch", "setup": true, "save": "bad", "args": {"placement": {"principal": "xy", "origin": [0, 0, 100]}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$bad.data.sketch.id", "curves": [{"type": "polyline", "points": [[0, 0], [0, 0], [5, 5]]}]},
     "expect": {"error.category": "invalid_argument", "error.field": "/curves/0/points/1", "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$bad.data.sketch.id", "curves": [{"type": "polyline", "points": [[0, 0], [5, 5]], "closed": true}]},
     "expect": {"error.field": "/curves/0", "mutation_outcome": "not_started"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$bad.data.sketch.id"}},
    {"call": "nx_check_model", "expect": {"data.healthy": true}}
  ]
}
