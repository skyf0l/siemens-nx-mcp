{
  "covers": {"nx_create_sketch": ["principal"], "nx_create_sketch_curves": ["arc", "circle", "rounded_rectangle"],
             "nx_finish_sketch": [], "nx_check_sketch": [], "nx_get_sketch": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "save": "sk", "args": {"placement": "XY", "name": "my sketch"},
     "expect": {"mutation_outcome": "committed", "data.active": true, "data.sketch.name": {"matches": "(?i)^my sketch$"},
                "data.frame.origin": {"close": [0, 0, 0], "tol": 1e-9}, "data.frame.normal": {"close": [0, 0, 1], "tol": 1e-9}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "diameter": 8}]},
     "expect": {"mutation_outcome": "committed", "data.curves.0.type": "circle", "data.curves.0.radius": {"close": 4, "tol": 1e-9},
                "data.loops.0.closed": true}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 4, "diameter": 8}]},
     "expect": {"error.category": "invalid_argument", "error.field": "/curves/0/diameter", "mutation_outcome": "not_started"}},
    {"call": "nx_finish_sketch", "args": {},
     "expect": {"mutation_outcome": "committed", "data.was_active": true, "data.curve_count": 1,
                "data.sketch.id": {"matches": "^s:"}}},
    {"call": "nx_finish_sketch", "args": {},
     "expect": {"data.was_active": false, "changes.created": {"count": 0}, "changes.deleted": {"count": 0}}},
    {"call": "nx_create_extrude", "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"data.volume": {"close": 502.6548245743669, "tol": 1e-6}}},
    {"call": "nx_create_sketch", "save": "side", "args": {"placement": {"principal": "XZ", "origin": [0, 10, 0]}},
     "expect": {"data.frame.origin": {"close": [0, 10, 0], "tol": 1e-9}, "data.frame.x_axis": {"close": [1, 0, 0], "tol": 1e-9},
                "data.frame.normal": {"close": [0, -1, 0], "tol": 1e-9}}},
    {"call": "nx_create_sketch_curves",
     "args": {"sketch": "$side.data.sketch.id", "curves": [
       {"type": "arc", "center": [20, 0], "diameter": 10, "start_angle": 0, "end_angle": 90}]},
     "expect": {"data.curves.0.radius": {"close": 5, "tol": 1e-9}, "data.curves.0.start": {"close": [25, 0], "tol": 1e-9},
                "data.curves.0.end": {"close": [20, 5], "tol": 1e-9}}},
    {"call": "nx_check_sketch", "args": {"sketch": "$side.data.sketch.id"},
     "expect": {"data.state": "under_constrained", "data.trials": {"count": 0},
                "data.note": {"contains": "under-constrained"}, "data.free": {"count": 1}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {}},
    {"call": "nx_create_sketch", "save": "one",
     "args": {"placement": {"principal": "Yz", "origin": [100, 0, 0]}, "finish": true, "curves": [
       {"type": "Rounded Rectangle", "center": [0, 0], "width": 40, "height": 20, "radius": 4},
       {"type": "CIRCLE", "center": [0, 0], "diameter": 8}]},
     "expect": {"mutation_outcome": "committed", "data.active": false, "data.frame.normal": {"close": [1, 0, 0], "tol": 1e-9},
                "data.loops": {"count": 2}, "data.loops.0.closed": true, "data.loops.0.curves": 8,
                "data.loops.1.closed": true, "data.loops.1.curves": 1}},
    {"call": "nx_get_sketch", "args": {"sketch": "$one.data.sketch.id", "include": ["geometry"]},
     "expect": {"data.curves": {"count": 9}, "data.curves.0.type": "line", "data.curves.0.constraints": 2,
                "data.curves.1.type": "arc", "data.curves.1.constraints": 2,
                "data.curves.8.type": "circle", "data.curves.8.radius": {"close": 4, "tol": 1e-9}, "data.curves.8.constraints": 0}},
    {"call": "nx_create_extrude", "args": {"sketch": "$one.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"data.volume": {"close": 7360, "tol": 1e-4}}},
    {"call": "nx_create_sketch", "args": {"placement": "zx"},
     "expect": {"error.category": "invalid_argument", "error.field": "/placement",
                "error.message": {"contains": "use 'xz'"}, "mutation_outcome": "not_started"}},
    {"call": "nx_create_sketch", "args": {"placement": "xy", "curves": [{"type": "circel", "center": [0, 0], "radius": 2}]},
     "expect": {"error.field": "/curves/0/type", "error.message": {"contains": "'circle'"},
                "error.hint": {"contains": "rounded_rectangle"}, "mutation_outcome": "not_started"}}
  ]
}
