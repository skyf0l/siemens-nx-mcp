{
  "covers": {"nx_edit_sketch_curves": ["line", "arc", "trim", "extend", "construction", "delete"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [
       {"type": "line", "start": [0, 20], "end": [10, 20]},
       {"type": "arc", "center": [40, 20], "radius": 5, "start_angle": 0, "end_angle": 90},
       {"type": "line", "start": [0, -5], "end": [0, 5]},
       {"type": "line", "start": [-5, 0], "end": [5, 0]},
       {"type": "line", "start": [-5, 3], "end": [-2, 3]},
       {"type": "line", "start": [50, 50], "end": [60, 50]},
       {"type": "line", "start": [0, 40], "end": [10, 42]}]}},
    {"call": "nx_edit_sketch_curves", "save": "e",
     "args": {"sketch": "$sk.data.sketch.id", "edits": [
       {"type": "line", "curve": "$c.data.curves.0.curve.id", "start": [0, 20], "end": [0, 32]},
       {"type": "arc", "curve": "$c.data.curves.1.curve.id", "center": [40, 20], "radius": 7, "start_angle": 0, "end_angle": 180},
       {"type": "trim", "curve": "$c.data.curves.3.curve.id", "boundaries": ["$c.data.curves.2.curve.id"], "pick": [-3, 0]},
       {"type": "extend", "curve": "$c.data.curves.4.curve.id", "boundaries": ["$c.data.curves.2.curve.id"], "pick": [-2, 3]},
       {"type": "construction", "curves": ["$c.data.curves.0.curve.id"], "on": true},
       {"type": "delete", "object": "$c.data.curves.5.curve.id"}]},
     "expect": {"mutation_outcome": "committed", "frame": "sketch_local",
                "data.edits.0.curves.0.end": {"close": [0, 32], "tol": 1e-9},
                "data.edits.0.curves.0.length": {"close": 12, "tol": 1e-9},
                "data.edits.1.curves.0.radius": {"close": 7, "tol": 1e-9},
                "data.edits.1.curves.0.end": {"close": [33, 20], "tol": 1e-9},
                "data.edits.2.curves.0.start": {"close": [0, 0], "tol": 1e-9},
                "data.edits.2.curves.0.end": {"close": [5, 0], "tol": 1e-9},
                "data.edits.3.curves.0.start": {"close": [-5, 3], "tol": 1e-9},
                "data.edits.3.curves.0.end": {"close": [0, 3], "tol": 1e-9},
                "data.edits.4.curves.0.construction": true,
                "data.edits.5.deleted": {"count": 1}, "data.status.state": "under_constrained"}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["geometry"]},
     "expect": {"data.curves": {"count": 6}}},
    {"call": "nx_create_sketch_constraints", "setup": true, "save": "h",
     "args": {"sketch": "$sk.data.sketch.id", "constraints": [{"type": "horizontal", "curves": ["$c.data.curves.6.curve.id"]}]}},
    {"call": "nx_edit_sketch_curves",
     "args": {"sketch": "$sk.data.sketch.id", "edits": [
       {"type": "line", "curve": "$c.data.curves.6.curve.id", "start": [0, 40], "end": [10, 50]}]},
     "expect": {"error.category": "solver_failed", "mutation_outcome": "rolled_back"}},
    {"call": "nx_edit_sketch_curves",
     "args": {"sketch": "$sk.data.sketch.id", "edits": [
       {"type": "delete", "object": "$h.data.constraints.0.constraints.0.id"},
       {"type": "line", "curve": "$c.data.curves.6.curve.id", "start": [0, 40], "end": [10, 50]}]},
     "expect": {"mutation_outcome": "committed", "data.edits.0.deleted": {"count": 1},
                "data.edits.1.curves.0.end": {"close": [10, 50], "tol": 1e-9}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id", "include": ["constraints"]},
     "expect": {"data.constraints": {"count": 0}}},
    {"call": "nx_edit_sketch_curves",
     "args": {"sketch": "$sk.data.sketch.id", "edits": [
       {"type": "construction", "curves": ["$c.data.curves.0.curve.id"], "on": false}]},
     "expect": {"data.edits.0.curves.0.construction": false}},
    {"call": "nx_edit_sketch_curves",
     "args": {"sketch": "$sk.data.sketch.id", "edits": [
       {"type": "line", "curve": "$c.data.curves.0.curve.id", "start": [1, 1], "end": [1, 1]}]},
     "expect": {"error.field": "/edits/0/end", "error.category": "invalid_argument"}},
    {"call": "nx_edit_sketch_curves",
     "args": {"sketch": "$sk.data.sketch.id", "edits": [
       {"type": "arc", "curve": "$c.data.curves.0.curve.id", "center": [0, 0], "radius": 2, "start_angle": 0, "end_angle": 90}]},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/edits/0/curve"}},
    {"call": "nx_edit_sketch_curves",
     "args": {"sketch": "$sk.data.sketch.id", "edits": [
       {"type": "trim", "curve": "$c.data.curves.2.curve.id", "boundaries": ["$c.data.curves.2.curve.id"], "pick": [0, 1]}]},
     "expect": {"error.field": "/edits/0/boundaries"}},
    {"call": "nx_edit_sketch_curves",
     "args": {"sketch": "$sk.data.sketch.id", "edits": [{"type": "delete", "object": "$c.data.curves.0.curve.id", "on": true}]},
     "expect": {"error.field": "/edits/0/on", "mutation_outcome": "not_started"}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_sketch", "setup": true, "save": "other", "args": {"placement": {"principal": "xz"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "o",
     "args": {"sketch": "$other.data.sketch.id", "curves": [{"type": "line", "start": [0, 0], "end": [5, 0]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$other.data.sketch.id"}},
    {"call": "nx_edit_sketch_curves",
     "args": {"sketch": "$sk.data.sketch.id", "edits": [{"type": "construction", "curves": ["$o.data.curves.0.curve.id"], "on": true}]},
     "expect": {"error.category": "wrong_owner", "error.field": "/edits/0/curves/0"}},
    {"call": "nx_list_objects", "args": {"kind": "sketch"},
     "expect": {"data.items.0.details.active": false, "data.items.1.details.active": false}}
  ]
}
