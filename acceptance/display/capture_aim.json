{
 "covers": {"nx_capture_view": [], "nx_get_camera": []},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_set_camera", "setup": true, "args": {"orientation": "top", "fit": true}},
  {"call": "nx_capture_view", "args": {"path": "$run/aim.png", "view_from": [-1, -1, 1]},
   "expect": {"mutation_outcome": "not_applicable", "data.image.inline": false, "data.hidden_sketches": 16,
              "data.camera.view": "custom", "data.camera.nearest_view": "front", "data.camera.view_angle": {"close": 54.736, "tol": 0.001},
              "data.camera.view_from": {"close": [-0.5773502692, -0.5773502692, 0.5773502692], "tol": 1e-9},
              "data.camera.up.2": {"close": 0.8164965809, "tol": 1e-9},
              "data.marks_part_modified": false, "data.path": {"matches": "aim[.]png$"}, "data.size": {"close": 50000, "tol": 49900}}},
  {"call": "nx_get_camera", "args": {},
   "expect": {"data.view": "top", "data.view_angle": 0, "data.view_from": {"close": [0, 0, 1], "tol": 1e-9}}},
  {"call": "nx_get_appearance", "args": {"objects": ["$sk.data.sketch.id"]},
   "expect": {"data.objects.0.blanked": false}},
  {"call": "nx_get_model_summary", "args": {}, "expect": {"data.modified": false}},
  {"call": "nx_capture_view", "args": {"path": "$run/aim_up.png", "view_from": [1, 0, 0], "up": [0, 1, 0], "fit": false, "hide_sketches": false},
   "expect": {"data.hidden_sketches": 0, "data.image.inline": false, "data.camera.view": "right", "data.camera.view_angle": 0,
              "data.camera.up": {"close": [0, 1, 0], "tol": 1e-9}}},
  {"call": "nx_capture_view", "args": {"path": "$run/aim_inline.png", "inline": true},
   "expect": {"data.image.inline": true, "data.hidden_sketches": 16, "data.camera.view": "top"}},
  {"call": "nx_capture_view", "args": {},
   "expect": {"data.image.inline": true, "data.path": {"matches": "^captures/view-"}}},
  {"call": "nx_capture_view", "args": {"up": [0, 0, 1]},
   "expect": {"error.field": "/up", "mutation_outcome": "not_started"}},
  {"call": "nx_get_model_summary", "args": {}, "expect": {"data.modified": false}}
 ]
}
