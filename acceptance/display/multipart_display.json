{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "front", "args": {"path": "$run/mdd/mdd_front.prt", "units": "mm"}},
  {"call": "engineer", "args": {"code": "from nx_mcp.kit import parts as kp\nservices.host._remember_model()  # the development tool's own undo mark is no engineer edit\np = [x for x in session.Parts if str(x.Leaf).lower().startswith('mdd_front') and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nkp.show(NXOpen, session.Parts, p)\nresult = p.Leaf"}, "intent": "Acceptance: the engineer looks at mdd_front.prt (a tab click, no edit): it is the displayed part whatever NX showed before (engineer tab guard)", "expect": {"ok": true, "data.noticed": false}},
  {"call": "nx_create_primitive", "setup": true, "save": "fblk", "args": {"shape": "block", "length": 40, "width": 20, "height": 10}},
  {"call": "nx_set_camera", "setup": true, "args": {"orientation": "isometric", "fit": true}},
  {"call": "nx_create_part", "setup": true, "save": "a", "args": {"path": "$run/mdd/mdd_a.prt", "units": "mm", "display": false}},
  {"call": "nx_create_primitive", "setup": true, "save": "ablk", "args": {"shape": "block", "length": 30, "width": 30, "height": 5, "part": "mdd_a"}},

  {"call": "nx_get_camera", "save": "cam0", "args": {},
   "intent": "Acceptance: the camera read with two agent parts loaded needs no part (target any) and reads the displayed view",
   "expect": {"ok": true, "data.part.id": "$front.data.part.id", "data.scale": {"close": 0, "tol": 1e9}}},
  {"call": "nx_get_camera", "args": {"part": "mdd_a"},
   "intent": "Acceptance: a camera read naming the background part shows it for the read (live: the engineer's camera came back); the shown tab comes back",
   "expect": {"ok": true, "data.part.id": "$a.data.part.id", "data.scale": {"close": 0, "tol": 1e9}}},
  {"call": "nx_capture_view", "args": {"part": "mdd_a", "path": "$run/mdd/mdd_a.png", "overwrite": true},
   "intent": "Acceptance: no width/height captures the window size with no requested size to mistake (live: 1024x768 asked, 1106x1794 given)",
   "expect": {"ok": true, "part.file": "mdd_a.prt", "data.quality": "viewport", "data.resolution": {"count": 2}, "warnings": {"count": 0}}},
  {"call": "nx_capture_view", "args": {"part": "mdd_a", "path": "$run/mdd/mdd_a_sized.png", "overwrite": true, "width": 640, "height": 480},
   "expect": {"ok": true, "data.requested": [640, 480], "data.resolution": [640, 480], "data.image.height": 480}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}, "page.total": 2}},

  {"call": "nx_create_section_view", "save": "sec", "args": {"part": "mdd_a", "plane": {"origin": [10, 5, 0], "normal": [1, 0, 0]}, "name": "CUT_A"},
   "intent": "Acceptance: a section view made in the background part (display switch, then back)",
   "expect": {"mutation_outcome": "committed", "part.file": "mdd_a.prt",
              "data.origin": {"close": [10, 5, 0], "tol": 1e-09}, "data.normal": {"close": [1, 0, 0], "tol": 1e-12},
              "data.active": true, "data.sectioning": true}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},

  {"call": "nx_list_objects", "args": {"part": "mdd_a", "kind": "section_view"},
   "intent": "Acceptance: section views listed in the background part (a bound read): plane and state",
   "expect": {"ok": true, "part.file": "mdd_a.prt", "data.items": {"count": 1},
              "data.items.0.id": "$sec.data.section.id", "data.items.0.type": "one_plane",
              "data.items.0.details.origin": {"close": [10, 5, 0], "tol": 1e-09},
              "data.items.0.details.normal": {"close": [1, 0, 0], "tol": 1e-12},
              "data.items.0.details.cap": true, "data.items.0.details.active": true,
              "data.items.0.details.sectioning": null}},
  {"call": "nx_list_objects", "args": {"part": "mdd_front", "kind": "section_view"},
   "intent": "Acceptance: the displayed part has no section of its own",
   "expect": {"ok": true, "part.file": "mdd_front.prt", "data.items": {"count": 0}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},

  {"call": "nx_delete_objects", "args": {"objects": ["$sec.data.section.id"]},
   "intent": "Acceptance: a section view of the background part deleted (display-bound kind: displayed for the call)",
   "expect": {"ok": true, "mutation_outcome": "committed", "part.file": "mdd_a.prt", "data.deleted": {"count": 1},
              "data.deleted.0.kind": "section_view"}},
  {"call": "nx_list_objects", "args": {"part": "mdd_a", "kind": "section_view"},
   "intent": "Acceptance: the section is gone",
   "expect": {"data.items": {"count": 0}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "intent": "Acceptance: the engineer's display and work part are back",
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_get_camera", "args": {},
   "intent": "Acceptance: the displayed view came back with its camera",
   "expect": {"data.part.id": "$front.data.part.id", "data.scale": {"close": "$cam0.data.scale", "tol": 1e-09},
              "data.origin": {"close": "$cam0.data.origin", "tol": 1e-06}}},

  {"call": "engineer", "args": {"code": "p = [x for x in session.Parts if str(x.Leaf).lower() == 'mdd_a' and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nservices.uf.Assem.SetWorkPartQuietly(p.Tag)\nresult = session.Parts.Work.Leaf"}, "intent": "Acceptance: mdd_a becomes NX's work part without being displayed (a quiet work part beside the shown part)", "expect": {"ok": true}},
  {"call": "nx_get_camera", "args": {"part": "mdd_a"}, "intent": "Acceptance: a camera read naming the work part that is not displayed shows it for the read (bug-fix round: it read the shown part's camera and named that part)", "expect": {"ok": true, "data.part.id": "$a.data.part.id", "data.scale": {"close": 0, "tol": 1000000000.0}}},
  {"call": "nx_capture_view", "args": {"part": "mdd_a", "path": "$run/mdd/mdd_a_work.png", "overwrite": true, "fit": true}, "intent": "Acceptance: a fitted capture naming that part captures it: the fitted view centre is mdd_a's 30x30x5 block centre, not the shown 40x20x10 block's (bug-fix round: the shown part was captured, or the fit refused)", "expect": {"ok": true, "part.file": "mdd_a.prt", "data.camera.absolute_origin": {"close": [15, 15, 2.5], "tol": 1e-06}}},
  {"call": "nx_set_camera", "args": {"part": "mdd_a", "orientation": "top"}, "intent": "Acceptance: the camera of the named, hidden work part is set (it was refused: the displayed part is not the work part)", "expect": {"ok": true, "data.part.id": "$a.data.part.id", "data.view": "top", "data.view_from": {"close": [0, 0, 1], "tol": 1e-09}}},
  {"call": "nx_create_section_view", "save": "secw", "args": {"part": "mdd_a", "plane": {"origin": [10, 5, 0], "normal": [0, 1, 0]}, "name": "CUT_W"}, "intent": "Acceptance: a section view naming the hidden work part is made in it (bug-fix round: gate 4s skipped the display switch for the work part, so display tools acted on the shown part)", "expect": {"mutation_outcome": "committed", "part.file": "mdd_a.prt", "data.origin": {"close": [10, 5, 0], "tol": 1e-09}, "data.normal": {"close": [0, 1, 0], "tol": 1e-12}, "data.active": true}},
  {"call": "nx_list_objects", "args": {"part": "mdd_front", "kind": "section_view"}, "intent": "Acceptance: the shown part got no section", "expect": {"ok": true, "part.file": "mdd_front.prt", "data.items": {"count": 0}}},
  {"call": "nx_list_objects", "args": {"part": "mdd_a", "kind": "section_view"}, "expect": {"ok": true, "part.file": "mdd_a.prt", "data.items": {"count": 1}, "data.items.0.id": "$secw.data.section.id", "data.items.0.details.normal": {"close": [0, 1, 0], "tol": 1e-12}}},
  {"call": "nx_delete_objects", "args": {"objects": ["$secw.data.section.id"]}, "intent": "Acceptance: refs of the hidden work part show it for the delete", "expect": {"mutation_outcome": "committed", "part.file": "mdd_a.prt", "data.deleted": {"count": 1}, "data.deleted.0.kind": "section_view"}},
  {"call": "nx_get_appearance", "save": "fapp", "args": {"objects": ["$fblk.data.bodies.0.id"]}, "expect": {"ok": true, "data.count": 7}},
  {"call": "nx_set_appearance", "args": {"objects": ["$ablk.data.bodies.0.id"], "color": "red"}, "intent": "Acceptance: an appearance change on a body of the hidden work part shows it for the call (it needs the displayed part to be the work part)", "expect": {"mutation_outcome": "committed", "part.file": "mdd_a.prt", "data.count": 7, "data.objects.0.color": 186, "data.objects.6.color": 186}},
  {"call": "nx_get_appearance", "args": {"objects": ["$ablk.data.bodies.0.id"]}, "expect": {"ok": true, "data.objects.0.color": 186, "data.objects.6.color": 186}},
  {"call": "nx_get_appearance", "args": {"objects": ["$fblk.data.bodies.0.id"]}, "intent": "Acceptance: the shown part's block kept its colour", "expect": {"ok": true, "data.objects.0.color": "$fapp.data.objects.0.color", "data.objects.6.color": "$fapp.data.objects.6.color"}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"}, "intent": "Acceptance: the shown part stayed displayed and mdd_a stayed the work part", "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": false}}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"}, "expect": {"data.items": {"contains": {"part": {"id": "$a.data.part.id"}, "display": false, "work": true}}}},
  {"call": "engineer", "args": {"code": "p = [x for x in session.Parts if str(x.Leaf).lower() == 'mdd_front' and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nsession.Parts.SetWork(p)\nresult = session.Parts.Work.Leaf"}, "intent": "Acceptance: the shown part is the work part again", "expect": {"ok": true}},
  {"call": "nx_get_camera", "args": {}, "intent": "Acceptance: the displayed view kept its camera through the three calls", "expect": {"data.part.id": "$front.data.part.id", "data.scale": {"close": "$cam0.data.scale", "tol": 1e-09}, "data.origin": {"close": "$cam0.data.origin", "tol": 1e-06}}}
 ]
}
