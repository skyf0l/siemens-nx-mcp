{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "front", "args": {"path": "$run/mdd/mdd_front.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "args": {"shape": "block", "length": 40, "width": 20, "height": 10}},
  {"call": "nx_set_camera", "setup": true, "args": {"orientation": "isometric", "fit": true}},
  {"call": "nx_create_part", "setup": true, "save": "a", "args": {"path": "$run/mdd/mdd_a.prt", "units": "mm", "display": false}},
  {"call": "nx_create_primitive", "setup": true, "args": {"shape": "block", "length": 30, "width": 30, "height": 5, "part": "mdd_a"}},

  {"call": "nx_get_camera", "save": "cam0", "args": {},
   "intent": "Acceptance: the camera read with two agent parts loaded needs no part (target any) and reads the displayed view",
   "expect": {"ok": true, "data.part.id": "$front.data.part.id", "data.scale": {"close": 0, "tol": 1e9}}},
  {"call": "nx_get_camera", "args": {"part": "mdd_a"},
   "intent": "Acceptance: a camera read with part = the background part never switches the display",
   "expect": {"ok": true, "data.part.id": "$front.data.part.id",
              "data.scale": {"close": "$cam0.data.scale", "tol": 1e-09},
              "data.origin": {"close": "$cam0.data.origin", "tol": 1e-09}}},
  {"call": "nx_list_parts", "args": {},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}, "page.total": 2}},

  {"call": "nx_create_section_view", "save": "sec", "args": {"part": "mdd_a", "plane": {"origin": [10, 5, 0], "normal": [1, 0, 0]}, "name": "CUT_A"},
   "intent": "Acceptance: a section view made in the background part (display switch, then back)",
   "expect": {"mutation_outcome": "committed", "part.file": "mdd_a.prt",
              "data.origin": {"close": [10, 5, 0], "tol": 1e-09}, "data.normal": {"close": [1, 0, 0], "tol": 1e-12},
              "data.active": true, "data.sectioning": true}},
  {"call": "nx_list_parts", "args": {},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},

  {"call": "nx_list_objects", "args": {"part": "mdd_a", "kind": "section_view"},
   "intent": "Acceptance: section views listed in the background part (a bound read): plane and state",
   "expect": {"ok": true, "part.file": "mdd_a.prt", "data.items": {"count": 1},
              "data.items.0.id": "$sec.data.section.id", "data.items.0.type": "one_plane",
              "data.items.0.details.origin": {"close": [10, 5, 0], "tol": 1e-09},
              "data.items.0.details.normal": {"close": [1, 0, 0], "tol": 1e-12},
              "data.items.0.details.cap": true, "data.items.0.details.active": true,
              "data.items.0.details.sectioning": null}},
  {"call": "nx_list_objects", "args": {"part": "mdd_front", "kind": "section_view"},
   "intent": "Acceptance: the displayed part has no section of its own",
   "expect": {"ok": true, "part.file": "mdd_front.prt", "data.items": {"count": 0}}},
  {"call": "nx_list_parts", "args": {},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},

  {"call": "nx_delete_objects", "args": {"objects": ["$sec.data.section.id"]},
   "intent": "Acceptance: a section view of the background part deleted (display-bound kind: displayed for the call)",
   "expect": {"ok": true, "mutation_outcome": "committed", "part.file": "mdd_a.prt", "data.deleted": {"count": 1},
              "data.deleted.0.kind": "section_view"}},
  {"call": "nx_list_objects", "args": {"part": "mdd_a", "kind": "section_view"},
   "intent": "Acceptance: the section is gone",
   "expect": {"data.items": {"count": 0}}},
  {"call": "nx_list_parts", "args": {},
   "intent": "Acceptance: the engineer's display and work part are back",
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_get_camera", "args": {},
   "intent": "Acceptance: the displayed view came back with its camera",
   "expect": {"data.part.id": "$front.data.part.id", "data.scale": {"close": "$cam0.data.scale", "tol": 1e-09},
              "data.origin": {"close": "$cam0.data.origin", "tol": 1e-06}}}
 ]
}
