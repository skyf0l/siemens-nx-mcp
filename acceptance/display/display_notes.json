{
 "covers": {
  "nx_set_visibility": [],
  "nx_set_appearance": [],
  "nx_get_appearance": [],
  "nx_set_highlight": [],
  "nx_capture_view": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "blk",
   "args": {
    "shape": "block",
    "length": 100,
    "width": 60,
    "height": 20
   }
  },
  {
   "call": "nx_set_visibility",
   "args": {
    "mode": "hide",
    "types": [
     "sketch"
    ]
   },
   "intent": "Acceptance: hiding a type the part has none of changes nothing (live: NX_NOT_FOUND 'No sketchs')",
   "expect": {
    "ok": true,
    "data.count": 0,
    "data.by_type": {
     "sketch": 0
    },
    "warnings.0.message": {
     "contains": "no sketches"
    }
   }
  },
  {
   "call": "nx_set_appearance",
   "args": {
    "objects": [
     "$blk.data.bodies.0.id"
    ],
    "color": "Pale Steel"
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.color_match.label": "Pale Steel"
   }
  },
  {
   "call": "nx_get_appearance",
   "args": {
    "objects": [
     "$blk.data.bodies.0.id"
    ]
   },
   "intent": "Acceptance: rows name the colour-table entry (live: a bare index)",
   "expect": {
    "ok": true,
    "data.objects.0.color_label": "Pale Steel",
    "data.objects.0.color_hex": {
     "matches": "^#[0-9A-F]{6}$"
    }
   }
  },
  {
   "call": "nx_set_visibility",
   "setup": true,
   "save": "hid",
   "args": {
    "mode": "hide",
    "objects": [
     "$blk.data.bodies.0.id"
    ]
   }
  },
  {
   "call": "nx_set_highlight",
   "args": {
    "objects": [
     "$blk.data.bodies.0.id"
    ]
   },
   "expect": {
    "ok": true,
    "data.count": 1,
    "warnings.0.message": {
     "contains": "hidden"
    }
   }
  },
  {
   "call": "nx_set_highlight",
   "args": {
    "objects": []
   },
   "expect": {
    "ok": true,
    "data.count": 0
   }
  },
  {
   "call": "nx_restore_display",
   "setup": true,
   "args": {
    "restore_id": "$hid.restore_id"
   }
  },
  {
   "call": "nx_capture_view",
   "args": {
    "path": "$run/sized.png",
    "overwrite": true,
    "width": 640,
    "height": 480
   },
   "intent": "Acceptance: a sized viewport capture rendered by Studio says so",
   "expect": {
    "ok": true,
    "data.resolution": [
     640,
     480
    ],
    "data.quality": "studio",
    "warnings": {
     "contains": {
      "code": "NX_NOTE"
     }
    }
   }
  }
 ]
}
