{
 "covers": {
  "nx_set_highlight": []
 },
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {
   "call": "nx_open_part",
   "setup": true,
   "save": "part",
   "args": {
    "path": "$fixture"
   }
  },
  {
   "call": "nx_list_objects",
   "setup": true,
   "save": "bodies",
   "args": {
    "kind": "body"
   }
  },
  {
   "call": "nx_list_objects",
   "setup": true,
   "save": "faces",
   "args": {
    "kind": "face",
    "owner": "$bodies.data.items.0.id",
    "limit": 50
   }
  },
  {
   "call": "nx_set_highlight",
   "args": {
    "objects": [
     "$bodies.data.items.0.id",
     "$faces.data.items.0.id"
    ]
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.count": 2,
    "data.highlighted.0.kind": "body",
    "data.highlighted.1.kind": "face"
   }
  },
  {
   "call": "nx_set_highlight",
   "args": {
    "objects": [
     "$faces.data.items.1.id"
    ]
   },
   "expect": {
    "data.count": 1,
    "data.highlighted.0.kind": "face"
   }
  },
  {
   "call": "nx_set_highlight",
   "args": {
    "objects": []
   },
   "expect": {
    "data.count": 0,
    "data.highlighted": {
     "count": 0
    }
   }
  },
  {
   "call": "nx_set_highlight",
   "args": {
    "objects": [
     "b:1"
    ]
   },
   "expect": {
    "error.category": "stale_reference",
    "mutation_outcome": "not_started"
   }
  }
 ]
}
