{
 "covers": {"nx_set_camera": [], "nx_get_camera": [], "nx_capture_view": [], "nx_restore_display": [], "nx_save_presentation": []},
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {"call": "nx_open_part", "setup": true, "save": "part", "args": {"path": "$fixture"}},
  {"call": "nx_set_camera", "args": {"orientation": "iso", "fit": true},
   "expect": {"mutation_outcome": "committed", "data.view": "isometric", "data.view_angle": 0,
              "data.view_from": {"close": [0.5773502692, -0.5773502692, 0.5773502692], "tol": 1e-9},
              "restore_id": {"matches": "^display_[0-9a-f]{32}$"}}},
  {"call": "nx_set_camera", "args": {"rotation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]], "origin": [0, 0, 0], "scale": 2},
   "expect": {"data.view": "top", "data.scale": {"close": 2, "tol": 1e-9}}},
  {"call": "nx_set_camera", "args": {"zoom": 1.5},
   "expect": {"mutation_outcome": "committed", "data.scale": {"close": 3, "tol": 1e-9},
              "data.origin": {"close": [0, 0, 0], "tol": 1e-9}, "data.view": "top",
              "restore_id": {"matches": "^display_[0-9a-f]{32}$"}}},
  {"call": "nx_restore_display", "args": {},
   "expect": {"mutation_outcome": "committed", "data.restored": {"matches": "^display_[0-9a-f]{32}$"},
              "data.camera.scale": {"close": 2, "tol": 1e-9}, "data.camera.view": "top"}},
  {"call": "nx_restore_display", "args": {"restore_id": "last"},
   "expect": {"mutation_outcome": "committed", "data.camera.view": "isometric", "data.camera.view_angle": 0}},
  {"call": "nx_set_camera", "args": {"orientation": "front", "fit": true, "zoom": 0.5},
   "expect": {"mutation_outcome": "committed", "data.view": "front", "data.view_angle": 0,
              "data.view_from": {"close": [0, -1, 0], "tol": 1e-9}}},
  {"call": "nx_set_camera", "args": {"view_from": [-1, -1, 1], "fit": true},
   "expect": {"data.view": "custom", "data.nearest_view": "front", "data.view_angle": {"close": 54.736, "tol": 0.001},
              "data.view_from": {"close": [-0.5773502692, -0.5773502692, 0.5773502692], "tol": 1e-9}}},
  {"call": "nx_capture_view", "args": {"path": "$run/after_custom.png"},
   "expect": {"mutation_outcome": "not_applicable", "data.marks_part_modified": false,
              "data.camera.view": "custom",
              "data.camera.view_from": {"close": [-0.5773502692, -0.5773502692, 0.5773502692], "tol": 1e-9},
              "data.camera.up.2": {"close": 0.8164965809, "tol": 1e-9}}},
  {"call": "nx_get_camera", "args": {},
   "expect": {"data.view": "custom",
              "data.view_from": {"close": [-0.5773502692, -0.5773502692, 0.5773502692], "tol": 1e-9},
              "data.right": {"close": [0.7071067812, -0.7071067812, 0], "tol": 1e-9}}},
  {"call": "nx_capture_view", "args": {"path": "$run/black.png", "background": "black"},
   "expect": {"mutation_outcome": "not_applicable", "data.path": {"matches": "black[.]png$"}, "data.size": {"close": 50000, "tol": 49900}}},
  {"call": "nx_capture_view", "args": {"path": "$run/rgb.png", "quality": "studio", "width": 320, "height": 240, "color": [255, 128, 0]},
   "expect": {"mutation_outcome": "not_applicable", "data.resolution": [320, 240], "data.image.width": 320}},
  {"call": "nx_capture_view", "args": {"path": "$run/wire_natural.png", "quality": "studio", "style": "wireframe"},
   "expect": {"error.code": "NX_UNSUPPORTED_OPTION", "error.field": "/style", "mutation_outcome": "not_started"}},
  {"call": "nx_capture_view", "args": {"background": "white", "color": [0, 0, 0]},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/color", "mutation_outcome": "not_started"}},
  {"call": "nx_set_camera", "args": {"scale": 2, "zoom": 2},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/zoom", "mutation_outcome": "not_started"}},
  {"call": "nx_set_camera", "args": {"orientation": "top", "view_from": [1, 1, 1]},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/view_from", "mutation_outcome": "not_started"}},
  {"call": "nx_save_presentation", "args": {"path": "$run/natural.json"},
   "expect": {"mutation_outcome": "committed", "data.path": {"matches": "natural[.]json$"}}},
  {"call": "nx_set_camera", "setup": true, "args": {"orientation": "top"}},
  {"call": "nx_restore_display", "args": {"presentation": "$run/natural.json"},
   "expect": {"mutation_outcome": "committed", "data.identical": true, "restore_id": {"matches": "^display_[0-9a-f]{32}$"},
              "data.camera.view": "custom",
              "data.camera.view_from": {"close": [-0.5773502692, -0.5773502692, 0.5773502692], "tol": 1e-9}}},
  {"call": "nx_restore_display", "args": {"restore_id": "last"},
   "expect": {"mutation_outcome": "committed", "data.camera.view": "top", "data.camera.view_angle": 0}}
 ]
}
