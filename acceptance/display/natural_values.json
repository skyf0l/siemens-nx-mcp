{
 "covers": {"nx_create_section_view": [], "nx_edit_section_view": [], "nx_set_appearance": [],
            "nx_get_appearance": [], "nx_set_visibility": [], "nx_restore_display": []},
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {"call": "nx_open_part", "setup": true, "save": "part", "args": {"path": "$fixture"}},
  {"call": "nx_list_objects", "setup": true, "save": "bodies", "args": {"kind": "body"}},
  {"call": "nx_create_section_view", "save": "sec", "args": {"plane": "XZ", "offset": "5 mm", "name": "NATURAL_CUT"},
   "expect": {"mutation_outcome": "committed", "frame": "display_part_absolute",
              "data.origin": {"close": [0, 5, 0], "tol": 1e-9}, "data.normal": {"close": [0, 1, 0], "tol": 1e-12},
              "data.hidden_side": "y > 5", "data.enabled": true, "data.active": true, "data.sectioning": true}},
  {"call": "nx_edit_section_view", "args": {"section": "natural cut", "plane": {"origin": [0, 8, 0]}},
   "expect": {"mutation_outcome": "committed", "data.section.kind": "section_view", "data.section.name": {"matches": "(?i)^natural_cut$"},
              "data.origin": {"close": [0, 8, 0], "tol": 1e-9}, "data.normal": {"close": [0, 1, 0], "tol": 1e-12},
              "data.hidden_side": "y > 8"}},
  {"call": "nx_edit_section_view", "args": {"section": "$sec.data.section.id", "offset": -3},
   "expect": {"mutation_outcome": "committed", "data.origin": {"close": [0, 5, 0], "tol": 1e-9}}},
  {"call": "nx_edit_section_view", "args": {"section": "$sec.data.section.id", "plane": "-yz", "offset": 10},
   "expect": {"mutation_outcome": "committed", "data.origin": {"close": [10, 0, 0], "tol": 1e-9},
              "data.normal": {"close": [-1, 0, 0], "tol": 1e-12}, "data.hidden_side": "x < 10"}},
  {"call": "nx_edit_section_view", "args": {"section": "$sec.data.section.id", "enabled": false},
   "expect": {"mutation_outcome": "committed", "data.enabled": false, "data.sectioning": false}},
  {"call": "nx_edit_section_view", "args": {"section": "no such cut", "cap": false},
   "expect": {"error.code": "NX_NOT_FOUND", "error.field": "/section", "mutation_outcome": "not_started",
              "error.details.sections": {"count": 1}}},
  {"call": "nx_create_section_view", "args": {"plane": "xq"},
   "expect": {"error.category": "invalid_argument", "error.field": "/plane", "mutation_outcome": "not_started"}},
  {"call": "nx_delete_objects", "args": {"objects": ["$sec.data.section.id"]},
   "expect": {"ok": true, "mutation_outcome": "committed"}},
  {"call": "nx_set_appearance", "save": "red", "args": {"objects": ["$bodies.data.items.0.id"], "color": "Red", "transparency": "40%"},
   "expect": {"mutation_outcome": "committed", "data.count": 10, "data.objects.0.object.kind": "body",
              "data.objects.0.color": 186, "data.objects.0.color_name": "red", "data.objects.0.transparency": 40,
              "data.objects.9.transparency": 40}},
  {"call": "nx_get_appearance", "args": {"objects": ["$bodies.data.items.0.id"]},
   "expect": {"mutation_outcome": "not_applicable", "data.objects.0.color_name": "red",
              "data.objects.0.transparency": 40, "data.objects.1.color": 186}},
  {"call": "nx_set_appearance", "save": "grey", "args": {"objects": ["$bodies.data.items.0.id"], "color": "grey"},
   "expect": {"mutation_outcome": "committed", "data.objects.0.color_name": "gray", "data.objects.0.transparency": 40}},
  {"call": "nx_set_appearance", "args": {"objects": ["$bodies.data.items.0.id"], "color": "bleu"},
   "expect": {"error.category": "invalid_argument", "error.field": "/color", "mutation_outcome": "not_started",
              "error.message": {"matches": "did you mean 'blue'"}}},
  {"call": "nx_restore_display", "args": {"restore_id": "$grey.restore_id"},
   "expect": {"mutation_outcome": "committed", "data.objects.0.color": 186}},
  {"call": "nx_restore_display", "args": {"restore_id": "$red.restore_id"},
   "expect": {"mutation_outcome": "committed", "data.objects.0.transparency": 0}},
  {"call": "nx_set_visibility", "save": "hide", "args": {"mode": "hide", "objects": ["$bodies.data.items.0.id"]},
   "expect": {"mutation_outcome": "committed", "data.mode": "hide", "data.count": 1, "data.blanked": 1}},
  {"call": "nx_set_visibility", "args": {"mode": "hide"},
   "expect": {"error.category": "invalid_argument", "error.field": "/objects", "mutation_outcome": "not_started"}},
  {"call": "nx_set_visibility", "save": "showall", "args": {"mode": "show"},
   "expect": {"mutation_outcome": "committed", "data.count": 1, "data.blanked": 0,
              "data.objects.0.object.kind": "body"}},
  {"call": "nx_restore_display", "args": {"restore_id": "$showall.restore_id"},
   "expect": {"mutation_outcome": "committed", "data.objects.0.blanked": true}},
  {"call": "nx_restore_display", "args": {"restore_id": "$hide.restore_id"},
   "expect": {"mutation_outcome": "committed", "data.objects.0.blanked": false}}
 ]
}
