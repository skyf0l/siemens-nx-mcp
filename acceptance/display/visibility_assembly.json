{
 "covers": {
  "nx_set_visibility": [],
  "nx_restore_display": []
 },
 "fixture": null,
 "part": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "comp", "args": {"path": "$run/visasm/visa_comp.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "args": {"shape": "block", "length": 20, "width": 10, "height": 5}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "save": "circ", "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 5}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_spline", "setup": true, "save": "spl", "args": {"points": [[0, 0, 10], [10, 5, 12], [20, 0, 10]]}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "save": "asm", "args": {"path": "$run/visasm/visa_asm.prt", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "c1", "args": {"part": "visa_asm", "path": "$run/visasm/visa_comp.prt", "name": "c1"}},
  {"call": "nx_create_component", "setup": true, "save": "c2", "args": {"part": "visa_asm", "path": "$run/visasm/visa_comp.prt", "name": "c2", "pose": {"translation": [40, 0, 0]}}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "visa_asm"}},

  {"call": "nx_set_visibility", "save": "types", "args": {"part": "visa_asm", "mode": "hide", "types": ["sketch", "curve"], "scope": "assembly"},
   "intent": "Acceptance: the sketch and both curves of each of the two components are hidden as occurrences, in the assembly only",
   "expect": {"mutation_outcome": "committed", "part.file": "visa_asm.prt",
              "data.by_type.sketch": 2, "data.by_type.curve": 4, "data.count": 6, "data.blanked": 6,
              "data.modified_parts": ["visa_asm.prt"], "warnings": {"count": 0},
              "restore_id": {"matches": "^display_"}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "intent": "Acceptance: the component part stays unmodified; the assembly holds the change",
   "expect": {"data.items": {"contains": {"part": {"name": "visa_comp"}, "modified": false}}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"name": "visa_asm"}, "modified": true}}}},
  {"call": "nx_get_appearance", "args": {"objects": ["$circ.data.curves.0.curve.id"]},
   "intent": "Acceptance: the curve itself (in its own part) is still shown",
   "expect": {"data.count": 1, "data.objects.0.blanked": false}},
  {"call": "nx_set_visibility", "save": "types_show", "args": {"part": "visa_asm", "mode": "show", "types": ["curve"], "scope": "assembly"},
   "expect": {"mutation_outcome": "committed", "data.by_type.curve": 4, "data.count": 4, "data.blanked": 0,
              "data.modified_parts": ["visa_asm.prt"]}},
  {"call": "nx_restore_display", "args": {"part": "visa_asm", "restore_id": "$types_show.restore_id"},
   "expect": {"data.identical": true, "data.count": 4, "data.objects.0.blanked": true}},
  {"call": "nx_restore_display", "args": {"part": "visa_asm", "restore_id": "$types.restore_id"},
   "expect": {"data.identical": true, "data.count": 6, "data.objects.0.blanked": false, "data.objects.5.blanked": false}},

  {"call": "nx_set_visibility", "save": "mixed", "args": {"mode": "hide", "objects": ["$c2.data.component.id", "$circ.data.curves.0.curve.id"]},
   "intent": "Acceptance: a component ref makes the assembly the target; the component part's curve is hidden in both components that show it, not in its part",
   "expect": {"mutation_outcome": "committed", "part.file": "visa_asm.prt", "data.count": 3, "data.blanked": 3,
              "data.modified_parts": ["visa_asm.prt"], "warnings": {"count": 0}}},
  {"call": "nx_get_appearance", "args": {"objects": ["$circ.data.curves.0.curve.id"]},
   "expect": {"data.objects.0.blanked": false}},
  {"call": "nx_restore_display", "args": {"part": "visa_asm", "restore_id": "$mixed.restore_id"},
   "expect": {"data.identical": true, "data.count": 3}},

  {"call": "nx_set_visibility", "save": "dat", "args": {"part": "visa_asm", "mode": "hide", "datums": true, "scope": "assembly"},
   "intent": "Acceptance: datums of the assembly and of both components (occurrences) hide in the assembly; the component part stays unmodified",
   "expect": {"mutation_outcome": "committed", "data.by_type.datum": 36, "data.count": 36, "data.blanked": 36, "warnings": {"count": 0},
              "data.objects.0.blanked": true, "data.modified_parts": ["visa_asm.prt"]}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"name": "visa_comp"}, "modified": false}}}},
  {"call": "nx_restore_display", "args": {"part": "visa_asm", "restore_id": "$dat.restore_id"},
   "expect": {"data.identical": true}},

  {"call": "nx_set_visibility", "save": "own", "args": {"mode": "hide", "objects": ["$spl.data.curve.id"]},
   "intent": "Acceptance: a ref of the component part alone changes that part itself: it is named in modified_parts and a note says the assembly using it is not where it changed",
   "expect": {"mutation_outcome": "committed", "part.file": "visa_comp.prt", "data.count": 1, "data.blanked": 1,
              "data.modified_parts": ["visa_comp.prt"], "warnings": {"contains": {"code": "NX_NOTE"}}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"name": "visa_comp"}, "modified": true}}}},
  {"call": "nx_restore_display", "args": {"part": "visa_comp", "restore_id": "$own.restore_id"},
   "expect": {"data.identical": true, "data.objects.0.blanked": false}},

  {"call": "nx_set_visibility", "args": {"part": "visa_asm", "mode": "isolate", "types": ["curve"]},
   "expect": {"error.category": "invalid_argument", "error.field": "/mode", "mutation_outcome": "not_started"}},
  {"call": "nx_set_visibility", "args": {"part": "visa_asm", "mode": "hide", "objects": ["$c1.data.component.id"], "scope": "assembly"},
   "expect": {"error.category": "invalid_argument", "error.field": "/scope", "mutation_outcome": "not_started"}}
 ]
}
