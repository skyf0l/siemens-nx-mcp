{
 "covers": {
  "nx_edit_face_region": [
   "offset",
   "pull"
  ]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "a",
   "args": {
    "shape": "block",
    "origin": [
     0,
     0,
     0
    ],
    "length": 20,
    "width": 20,
    "height": 10
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top",
   "args": {
    "owner": "$a.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "order": "nearest",
    "near": [
     10,
     10,
     10
    ],
    "limit": 1,
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "xp",
   "args": {
    "owner": "$a.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "order": "nearest",
    "near": [
     20,
     10,
     5
    ],
    "limit": 1,
    "normal": [
     1,
     0,
     0
    ]
   }
  },
  {
   "call": "nx_edit_face_region",
   "args": {
    "faces": [
     "$top.data.items.0.id"
    ],
    "action": "offset",
    "distance": 2
   },
   "expect": {
    "data.volume": {
     "close": 4800.0,
     "tol": 1e-06
    },
    "data.offsets": {
     "close": [
      2.0
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_edit_face_region",
   "args": {
    "faces": [
     "$top.data.items.0.id"
    ],
    "action": "offset",
    "distance": -4
   },
   "expect": {
    "data.volume": {
     "close": 3200.0,
     "tol": 1e-06
    },
    "data.offsets": {
     "close": [
      -4.0
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_edit_face_region",
   "args": {
    "faces": [
     "$xp.data.items.0.id"
    ],
    "action": "pull",
    "distance": 5,
    "direction": "x"
   },
   "expect": {
    "data.volume": {
     "close": 4000.0,
     "tol": 1e-06
    },
    "data.offsets": {
     "close": [
      5.0
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_measure_bounds",
   "args": {
    "bodies": [
     "$a.data.bodies.0.id"
    ],
    "precision": "exact"
   },
   "expect": {
    "data.max": {
     "close": [
      25,
      20,
      8
     ],
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_check_model",
   "args": {},
   "expect": {
    "data.healthy": {
     "equals": true
    }
   }
  },
  {
   "call": "nx_edit_face_region",
   "args": {
    "faces": [
     "$xp.data.items.0.id"
    ],
    "action": "offset",
    "distance": 1,
    "direction": "x"
   },
   "expect": {
    "error.field": "/direction",
    "mutation_outcome": "not_started"
   }
  }
 ]
}
