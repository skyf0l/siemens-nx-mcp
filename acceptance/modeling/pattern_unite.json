{
  "covers": {"nx_create_pattern": ["linear", "circular"], "nx_create_mirror": ["features"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s1",
     "args": {"placement": {"principal": "xy"},
              "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [10, 10]}], "finish": true}},
    {"call": "nx_create_extrude", "setup": true, "save": "a",
     "args": {"sketch": "$s1.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_pattern", "save": "pu",
     "intent": "18 overlapping copies of a separate-body seed united into the seed body",
     "args": {"features": ["$a.data.feature.id"], "layout": "linear", "unite": true,
              "parameters": {"direction": [1, 0, 0], "count": 18, "spacing": 8}},
     "expect": {"mutation_outcome": "committed", "data.count": 18, "data.new_bodies": 0, "data.united": 17,
                "data.bodies": {"count": 1},
                "data.volume": {"close": 14600, "tol": 1e-6}, "data.unite_feature.kind": "feature"}},
    {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"page.total": 1}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$a.data.bodies.0.id"], "precision": "exact"},
     "expect": {"data.min": {"close": [0, 0, 0], "tol": 1e-4}, "data.max": {"close": [146, 10, 10], "tol": 1e-4}}},
    {"call": "nx_create_sketch", "setup": true, "save": "s2",
     "args": {"placement": {"principal": "xy"},
              "curves": [{"type": "rectangle", "corner1": [20, 30], "corner2": [40, 40]}], "finish": true}},
    {"call": "nx_create_extrude", "setup": true, "save": "b",
     "args": {"sketch": "$s2.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_pattern", "save": "cu",
     "intent": "Circular copies that do not touch the seed cannot unite: the call rolls back",
     "args": {"features": ["$b.data.feature.id"], "layout": "circular", "unite": true,
              "parameters": {"axis": {"principal": "z"}, "count": 4, "angle": 90}},
     "expect": {"error.code": "NX_BUILD_FAILED", "error.details.bodies": 4, "mutation_outcome": "rolled_back"}},
    {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"page.total": 2}},
    {"call": "nx_create_mirror", "save": "mu",
     "intent": "Feature mirror of a separate-body seed about its own face plane, united: one body",
     "args": {"target": "features", "features": ["$b.data.feature.id"], "unite": true,
              "plane": {"origin": [20, 0, 0], "normal": [1, 0, 0]}},
     "expect": {"mutation_outcome": "committed", "data.new_bodies": 0, "data.united": 1,
                "data.bodies": {"count": 1}, "data.volume": {"close": 4000, "tol": 1e-6}}},
    {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"page.total": 2}},
    {"call": "nx_create_pattern",
     "args": {"features": ["$a.data.feature.id", "$b.data.feature.id"], "layout": "linear", "unite": true,
              "parameters": {"direction": [0, 1, 0], "count": 2, "spacing": 50}},
     "expect": {"error.field": "/unite", "mutation_outcome": "not_started"}},
    {"call": "nx_check_model", "expect": {"data.healthy": true}}
  ]
}
