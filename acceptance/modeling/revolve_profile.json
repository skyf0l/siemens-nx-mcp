{
  "covers": {"nx_create_revolve": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "cone",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "line", "start": [10, 0], "end": [20, 10]}]}},
    {"call": "nx_create_revolve", "save": "skin",
     "intent": "An open profile with sheet true builds a surface: a cone frustum of area pi (10 + 20) sqrt(200)",
     "args": {"sketch": "$cone.data.sketch.id", "axis": "y", "sheet": true},
     "expect": {"mutation_outcome": "committed", "data.sheet": true, "data.volume": {"close": 0, "tol": 1e-9},
                "data.area": {"close": 1332.8648814475, "tol": 1e-2}, "warnings": {"count": 0}}},
    {"call": "nx_create_revolve", "save": "capped",
     "intent": "The same open profile without sheet: NX closes it into a solid and the result says so",
     "args": {"sketch": "$cone.data.sketch.id", "axis": "y"},
     "expect": {"mutation_outcome": "committed", "data.sheet": false,
                "warnings": {"contains": {"code": "NX_NOTE"}}}},
    {"call": "nx_create_sketch", "setup": true, "save": "ring",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [10, 0], "corner2": [20, 10]},
                         {"type": "line", "start": [30, 0], "end": [30, 10]}]}},
    {"call": "nx_create_revolve", "save": "mixed",
     "intent": "A closed loop next to an open line: the call warns that the open chain became a body of its own",
     "args": {"sketch": "$ring.data.sketch.id", "axis": "y"},
     "expect": {"mutation_outcome": "committed", "data.sheet": false,
                "warnings.0.code": "NX_UPDATE_WARNING", "warnings.0.message": {"matches": "1 open chain"}}},
    {"call": "nx_create_sketch", "setup": true, "save": "gap",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "line", "start": [10, 0], "end": [20, 0]},
                         {"type": "line", "start": [20, 0], "end": [20, 10]},
                         {"type": "line", "start": [20, 10], "end": [10, 10]},
                         {"type": "line", "start": [10, 10], "end": [10.0007, 0]}]}},
    {"call": "nx_create_revolve",
     "intent": "Curve ends 0.0007 mm apart: refused before NX with the gap and its size",
     "args": {"sketch": "$gap.data.sketch.id", "axis": "y"},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/sketch", "mutation_outcome": "not_started",
                "error.details.gaps.0.gap": {"close": 0.0007, "tol": 1e-6}}},
    {"call": "nx_create_sketch", "setup": true, "save": "cross",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [10, 0], "corner2": [20, 10]},
                         {"type": "line", "start": [5, 5], "end": [25, 5]}]}},
    {"call": "nx_create_revolve",
     "intent": "A line across the closed loop: refused before NX with both crossing points",
     "args": {"sketch": "$cross.data.sketch.id", "axis": "y"},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/sketch", "mutation_outcome": "not_started",
                "error.message": {"matches": "cross each other"}, "error.details.crossings": {"count": 2}}}
  ]
}
