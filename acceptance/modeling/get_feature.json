{
 "covers": {
  "nx_get_feature": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "blk_sk",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$blk_sk.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       40,
       20
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$blk_sk.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "save": "blk",
   "args": {
    "sketch": "$blk_sk.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 10
    }
   },
   "setup": true
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "bs",
   "args": {
    "placement": {
     "principal": "xy",
     "origin": [
      0,
      0,
      10
     ]
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$bs.data.sketch.id",
    "curves": [
     {
      "type": "circle",
      "center": [
       20,
       10
      ],
      "radius": 5
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$bs.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "setup": true,
   "save": "boss",
   "args": {
    "sketch": "$bs.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 5
    },
    "combine": {
     "operation": "unite",
     "targets": [
      "$blk.data.bodies.0.id"
     ]
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "rim",
   "args": {
    "owner": "$blk.data.bodies.0.id",
    "kind": "edge",
    "geometry_type": "circle",
    "order": "highest",
    "axis": "Z",
    "limit": 1
   }
  },
  {
   "call": "nx_create_blend",
   "setup": true,
   "save": "fil",
   "args": {
    "edges": [
     "$rim.items.0.object.id"
    ],
    "radius": 1
   }
  },
  {
   "call": "nx_get_feature",
   "save": "gb",
   "args": {
    "feature": "$boss.data.feature.id"
   },
   "expect": {
    "data.type": "EXTRUDE",
    "data.active": true,
    "data.suppressed": false,
    "data.parameters": {
     "count": 2
    },
    "data.parameters.1.description": {
     "matches": "End Limit"
    },
    "data.parameters.1.value": {
     "close": 5,
     "tol": 1e-12
    },
    "data.parameters.1.units": "mm",
    "data.parameters.1.editable": true,
    "data.parents": {
     "contains": {
      "name": "EXTRUDE(2)"
     }
    },
    "data.children": {
     "contains": {
      "name": "BLEND(5)"
     }
    }
   }
  },
  {
   "call": "nx_get_feature",
   "args": {
    "feature": "$blk.data.feature.id"
   },
   "expect": {
    "data.children": {
     "contains": {
      "name": "EXTRUDE(4)"
     }
    },
    "data.timestamp": 2,
    "mutation_outcome": "not_applicable"
   }
  },
  {
   "call": "nx_get_feature",
   "args": {
    "feature": "$blk.data.bodies.0.id"
   },
   "expect": {
    "error.code": "NX_WRONG_KIND"
   }
  }
 ]
}
