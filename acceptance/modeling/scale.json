{
 "covers": {
  "nx_create_scale": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "a_sk",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$a_sk.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       10,
       10
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$a_sk.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "save": "a",
   "args": {
    "sketch": "$a_sk.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 10
    }
   },
   "setup": true
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "b_sk",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$b_sk.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       100,
       0
      ],
      "corner2": [
       110,
       10
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$b_sk.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "save": "b",
   "args": {
    "sketch": "$b_sk.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 10
    }
   },
   "setup": true
  },
  {
   "call": "nx_create_scale",
   "args": {
    "bodies": [
     "$a.data.bodies.0.id"
    ],
    "factor": 2
   },
   "expect": {
    "data.volume": {
     "close": 8000,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_get_bounding_box",
   "args": {
    "body": "$a.data.bodies.0.id",
    "precision": "exact"
   },
   "expect": {
    "min": {
     "close": [
      0,
      0,
      0
     ],
     "tol": 0.0001
    },
    "max": {
     "close": [
      20,
      20,
      20
     ],
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_create_scale",
   "args": {
    "bodies": [
     "$b.data.bodies.0.id"
    ],
    "factor": 0.5,
    "origin": [
     110,
     10,
     10
    ]
   },
   "expect": {
    "data.volume": {
     "close": 125,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_get_bounding_box",
   "args": {
    "body": "$b.data.bodies.0.id",
    "precision": "exact"
   },
   "expect": {
    "min": {
     "close": [
      105,
      5,
      5
     ],
     "tol": 0.0001
    },
    "max": {
     "close": [
      110,
      10,
      10
     ],
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_create_scale",
   "args": {
    "bodies": [
     "$a.data.bodies.0.id"
    ],
    "factor": 1
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/factor"
   }
  },
  {
   "call": "nx_create_scale",
   "args": {
    "bodies": [
     "$a.data.bodies.0.id"
    ],
    "factor": -2
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_model_health",
   "args": {},
   "expect": {
    "healthy": true
   }
  }
 ]
}
