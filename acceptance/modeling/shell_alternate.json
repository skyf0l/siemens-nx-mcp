{
 "covers": {"nx_create_shell": []},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "a", "args": {"length": 40, "width": 20, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "a_top",
   "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "a_end",
   "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [1, 0, 0], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "a_back",
   "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 1, 0], "limit": 1}},
  {"call": "nx_create_shell",
   "args": {"body": "$a.data.bodies.0.id", "thickness": 2, "remove_faces": ["$a_top.data.items.0.id"],
            "alternate": [{"faces": ["$a_end.data.items.0.id"], "thickness": 4},
                          {"faces": ["$a_back.data.items.0.id"], "thickness": "3 mm"}]},
   "expect": {"data.volume": {"close": 3920, "tol": 1e-06}}},
  {"call": "nx_create_primitive", "setup": true, "save": "b", "args": {"origin": [100, 0, 0], "length": 40, "width": 20, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "b_top",
   "args": {"owner": "$b.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "b_end",
   "args": {"owner": "$b.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [1, 0, 0], "limit": 1}},
  {"call": "nx_create_shell",
   "args": {"body": "$b.data.bodies.0.id", "thickness": 2, "remove_faces": ["$b_top.data.items.0.id"], "outward": true,
            "alternate": [{"faces": ["$b_end.data.items.0.id"], "thickness": 3}]},
   "expect": {"data.volume": {"close": 4960, "tol": 1e-06}}},
  {"call": "nx_measure_bounds", "args": {"bodies": ["$b.data.bodies.0.id"], "precision": "exact"},
   "expect": {"data.min": {"close": [98, -2, -2], "tol": 0.0001}, "data.max": {"close": [143, 22, 10], "tol": 0.0001}}},
  {"call": "nx_create_shell",
   "args": {"body": "$a.data.bodies.0.id", "thickness": 2, "alternate": [{"faces": ["$b_end.data.items.0.id"], "thickness": 3}]},
   "expect": {"error.code": "NX_WRONG_OWNER", "mutation_outcome": "not_started"}}
 ]
}
