    "first_offset": 1,
    "second_offset": -1
   },
   "expect": {
    "data.volume": {
     "close": 6000,
     "tol": 0.01
    }
   }
  },
  {
   "call": "nx_create_sweep_along_guide",
   "save": "lw",
   "args": {
    "section": "$s.data.sketch.id",
    "guide": "$l.data.sketch.id"
   },
   "expect": {
    "data.volume": {
     "close": 8500,
