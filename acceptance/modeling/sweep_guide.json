   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "blk",
   "args": {
    "shape": "block",
    "origin": [
     40,
     -5,
     -5
    ],
    "length": 20,
    "width": 20,
    "height": 20
   }
  },
  {
   "call": "nx_create_sweep_along_guide",
   "args": {
    "section": "$s.data.sketch.id",
    "guide": "$g.data.sketch.id",
    "combine": {
