{
 "covers": {"nx_create_offset_emboss": [], "nx_create_rib": ["perpendicular"], "nx_create_loft": [],
            "nx_create_unsew": ["faces"], "nx_create_untrim": [], "nx_edit_edges": ["offset"],
            "nx_edit_face_relation": ["tangent"], "nx_create_shell": []},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},

  {"call": "nx_create_sketch", "setup": true, "save": "shline",
   "args": {"placement": "xz", "curves": [{"type": "line", "start": [0, 0], "end": [100, 0]}], "finish": true}},
  {"call": "nx_create_extrude", "setup": true, "save": "sh", "args": {"sketch": "$shline.data.sketch.id", "end": 60, "direction": "y"}},
  {"call": "nx_create_sketch", "setup": true, "save": "p",
   "args": {"placement": "xy", "curves": [{"type": "line", "start": [20, 30], "end": [80, 30]}], "finish": true}},
  {"call": "nx_create_offset_emboss", "save": "bead",
   "args": {"sheet": "$sh.data.bodies.0.id", "path": ["$p.data.curves.0.id"], "height": 3, "left_width": 5, "side_offset": 2},
   "expect": {"data.area": {"close": 6211.9328, "tol": 0.05}}},
  {"call": "nx_create_offset_emboss", "intent": "Acceptance: a second emboss on the embossed path names the first",
   "args": {"sheet": "$sh.data.bodies.0.id", "path": ["$p.data.curves.0.id"], "height": 3, "left_width": 5},
   "expect": {"error.field": "/path/0", "error.message": {"contains": "already carries an emboss"},
              "mutation_outcome": "not_started"}},

  {"call": "nx_create_primitive", "setup": true, "save": "plate", "args": {"origin": [0, 200, 0], "length": 40, "width": 20, "height": 3}},
  {"call": "nx_create_sketch", "setup": true, "save": "ontop",
   "args": {"placement": {"principal": "xy", "origin": [0, 0, 3]}, "curves": [{"type": "line", "start": [5, 210], "end": [35, 210]}], "finish": true}},
  {"call": "nx_create_rib", "intent": "Acceptance: a rib sketched on a flat plate's top says a plate gives it no walls",
   "args": {"sketch": "$ontop.data.sketch.id", "body": "$plate.data.bodies.0.id", "thickness": 2},
   "expect": {"error.code": "NX_BUILD_FAILED", "error.details.cause": "on_material", "error.hint": {"contains": "flat plate"},
              "mutation_outcome": "rolled_back"}},
  {"call": "nx_create_rib", "intent": "Acceptance: flipped, the same rib gets the same cause (no flip loop)",
   "args": {"sketch": "$ontop.data.sketch.id", "body": "$plate.data.bodies.0.id", "thickness": 2, "flip": true},
   "expect": {"error.details.cause": "on_material", "mutation_outcome": "rolled_back"}},
  {"call": "nx_create_sketch", "setup": true, "save": "above",
   "args": {"placement": {"principal": "xy", "origin": [0, 0, 13]}, "curves": [{"type": "line", "start": [5, 210], "end": [35, 210]}], "finish": true}},
  {"call": "nx_create_rib", "intent": "Acceptance: a sketch above the plate is named off the body whatever flip says",
   "args": {"sketch": "$above.data.sketch.id", "body": "$plate.data.bodies.0.id", "thickness": 2},
   "expect": {"error.details.cause": "plane_off_body", "error.message": {"contains": "lies 10 from the body"},
              "mutation_outcome": "rolled_back"}},

  {"call": "nx_create_sketch", "setup": true, "save": "l0",
   "args": {"placement": {"principal": "xy", "origin": [0, 400, 0]}, "curves": [{"type": "rectangle", "corner1": [-10, -10], "corner2": [10, 10]}], "finish": true}},
  {"call": "nx_create_sketch", "setup": true, "save": "l1",
   "args": {"placement": {"principal": "xy", "origin": [0, 400, 40]}, "curves": [{"type": "rectangle", "corner1": [-10, -10], "corner2": [10, 10]}], "finish": true}},
  {"call": "nx_create_loft", "intent": "Acceptance: start corners half a turn apart are named as the twist NX cannot surface",
   "args": {"sections": ["$l0.data.sketch.id", "$l1.data.sketch.id"], "start_points": [[10, 410, 0], [-10, 390, 40]]},
   "expect": {"error.code": "NX_BUILD_FAILED", "error.field": "/start_points/1", "error.details.twist_degrees": {"close": 180, "tol": 0.001},
              "error.hint": {"contains": "twists the loft"}}},
  {"call": "nx_create_loft", "save": "lo",
   "args": {"sections": ["$l0.data.sketch.id", "$l1.data.sketch.id"]},
   "expect": {"data.volume": {"close": 16000, "tol": 0.01}, "warnings": {"count": 0}}},
  {"call": "nx_create_loft", "intent": "Acceptance: the same loft again warns that it stacked a duplicate",
   "args": {"sections": ["$l0.data.sketch.id", "$l1.data.sketch.id"]},
   "expect": {"data.volume": {"close": 16000, "tol": 0.01}, "warnings.0.message": {"matches": "coincides with .*loft duplicated"}}},

  {"call": "nx_create_primitive", "setup": true, "save": "u", "args": {"origin": [0, 600, 0], "length": 40, "width": 30, "height": 20}},
  {"call": "nx_find_geometry", "setup": true, "save": "utop", "args": {"owner": "$u.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "order": "nearest", "near": [20, 615, 20], "limit": 1, "normal": [0, 0, 1]}},
  {"call": "nx_create_unsew", "intent": "Acceptance: keeping the original, the sheet with the given face is still marked",
   "args": {"faces": ["$utop.data.items.0.id"], "keep_original": true},
   "expect": {"data.kept_original": true, "data.count": 2, "data.sheets": {"contains": {"faces": 1, "selected": true}}}},
  {"call": "nx_create_untrim", "intent": "Acceptance: hide_original hides the source body",
   "args": {"faces": ["$utop.data.items.0.id"], "hide_original": true},
   "expect": {"data.area": {"close": 4800, "tol": 0.01}, "data.hidden": {"count": 1}, "data.hidden.0.id": "$u.data.bodies.0.id"}},

  {"call": "nx_create_primitive", "setup": true, "save": "c", "args": {"origin": [100, 600, 0], "length": 20, "width": 20, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "ce", "args": {"owner": "$c.data.bodies.0.id", "kind": "edge", "order": "nearest", "near": [110, 620, 10], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "ctop", "args": {"owner": "$c.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "order": "nearest", "near": [110, 610, 10], "limit": 1, "normal": [0, 0, 1]}},
  {"call": "nx_edit_edges", "intent": "Acceptance: moved is signed: an offset that shrinks the face reads negative",
   "args": {"edges": ["$ce.data.items.0.id"], "action": "offset", "distance": -3, "along": "$ctop.data.items.0.id"},
   "expect": {"data.moved": {"close": [-3.0], "tol": 1e-06}, "data.volume_change": {"close": -300, "tol": 0.001}}},

  {"call": "nx_create_primitive", "setup": true, "save": "a", "args": {"origin": [0, 800, 0], "length": 40, "width": 30, "height": 20}},
  {"call": "nx_create_primitive", "setup": true, "args": {"shape": "cylinder", "origin": [20, 820, 20], "diameter": 20, "height": 8, "combine": {"operation": "unite", "targets": ["$a.data.bodies.0.id"]}}},
  {"call": "nx_find_geometry", "setup": true, "save": "side", "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "order": "nearest", "near": [20, 800, 10], "limit": 1, "normal": [0, -1, 0]}},
  {"call": "nx_find_geometry", "setup": true, "save": "boss", "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "cylinder", "order": "nearest", "near": [20, 820, 24], "limit": 1}},
  {"call": "nx_edit_face_relation", "intent": "Acceptance: a side face made tangent to a boss of its own body",
   "args": {"face": "$side.data.items.0.id", "relation": "tangent", "to": "$boss.data.items.0.id"},
   "expect": {"data.angle": {"close": 90, "tol": 0.001}, "data.gap": {"close": 0, "tol": 1e-05},
              "data.volume_change": {"close": -8000, "tol": 0.001}}},
  {"call": "nx_edit_face_relation", "intent": "Acceptance: the same relation again is refused as already met",
   "args": {"face": "$side.data.items.0.id", "relation": "tangent", "to": "$boss.data.items.0.id"},
   "expect": {"error.message": {"contains": "already tangent"}, "mutation_outcome": "not_started"}},

  {"call": "nx_create_primitive", "setup": true, "save": "box", "args": {"origin": [0, 1000, 0], "length": 40, "width": 30, "height": 20}},
  {"call": "nx_create_shell", "setup": true, "args": {"body": "$box.data.bodies.0.id", "thickness": 2}},
  {"call": "nx_create_shell", "intent": "Acceptance: shelling a shelled body names the shell, not the thickness",
   "args": {"body": "$box.data.bodies.0.id", "thickness": 1},
   "expect": {"error.code": "NX_BUILD_FAILED", "error.hint": {"contains": "shelled already"}, "mutation_outcome": "rolled_back"}}
 ]
}
