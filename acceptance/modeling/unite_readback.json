{
  "covers": {"nx_create_boolean": ["unite"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "a_sk",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [10, 10]}]}},
    {"call": "nx_create_extrude", "setup": true, "save": "a", "args": {"sketch": "$a_sk.data.sketch.id", "end": 10}},
    {"call": "nx_create_sketch", "setup": true, "save": "b_sk",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [5, 0], "corner2": [15, 10]}]}},
    {"call": "nx_create_extrude", "setup": true, "save": "b", "args": {"sketch": "$b_sk.data.sketch.id", "end": 10}},
    {"call": "nx_create_sketch", "setup": true, "save": "c_sk",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [0, 5], "corner2": [10, 15]}]}},
    {"call": "nx_create_extrude", "setup": true, "save": "c", "args": {"sketch": "$c_sk.data.sketch.id", "end": 10}},
    {"call": "nx_create_sketch", "setup": true, "save": "d_sk",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [2, 2], "corner2": [4, 4]}]}},
    {"call": "nx_create_extrude", "setup": true, "save": "d",
     "args": {"sketch": "$d_sk.data.sketch.id", "start": 2, "end": 4}},
    {"call": "nx_create_sketch", "setup": true, "save": "e_sk",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [-10, 0], "corner2": [0, 10]}]}},
    {"call": "nx_create_extrude", "setup": true, "save": "e", "args": {"sketch": "$e_sk.data.sketch.id", "end": 10}},
    {"call": "nx_create_boolean", "save": "u",
     "intent": "Unite four tools in one call: two overlapping, one buried inside the target (adds nothing and is not reported as dropped), one touching face to face",
     "args": {"operation": "unite", "target": "$a.data.bodies.0.id",
              "tools": ["$b.data.bodies.0.id", "$c.data.bodies.0.id", "$d.data.bodies.0.id", "$e.data.bodies.0.id"]},
     "expect": {"mutation_outcome": "committed", "data.volume": {"close": 3000, "tol": 1e-3},
                "data.bodies": {"count": 1}, "data.deleted_bodies": 4, "warnings": {"count": 0}}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$u.data.bodies.0.id"], "precision": "exact"},
     "expect": {"data.min": {"close": [-10, 0, 0], "tol": 1e-4}, "data.max": {"close": [15, 15, 10], "tol": 1e-4}}},
    {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
  ]
}
