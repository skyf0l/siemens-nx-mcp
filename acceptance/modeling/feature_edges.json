{
 "covers": {
  "nx_get_feature": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "blk",
   "args": {
    "shape": "block",
    "length": 20,
    "width": 20,
    "height": 20,
    "origin": [
     0,
     0,
     0
    ]
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e1",
   "args": {
    "owner": "$blk.data.bodies.0.id",
    "kind": "edge",
    "geometry_type": "line",
    "limit": 1,
    "order": "nearest",
    "near": [
     20,
     10,
     20
    ]
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e2",
   "args": {
    "owner": "$blk.data.bodies.0.id",
    "kind": "edge",
    "geometry_type": "line",
    "limit": 1,
    "order": "nearest",
    "near": [
     10,
     20,
     20
    ]
   }
  },
  {
   "call": "nx_create_blend",
   "setup": true,
   "save": "bl",
   "args": {
    "edges": [
     "$e1.data.items.0.id",
     "$e2.data.items.0.id"
    ],
    "radius": 2
   }
  },
  {
   "call": "nx_get_feature",
   "args": {
    "feature": "$bl.data.feature.id"
   },
   "expect": {
    "data.edge_count": 2,
    "data.edges": {
     "count_kind": {
      "edge": 2
     }
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e3",
   "args": {
    "owner": "$blk.data.bodies.0.id",
    "kind": "edge",
    "geometry_type": "line",
    "limit": 1,
    "order": "nearest",
    "near": [
     0,
     10,
     0
    ]
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e4",
   "args": {
    "owner": "$blk.data.bodies.0.id",
    "kind": "edge",
    "geometry_type": "line",
    "limit": 1,
    "order": "nearest",
    "near": [
     10,
     0,
     0
    ]
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e5",
   "args": {
    "owner": "$blk.data.bodies.0.id",
    "kind": "edge",
    "geometry_type": "line",
    "limit": 1,
    "order": "nearest",
    "near": [
     0,
     0,
     10
    ]
   }
  },
  {
   "call": "nx_create_chamfer",
   "setup": true,
   "save": "ch",
   "args": {
    "edges": [
     "$e3.data.items.0.id",
     "$e4.data.items.0.id",
     "$e5.data.items.0.id"
    ],
    "offset": 1
   }
  },
  {
   "call": "nx_get_feature",
   "args": {
    "feature": "$ch.data.feature.id"
   },
   "expect": {
    "data.edge_count": 3,
    "data.type": "CHAMFER"
   }
  },
  {
   "call": "nx_get_feature",
   "args": {
    "feature": "$blk.data.feature.id"
   },
   "expect": {
    "data.type": "BLOCK"
   }
  },
  {
   "call": "nx_measure_mass",
   "args": {
    "bodies": [
     "$blk.data.bodies.0.id"
    ]
   },
   "expect": {
    "data.volume": {
     "close": 7935.663706143591,
     "tol": 2.0
    }
   }
  }
 ]
}
