{
 "covers": {
  "nx_create_primitive": ["block", "cylinder", "cone", "sphere"]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_set_expression", "setup": true, "args": {"name": "thickness", "formula": "10", "units": "mm"}},
  {"call": "nx_create_primitive", "save": "plate",
   "args": {"length": 40, "width": 20, "height": "thickness", "origin": [5, 0, 0]},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 8000, "tol": 1e-06},
              "data.bodies": {"count": 1}, "data.feature.name": {"matches": "^BLOCK"},
              "changes.created": {"count_kind": {"feature": 1, "body": 1}}}},
  {"call": "nx_measure_bounds", "args": {"bodies": ["$plate.data.bodies.0.id"], "precision": "exact"},
   "expect": {"data.min": {"close": [5, 0, 0], "tol": 0.0001}, "data.max": {"close": [45, 20, 10], "tol": 0.0001}}},
  {"call": "nx_set_expression", "args": {"name": "thickness", "formula": "15"},
   "intent": "Acceptance: the block height follows the expression it was given"},
  {"call": "nx_measure_mass", "args": {"bodies": ["$plate.data.bodies.0.id"]},
   "expect": {"data.volume": {"close": 12000, "tol": 1e-06}, "data.center_of_gravity": {"close": [25, 10, 7.5], "tol": 1e-06}}},
  {"call": "nx_create_primitive", "save": "box",
   "args": {"length": 40, "width": 20, "height": 10, "centered": true, "origin": [0, 0, 100],
            "direction": [0, 1, 1], "x_direction": [1, 0, 0]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$box.data.bodies.0.id"]},
   "expect": {"data.center_of_gravity": {"close": [0, 0, 100], "tol": 1e-06}}},
  {"call": "nx_create_primitive", "save": "box2",
   "intent": "Acceptance: shape box (or cuboid) is the block",
   "args": {"shape": "box", "length": 10, "width": 20, "height": 5, "origin": [200, 0, 0]},
   "expect": {"data.volume": {"close": 1000, "tol": 1e-06}, "data.feature.name": {"matches": "^BLOCK"}}},
  {"call": "nx_measure_bounds", "args": {"bodies": ["$box2.data.bodies.0.id"], "precision": "exact"},
   "expect": {"data.min": {"close": [200, 0, 0], "tol": 0.0001}, "data.max": {"close": [210, 20, 5], "tol": 0.0001}}},
  {"call": "nx_create_primitive", "save": "rod",
   "args": {"shape": "cylinder", "diameter": 10, "height": 30, "origin": [0, 50, 0], "direction": "x"},
   "expect": {"data.volume": {"close": 2356.194490192345, "tol": 0.001}, "data.feature.name": {"matches": "^CYLINDER"}}},
  {"call": "nx_measure_bounds", "args": {"bodies": ["$rod.data.bodies.0.id"], "precision": "exact"},
   "expect": {"data.min": {"close": [0, 45, -5], "tol": 0.0001}, "data.max": {"close": [30, 55, 5], "tol": 0.0001}}},
  {"call": "nx_create_primitive", "save": "frustum",
   "args": {"shape": "cone", "diameter": 20, "top_diameter": 10, "height": 12, "origin": [0, -50, 0]},
   "expect": {"data.volume": {"close": 2199.114857512855, "tol": 0.001}, "data.feature.name": {"matches": "^CONE"}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$frustum.data.bodies.0.id"]},
   "expect": {"data.center_of_gravity": {"close": [0, -50, 4.714285714285714], "tol": 0.0001}}},
  {"call": "nx_create_primitive",
   "args": {"shape": "cone", "diameter": 20, "height": 12, "origin": [50, -50, 0]},
   "expect": {"data.volume": {"close": 1256.6370614359173, "tol": 0.001}}},
  {"call": "nx_create_primitive", "save": "ball",
   "args": {"shape": "sphere", "diameter": 12, "origin": [100, 0, 0]},
   "expect": {"data.volume": {"close": 904.7786842338604, "tol": 0.001}, "data.feature.name": {"matches": "^SPHERE"}}},
  {"call": "nx_measure_bounds", "args": {"bodies": ["$ball.data.bodies.0.id"], "precision": "exact"},
   "expect": {"data.min": {"close": [94, -6, -6], "tol": 0.0001}, "data.max": {"close": [106, 6, 6], "tol": 0.0001}}},
  {"call": "nx_create_primitive",
   "args": {"shape": "cylinder", "diameter": 6, "height": 50, "origin": [25, 10, 5], "centered": true,
            "combine": {"operation": "subtract", "targets": ["$plate.data.bodies.0.id"]}},
   "intent": "Acceptance: a cylinder through the plate subtracts a 6 mm hole 15 mm deep",
   "expect": {"data.volume": {"close": 11575.88499, "tol": 0.001}, "data.bodies": {"count": 1},
              "data.bodies.0.name": "BLOCK(1)"}},
  {"call": "nx_create_primitive",
   "args": {"shape": "sphere", "diameter": 4, "origin": [500, 0, 0],
            "combine": {"operation": "unite", "targets": ["$plate.data.bodies.0.id"]}},
   "intent": "Acceptance: a unite that misses its target is refused and rolled back",
   "expect": {"error.code": "NX_BUILD_FAILED", "mutation_outcome": "rolled_back"}},
  {"call": "nx_create_primitive", "args": {"shape": "sphere", "diameter": 4, "width": 3},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/width", "mutation_outcome": "not_started"}},
  {"call": "nx_create_primitive", "args": {"length": 10, "width": 10},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/height", "mutation_outcome": "not_started"}}
 ]
}
