{
 "covers": {
  "nx_create_mirror": [
   "bodies",
   "features"
  ]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "a",
   "args": {
    "shape": "block",
    "origin": [
     0,
     0,
     0
    ],
    "length": 40,
    "width": 20,
    "height": 10
   }
  },
  {
   "call": "nx_create_mirror",
   "args": {
    "bodies": [
     "$a.data.bodies.0.id"
    ],
    "plane": "yz",
    "keep_original": false
   },
   "expect": {
    "data.volume": {
     "close": 8000,
     "tol": 1e-06
    },
    "data.hidden": {
     "count": 1
    },
    "data.hidden.0.id": "$a.data.bodies.0.id"
   }
  },
  {
   "call": "nx_create_datum_plane",
   "setup": true,
   "save": "dp",
   "args": {
    "method": "point_normal",
    "origin": [
     60,
     0,
     0
    ],
    "normal": [
     1,
     0,
     0
    ]
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "b",
   "args": {
    "shape": "block",
    "origin": [
     0,
     50,
     0
    ],
    "length": 20,
    "width": 20,
    "height": 10
   }
  },
  {
   "call": "nx_create_mirror",
   "save": "mf",
   "args": {
    "features": [
     "$b.data.feature.id"
    ],
    "plane": "$dp.data.feature.id"
   },
   "intent": "Features without target mirror as features; a datum plane feature is a plane",
   "expect": {
    "data.target": "features",
    "data.new_bodies": 1,
    "data.volume": {
     "close": 8000,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_measure_bounds",
   "args": {
    "bodies": [
     "$mf.data.bodies.1.id"
    ],
    "precision": "exact"
   },
   "expect": {
    "data.min": {
     "close": [
      100,
      50,
      0
     ],
     "tol": 0.0001
    },
    "data.max": {
     "close": [
      120,
      70,
      10
     ],
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_create_mirror",
   "args": {
    "bodies": [
     "$b.data.bodies.0.id"
    ],
    "plane": "$b.data.feature.id"
   },
   "expect": {
    "error.code": "NX_WRONG_KIND",
    "error.field": "/plane",
    "mutation_outcome": "not_started"
   }
  }
 ]
}
