{
 "covers": {
  "nx_list_thread_sizes": [],
  "nx_create_thread": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_list_thread_sizes",
   "args": {
    "size": "M7"
   },
   "expect": {
    "error.code": "NX_NOT_FOUND",
    "error.details.close_matches": {
     "count": 2
    }
   }
  },
  {
   "call": "nx_list_thread_sizes",
   "args": {
    "standard": "ISO metric"
   },
   "expect": {
    "warnings": {
     "contains": {
      "code": "NX_NOTE"
     }
    },
    "warnings.0.message": {
     "contains": "Metric Coarse"
    }
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "c",
   "args": {
    "shape": "cylinder",
    "origin": [
     0,
     0,
     0
    ],
    "diameter": 10,
    "height": 30
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "cf",
   "args": {
    "owner": "$c.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "cylinder",
    "order": "nearest",
    "near": [
     5,
     0,
     15
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "tp",
   "args": {
    "owner": "$c.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "order": "nearest",
    "near": [
     0,
     0,
     30
    ],
    "limit": 1,
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_create_thread",
   "setup": true,
   "args": {
    "face": "$cf.data.items.0.id",
    "start_face": "$tp.data.items.0.id",
    "length": 20,
    "spec": {
     "size": "M10"
    }
   }
  },
  {
   "call": "nx_create_thread",
   "args": {
    "face": "$cf.data.items.0.id",
    "start_face": "$tp.data.items.0.id",
    "length": 20,
    "spec": {
     "size": "M10"
    }
   },
   "intent": "A second thread on a threaded span says the face is threaded",
   "expect": {
    "error.code": "NX_BUILD_FAILED",
    "error.hint": {
     "contains": "already carries a thread"
    },
    "mutation_outcome": "rolled_back"
   }
  }
 ]
}
