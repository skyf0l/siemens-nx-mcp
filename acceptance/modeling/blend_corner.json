{
 "covers": {"nx_create_blend_corner": []},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "a", "args": {"length": 40, "width": 40, "height": 40}},
  {"call": "nx_find_geometry", "setup": true, "save": "ea",
   "args": {"owner": "$a.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [40, 40, 40], "limit": 3}},
  {"call": "nx_create_blend_corner",
   "args": {"edges": ["$ea.data.items.0.id", "$ea.data.items.1.id", "$ea.data.items.2.id"], "radius": 5, "setback": 12, "setback_faces": "separate"},
   "expect": {"data.volume": {"close": 63207.18681023753, "tol": 0.01}, "data.blend_faces": 9, "data.corner": {"close": [40, 40, 40], "tol": 1e-06},
              "data.area": {"close": 910.426700258363, "tol": 0.01}, "data.bodies": {"count": 1}}},
  {"call": "nx_create_primitive", "setup": true, "save": "b", "args": {"origin": [100, 0, 0], "length": 40, "width": 40, "height": 40}},
  {"call": "nx_find_geometry", "setup": true, "save": "eb",
   "args": {"owner": "$b.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [140, 40, 40], "limit": 3}},
  {"call": "nx_create_blend_corner",
   "args": {"edges": ["$eb.data.items.0.id", "$eb.data.items.1.id", "$eb.data.items.2.id"], "radius": "5 mm", "setback": 12},
   "expect": {"data.volume": {"close": 63139.33756275438, "tol": 0.01}, "data.blend_faces": 18, "data.area": {"close": 897.2828851297695, "tol": 0.01}}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}},
  {"call": "nx_create_primitive", "setup": true, "save": "c", "args": {"origin": [200, 0, 0], "length": 40, "width": 40, "height": 40}},
  {"call": "nx_find_geometry", "setup": true, "save": "ec",
   "args": {"owner": "$c.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [240, 40, 40], "limit": 3}},
  {"call": "nx_create_blend_corner",
   "args": {"edges": ["$ec.data.items.0.id", "$ec.data.items.1.id", "$ec.data.items.2.id"], "radius": 5, "setback": 4},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/setback", "mutation_outcome": "not_started"}},
  {"call": "nx_create_blend_corner",
   "args": {"edges": ["$ec.data.items.0.id", "$ec.data.items.1.id", "$ec.data.items.2.id"], "radius": 5, "setback": 45},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/setback", "mutation_outcome": "not_started"}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$c.data.bodies.0.id"]}, "expect": {"data.volume": {"close": 64000, "tol": 0.001}}}
 ]
}
