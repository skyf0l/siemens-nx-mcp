{
  "covers": {
    "nx_create_hole": ["simple", "threaded"],
    "nx_create_thread": [],
    "nx_list_thread_sizes": []
  },
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "bs", "args": {"placement": "xy"}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$bs.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 30]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$bs.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "blk", "args": {"sketch": "$bs.data.sketch.id", "end": 20}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1],
              "limit": 1, "order": "highest", "axis": "z"}},
    {"call": "nx_create_hole", "save": "tap",
     "args": {"face": "$top.data.items.0.id", "positions": [[10, 15]], "form": "threaded", "depth": 12,
              "thread": {"size": "M6"}},
     "expect": {"mutation_outcome": "committed", "data.nominal": {"close": 245.45100790761157, "tol": 1e-6},
                "data.removed": {"close": 245.451, "tol": 0.5}, "data.positions.0": {"close": [10, 15, 20], "tol": 1e-6}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1],
              "limit": 1, "order": "highest", "axis": "z"}},
    {"call": "nx_create_hole",
     "args": {"face": "$top.data.items.0.id", "positions": [[20, 15]], "diameter": 6, "depth": "10 mm"},
     "expect": {"mutation_outcome": "committed", "data.nominal": {"close": 299.73227258219697, "tol": 1e-6},
                "data.removed": {"close": 299.73227258219697, "tol": 1e-3}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1],
              "limit": 1, "order": "highest", "axis": "z"}},
    {"call": "nx_create_hole",
     "args": {"face": "$top.data.items.0.id", "positions": [[30, 8], [30, 22]], "diameter": 5, "depth": 12},
     "expect": {"mutation_outcome": "committed", "data.removed": {"close": 490.90201581522314, "tol": 1e-3}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1],
              "limit": 1, "order": "highest", "axis": "z"}},
    {"call": "nx_create_hole",
     "args": {"face": "$top.data.items.0.id", "positions": [[35, 15]], "form": "threaded", "diameter": 6.6, "depth": 10,
              "thread": {"size": "M6"}},
     "expect": {"error.field": "/diameter", "mutation_outcome": "not_started",
                "error.details.tap_drill_diameters": {"contains": 5}, "error.hint": {"contains": "form 'simple'"}}},
    {"call": "nx_create_hole",
     "args": {"face": "$top.data.items.0.id", "positions": [[35, 15]], "diameter": 5, "depth": 10,
              "counterbore": {"diameter": 9, "depth": 3}},
     "expect": {"error.field": "/counterbore", "mutation_outcome": "not_started",
                "error.hint": {"contains": "form 'counterbore'"}}},
    {"call": "nx_create_hole",
     "args": {"face": "$top.data.items.0.id", "positions": [[35, 15]], "form": "threaded", "depth": 10,
              "thread": {"size": "M6 x 7"}},
     "expect": {"error.code": "NX_NOT_FOUND", "mutation_outcome": "not_started", "error.field": "/thread/size"}},
    {"call": "nx_find_geometry", "setup": true, "save": "bore6",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "cylinder", "order": "nearest",
              "near": [23, 15, 15], "limit": 1}},
    {"call": "nx_create_thread", "args": {"face": "$bore6.data.items.0.id", "spec": {"size": "M6"}},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/face", "error.hint": {"contains": "tap drill 5"}}},
    {"call": "nx_find_geometry", "setup": true, "save": "bore5",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "cylinder", "order": "nearest",
              "near": [32.5, 8, 14], "limit": 1}},
    {"call": "nx_create_thread",
     "args": {"face": "$bore5.data.items.0.id", "spec": {"standard": "metric", "size": "m6x1"}},
     "expect": {"mutation_outcome": "committed", "data.internal": true, "data.length": {"close": 12, "tol": 1e-6},
                "data.standard": "Metric Coarse", "data.size": "M6 x 1.0", "data.engagement": "0.75",
                "data.major_diameter": {"close": 6, "tol": 1e-6}}},
    {"call": "nx_find_geometry", "setup": true, "save": "bore5b",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "cylinder", "order": "nearest",
              "near": [32.5, 22, 14], "limit": 1}},
    {"call": "nx_create_thread",
     "args": {"face": "$bore5b.data.items.0.id", "spec": {"size": "M6", "engagement": 0.75}, "length": 8,
              "detailed": true},
     "expect": {"mutation_outcome": "committed", "data.internal": true, "data.length": {"close": 8, "tol": 1e-9}}},
    {"call": "nx_create_sketch", "setup": true, "save": "cs", "args": {"placement": "xy"}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$cs.data.sketch.id", "curves": [{"type": "circle", "center": [70, 0], "radius": 3}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$cs.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "rod", "args": {"sketch": "$cs.data.sketch.id", "end": 20}},
    {"call": "nx_find_geometry", "setup": true, "save": "rodf",
     "args": {"owner": "$rod.data.bodies.0.id", "kind": "face", "geometry_type": "cylinder", "limit": 1}},
    {"call": "nx_create_thread", "args": {"face": "$rodf.data.items.0.id", "spec": {"size": "M6"}},
     "expect": {"error.field": "/start_face", "error.details.candidates": {"count": 2}}},
    {"call": "nx_find_geometry", "setup": true, "save": "rodtop",
     "args": {"owner": "$rod.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1],
              "limit": 1, "order": "highest", "axis": "z"}},
    {"call": "nx_create_thread",
     "args": {"face": "$rodf.data.items.0.id", "start_face": "$rodtop.data.items.0.id", "spec": {"size": "M6"}},
     "expect": {"mutation_outcome": "committed", "data.internal": false, "data.length": {"close": 20, "tol": 1e-6},
                "data.volume": {"close": 565.4866776461628, "tol": 1e-6}}},
    {"call": "nx_list_thread_sizes", "args": {"size": "M6"},
     "expect": {"data.items.0.standard": "Metric Coarse", "data.items.0.size": "M6 x 1.0",
                "data.items.0.tap_drill": {"close": 5, "tol": 1e-9}}},
    {"call": "nx_list_thread_sizes", "args": {"standard": "metric"},
     "expect": {"page.total": 46, "data.items": {"contains": {"size": "M6 x 1.0", "engagements": ["0.75", "0.5", "Custom"]}}}},
    {"call": "nx_list_thread_sizes", "args": {"standard": "ISO Metric Fine", "size": "M8x1"},
     "expect": {"data.items.0.standard": "Metric Fine", "data.items.0.pitch": {"close": 1, "tol": 1e-9}}},
    {"call": "nx_list_thread_sizes", "args": {"standard": "Metric Coarse", "size": "M6 x 7"},
     "expect": {"error.code": "NX_NOT_FOUND", "error.details.close_matches": {"contains": "M6 x 1.0"}}},
    {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
  ]
}
