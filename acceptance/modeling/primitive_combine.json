{
 "covers": {
  "nx_create_primitive": ["block", "cylinder", "cone", "sphere"]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "save": "plate", "args": {"length": 120, "width": 80, "height": 10},
   "expect": {"data.volume": {"close": 96000, "tol": 1e-06}}},
  {"call": "nx_create_primitive",
   "args": {"length": 60, "width": 40, "height": 4, "origin": [30, 20, 6],
            "combine": {"operation": "subtract", "targets": ["$plate.data.bodies.0.id"]}},
   "intent": "Acceptance: a block subtract cuts a 60x40x4 pocket into the plate (NX's block ignores BooleanOption)",
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 86400, "tol": 1e-06},
              "data.bodies": {"count": 1}, "data.bodies.0.id": "$plate.data.bodies.0.id"}},
  {"call": "nx_list_objects", "args": {"kind": "body"},
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_create_primitive",
   "args": {"length": 20, "width": 20, "height": 5, "origin": [0, 0, 10],
            "combine": {"operation": "unite", "targets": ["$plate.data.bodies.0.id"]}},
   "expect": {"data.volume": {"close": 88400, "tol": 1e-06}, "data.bodies": {"count": 1}}},
  {"call": "nx_create_primitive", "save": "cube", "args": {"length": 50, "width": 50, "height": 50, "origin": [200, 0, 0]},
   "expect": {"data.volume": {"close": 125000, "tol": 1e-06}}},
  {"call": "nx_create_primitive",
   "args": {"length": 30, "width": 20, "height": 20, "origin": [190, 10, 10],
            "combine": {"operation": "intersect", "targets": ["$cube.data.bodies.0.id"]}},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}, "data.bodies": {"count": 1}}},
  {"call": "nx_create_primitive",
   "args": {"length": 5, "width": 5, "height": 5,
            "combine": {"operation": "subtract", "targets": ["$plate.data.bodies.0.id", "$cube.data.bodies.0.id"]}},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/combine/targets", "mutation_outcome": "not_started"}},
  {"call": "nx_create_primitive",
   "args": {"shape": "cylinder", "diameter": 10, "height": 50, "origin": [100, 60, 5], "centered": true,
            "combine": {"operation": "subtract", "targets": ["$plate.data.bodies.0.id"]}},
   "expect": {"data.volume": {"close": 87614.60183660255, "tol": 0.01}, "data.bodies": {"count": 1}}},
  {"call": "nx_create_primitive",
   "args": {"shape": "cone", "diameter": 10, "height": 6, "origin": [100, 20, 10],
            "combine": {"operation": "unite", "targets": ["$plate.data.bodies.0.id"]}},
   "expect": {"data.volume": {"close": 87771.68146928204, "tol": 0.01}, "data.bodies": {"count": 1}}},
  {"call": "nx_create_primitive",
   "args": {"shape": "sphere", "diameter": 10, "origin": [210, 20, 20],
            "combine": {"operation": "intersect", "targets": ["$cube.data.bodies.0.id"]}},
   "expect": {"data.volume": {"close": 523.5987755982989, "tol": 0.01}, "data.bodies": {"count": 1}}},
  {"call": "nx_create_primitive",
   "args": {"shape": "sphere", "diameter": 6, "origin": [210, 20, 20],
            "combine": {"operation": "subtract", "targets": ["$plate.data.bodies.0.id"]}},
   "intent": "Acceptance: a subtract that misses its target is refused and rolled back",
   "expect": {"error.code": "NX_BUILD_FAILED", "mutation_outcome": "rolled_back"}},
  {"call": "nx_list_objects", "args": {"kind": "body"},
   "expect": {"data.items": {"count": 2}}}
 ]
}
