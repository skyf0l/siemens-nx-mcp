{
 "covers": {"nx_create_thread": [], "nx_create_transform": [], "nx_create_emboss": [], "nx_create_offset_emboss": [],
            "nx_create_shell": [], "nx_create_loft": [], "nx_create_revolve": [], "nx_create_hole": []},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},

  {"call": "nx_create_primitive", "setup": true, "save": "c", "args": {"shape": "cylinder", "diameter": 20, "height": 30}},
  {"call": "nx_find_geometry", "setup": true, "save": "side", "args": {"owner": "$c.data.bodies.0.id", "geometry_type": "cylinder", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "top", "args": {"owner": "$c.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_create_thread", "intent": "Acceptance: a thread longer than its face is refused before NX",
   "args": {"face": "$side.data.items.0.id", "spec": {"size": "M20"}, "start_face": "$top.data.items.0.id", "length": 40},
   "expect": {"error.field": "/length", "error.details.face_length": {"close": 30, "tol": 1e-06}, "mutation_outcome": "not_started"}},
  {"call": "nx_create_transform", "intent": "Acceptance: a body listed twice is refused before the undo mark",
   "args": {"bodies": ["$c.data.bodies.0.id", "$c.data.bodies.0.id"], "transform": {"translation": [0, 0, 5]}, "copy": true},
   "expect": {"error.field": "/bodies/1", "mutation_outcome": "not_started"}},

  {"call": "nx_create_primitive", "setup": true, "save": "pad", "args": {"origin": [100, 0, -20], "length": 80, "width": 80, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "padtop", "args": {"owner": "$pad.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_create_sketch", "setup": true, "save": "open",
   "args": {"placement": "xy", "curves": [{"type": "line", "start": [110, 10], "end": [130, 10]},
                                          {"type": "line", "start": [130, 10], "end": [130, 30]},
                                          {"type": "line", "start": [130, 30], "end": [110, 30]}], "finish": true}},
  {"call": "nx_create_emboss", "intent": "Acceptance: an open emboss section is refused before NX",
   "args": {"sketch": "$open.data.sketch.id", "faces": ["$padtop.data.items.0.id"], "height": 5},
   "expect": {"error.field": "/sketch", "error.message": {"contains": "no closed loop"}, "mutation_outcome": "not_started"}},
  {"call": "nx_create_sketch", "setup": true, "save": "beside",
   "args": {"placement": "xy", "curves": [{"type": "rectangle", "corner1": [400, 10], "corner2": [420, 30]}], "finish": true}},
  {"call": "nx_create_emboss", "intent": "Acceptance: a section beside the target faces is refused before NX",
   "args": {"sketch": "$beside.data.sketch.id", "faces": ["$padtop.data.items.0.id"], "height": 5},
   "expect": {"error.field": "/sketch", "error.message": {"contains": "does not lie over"}, "mutation_outcome": "not_started"}},

  {"call": "nx_create_sketch", "setup": true, "save": "shline",
   "args": {"placement": "xz", "curves": [{"type": "line", "start": [600, 0], "end": [700, 0]}], "finish": true}},
  {"call": "nx_create_extrude", "setup": true, "save": "sh", "args": {"sketch": "$shline.data.sketch.id", "end": 60, "direction": "y"}},
  {"call": "nx_create_datum_plane", "setup": true, "save": "z15", "args": {"method": "offset", "reference": "xy", "distance": 15}},
  {"call": "nx_create_sketch", "setup": true, "save": "high",
   "args": {"placement": {"on": "$z15.data.datum_plane.id"}, "curves": [{"type": "line", "start": [620, 30], "end": [680, 30]}], "finish": true}},
  {"call": "nx_create_offset_emboss", "intent": "Acceptance: a path off the sheet is refused before NX",
   "args": {"sheet": "$sh.data.bodies.0.id", "path": ["$high.data.curves.0.id"], "height": 2, "left_width": 2},
   "expect": {"error.field": "/path/0", "error.details.distance": {"close": 15, "tol": 0.001}, "mutation_outcome": "not_started"}},

  {"call": "nx_create_primitive", "setup": true, "save": "box", "args": {"origin": [300, 0, 0], "length": 60, "width": 40, "height": 30}},
  {"call": "nx_find_geometry", "setup": true, "save": "boxtop", "args": {"owner": "$box.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_create_shell", "intent": "Acceptance: a wall too thick for the body names the limit",
   "args": {"body": "$box.data.bodies.0.id", "thickness": 25, "remove_faces": ["$boxtop.data.items.0.id"]},
   "expect": {"error.field": "/thickness", "error.details.smallest_extent": {"close": 30, "tol": 1e-06},
              "error.hint": {"contains": "less than 15"}}},
  {"call": "nx_find_geometry", "setup": true, "save": "boxtop2", "args": {"owner": "$box.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_create_hole", "intent": "Acceptance: a narrow counterbore names both diameters",
   "args": {"face": "$boxtop2.data.items.0.id", "positions": [[315, 15, 30]], "form": "counterbore", "diameter": 10, "depth": 10,
            "counterbore": {"diameter": 8, "depth": 2}},
   "expect": {"error.message": {"contains": "(8) must be wider than the hole (10)"}, "mutation_outcome": "not_started"}},
  {"call": "nx_create_hole", "setup": true, "args": {"face": "$boxtop2.data.items.0.id", "positions": [[315, 15, 30]], "diameter": 8, "depth": "through_all"}},
  {"call": "nx_find_geometry", "setup": true, "save": "boxtop3", "args": {"owner": "$box.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_create_hole", "intent": "Acceptance: a position in an existing hole says it falls in an opening",
   "args": {"face": "$boxtop3.data.items.0.id", "positions": [[315, 15, 30]], "diameter": 4, "depth": 5},
   "expect": {"error.message": {"contains": "in an opening of the face"}, "mutation_outcome": "not_started"}},

  {"call": "nx_create_sketch", "setup": true, "save": "lo1",
   "args": {"placement": "xy", "curves": [{"type": "rectangle", "corner1": [500, 0], "corner2": [520, 20]}], "finish": true}},
  {"call": "nx_create_datum_plane", "setup": true, "save": "z30", "args": {"method": "offset", "reference": "xy", "distance": 30}},
  {"call": "nx_create_sketch", "setup": true, "save": "lo2",
   "args": {"placement": {"on": "$z30.data.datum_plane.id"},
            "curves": [{"type": "line", "start": [500, 0], "end": [520, 0]}, {"type": "line", "start": [520, 0], "end": [520, 20]}], "finish": true}},
  {"call": "nx_create_loft", "intent": "Acceptance: an open section in a solid loft is refused before NX",
   "args": {"sections": ["$lo1.data.sketch.id", "$lo2.data.sketch.id"]},
   "expect": {"error.field": "/sections/1", "error.message": {"contains": "is open"}, "mutation_outcome": "not_started"}},

  {"call": "nx_create_sketch", "setup": true, "save": "shaft",
   "args": {"placement": "xz", "curves": [{"type": "rectangle", "corner1": [0, 100], "corner2": [5, 110]}], "finish": true}},
  {"call": "nx_create_revolve", "intent": "Acceptance: a sheet revolve of a profile edge on the axis names that edge",
   "args": {"sketch": "$shaft.data.sketch.id", "axis": "z", "end_angle": 90, "sheet": true},
   "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/sketch", "error.message": {"contains": "on the axis"}}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
 ]
}
