{
 "covers": {
  "nx_edit_feature": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "blk_sk",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$blk_sk.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       40,
       20
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$blk_sk.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "save": "blk",
   "args": {
    "sketch": "$blk_sk.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 10
    }
   },
   "setup": true
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "bs",
   "args": {
    "placement": {
     "principal": "xy",
     "origin": [
      0,
      0,
      10
     ]
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$bs.data.sketch.id",
    "curves": [
     {
      "type": "circle",
      "center": [
       20,
       10
      ],
      "radius": 5
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$bs.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "setup": true,
   "save": "boss",
   "args": {
    "sketch": "$bs.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 5
    },
    "combine": {
     "operation": "unite",
     "targets": [
      "$blk.data.bodies.0.id"
     ]
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "rim",
   "args": {
    "owner": "$blk.data.bodies.0.id",
    "kind": "edge",
    "geometry_type": "circle",
    "order": "highest",
    "axis": "Z",
    "limit": 1
   }
  },
  {
   "call": "nx_create_blend",
   "setup": true,
   "save": "fil",
   "args": {
    "edges": [
     "$rim.items.0.object.id"
    ],
    "radius": 1
   }
  },
  {
   "call": "nx_get_feature",
   "setup": true,
   "save": "gb",
   "args": {
    "feature": "$boss.data.feature.id"
   }
  },
  {
   "call": "nx_edit_feature",
   "args": {
    "feature": "$boss.data.feature.id",
    "parameters": [
     {
      "name": "distance",
      "value": 8
     }
    ]
   },
   "expect": {
    "data.parameters.1.value": {
     "close": 8,
     "tol": 1e-12
    }
   }
  },
  {
   "call": "nx_measure_volume",
   "args": {
    "body": "$blk.data.bodies.0.id"
   },
   "expect": {
    "volume_mm3": {
     "close": 8621.877800740223,
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_edit_feature",
   "args": {
    "feature": "$boss.data.feature.id",
    "parameters": [
     {
      "name": "$gb.data.parameters.1.expression.name",
      "value": "2*3"
     }
    ]
   },
   "expect": {
    "data.parameters.1.value": {
     "close": 6,
     "tol": 1e-12
    },
    "data.parameters.1.formula": "2*3"
   }
  },
  {
   "call": "nx_measure_volume",
   "args": {
    "body": "$blk.data.bodies.0.id"
   },
   "expect": {
    "volume_mm3": {
     "close": 8464.798168060734,
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_set_expression",
   "setup": true,
   "args": {
    "name": "boss_h",
    "formula": "4",
    "units": "mm"
   }
  },
  {
   "call": "nx_edit_feature",
   "args": {
    "feature": "$boss.data.feature.id",
    "parameters": [
     {
      "name": "end",
      "value": "boss_h"
     }
    ]
   },
   "expect": {
    "data.parameters.1.value": {
     "close": 4,
     "tol": 1e-12
    }
   }
  },
  {
   "call": "nx_set_expression",
   "setup": true,
   "args": {
    "name": "boss_h",
    "formula": "7"
   }
  },
  {
   "call": "nx_measure_volume",
   "args": {
    "body": "$blk.data.bodies.0.id"
   },
   "expect": {
    "volume_mm3": {
     "close": 8543.337984400478,
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_edit_feature",
   "args": {
    "feature": "$fil.data.feature.id",
    "parameters": [
     {
      "name": "radius",
      "value": "0.5"
     }
    ]
   },
   "expect": {
    "data.parameters.0.value": {
     "close": 0.5,
     "tol": 1e-12
    }
   }
  },
  {
   "call": "nx_edit_feature",
   "args": {
    "feature": "$boss.data.feature.id",
    "parameters": [
     {
      "name": "distance",
      "value": "boss_h +"
     }
    ]
   },
   "expect": {
    "error.code": "NX_INVALID_FORMULA",
    "mutation_outcome": "rolled_back"
   }
  },
  {
   "call": "nx_set_expression",
   "setup": true,
   "args": {
    "name": "tilt",
    "formula": "30",
    "units": "deg"
   }
  },
  {
   "call": "nx_edit_feature",
   "args": {
    "feature": "$boss.data.feature.id",
    "parameters": [
     {
      "name": "distance",
      "value": "tilt"
     }
    ]
   },
   "expect": {
    "error.code": "NX_INVALID_ARGUMENT",
    "error.nx_code": 3270081
   }
  },
  {
   "call": "nx_edit_feature",
   "args": {
    "feature": "$boss.data.feature.id",
    "parameters": [
     {
      "name": "spacing",
      "value": 3
     }
    ]
   },
   "expect": {
    "error.code": "NX_NOT_FOUND"
   }
  },
  {
   "call": "nx_edit_feature",
   "args": {
    "feature": "$boss.data.feature.id"
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_model_health",
   "args": {},
   "expect": {
    "healthy": true
   }
  }
 ]
}
