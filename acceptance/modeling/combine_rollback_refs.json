     {
      "type": "rectangle",
      "corner1": [
       5,
       0
      ],
      "corner2": [
       15,
       10
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$s2.data.sketch.id"
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "s3",
   "args": {
    "placement": {
     "principal": "xy"
