{
 "covers": {
  "nx_edit_faces": [
   "move",
   "offset",
   "replace",
   "delete"
  ]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "a_sk",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$a_sk.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       40,
       20
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$a_sk.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "save": "a",
   "args": {
    "sketch": "$a_sk.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 10
    }
   },
   "setup": true
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "e_sk",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$e_sk.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       100,
       0
      ],
      "corner2": [
       110,
       10
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$e_sk.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "save": "e",
   "args": {
    "sketch": "$e_sk.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 15
    }
   },
   "setup": true
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top",
   "args": {
    "owner": "$a.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "normal": [
     0,
     0,
     1
    ],
    "limit": 1,
    "order": "highest",
    "axis": "z"
   }
  },
  {
   "call": "nx_edit_faces",
   "args": {
    "faces": [
     "$top.data.items.0.id"
    ],
    "action": "offset",
    "distance": 2
   },
   "expect": {
    "data.volume": {
     "close": 9600,
     "tol": 1e-06
    },
    "data.volume_change": {
     "close": 1600,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "side",
   "args": {
    "owner": "$a.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "normal": [
     1,
     0,
     0
    ],
    "limit": 1,
    "order": "nearest",
    "near": [
     40,
     10,
     5
    ]
   }
  },
  {
   "call": "nx_edit_faces",
   "args": {
    "faces": [
     "$side.data.items.0.id"
    ],
    "action": "move",
    "distance": 5,
    "direction": "x"
   },
   "expect": {
    "data.volume": {
     "close": 10800,
     "tol": 1e-06
    },
    "data.volume_change": {
     "close": 1200,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top",
   "args": {
    "owner": "$a.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "normal": [
     0,
     0,
     1
    ],
    "limit": 1,
    "order": "highest",
    "axis": "z"
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "etop",
   "args": {
    "owner": "$e.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "normal": [
     0,
     0,
     1
    ],
    "limit": 1,
    "order": "highest",
    "axis": "z"
   }
  },
  {
   "call": "nx_edit_faces",
   "args": {
    "faces": [
     "$top.data.items.0.id"
    ],
    "action": "replace",
    "replacement": "$etop.data.items.0.id"
   },
   "expect": {
    "data.volume": {
     "close": 13500,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_measure_bounds",
   "args": {
    "bodies": [
     "$a.data.bodies.0.id"
    ],
    "precision": "exact"
   },
   "expect": {
    "data.min": {
     "close": [
      0,
      0,
      0
     ],
     "tol": 0.0001
    },
    "data.max": {
     "close": [
      45,
      20,
      15
     ],
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e1",
   "args": {
    "owner": "$a.data.bodies.0.id",
    "kind": "edge",
    "geometry_type": "line",
    "order": "nearest",
    "near": [
     20,
     0,
     15
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_create_blend",
   "setup": true,
   "args": {
    "edges": [
     "$e1.data.items.0.id"
    ],
    "radius": 2
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "bf",
   "args": {
    "owner": "$a.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "cylinder",
    "order": "nearest",
    "near": [
     20,
     0.6,
     14.4
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_edit_faces",
   "args": {
    "faces": [
     "$bf.data.items.0.id"
    ],
    "action": "delete"
   },
   "expect": {
    "data.volume": {
     "close": 13500,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top",
   "args": {
    "owner": "$a.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "normal": [
     0,
     0,
     1
    ],
    "limit": 1,
    "order": "highest",
    "axis": "z"
   }
  },
  {
   "call": "nx_edit_faces",
   "args": {
    "faces": [
     "$top.data.items.0.id"
    ],
    "action": "offset"
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/distance"
   }
  },
  {
   "call": "nx_edit_faces",
   "args": {
    "faces": [
     "$top.data.items.0.id"
    ],
    "action": "delete",
    "distance": 1
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/distance"
   }
  },
  {
   "call": "nx_edit_faces",
   "args": {
    "faces": [
     "$top.data.items.0.id"
    ],
    "action": "resize"
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/diameter",
    "error.message": {
     "contains": "radius"
    }
   }
  },
  {
   "call": "nx_edit_faces",
   "args": {
    "faces": [
     "$top.data.items.0.id"
    ],
    "action": "offset",
    "distance": 1,
    "direction": "z"
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/direction",
    "error.hint": {
     "contains": "offset takes distance"
    }
   }
  },
  {
   "call": "nx_edit_faces",
   "args": {
    "faces": [
     "$top.data.items.0.id"
    ],
    "action": "resize",
    "diameter": 5
   },
   "intent": "Acceptance: resizing a planar face is refused before NX (live: reported rolled_back)",
   "expect": {
    "error.code": "NX_WRONG_GEOMETRY",
    "error.field": "/faces/0",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_check_model",
   "args": {},
   "expect": {
    "data.healthy": true
   }
  }
 ]
}
