  {
   "call": "nx_create_sweep",
   "args": {
    "section": "$sec.data.sketch.id",
    "guide": "$gd.data.sketch.id",
    "combine": {
     "operation": "unite",
     "targets": [
      "$blk.data.bodies.0.id",
      "$tube.data.bodies.0.id"
     ]
    }
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/combine/targets"
   }
  }
 ]
