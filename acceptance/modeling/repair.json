{
 "covers": {"nx_create_patch_body": [], "nx_create_delete_body": [], "nx_create_unsew": ["faces", "edges"], "nx_create_untrim": []},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk",
   "args": {"placement": "xz", "curves": [{"type": "line", "start": [0, 15], "end": [40, 15]}], "finish": true}},
  {"call": "nx_create_primitive", "setup": true, "save": "a", "args": {"length": 40, "width": 30, "height": 20}},
  {"call": "nx_create_extrude", "setup": true, "save": "pa", "args": {"sketch": "$sk.data.sketch.id", "end": 30, "direction": [0, 1, 0]}},
  {"call": "nx_create_patch_body", "args": {"body": "$a.data.bodies.0.id", "sheet": "$pa.data.bodies.0.id"},
   "expect": {"data.volume": {"close": 18000, "tol": 0.001}, "data.volume_before": {"close": 24000, "tol": 0.001},
              "data.sheet": false, "data.faces": 6, "data.bodies": {"count": 1}}},
  {"call": "nx_create_primitive", "setup": true, "save": "b", "args": {"origin": [0, 50, 0], "length": 40, "width": 30, "height": 20}},
  {"call": "nx_create_extrude", "setup": true, "save": "pb", "args": {"sketch": "$sk.data.sketch.id", "start": 50, "end": 80, "direction": [0, 1, 0]}},
  {"call": "nx_create_patch_body", "args": {"body": "$b.data.bodies.0.id", "sheet": "$pb.data.bodies.0.id", "reverse": true},
   "expect": {"data.volume": {"close": 6000, "tol": 0.001}, "data.faces": 6}},
  {"call": "nx_create_primitive", "setup": true, "save": "c", "args": {"origin": [100, 0, 0], "length": 40, "width": 30, "height": 20}},
  {"call": "nx_create_extrude", "setup": true, "save": "pc", "args": {"sketch": "$sk.data.sketch.id", "end": 30, "direction": [0, 1, 0]}},
  {"call": "nx_create_patch_body", "args": {"body": "$c.data.bodies.0.id", "sheet": "$pc.data.bodies.0.id"},
   "expect": {"error.code": "NX_BUILD_FAILED", "mutation_outcome": "rolled_back", "error.hint": {"contains": "lie on the body"}}},
  {"call": "nx_create_patch_body", "args": {"body": "$c.data.bodies.0.id", "sheet": "$c.data.bodies.0.id"},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/sheet", "mutation_outcome": "not_started"}},
  {"call": "nx_create_primitive", "setup": true, "save": "d", "args": {"origin": [0, 200, 0], "length": 40, "width": 30, "height": 20}},
  {"call": "nx_create_primitive", "setup": true, "save": "cyl", "args": {"shape": "cylinder", "origin": [20, 215, 0], "diameter": 10, "height": 20}},
  {"call": "nx_find_geometry", "setup": true, "save": "side", "args": {"owner": "$cyl.data.bodies.0.id", "geometry_type": "cylinder", "limit": 1}},
  {"call": "nx_create_unsew", "save": "u", "args": {"by": "faces", "faces": ["$side.data.items.0.id"]},
   "expect": {"data.count": 3, "data.area": {"close": 785.3981633974483, "tol": 0.001}, "data.kept_original": false}},
  {"call": "nx_find_geometry", "setup": true, "save": "tube", "args": {"owner": "$u.data.feature.id", "kind": "body", "near": [20, 215, 10], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "cap1", "args": {"owner": "$u.data.feature.id", "kind": "body", "near": [20, 215, -50], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "cap2", "args": {"owner": "$u.data.feature.id", "kind": "body", "near": [20, 215, 70], "limit": 1}},
  {"call": "nx_create_delete_body", "args": {"bodies": ["$cap1.data.items.0.id", "$cap2.data.items.0.id"]},
   "expect": {"data.deleted": {"count": 2}, "data.remaining": 6}},
  {"call": "nx_create_patch_body", "args": {"body": "$d.data.bodies.0.id", "sheet": "$tube.data.items.0.id", "hole": true},
   "expect": {"data.volume": {"close": 22429.203673205103, "tol": 0.001}, "data.faces": 7}},
  {"call": "nx_create_primitive", "setup": true, "save": "e", "args": {"origin": [200, 0, 0], "length": 40, "width": 30, "height": 20}},
  {"call": "nx_find_geometry", "setup": true, "save": "etop", "args": {"owner": "$e.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "eside", "args": {"owner": "$e.data.bodies.0.id", "geometry_type": "plane", "normal": [1, 0, 0], "limit": 1}},
  {"call": "nx_create_unsew", "args": {"faces": ["$etop.data.items.0.id", "$eside.data.items.0.id"], "output": "each_face"},
   "expect": {"data.count": 3, "data.area": {"close": 5200, "tol": 0.001}}},
  {"call": "nx_create_primitive", "setup": true, "save": "f", "args": {"origin": [300, 0, 0], "length": 40, "width": 30, "height": 20}},
  {"call": "nx_find_geometry", "setup": true, "save": "fedges",
   "args": {"owner": "$f.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [320, 15, 25], "limit": 4}},
  {"call": "nx_create_unsew",
   "args": {"by": "edges", "edges": ["$fedges.data.items.0.id", "$fedges.data.items.1.id", "$fedges.data.items.2.id", "$fedges.data.items.3.id"], "keep_original": true},
   "expect": {"data.count": 2, "data.area": {"close": 5200, "tol": 0.001}, "data.kept_original": true}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$f.data.bodies.0.id"]}, "expect": {"data.volume": {"close": 24000, "tol": 0.001}}},
  {"call": "nx_create_unsew", "args": {"by": "edges", "faces": ["$etop.data.items.0.id"]},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "mutation_outcome": "not_started"}},
  {"call": "nx_create_primitive", "setup": true, "save": "g", "args": {"origin": [0, 300, 0], "length": 40, "width": 30, "height": 20}},
  {"call": "nx_create_primitive", "setup": true,
   "args": {"shape": "cylinder", "origin": [20, 315, -5], "diameter": 10, "height": 30, "combine": {"operation": "subtract", "targets": ["$g.data.bodies.0.id"]}}},
  {"call": "nx_find_geometry", "setup": true, "save": "gtop", "args": {"owner": "$g.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_create_untrim", "args": {"faces": ["$gtop.data.items.0.id"]},
   "expect": {"data.area": {"close": 4800, "tol": 0.01}, "data.trimmed_area": {"close": 1121.4601836602552, "tol": 0.001}, "data.bodies": {"count": 1}}},
  {"call": "nx_find_geometry", "setup": true, "save": "ghole", "args": {"owner": "$g.data.bodies.0.id", "geometry_type": "cylinder", "limit": 1}},
  {"call": "nx_create_untrim", "args": {"faces": ["$ghole.data.items.0.id"], "hide_original": true},
   "expect": {"data.area": {"close": 1256.6370614359173, "tol": 0.01}, "data.trimmed_area": {"close": 628.3185307179587, "tol": 0.001}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$g.data.bodies.0.id"]}, "expect": {"data.volume": {"close": 22429.203673205103, "tol": 0.001}}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
 ]
}
