{
  "covers": {"nx_create_transform": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "a_sk",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [10, 10]}]}},
    {"call": "nx_create_extrude", "setup": true, "save": "a", "args": {"sketch": "$a_sk.data.sketch.id", "end": 10}},
    {"call": "nx_create_sketch", "setup": true, "save": "b_sk",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [20, 0], "corner2": [30, 10]}]}},
    {"call": "nx_create_extrude", "setup": true, "save": "b", "args": {"sketch": "$b_sk.data.sketch.id", "end": 10}},
    {"call": "nx_create_sketch", "setup": true, "save": "c_sk",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [40, 0], "corner2": [50, 10]}]}},
    {"call": "nx_create_extrude", "setup": true, "save": "c", "args": {"sketch": "$c_sk.data.sketch.id", "end": 10}},
    {"call": "nx_create_transform", "save": "up",
     "intent": "Copy three identical bodies given out of creation order: each copy is paired with its own source and listed in input order",
     "args": {"bodies": ["$c.data.bodies.0.id", "$a.data.bodies.0.id", "$b.data.bodies.0.id"],
              "copy": true, "transform": {"translation": [0, 0, 30]}},
     "expect": {"mutation_outcome": "committed", "data.bodies": {"count": 3}, "data.volume": {"close": 3000, "tol": 1e-3}}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$up.data.bodies.0.id"], "precision": "exact"},
     "expect": {"data.min": {"close": [40, 0, 30], "tol": 1e-4}, "data.max": {"close": [50, 10, 40], "tol": 1e-4}}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$up.data.bodies.1.id"], "precision": "exact"},
     "expect": {"data.min": {"close": [0, 0, 30], "tol": 1e-4}, "data.max": {"close": [10, 10, 40], "tol": 1e-4}}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$up.data.bodies.2.id"], "precision": "exact"},
     "expect": {"data.min": {"close": [20, 0, 30], "tol": 1e-4}, "data.max": {"close": [30, 10, 40], "tol": 1e-4}}},
    {"call": "nx_create_transform", "save": "turn",
     "intent": "Copy the same bodies turned 90 deg about z: copies listed in input order",
     "args": {"bodies": ["$c.data.bodies.0.id", "$a.data.bodies.0.id", "$b.data.bodies.0.id"],
              "copy": true, "transform": {"rotation": {"axis": "z", "angle": 90}}},
     "expect": {"mutation_outcome": "committed", "data.bodies": {"count": 3}, "data.volume": {"close": 3000, "tol": 1e-3}}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$turn.data.bodies.0.id"], "precision": "exact"},
     "expect": {"data.min": {"close": [-10, 40, 0], "tol": 1e-4}, "data.max": {"close": [0, 50, 10], "tol": 1e-4}}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$turn.data.bodies.1.id"], "precision": "exact"},
     "expect": {"data.min": {"close": [-10, 0, 0], "tol": 1e-4}, "data.max": {"close": [0, 10, 10], "tol": 1e-4}}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$turn.data.bodies.2.id"], "precision": "exact"},
     "expect": {"data.min": {"close": [-10, 20, 0], "tol": 1e-4}, "data.max": {"close": [0, 30, 10], "tol": 1e-4}}},
    {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
  ]
}
