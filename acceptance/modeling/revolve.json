    }
   },
   "expect": {
    "data.volume": {
     "close": 4523.893421169302,
     "tol": 1e-06
    },
    "data.bodies": {
     "count": 1
    }
   }
  },
  {
   "call": "nx_get_bounding_box",
   "args": {
    "body": "$full.data.bodies.0.id",
    "precision": "exact"
   },
   "expect": {
    "min": {
     "close": [
      -12,
      -12,
      0
     ],
     "tol": 0.0001
    },
    "max": {
     "close": [
      12,
      12,
      10
     ],
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_create_revolve",
   "args": {
    "sketch": "$rv.data.sketch.id",
    "axis": {
     "principal": "z"
    },
    "start_angle": 90,
    "end_angle": 45
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/end_angle"
   }
  },
  {
   "call": "nx_create_revolve",
   "args": {
    "sketch": "$rv.data.sketch.id",
    "axis": {
     "principal": "z"
    },
    "end_angle": 400
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/end_angle"
   }
  },
  {
   "call": "nx_model_health",
   "args": {},
   "expect": {
    "healthy": true
   }
  }
 ]
