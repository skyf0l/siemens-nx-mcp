{
 "covers": {
  "nx_create_thread": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "plate", "args": {"length": 40, "width": 40, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "top",
   "args": {"owner": "$plate.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_create_hole", "setup": true, "save": "h1",
   "args": {"face": "$top.data.items.0.id", "positions": [[12, 20, 10]], "form": "simple", "diameter": 6.6, "depth": "through_all"}},
  {"call": "nx_find_geometry", "setup": true, "save": "b1",
   "args": {"owner": "$plate.data.bodies.0.id", "kind": "face", "geometry_type": "cylinder", "near": [12, 20, 5], "order": "nearest", "limit": 1}},
  {"call": "nx_create_thread", "args": {"face": "$b1.data.items.0.id", "spec": {"size": "M6"}},
   "intent": "Acceptance: an M6 thread on a 6.6 clearance bore is refused with the tap-drill route",
   "expect": {"error.code": "NX_WRONG_GEOMETRY",
              "error.message": {"contains": "clearance hole for M6 x 1.0"},
              "error.hint": {"contains": "nx_edit_feature"}, "error.details.tap_drill": {"close": 5, "tol": 1e-09},
              "error.details.bore": {"close": 6.6, "tol": 1e-06},
              "error.details.seed_feature.id": "$h1.data.feature.id"}},
  {"call": "nx_find_geometry", "setup": true, "save": "top1",
   "args": {"owner": "$plate.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_create_thread",
   "args": {"face": "$b1.data.items.0.id", "start_face": "$top1.data.items.0.id", "spec": {"pitch": 1, "major_diameter": 7, "minor_diameter": 6.6}},
   "intent": "Acceptance: a custom thread matching no table row is accepted with a note",
   "expect": {"mutation_outcome": "committed", "data.major_diameter": {"close": 7, "tol": 1e-06},
              "warnings": {"count": 1}, "warnings.0.code": "NX_NOTE", "warnings.0.message": {"contains": "Non-standard thread"},
              "data.volume": {"close": 15657.880560024072, "tol": 0.01}}},
  {"call": "nx_create_hole", "setup": true, "save": "h2",
   "args": {"face": "$top.data.items.0.id", "positions": [[28, 20, 10]], "form": "simple", "diameter": 6.6, "depth": "through_all"}},
  {"call": "nx_edit_feature", "args": {"feature": "$h2.data.feature.id", "parameters": [{"name": "diameter", "value": 5}]},
   "intent": "Acceptance: the hint's route: the seed hole edited to the M6 tap drill",
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_find_geometry", "setup": true, "save": "b2",
   "args": {"owner": "$plate.data.bodies.0.id", "kind": "face", "geometry_type": "cylinder", "near": [28, 20, 5], "order": "nearest", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "top2",
   "args": {"owner": "$plate.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_create_thread", "args": {"face": "$b2.data.items.0.id", "start_face": "$top2.data.items.0.id", "spec": {"size": "M6"}},
   "expect": {"mutation_outcome": "committed", "data.internal": true, "data.size": "M6 x 1.0",
              "data.major_diameter": {"close": 6, "tol": 1e-06}, "data.length": {"close": 10, "tol": 1e-06}}}
 ]
}
