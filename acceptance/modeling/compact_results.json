{
  "covers": {"nx_create_pattern": ["linear"], "nx_create_boolean": ["unite"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s1",
     "args": {"placement": {"principal": "xy"},
              "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [10, 10]}], "finish": true}},
    {"call": "nx_create_extrude", "setup": true, "save": "a",
     "args": {"sketch": "$s1.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_pattern", "save": "pc", "detail": "compact",
     "intent": "Compact result of an 18-instance separate-body pattern: data and changes show the first and last body",
     "args": {"features": ["$a.data.feature.id"], "layout": "linear",
              "parameters": {"direction": [1, 0, 0], "count": 18, "spacing": 20}},
     "expect": {"data.count": 18, "data.new_bodies": 17, "data.volume": {"close": 18000, "tol": 1e-6},
                "data.bodies": {"count": 2}, "omitted./data/bodies.total": 18,
                "omitted./data/bodies.returned": 2, "omitted./data/bodies.shown": "first_last",
                "changes.created": {"count": 2}, "changes.created.0.kind": "body",
                "omitted./changes/created.shown": "first_last", "changes.counts.created.body": 17,
                "changes.deleted": {"count": 0},
                "result_id": {"matches": "^result_[0-9a-f]{32}$"}, "expand_with": "nx_get_result"}},
    {"call": "nx_get_result", "detail": "compact",
     "args": {"result_id": "$pc.result_id", "field": "/data/bodies", "limit": 20},
     "expect": {"data.kind": "list", "page.total": 18, "data.items": {"count": 18},
                "data.items.0.kind": "body"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s2",
     "args": {"placement": {"principal": "xy"},
              "curves": [{"type": "rectangle", "corner1": [0, 30], "corner2": [10, 40]}], "finish": true}},
    {"call": "nx_create_extrude", "setup": true, "save": "b",
     "args": {"sketch": "$s2.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_pattern", "setup": true, "save": "p19",
     "args": {"features": ["$b.data.feature.id"], "layout": "linear",
              "parameters": {"direction": [1, 0, 0], "count": 19, "spacing": 8}}},
    {"call": "nx_create_boolean", "save": "u", "detail": "compact",
     "intent": "Compact result of an 18-tool unite: the new feature, first and last deleted tool, counts",
     "args": {"operation": "unite", "target": "$b.data.bodies.0.id",
              "tools": ["$p19.data.bodies.1.id", "$p19.data.bodies.2.id", "$p19.data.bodies.3.id",
                        "$p19.data.bodies.4.id", "$p19.data.bodies.5.id", "$p19.data.bodies.6.id",
                        "$p19.data.bodies.7.id", "$p19.data.bodies.8.id", "$p19.data.bodies.9.id",
                        "$p19.data.bodies.10.id", "$p19.data.bodies.11.id", "$p19.data.bodies.12.id",
                        "$p19.data.bodies.13.id", "$p19.data.bodies.14.id", "$p19.data.bodies.15.id",
                        "$p19.data.bodies.16.id", "$p19.data.bodies.17.id", "$p19.data.bodies.18.id"]},
     "expect": {"data.deleted_bodies": 18, "data.bodies": {"count": 1},
                "data.volume": {"close": 15400, "tol": 1e-6},
                "changes.deleted": {"count": 2}, "changes.deleted.0.kind": "body",
                "changes.counts.deleted.body": 18, "omitted./changes/deleted.total": 18,
                "changes.created": {"count": 1}, "changes.created.0.kind": "feature"}},
    {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"page.total": 19}},
    {"call": "nx_check_model", "expect": {"data.healthy": true}}
  ]
}
