{
 "covers": {
  "nx_create_boolean": ["subtract"],
  "nx_create_extrude": [],
  "nx_create_primitive": ["cylinder"],
  "nx_create_pattern": ["circular"]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "t", "args": {"length": 10, "width": 10, "height": 10}},
  {"call": "nx_create_primitive", "setup": true, "save": "r1", "args": {"length": 10, "width": 6, "height": 6, "origin": [5, 2, 2]}},
  {"call": "nx_create_primitive", "setup": true, "save": "r2", "args": {"length": 10, "width": 6, "height": 6, "origin": [5, 2, 10]}},
  {"call": "nx_create_boolean",
   "args": {"operation": "subtract", "target": "$t.data.bodies.0.id", "tools": ["$r1.data.bodies.0.id", "$r2.data.bodies.0.id"]},
   "intent": "Acceptance: r2 only sits on the target's top face; NX's own alert comes back as a warning naming the touching tool",
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 820, "tol": 1e-06},
              "data.deleted_bodies": 2, "warnings": {"count": 1},
              "warnings.0.message": {"matches": "did not intersect.*tools\\[1\\] only touch"}}},
  {"call": "nx_create_primitive", "setup": true, "save": "p", "args": {"length": 10, "width": 10, "height": 10, "origin": [0, 30, 0]}},
  {"call": "nx_create_primitive", "setup": true, "save": "q", "args": {"length": 10, "width": 10, "height": 10, "origin": [0, 30, 10]}},
  {"call": "nx_create_primitive",
   "args": {"shape": "cylinder", "diameter": 4, "height": 30, "origin": [5, 35, -5],
            "combine": {"operation": "subtract", "targets": ["$p.data.bodies.0.id", "$q.data.bodies.0.id"]}},
   "intent": "Acceptance: a cylinder through both stacked blocks cuts each target: no unchanged-target warning",
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 1748.672, "tol": 0.01},
              "data.bodies": {"count": 2}, "warnings": {"count": 0}}},
  {"call": "nx_create_primitive", "setup": true, "save": "u", "args": {"length": 10, "width": 10, "height": 10, "origin": [0, 60, 0]}},
  {"call": "nx_create_primitive", "setup": true, "save": "v", "args": {"length": 10, "width": 10, "height": 10, "origin": [0, 60, 10]}},
  {"call": "nx_create_sketch", "setup": true, "save": "s", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$s.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [2, 62], "corner2": [8, 68]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s.data.sketch.id"}},
  {"call": "nx_create_extrude",
   "args": {"sketch": "$s.data.sketch.id", "end": 10,
            "combine": {"operation": "subtract", "targets": ["$u.data.bodies.0.id", "$v.data.bodies.0.id"]}},
   "intent": "Acceptance: the pocket only reaches u; NX refuses a target the tool misses (670030) and the hint says to drop it",
   "expect": {"mutation_outcome": "rolled_back", "error.code": "NX_BUILD_FAILED", "error.nx_code": 670030,
              "error.field": "/combine/targets", "error.hint": {"contains": "drop that body"}}},
  {"call": "nx_create_pattern",
   "args": {"bodies": ["$u.data.bodies.0.id"], "layout": "circular",
            "parameters": {"axis": "z", "count": 3, "angle": -30}},
   "expect": {"mutation_outcome": "not_started", "error.field": "/parameters/angle",
              "error.hint": {"contains": "reversing the axis direction"}}}
 ]
}
