{
 "covers": {
  "nx_set_feature_order": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "blk_sk",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$blk_sk.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       40,
       20
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$blk_sk.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "save": "blk",
   "args": {
    "sketch": "$blk_sk.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 10
    }
   },
   "setup": true
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "bs",
   "args": {
    "placement": {
     "principal": "xy",
     "origin": [
      0,
      0,
      10
     ]
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$bs.data.sketch.id",
    "curves": [
     {
      "type": "circle",
      "center": [
       20,
       10
      ],
      "radius": 5
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$bs.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "setup": true,
   "save": "boss",
   "args": {
    "sketch": "$bs.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 5
    },
    "combine": {
     "operation": "unite",
     "targets": [
      "$blk.data.bodies.0.id"
     ]
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "rim",
   "args": {
    "owner": "$blk.data.bodies.0.id",
    "kind": "edge",
    "geometry_type": "circle",
    "order": "highest",
    "axis": "z",
    "limit": 1
   }
  },
  {
   "call": "nx_create_blend",
   "setup": true,
   "save": "fil",
   "args": {
    "edges": [
     "$rim.data.items.0.id"
    ],
    "radius": 1
   }
  },
  {
   "call": "nx_create_datum_plane",
   "setup": true,
   "save": "dp",
   "args": {
    "method": "point_normal",
    "origin": [
     0,
     0,
     50
    ],
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_set_feature_order",
   "args": {
    "feature": "$dp.data.feature.id",
    "anchor": "$boss.data.feature.id",
    "position": "before"
   },
   "expect": {
    "data.moved": true,
    "data.feature.name": {
     "matches": "DATUM_PLANE"
    },
    "data.feature.index": 4
   }
  },
  {
   "call": "nx_get_feature",
   "args": {
    "feature": "$dp.data.feature.id"
   },
   "expect": {
    "data.timestamp": 4
   }
  },
  {
   "call": "nx_set_feature_order",
   "args": {
    "feature": "$dp.data.feature.id",
    "anchor": "$boss.data.feature.id",
    "position": "before"
   },
   "expect": {
    "data.moved": false
   }
  },
  {
   "call": "nx_set_feature_order",
   "args": {
    "feature": "$fil.data.feature.id",
    "anchor": "$bs.data.feature.id",
    "position": "before"
   },
   "expect": {
    "error.code": "NX_DEPENDENCY_ORDER",
    "error.details.conflicts": {
     "contains": {
      "relation": "parent"
     }
    }
   }
  },
  {
   "call": "nx_set_feature_order",
   "args": {
    "feature": "$fil.data.feature.id",
    "anchor": "$fil.data.feature.id",
    "position": "after"
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/anchor"
   }
  },
  {
   "call": "nx_measure_volume",
   "args": {
    "body": "$blk.data.bodies.0.id"
   },
   "expect": {
    "volume_mm3": {
     "close": 8386.258351720988,
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_model_health",
   "args": {},
   "expect": {
    "healthy": true
   }
  }
 ]
}
