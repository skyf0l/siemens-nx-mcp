{
 "covers": {"nx_create_face_blend": []},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "base", "args": {"length": 40, "width": 20, "height": 10}},
  {"call": "nx_create_primitive", "setup": true, "args": {"length": 10, "width": 20, "height": 30, "combine": {"operation": "unite", "targets": ["$base.data.bodies.0.id"]}}},
  {"call": "nx_find_geometry", "setup": true, "save": "deck",
   "args": {"owner": "$base.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "wall",
   "args": {"owner": "$base.data.bodies.0.id", "geometry_type": "plane", "normal": [1, 0, 0], "order": "lowest", "axis": "x", "limit": 1}},
  {"call": "nx_create_face_blend",
   "args": {"faces1": ["$deck.data.items.0.id"], "faces2": ["$wall.data.items.0.id"], "radius": 3},
   "expect": {"data.volume": {"close": 12038.62833058846, "tol": 0.001}, "data.radius": {"close": 3, "tol": 1e-06},
              "data.area": {"close": 94.24777960769379, "tol": 0.001}, "data.blend_faces": {"count": 1}, "data.bodies": {"count": 1}}},
  {"call": "nx_find_geometry", "setup": true, "save": "deck2",
   "args": {"owner": "$base.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "end",
   "args": {"owner": "$base.data.bodies.0.id", "geometry_type": "plane", "normal": [1, 0, 0], "order": "highest", "axis": "x", "limit": 1}},
  {"call": "nx_create_face_blend",
   "args": {"faces1": ["$deck2.data.items.0.id"], "faces2": ["$end.data.items.0.id"], "radius": 3},
   "expect": {"error.code": "NX_BUILD_FAILED", "mutation_outcome": "rolled_back", "error.hint": {"contains": "convex edge both true"}}},
  {"call": "nx_find_geometry", "setup": true, "save": "deck3",
   "args": {"owner": "$base.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "end3",
   "args": {"owner": "$base.data.bodies.0.id", "geometry_type": "plane", "normal": [1, 0, 0], "order": "highest", "axis": "x", "limit": 1}},
  {"call": "nx_create_face_blend",
   "args": {"faces1": ["$deck3.data.items.0.id"], "faces2": ["$end3.data.items.0.id"], "radius": "2 mm", "flip1": true, "flip2": true},
   "expect": {"data.volume": {"close": 12021.460183660256, "tol": 0.001}, "data.radius": {"close": 2, "tol": 1e-06}}},
  {"call": "nx_create_sketch", "setup": true, "save": "h", "args": {"placement": "xz"}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$h.data.sketch.id", "curves": [{"type": "line", "start": [0, -100], "end": [0, -80]}, {"type": "line", "start": [0, -80], "end": [40, -80]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$h.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "hull", "args": {"sketch": "$h.data.sketch.id", "end": 15, "symmetric": true}},
  {"call": "nx_find_geometry", "setup": true, "save": "sdeck",
   "args": {"owner": "$hull.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, -1], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "sside",
   "args": {"owner": "$hull.data.bodies.0.id", "geometry_type": "plane", "normal": [1, 0, 0], "limit": 1}},
  {"call": "nx_create_face_blend",
   "args": {"faces1": ["$sdeck.data.items.0.id"], "faces2": ["$sside.data.items.0.id"], "radius": 5},
   "expect": {"data.volume": 0, "data.radius": {"close": 5, "tol": 1e-06}, "data.area": {"close": 235.61944901923448, "tol": 0.001},
              "data.bodies": {"count": 1}}},
  {"call": "nx_create_primitive", "setup": true, "save": "cube", "args": {"origin": [100, 0, 0], "length": 10, "width": 10, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "ctop",
   "args": {"owner": "$cube.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "cside",
   "args": {"owner": "$cube.data.bodies.0.id", "geometry_type": "plane", "normal": [1, 0, 0], "limit": 1}},
  {"call": "nx_create_face_blend",
   "args": {"faces1": ["$ctop.data.items.0.id"], "faces2": ["$cside.data.items.0.id"], "radius": 2, "flip1": true, "flip2": true, "trim": false},
   "expect": {"data.volume": 0, "data.area": {"close": 31.41592653589793, "tol": 0.001}, "data.bodies": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$cube.data.bodies.0.id"]},
   "expect": {"data.volume": {"close": 1000, "tol": 1e-06}}},
  {"call": "nx_create_face_blend",
   "args": {"faces1": ["$ctop.data.items.0.id"], "faces2": ["$ctop.data.items.0.id"], "radius": 2},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/faces2/0", "mutation_outcome": "not_started"}}
 ]
}
