{
 "covers": {
  "nx_edit_faces": [
   "resize",
   "resize_blend",
   "resize_chamfer",
   "pattern",
   "mirror",
   "delete_blend"
  ]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$run/sync_src.prt",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "sk",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$sk.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       100,
       60
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$sk.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "setup": true,
   "save": "src",
   "args": {
    "sketch": "$sk.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 20
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top",
   "args": {
    "kind": "face",
    "geometry_type": "plane",
    "limit": 1,
    "owner": "$src.data.bodies.0.id",
    "normal": [
     0,
     0,
     1
    ],
    "order": "highest",
    "axis": "z"
   }
  },
  {
   "call": "nx_create_hole",
   "setup": true,
   "args": {
    "face": "$top.data.items.0.id",
    "positions": [
     [
      20,
      30,
      20
     ]
    ],
    "form": "simple",
    "diameter": 10,
    "depth": {
     "type": "through_all"
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top",
   "args": {
    "kind": "face",
    "geometry_type": "plane",
