{
 "covers": {"nx_create_datum_axis": ["reference", "intersection"], "nx_create_datum_plane": []},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "a", "args": {"length": 40, "width": 20, "height": 10}},
  {"call": "nx_create_primitive", "setup": true, "save": "c", "args": {"shape": "cylinder", "origin": [100, 0, 0], "diameter": 20, "height": 30}},
  {"call": "nx_find_geometry", "setup": true, "save": "cyl", "args": {"owner": "$c.data.bodies.0.id", "geometry_type": "cylinder", "limit": 1}},
  {"call": "nx_create_datum_axis", "args": {"method": "reference", "reference": "$cyl.data.items.0.id", "name": "BORE_AX"},
   "expect": {"data.origin.0": {"close": 100, "tol": 1e-06}, "data.origin.1": {"close": 0, "tol": 1e-06},
              "data.direction.2": {"matches": "^-?1(\\.0*)?$"}, "data.feature.name": {"matches": "(?i)^bore_ax$"}}},
  {"call": "nx_find_geometry", "setup": true, "save": "edge",
   "args": {"owner": "$a.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [20, 0, 0], "limit": 1}},
  {"call": "nx_create_datum_axis", "args": {"method": "reference", "reference": "$edge.data.items.0.id"},
   "expect": {"data.origin.1": {"close": 0, "tol": 1e-06}, "data.origin.2": {"close": 0, "tol": 1e-06},
              "data.direction.0": {"matches": "^-?1(\\.0*)?$"}}},
  {"call": "nx_find_geometry", "setup": true, "save": "top", "args": {"owner": "$a.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "side", "args": {"owner": "$a.data.bodies.0.id", "geometry_type": "plane", "normal": [1, 0, 0], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "bot", "args": {"owner": "$a.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, -1], "limit": 1}},
  {"call": "nx_create_datum_axis", "args": {"method": "intersection", "planes": ["$top.data.items.0.id", "$side.data.items.0.id"]},
   "expect": {"data.origin.0": {"close": 40, "tol": 1e-06}, "data.origin.2": {"close": 10, "tol": 1e-06},
              "data.direction.1": {"matches": "^-?1(\\.0*)?$"}}},
  {"call": "nx_create_datum_axis", "args": {"method": "intersection", "planes": ["$top.data.items.0.id", "$bot.data.items.0.id"]},
   "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/planes/1", "mutation_outcome": "not_started"}},
  {"call": "nx_create_datum_axis", "args": {"method": "reference", "reference": "$cyl.data.items.0.id", "origin": [0, 0, 0]},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/origin", "mutation_outcome": "not_started"}},
  {"call": "nx_create_datum_plane", "args": {"method": "offset", "reference": "xz", "distance": 10, "points": [[0, 0, 0], [1, 0, 0], [0, 1, 0]]},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/points", "mutation_outcome": "not_started"}},
  {"call": "nx_create_datum_plane", "args": {"method": "offset", "reference": "xz", "distance": 10},
   "expect": {"data.origin.1": {"close": -10, "tol": 1e-06}}}
 ]
}
