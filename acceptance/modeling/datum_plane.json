{
  "covers": {"nx_create_datum_plane": ["offset", "point_normal", "three_points"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"plane": "XY"}},
    {"call": "nx_sketch_rectangle", "setup": true,
     "args": {"sketch_id": "$sk.object.id", "corner1": {"x": 0, "y": 0}, "corner2": {"x": 40, "y": 20}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch_id": "$sk.object.id"}},
    {"call": "nx_extrude", "setup": true, "save": "ext", "args": {"sketch_id": "$sk.object.id", "distance": 10}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "Z", "limit": 1}},
    {"call": "nx_create_datum_plane", "save": "dp1",
     "args": {"method": "offset", "reference": "$top.items.0.object.id", "distance": "15 mm"},
     "expect": {"mutation_outcome": "committed", "data.origin.2": {"close": 25, "tol": 1e-6},
                "data.normal": {"close": [0, 0, 1], "tol": 1e-9}, "changes.created": {"count_kind": {"feature": 1}},
                "changes.references": "preserved", "units.length": "mm"}},
    {"call": "nx_create_datum_plane",
     "args": {"method": "offset", "reference": "$dp1.data.datum_plane.id", "distance": -40},
     "expect": {"data.origin.2": {"close": -15, "tol": 1e-6}, "data.normal": {"close": [0, 0, 1], "tol": 1e-9}}},
    {"call": "nx_create_datum_plane",
     "args": {"method": "offset", "reference": "$top.items.0.object.id", "distance": "0.5 in"},
     "expect": {"data.origin.2": {"close": 22.7, "tol": 1e-6}}},
    {"call": "nx_create_datum_plane",
     "args": {"method": "point_normal", "origin": [5, 5, 5], "normal": [1, 1, 0], "name": "MID_PLANE"},
     "expect": {"data.normal": {"close": [0.7071068, 0.7071068, 0], "tol": 1e-6},
                "data.origin": {"close": [5, 5, 5], "tol": 1e-6}, "data.feature.name": {"matches": "(?i)^mid_plane$"}}},
    {"call": "nx_create_datum_plane",
     "args": {"method": "three_points", "points": [[0, 0, 5], [0, 10, 5], [10, 0, 5]]},
     "expect": {"data.normal": {"close": [0, 0, -1], "tol": 1e-9}, "data.origin.2": {"close": 5, "tol": 1e-6}}},
    {"call": "nx_create_datum_plane",
     "args": {"method": "three_points", "points": [[0, 0, 0], [1, 1, 1], [2, 2, 2]]},
     "expect": {"error.category": "invalid_argument", "error.field": "/points", "mutation_outcome": "not_started"}},
    {"call": "nx_create_datum_plane",
     "args": {"method": "offset", "reference": "$ext.feature.id", "distance": 5},
     "expect": {"error.code": "NX_WRONG_KIND", "mutation_outcome": "not_started"}},
    {"call": "nx_create_datum_plane",
     "args": {"method": "offset", "reference": "$top.items.0.object.id", "distance": "15 deg"},
     "expect": {"error.field": "/distance", "mutation_outcome": "not_started"}},
    {"call": "nx_list_objects", "args": {"kind": "feature", "type": "datum_plane"},
     "expect": {"page.total": 5}}
  ]
}
