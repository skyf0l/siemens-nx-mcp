{
 "covers": {"nx_create_trim_body": ["both", "back"], "nx_create_scale": [], "nx_edit_faces": ["replace"],
            "nx_create_datum_csys": [], "nx_create_datum_point": [], "nx_create_chamfer": ["two_offsets"],
            "nx_create_shell": [], "nx_get_feature": [], "nx_create_loft": [], "nx_get_material": [], "nx_create_text": []},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},

  {"call": "nx_create_primitive", "setup": true, "save": "half", "args": {"length": 40, "width": 20, "height": 10}},
  {"call": "nx_create_trim_body", "intent": "Acceptance: a split by an inline plane labels the side of each piece",
   "args": {"body": "$half.data.bodies.0.id", "tool": {"origin": [10, 0, 0], "normal": [1, 0, 0]}, "keep": "both"},
   "expect": {"data.volume": {"close": 8000, "tol": 0.001}, "data.sides": {"count": 2}, "data.volumes": {"count": 2}}},
  {"call": "nx_create_primitive", "setup": true, "save": "low", "args": {"origin": [100, 0, -5], "length": 40, "width": 20, "height": 10}},
  {"call": "nx_create_trim_body", "intent": "Acceptance: a principal plane trims and keeps the back",
   "args": {"body": "$low.data.bodies.0.id", "tool": "xy"},
   "expect": {"data.volumes.0": {"close": 4000, "tol": 0.001}, "data.sides.0": "back"}},

  {"call": "nx_set_expression", "setup": true, "args": {"name": "shrink", "formula": "2"}},
  {"call": "nx_create_primitive", "setup": true, "save": "cube", "args": {"origin": [200, 0, 0], "length": 10, "width": 10, "height": 10}},
  {"call": "nx_create_scale", "intent": "Acceptance: a scale factor given as an expression keeps driving the scale",
   "args": {"bodies": ["$cube.data.bodies.0.id"], "factor": "shrink", "origin": "center"},
   "expect": {"data.volume": {"close": 8000, "tol": 0.01}}},
  {"call": "nx_set_expression", "args": {"name": "shrink", "formula": "1.5"}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$cube.data.bodies.0.id"]},
   "expect": {"data.volume": {"close": 3375, "tol": 0.01}}},

  {"call": "nx_create_primitive", "setup": true, "save": "a", "args": {"origin": [0, 100, 0], "length": 40, "width": 20, "height": 10}},
  {"call": "nx_create_primitive", "setup": true, "save": "b", "args": {"origin": [100, 100, 20], "length": 40, "width": 20, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "atop", "args": {"owner": "$a.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "bbot", "args": {"owner": "$b.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, -1], "limit": 1}},
  {"call": "nx_edit_faces", "intent": "Acceptance: a replacement face facing the other way replaces the face",
   "args": {"faces": ["$atop.data.items.0.id"], "action": "replace", "replacement": "$bbot.data.items.0.id"},
   "expect": {"data.volume_change": {"close": 8000, "tol": 0.01}}},

  {"call": "nx_create_datum_csys", "intent": "Acceptance: a datum CSYS returns its planes and axes",
   "args": {"origin": [0, 0, 50], "name": "REF"},
   "expect": {"data.planes": {"count": 3}, "data.axes": {"count": 3}, "data.planes.xy.kind": "datum_plane", "data.origin": {"close": [0, 0, 50], "tol": 1e-06}}},
  {"call": "nx_create_datum_csys", "intent": "Acceptance: a second datum of the same name is noted",
   "args": {"origin": [0, 0, 80], "name": "REF"},
   "expect": {"warnings.0.message": {"contains": "already named"}, "data.origin": {"close": [0, 0, 80], "tol": 1e-06}}},
  {"call": "nx_create_datum_point", "intent": "Acceptance: a point far from the origin is noted",
   "args": {"position": [200000, 0, 0]},
   "expect": {"warnings.0.message": {"contains": "from the origin"}, "data.position": {"close": [200000, 0, 0], "tol": 0.001}}},

  {"call": "nx_create_primitive", "setup": true, "save": "ch", "args": {"origin": [300, 0, 0], "length": 40, "width": 20, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "che",
   "args": {"owner": "$ch.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [320, 0, 10], "limit": 1}},
  {"call": "nx_create_chamfer", "intent": "Acceptance: an asymmetric chamfer reports the face each offset runs along",
   "args": {"edges": ["$che.data.items.0.id"], "offset": 3, "offset2": 1},
   "expect": {"data.volume": {"close": 7940, "tol": 0.01}, "data.offset_face.kind": "face", "data.offset2_face.kind": "face"}},

  {"call": "nx_create_primitive", "setup": true, "save": "sb", "args": {"origin": [400, 0, 0], "length": 60, "width": 40, "height": 30}},
  {"call": "nx_find_geometry", "setup": true, "save": "sbtop", "args": {"owner": "$sb.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "sbside", "args": {"owner": "$sb.data.bodies.0.id", "geometry_type": "plane", "normal": [1, 0, 0], "limit": 1}},
  {"call": "nx_create_shell", "save": "shl",
   "args": {"body": "$sb.data.bodies.0.id", "thickness": 2, "remove_faces": ["$sbtop.data.items.0.id"],
            "alternate": [{"faces": ["$sbside.data.items.0.id"], "thickness": 5}]},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_get_feature", "intent": "Acceptance: a shell zone thickness is a length expression",
   "args": {"feature": "$shl.data.feature.id"},
   "expect": {"data.parameters": {"contains": {"units": "mm", "value": -5}}}},
  {"call": "nx_get_feature", "intent": "Acceptance: a block lists the words nx_edit_feature takes",
   "args": {"feature": "$ch.data.feature.id"},
   "expect": {"data.parameters": {"contains": {"aliases": ["length"], "value": 40}}}},

  {"call": "nx_create_sketch", "setup": true, "save": "q1",
   "args": {"placement": "xy", "curves": [{"type": "rectangle", "corner1": [500, 0], "corner2": [520, 20]}], "finish": true}},
  {"call": "nx_create_datum_plane", "setup": true, "save": "z30", "args": {"method": "offset", "reference": "xy", "distance": 30}},
  {"call": "nx_create_sketch", "setup": true, "save": "q2",
   "args": {"placement": {"on": "$z30.data.datum_plane.id"}, "curves": [{"type": "rectangle", "corner1": [500, 0], "corner2": [520, 20]}], "finish": true}},
  {"call": "nx_create_loft", "intent": "Acceptance: a start point off its section is snapped to the nearest corner with a note",
   "args": {"sections": ["$q1.data.sketch.id", "$q2.data.sketch.id"], "start_points": [[600, 600, 0], [520, 20, 30]]},
   "expect": {"data.volume": {"close": 12000, "tol": 0.1}, "data.start_points.0": {"close": [520, 20, 0], "tol": 0.001},
              "warnings.0.message": {"contains": "start_points[0]"}}},
  {"call": "nx_create_sketch", "setup": true, "save": "l1",
   "args": {"placement": "xy", "curves": [{"type": "line", "start": [700, 0], "end": [720, 0]}], "finish": true}},
  {"call": "nx_create_sketch", "setup": true, "save": "l2",
   "args": {"placement": {"on": "$z30.data.datum_plane.id"}, "curves": [{"type": "line", "start": [700, 0], "end": [720, 0]}], "finish": true}},
  {"call": "nx_create_loft", "save": "sheet", "intent": "Acceptance: a sheet loft reports its area",
   "args": {"sections": ["$l1.data.sketch.id", "$l2.data.sketch.id"], "solid": false},
   "expect": {"data.area": {"close": 600, "tol": 0.01}}},
  {"call": "nx_get_material", "intent": "Acceptance: sheet bodies are marked as such",
   "args": {"bodies": ["$sheet.data.bodies.0.id"]},
   "expect": {"data.items.0.solid": false, "data.items": {"count": 1}}},

  {"call": "nx_create_primitive", "setup": true, "save": "rod", "args": {"shape": "cylinder", "diameter": 30, "height": 10, "origin": [800, 0, 0]}},
  {"call": "nx_find_geometry", "setup": true, "save": "rim",
   "args": {"owner": "$rod.data.bodies.0.id", "kind": "edge", "geometry_type": "circle", "order": "nearest", "near": [815, 0, 10], "limit": 1}},
  {"call": "nx_create_text", "intent": "Acceptance: text on a path takes the side word center",
   "args": {"text": "AB", "path": ["$rim.data.items.0.id"], "height": 3, "anchor": "center"},
   "expect": {"mutation_outcome": "committed", "data.curves": {"matches": "^[1-9]"}}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
 ]
}
