{
 "covers": {"nx_create_draft": [], "nx_create_draft_body": [], "nx_create_patch_body": [], "nx_edit_faces": ["move"],
            "nx_create_trim_body": ["front"], "nx_edit_face_relation": ["tangent", "coplanar"], "nx_create_blend_corner": [],
            "nx_create_unsew": ["faces"]},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "a", "args": {"length": 40, "width": 20, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "aside",
   "args": {"owner": "$a.data.bodies.0.id", "geometry_type": "plane", "normal": [1, 0, 0], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "abot",
   "args": {"owner": "$a.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, -1], "limit": 1}},
  {"call": "nx_create_draft",
   "args": {"faces": ["$aside.data.items.0.id"], "stationary_face": "$abot.data.items.0.id", "direction": [1, 0, 0], "angle": 3},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/direction", "mutation_outcome": "not_started"}},
  {"call": "nx_create_draft",
   "args": {"faces": ["$aside.data.items.0.id"], "stationary_face": "$abot.data.items.0.id", "direction": "z", "angle": 5},
   "expect": {"data.volume": {"close": 7912.511336474076, "tol": 0.0001}, "warnings": {"count": 0}}},

  {"call": "nx_create_primitive", "setup": true, "save": "b", "args": {"origin": [100, 0, 0], "length": 100, "width": 60, "height": 20}},
  {"call": "nx_find_geometry", "setup": true, "save": "bside",
   "args": {"owner": "$b.data.bodies.0.id", "geometry_type": "plane", "normal": [1, 0, 0], "limit": 1}},
  {"call": "nx_create_draft_body",
   "args": {"faces": ["$bside.data.items.0.id"], "parting": {"origin": [0, 0, 50], "normal": [0, 0, 1]}, "direction": "z",
            "angle": 3, "match": "none"},
   "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/faces/0", "mutation_outcome": "not_started"}},
  {"call": "nx_create_draft_body",
   "args": {"faces": ["$bside.data.items.0.id"], "parting": {"origin": [0, 0, 10], "normal": [0, 0, 1]}, "direction": "z", "angle": 3},
   "expect": {"mutation_outcome": "committed", "data.faces.0.at_angle": true, "data.faces.0.angle": {"close": 3, "tol": 0.01}}},
  {"call": "nx_measure_bounds", "args": {"bodies": ["$b.data.bodies.0.id"]},
   "expect": {"data.min.2": {"close": 0, "tol": 1e-06}, "data.max.2": {"close": 20, "tol": 1e-06}}},

  {"call": "nx_create_primitive", "setup": true, "save": "c", "args": {"origin": [300, 0, 0], "length": 40, "width": 40, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "ctop",
   "args": {"owner": "$c.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_create_hole", "setup": true, "args": {"face": "$ctop.data.items.0.id", "positions": [[320, 20, 10]], "diameter": 8, "depth": "through_all"}},
  {"call": "nx_find_geometry", "setup": true, "save": "bore",
   "args": {"owner": "$c.data.bodies.0.id", "geometry_type": "cylinder", "limit": 1}},
  {"call": "nx_edit_faces", "args": {"faces": ["$bore.data.items.0.id"], "action": "move", "direction": [0, 1, 0], "distance": 8},
   "expect": {"mutation_outcome": "committed", "data.volume_change": {"close": 0, "tol": 0.001}}},
  {"call": "nx_find_geometry", "setup": true, "save": "cfront",
   "args": {"owner": "$c.data.bodies.0.id", "geometry_type": "plane", "normal": [0, -1, 0], "limit": 1}},
  {"call": "nx_measure_distance", "args": {"first": "$bore.data.items.0.id", "second": "$cfront.data.items.0.id"},
   "expect": {"data.distance": {"close": 24, "tol": 1e-05}}},

  {"call": "nx_create_primitive", "setup": true, "save": "t", "args": {"origin": [400, 0, 0], "length": 40, "width": 20, "height": 20}},
  {"call": "nx_create_primitive", "setup": true, "save": "u", "args": {"origin": [500, 0, 0], "length": 10, "width": 10, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "utop",
   "args": {"owner": "$u.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_create_trim_body", "args": {"body": "$t.data.bodies.0.id", "tool": "$utop.data.items.0.id", "keep": "front"},
   "expect": {"data.volume": {"close": 8000, "tol": 0.001}}},
  {"call": "nx_measure_bounds", "args": {"bodies": ["$t.data.bodies.0.id"]},
   "expect": {"data.min.2": {"close": 10, "tol": 1e-06}, "data.max.2": {"close": 20, "tol": 1e-06}}},

  {"call": "nx_create_primitive", "setup": true, "save": "s", "args": {"origin": [600, 0, 0], "length": 40, "width": 20, "height": 10}},
  {"call": "nx_create_primitive", "setup": true,
   "args": {"origin": [600, 0, 0], "length": 20, "width": 20, "height": 15, "combine": {"operation": "unite", "targets": ["$s.data.bodies.0.id"]}}},
  {"call": "nx_find_geometry", "setup": true, "save": "low",
   "args": {"owner": "$s.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "order": "nearest", "near": [630, 10, 10], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "high",
   "args": {"owner": "$s.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "order": "nearest", "near": [610, 10, 15], "limit": 1}},
  {"call": "nx_edit_face_relation", "args": {"face": "$low.data.items.0.id", "relation": "coplanar", "to": "$high.data.items.0.id"},
   "expect": {"mutation_outcome": "committed", "data.gap": {"close": 0, "tol": 1e-06}, "data.volume_change": {"close": 2000, "tol": 0.001}}},

  {"call": "nx_create_primitive", "setup": true, "save": "w", "args": {"origin": [800, 0, 0], "length": 10, "width": 20, "height": 30}},
  {"call": "nx_find_geometry", "setup": true, "save": "wall",
   "args": {"owner": "$w.data.bodies.0.id", "geometry_type": "plane", "normal": [-1, 0, 0], "limit": 1}},
  {"call": "nx_create_primitive", "setup": true, "save": "boss",
   "args": {"shape": "cylinder", "origin": [790, 10, 0], "diameter": 8, "height": 10}},
  {"call": "nx_find_geometry", "setup": true, "save": "bossside",
   "args": {"owner": "$boss.data.bodies.0.id", "geometry_type": "cylinder", "limit": 1}},
  {"call": "nx_edit_face_relation", "args": {"face": "$bossside.data.items.0.id", "relation": "tangent", "to": "$wall.data.items.0.id"},
   "expect": {"mutation_outcome": "committed", "data.angle": {"close": 90, "tol": 0.001}, "data.gap": {"close": 0, "tol": 1e-05}}},

  {"call": "nx_create_primitive", "setup": true, "save": "k", "args": {"origin": [900, 0, 0], "length": 40, "width": 40, "height": 40}},
  {"call": "nx_find_geometry", "setup": true, "save": "ke",
   "args": {"owner": "$k.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [940, 40, 40], "limit": 3}},
  {"call": "nx_create_blend_corner",
   "args": {"edges": ["$ke.data.items.0.id", "$ke.data.items.1.id", "$ke.data.items.2.id"], "radius": 5, "setback": 12},
   "expect": {"data.volume": {"close": 63139.33756275438, "tol": 0.01}, "data.blend_ends": {"count": 3},
              "data.blend_ends.0": {"close": 17, "tol": 0.5}}},

  {"call": "nx_create_primitive", "setup": true, "save": "m", "args": {"origin": [1000, 0, 0], "length": 40, "width": 30, "height": 20}},
  {"call": "nx_find_geometry", "setup": true, "save": "mtop",
   "args": {"owner": "$m.data.bodies.0.id", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1}},
  {"call": "nx_create_unsew", "save": "us", "args": {"by": "faces", "faces": ["$mtop.data.items.0.id"]},
   "expect": {"data.count": 2, "data.sheets": {"count": 2}, "data.area": {"close": 5200, "tol": 0.001}}},
  {"call": "nx_create_primitive", "setup": true, "save": "n", "args": {"origin": [1100, 0, 0], "length": 40, "width": 30, "height": 20}},
  {"call": "nx_create_patch_body", "args": {"body": "$n.data.bodies.0.id", "sheet": "$us.data.sheets.0.body.id", "hole": true},
   "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/sheet", "mutation_outcome": "not_started", "error.details.open_loops": 1}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
 ]
}
