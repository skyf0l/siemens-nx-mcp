{
 "covers": {
  "nx_create_thread": [],
  "nx_create_blend": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [80, 20]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "blk",
   "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
  {"call": "nx_find_geometry", "setup": true, "save": "top",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1, "order": "highest", "axis": "z"}},
  {"call": "nx_find_geometry", "setup": true, "save": "bottom",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, -1], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "front",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, -1, 0], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "back",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 1, 0], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "edge",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [40, 0, 10], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "far_edge",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [40, 20, 0], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "left_edge", "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [0, 10, 0], "limit": 1}},
  {"call": "nx_create_hole",
   "args": {"face": "$top.data.items.0.id", "positions": [[10, 10, 10], [30, 10, 10], [50, 10, 10], [70, 10, 10]], "form": "simple", "diameter": 5, "depth": {"type": "distance", "value": 8}},
   "expect": {"mutation_outcome": "committed", "changes.references": "preserved"}},
  {"call": "nx_find_geometry", "setup": true, "save": "holes",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "cylinder", "order": "nearest", "near": [0, 10, 5], "limit": 10}},
  {"call": "nx_create_thread",
   "args": {"face": "$holes.data.items.0.id", "start_face": "$top.data.items.0.id", "length": 5, "spec": {"standard": "Metric Coarse", "size": "M6 x 1.0", "method": "CUT", "engagement": "0.75"}},
   "expect": {"mutation_outcome": "committed", "changes.references": "preserved"}},
  {"call": "nx_create_thread",
   "args": {"face": "$holes.data.items.1.id", "start_face": "$top.data.items.0.id", "length": 5, "spec": {"standard": "Metric Coarse", "size": "M6 x 1.0", "method": "CUT", "engagement": "0.75"}},
   "expect": {"mutation_outcome": "committed", "changes.references": "preserved"}},
  {"call": "nx_create_thread",
   "args": {"face": "$holes.data.items.2.id", "start_face": "$top.data.items.0.id", "length": 5, "spec": {"standard": "Metric Coarse", "size": "M6 x 1.0", "method": "CUT", "engagement": "0.75"}},
   "expect": {"mutation_outcome": "committed", "changes.references": "preserved"}},
  {"call": "nx_create_thread",
   "args": {"face": "$holes.data.items.3.id", "start_face": "$top.data.items.0.id", "length": 5, "spec": {"standard": "Metric Coarse", "size": "M6 x 1.0", "method": "CUT", "engagement": "0.75"}},
   "expect": {"mutation_outcome": "committed", "changes.references": "preserved"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk2", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$sk2.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [20, 14], "corner2": [60, 18]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk2.data.sketch.id"}},
  {"call": "nx_create_extrude",
   "args": {"sketch": "$sk2.data.sketch.id", "start": {"type": "distance", "value": 7}, "end": {"type": "distance", "value": 12}, "combine": {"operation": "subtract", "targets": ["$blk.data.bodies.0.id"]}},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_measure_distance",
   "args": {"first": "$top.data.items.0.id", "second": "$bottom.data.items.0.id"},
   "expect": {"data.distance": {"close": 10, "tol": 1e-06}}},
  {"call": "nx_create_blend", "args": {"edges": ["$edge.data.items.0.id"], "radius": 2},
   "expect": {"mutation_outcome": "committed", "changes.references": "listed", "changes.stale_refs": {"count": 1}}},
  {"call": "nx_measure_distance",
   "args": {"first": "$front.data.items.0.id", "second": "$back.data.items.0.id"},
   "expect": {"data.distance": {"close": 20, "tol": 1e-06}}},
  {"call": "nx_create_blend", "args": {"edges": ["$far_edge.data.items.0.id"], "radius": 1},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_create_blend", "args": {"edges": ["$edge.data.items.0.id"], "radius": 1},
   "expect": {"error.code": "NX_STALE_REFERENCE", "error.hint": {"contains": "nx_find_geometry"}}},
  {"call": "nx_create_chamfer", "args": {"edges": ["$left_edge.data.items.0.id"], "offset": 1}, "intent": "Acceptance: a ref of an untouched edge from before the hole, threads and blends still chamfers (live claim: every edge ref goes stale after a blend)", "expect": {"mutation_outcome": "committed", "changes.stale_refs": {"count": 1}, "changes.stale_refs.0": "$left_edge.data.items.0.id"}}
 ]
}
