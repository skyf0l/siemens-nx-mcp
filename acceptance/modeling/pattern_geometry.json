{
  "covers": {"nx_create_pattern": ["linear", "circular"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sd",
     "args": {"placement": {"principal": "xy"},
              "curves": [{"type": "circle", "center": [0, 0], "radius": 50}], "finish": true}},
    {"call": "nx_create_extrude", "setup": true, "save": "disk",
     "args": {"sketch": "$sd.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_sketch", "setup": true, "save": "st",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, 10]},
              "curves": [{"type": "rectangle", "corner1": [20, -2], "corner2": [45, 2]}], "finish": true}},
    {"call": "nx_create_extrude", "setup": true, "save": "top",
     "args": {"sketch": "$st.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"data.volume": {"close": 1000, "tol": 0.01}}},
    {"call": "nx_create_pattern", "save": "pb",
     "intent": "Pattern a whole body (Pattern Geometry) circularly: every copy is a separate body and listed",
     "args": {"bodies": ["$top.data.bodies.0.id"], "layout": "circular",
              "parameters": {"axis": "z", "count": 8, "angle": 45}},
     "expect": {"mutation_outcome": "committed", "data.count": 8, "data.new_bodies": 7,
                "data.bodies": {"count": 8}, "data.volume": {"close": 8000, "tol": 0.01},
                "data.feature.kind": "feature"}},
    {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"page.total": 9}},
    {"call": "nx_create_sketch", "setup": true, "save": "sb",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, -10]},
              "curves": [{"type": "rectangle", "corner1": [20, -2], "corner2": [45, 2]}], "finish": true}},
    {"call": "nx_create_extrude", "setup": true, "save": "under",
     "args": {"sketch": "$sb.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_pattern", "save": "pu",
     "intent": "Pattern a body under the disk 6 times and unite the seed and every copy into the disk",
     "args": {"bodies": ["$under.data.bodies.0.id"], "layout": "circular", "unite_into": "$disk.data.bodies.0.id",
              "parameters": {"axis": "z", "count": 6, "angle": 60}},
     "expect": {"mutation_outcome": "committed", "data.count": 6, "data.new_bodies": 0, "data.united": 6,
                "data.bodies": {"count": 1}, "data.volume": {"close": 84539.8163, "tol": 0.01},
                "data.unite_feature.kind": "feature"}},
    {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"page.total": 9}},
    {"call": "nx_create_sketch", "setup": true, "save": "sf",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, -10]},
              "curves": [{"type": "polyline", "closed": true,
                          "points": [[18.320508, 8.267949], [39.971143, 20.767949],
                                     [37.971143, 24.232051], [16.320508, 11.732051]]}],
              "finish": true}},
    {"call": "nx_create_extrude", "setup": true, "save": "rib",
     "args": {"sketch": "$sf.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_pattern", "save": "pf",
     "intent": "Feature pattern of a seed with its own body, every instance united into another body (the disk)",
     "args": {"features": ["$rib.data.feature.id"], "layout": "circular", "unite_into": "$disk.data.bodies.0.id",
              "parameters": {"axis": "z", "count": 6, "angle": 60}},
     "expect": {"mutation_outcome": "committed", "data.count": 6, "data.new_bodies": 0, "data.united": 6,
                "data.bodies": {"count": 1}, "data.volume": {"close": 90539.8163, "tol": 0.05}}},
    {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"page.total": 9}},
    {"call": "nx_create_sketch", "setup": true, "save": "sx",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, 100]},
              "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [5, 5]}], "finish": true}},
    {"call": "nx_create_extrude", "setup": true, "save": "far",
     "args": {"sketch": "$sx.data.sketch.id", "end": {"type": "distance", "value": 5}}},
    {"call": "nx_create_pattern",
     "intent": "Copies that do not touch the unite_into body: the call rolls back with the unite_into hint",
     "args": {"bodies": ["$far.data.bodies.0.id"], "layout": "linear", "unite_into": "$disk.data.bodies.0.id",
              "parameters": {"direction": "x", "count": 3, "spacing": 10}},
     "expect": {"error.code": "NX_BUILD_FAILED", "error.hint": {"contains": "unite_into"},
                "mutation_outcome": "rolled_back"}},
    {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"page.total": 10}},
    {"call": "nx_create_pattern",
     "args": {"bodies": ["$far.data.bodies.0.id"], "features": ["$far.data.feature.id"], "layout": "linear",
              "parameters": {"direction": "x", "count": 2, "spacing": 10}},
     "expect": {"error.field": "/bodies", "mutation_outcome": "not_started"}},
    {"call": "nx_create_pattern",
     "args": {"bodies": ["$far.data.bodies.0.id"], "layout": "linear", "unite": true,
              "unite_into": "$disk.data.bodies.0.id", "parameters": {"direction": "x", "count": 2, "spacing": 10}},
     "expect": {"error.field": "/unite_into", "mutation_outcome": "not_started"}},
    {"call": "nx_check_model", "expect": {"data.healthy": true}}
  ]
}
