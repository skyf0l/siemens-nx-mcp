{
  "covers": {"nx_create_loft": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s0",
     "args": {"placement": {"principal": "xy"}, "finish": true,
              "curves": [{"type": "spline", "closed": true,
                          "points": [[10.0, 0.0], [9.238795, 3.826834], [7.071068, 7.071068], [3.826834, 9.238795],
                                     [0.0, 10.0], [-3.826834, 9.238795], [-7.071068, 7.071068], [-9.238795, 3.826834],
                                     [-10.0, 0.0], [-9.238795, -3.826834], [-7.071068, -7.071068], [-3.826834, -9.238795],
                                     [0.0, -10.0], [3.826834, -9.238795], [7.071068, -7.071068], [9.238795, -3.826834]]}]}},
    {"call": "nx_create_spline", "setup": true, "save": "c30",
     "args": {"periodic": true,
              "points": [[10.0, 0.0, 30], [9.238795, 3.826834, 30], [7.071068, 7.071068, 30], [3.826834, 9.238795, 30],
                         [0.0, 10.0, 30], [-3.826834, 9.238795, 30], [-7.071068, 7.071068, 30], [-9.238795, 3.826834, 30],
                         [-10.0, 0.0, 30], [-9.238795, -3.826834, 30], [-7.071068, -7.071068, 30], [-3.826834, -9.238795, 30],
                         [0.0, -10.0, 30], [3.826834, -9.238795, 30], [7.071068, -7.071068, 30], [9.238795, -3.826834, 30]]}},
    {"call": "nx_create_loft", "save": "lc",
     "intent": "Loft from a sketch spline section to a 3D spline curve section: about a cylinder r 10 x 30",
     "args": {"sections": ["$s0.data.sketch.id", "$c30.data.curve.id"]},
     "expect": {"mutation_outcome": "committed", "data.bodies": {"count": 1},
                "data.volume": {"close": 9424.78, "tol": 15}}},
    {"call": "nx_create_sketch", "setup": true, "save": "q1",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, 100]}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [-10, -10], "corner2": [10, 10]}]}},
    {"call": "nx_create_sketch", "setup": true, "save": "q2",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, 130]}, "finish": true,
              "curves": [{"type": "rectangle", "corner1": [-10, -10], "corner2": [10, 10]}]}},
    {"call": "nx_create_loft", "save": "lq",
     "intent": "Sections given as lists of curves (the sketches' lines): a 20 x 20 x 30 block",
     "args": {"sections": [["$q1.data.curves.0.id", "$q1.data.curves.1.id", "$q1.data.curves.2.id", "$q1.data.curves.3.id"],
                           ["$q2.data.curves.0.id", "$q2.data.curves.1.id", "$q2.data.curves.2.id", "$q2.data.curves.3.id"]]},
     "expect": {"mutation_outcome": "committed", "data.bodies": {"count": 1},
                "data.volume": {"close": 12000, "tol": 0.01}}},
    {"call": "nx_create_loft",
     "args": {"sections": ["$q1.data.sketch.id", ["$q2.data.curves.0.id", "$q2.data.curves.0.id"]]},
     "expect": {"error.field": "/sections/1/1", "mutation_outcome": "not_started"}},
    {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"page.total": 2}},
    {"call": "nx_check_model", "expect": {"data.healthy": true}}
  ]
}
