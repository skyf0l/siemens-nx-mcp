{
 "covers": {
  "nx_list_materials": [],
  "nx_get_material": [],
  "nx_set_material": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "blk_sk",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$blk_sk.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       40,
       20
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$blk_sk.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "save": "blk",
   "args": {
    "sketch": "$blk_sk.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 10
    }
   },
   "setup": true
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "b2_sk",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$b2_sk.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       100,
       0
      ],
      "corner2": [
       140,
       20
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$b2_sk.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "save": "b2",
   "args": {
    "sketch": "$b2_sk.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 10
    }
   },
   "setup": true
  },
  {
   "call": "nx_get_material",
   "args": {},
   "expect": {
    "data.items": {
     "count": 2
    },
    "data.items.0.density": {
     "close": 7830.64,
     "tol": 1e-06
    },
    "warnings": {
     "contains": {
      "code": "NX_NOTE"
     }
    },
    "warnings.0.message": {
     "matches": "2 of 2 bodies have no material"
    }
   }
  },
  {
   "call": "nx_get_material",
   "args": {
    "scope": "assembly"
   },
   "expect": {
    "data.items": {
     "count": 0
    },
    "warnings": {
     "contains": {
      "code": "NX_NOTE"
     }
    },
    "warnings.0.message": {
     "matches": "no components"
    }
   }
  },
  {
   "call": "nx_list_materials",
   "args": {
    "query": "steel"
   },
   "expect": {
    "data.items.0.name": "Steel",
    "data.items.0.density": {
     "close": 7829,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_list_materials",
   "args": {
    "query": "aluminium 6061"
   },
   "expect": {
    "data.items": {
     "count": 1
    },
    "data.items.0.name": "Aluminum_6061",
    "data.items.0.density": {
     "close": 2711,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_list_materials",
   "args": {
    "query": "unobtainium"
   },
   "expect": {
    "data.items": {
     "count": 0
    },
    "warnings": {
     "contains": {
      "code": "NX_NOTE"
     }
    }
   }
  },
  {
   "call": "nx_set_material",
   "args": {
    "bodies": [
     "$blk.data.bodies.0.id"
    ],
    "material": "steel"
   },
   "expect": {
    "data.items.0.material": "Steel",
    "data.items.0.density": {
     "close": 7829,
     "tol": 1e-06
    },
    "mutation_outcome": "committed"
   }
  },
  {
   "call": "nx_measure_mass",
   "args": {
    "bodies": [
     "$blk.data.bodies.0.id"
    ]
   },
   "expect": {
    "data.mass": {
     "close": 0.062632,
     "tol": 1e-09
    }
   }
  },
  {
   "call": "nx_set_material",
   "args": {
    "bodies": [
     "$b2.data.bodies.0.id"
    ],
    "material": {
     "library": "aluminium 6061"
    }
   },
   "expect": {
    "data.items.0.material": "Aluminum_6061",
    "data.items.0.density": {
     "close": 2711,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_set_material",
   "args": {
    "bodies": [
     "$b2.data.bodies.0.id"
    ],
    "material": "Aluminium"
   },
   "expect": {
    "error.code": "NX_NOT_FOUND",
    "error.field": "/material",
    "error.details.candidates": {
     "contains": "Aluminum_6061"
    },
    "error.message": {
     "matches": "did you mean"
    }
   }
  },
  {
   "call": "nx_set_material",
   "args": {
    "bodies": [
     "$b2.data.bodies.0.id"
    ],
    "material": {
     "library": "Steel",
     "custom": {
      "name": "MDL_X",
      "density": 1000
     }
    }
   },
   "expect": {
    "error.code": "NX_INVALID_ARGUMENT",
    "error.field": "/material",
    "mutation_outcome": "not_started",
    "error.message": {
     "matches": "not both"
    }
   }
  },
  {
   "call": "nx_set_material",
   "args": {
    "bodies": [
     "$b2.data.bodies.0.id"
    ],
    "material": {}
   },
   "expect": {
    "error.code": "NX_INVALID_ARGUMENT",
    "error.field": "/material",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_set_material",
   "args": {
    "bodies": [
     "$b2.data.bodies.0.id"
    ],
    "material": {
     "custom": {
      "name": "MDL_PLA",
      "density": "1.2 furlongs"
     }
    }
   },
   "expect": {
    "error.code": "NX_INVALID_ARGUMENT",
    "error.field": "/material/custom/density",
    "mutation_outcome": "not_started",
    "error.hint": {
     "matches": "g/cm3"
    }
   }
  },
  {
   "call": "nx_set_material",
   "args": {
    "bodies": [
     "$b2.data.bodies.0.id"
    ],
    "material": {
     "custom": {
      "name": "MDL_PLA",
      "density": "1.24 g/cm3"
     }
    }
   },
   "expect": {
    "data.items.0.material": "MDL_PLA",
    "data.items.0.library": null,
    "data.items.0.density": {
     "close": 1240,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_measure_mass",
   "args": {
    "bodies": [
     "$b2.data.bodies.0.id"
    ]
   },
   "expect": {
    "data.volume": {
     "close": 8000,
     "tol": 1e-06
    },
    "data.mass": {
     "close": 0.00992,
     "tol": 1e-09
    }
   }
  },
  {
   "call": "nx_set_material",
   "args": {
    "bodies": [
     "$blk.data.bodies.0.id"
    ],
    "material": {
     "custom": {
      "name": "mdl_pla",
      "density": 1300
     }
    }
   },
   "expect": {
    "error.code": "NX_ALREADY_EXISTS",
    "mutation_outcome": "not_started",
    "error.details.free_name": "MDL_PLA_1300",
    "error.details.existing_density": {
     "close": 1240,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_get_material",
   "args": {
    "bodies": [
     "$blk.data.bodies.0.id"
    ]
   },
   "expect": {
    "data.items.0.material": "Steel",
    "data.items.0.density": {
     "close": 7829,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_set_material",
   "args": {
    "bodies": [
     "$blk.data.bodies.0.id"
    ],
    "material": "MDL_PLA"
   },
   "expect": {
    "data.items.0.material": "MDL_PLA",
    "data.items.0.library": null,
    "data.items.0.density": {
     "close": 1240,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_measure_mass",
   "args": {
    "bodies": [
     "$blk.data.bodies.0.id",
     "$b2.data.bodies.0.id"
    ]
   },
   "expect": {
    "data.mass": {
     "close": 0.01984,
     "tol": 1e-09
    }
   }
  }
 ]
}
