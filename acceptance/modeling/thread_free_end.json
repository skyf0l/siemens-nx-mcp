{
  "covers": {
    "nx_create_thread": []
  },
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_primitive", "setup": true, "save": "shaft",
     "args": {"shape": "cylinder", "origin": [0, 0, 0], "diameter": 6, "height": 20}},
    {"call": "nx_create_primitive", "setup": true,
     "args": {"shape": "cylinder", "origin": [0, 0, 20], "diameter": 10, "height": 4,
              "combine": {"operation": "unite", "targets": ["$shaft.data.bodies.0.id"]}}},
    {"call": "nx_find_geometry", "setup": true, "save": "shank",
     "args": {"kind": "face", "geometry_type": "cylinder", "radius": 3, "near": [3, 0, 10], "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "tip",
     "args": {"kind": "face", "normal": "-z", "near": [0, 0, 0], "limit": 1}},
    {"call": "nx_create_thread", "args": {"face": "$shank.data.items.0.id", "spec": {"size": "M6"}},
     "expect": {"mutation_outcome": "committed", "data.internal": false, "data.start_face.id": "$tip.data.items.0.id",
                "data.length": {"close": 20, "tol": 1e-6}, "data.size": "M6 x 1.0",
                "data.volume": {"close": 879.645943005142, "tol": 1e-6}}},
    {"call": "nx_create_primitive", "setup": true, "save": "plate",
     "args": {"shape": "block", "origin": [20, -15, 0], "length": 30, "width": 30, "height": 15}},
    {"call": "nx_create_primitive", "setup": true,
     "args": {"shape": "cylinder", "origin": [35, -7, 5], "diameter": 5, "height": 10,
              "combine": {"operation": "subtract", "targets": ["$plate.data.bodies.0.id"]}}},
    {"call": "nx_create_primitive", "setup": true,
     "args": {"shape": "cylinder", "origin": [35, 7, 0], "diameter": 5, "height": 15,
              "combine": {"operation": "subtract", "targets": ["$plate.data.bodies.0.id"]}}},
    {"call": "nx_find_geometry", "setup": true, "save": "blind",
     "args": {"kind": "face", "geometry_type": "cylinder", "near": [35, -9.5, 10], "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "through",
     "args": {"kind": "face", "geometry_type": "cylinder", "near": [35, 9.5, 10], "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "ptop",
     "args": {"kind": "face", "normal": "+z", "near": [25, -10, 15], "limit": 1}},
    {"call": "nx_create_thread", "args": {"face": "$blind.data.items.0.id", "spec": {"size": "M6"}},
     "expect": {"mutation_outcome": "committed", "data.internal": true, "data.start_face.id": "$ptop.data.items.0.id",
                "data.length": {"close": 10, "tol": 1e-6}}},
    {"call": "nx_create_thread", "args": {"face": "$through.data.items.0.id", "spec": {"size": "M6"}},
     "expect": {"error.field": "/start_face", "error.details.candidates": {"count": 2},
                "error.message": {"contains": "both free or both meeting larger faces"}}},
    {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
  ]
}
