{
 "covers": {
  "nx_edit_edges": [
   "move",
   "offset"
  ]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "a",
   "args": {
    "shape": "block",
    "origin": [
     0,
     0,
     0
    ],
    "length": 20,
    "width": 20,
    "height": 10
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "b",
   "args": {
    "shape": "block",
    "origin": [
     50,
     0,
     0
    ],
    "length": 20,
    "width": 20,
    "height": 10
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "c",
   "args": {
    "shape": "block",
    "origin": [
     100,
     0,
     0
    ],
    "length": 20,
    "width": 20,
    "height": 10
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e1",
   "args": {
    "owner": "$a.data.bodies.0.id",
    "kind": "edge",
    "order": "nearest",
    "near": [
     10,
     20,
     10
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_edit_edges",
   "args": {
    "edges": [
     "$e1.data.items.0.id"
    ],
    "action": "move",
    "distance": 3,
    "direction": "z"
   },
   "expect": {
    "data.volume": {
     "close": 4600.0,
     "tol": 1e-06
    },
    "data.moved": {
     "close": [
      3.0
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_measure_bounds",
   "args": {
    "bodies": [
     "$a.data.bodies.0.id"
    ],
    "precision": "exact"
   },
   "expect": {
    "data.max": {
     "close": [
      20,
      20,
      13
     ],
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e2",
   "args": {
    "owner": "$b.data.bodies.0.id",
    "kind": "edge",
    "order": "nearest",
    "near": [
     60,
     0,
     10
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "bfront",
   "args": {
    "owner": "$b.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "order": "nearest",
    "near": [
     60,
     0,
     5
    ],
    "limit": 1,
    "normal": [
     0,
     -1,
     0
    ]
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "btop",
   "args": {
    "owner": "$b.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "order": "nearest",
    "near": [
     60,
     10,
     10
    ],
    "limit": 1,
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_edit_edges",
   "args": {
    "edges": [
     "$e2.data.items.0.id"
    ],
    "action": "offset",
    "distance": 3,
    "along": "$bfront.data.items.0.id"
   },
   "expect": {
    "data.volume": {
     "close": 4600.0,
     "tol": 1e-06
    },
    "data.moved": {
     "close": [
      3.0
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_measure_bounds",
   "args": {
    "bodies": [
     "$b.data.bodies.0.id"
    ],
    "precision": "exact"
   },
   "expect": {
    "data.max": {
     "close": [
      70,
      20,
      13
     ],
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e3",
   "args": {
    "owner": "$c.data.bodies.0.id",
    "kind": "edge",
    "order": "nearest",
    "near": [
     110,
     0,
     10
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "ctop",
   "args": {
    "owner": "$c.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "order": "nearest",
    "near": [
     110,
     10,
     10
    ],
    "limit": 1,
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_edit_edges",
   "args": {
    "edges": [
     "$e3.data.items.0.id"
    ],
    "action": "offset",
    "distance": -3,
    "along": "$ctop.data.items.0.id"
   },
   "expect": {
    "data.volume": {
     "close": 3700.0,
     "tol": 1e-06
    },
    "data.moved": {
     "close": [
      3.0
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_measure_bounds",
   "args": {
    "bodies": [
     "$c.data.bodies.0.id"
    ],
    "precision": "exact"
   },
   "expect": {
    "data.min": {
     "close": [
      100,
      0,
      0
     ],
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_check_model",
   "args": {},
   "expect": {
    "data.healthy": {
     "equals": true
    }
   }
  },
  {
   "call": "nx_edit_edges",
   "args": {
    "edges": [
     "$e3.data.items.0.id"
    ],
    "action": "offset",
    "distance": 2,
    "direction": "z"
   },
   "expect": {
    "error.field": "/direction",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_edit_edges",
   "args": {
    "edges": [
     "$e3.data.items.0.id"
    ],
    "action": "offset",
    "distance": 2,
    "along": "$btop.data.items.0.id"
   },
   "expect": {
    "error.code": "NX_WRONG_GEOMETRY",
    "mutation_outcome": "not_started"
   }
  }
 ]
}
