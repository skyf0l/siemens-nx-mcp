{
 "covers": {
  "nx_create_intersection_curve": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "blk",
   "args": {
    "shape": "block",
    "length": 100,
    "width": 50,
    "height": 20
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "cyl",
   "args": {
    "shape": "cylinder",
    "diameter": 40,
    "height": 30,
    "origin": [
     200,
     0,
     0
    ]
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "lid",
   "args": {
    "shape": "block",
    "length": 60,
    "width": 60,
    "height": 5,
    "origin": [
     170,
     -30,
     10
    ]
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "side",
   "args": {
    "owner": "$cyl.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "cylinder"
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "lidtop",
   "args": {
    "owner": "$lid.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "order": "highest",
    "axis": "z"
   }
  },
  {
   "call": "nx_create_intersection_curve",
   "intent": "Cylinder r 20 side with z 10: a full circle",
   "args": {
    "first": [
     "$side.data.items.0.id"
    ],
    "plane": {
     "origin": [
      0,
      0,
      10
     ],
     "normal": [
      0,
      0,
      1
     ]
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.count": 1,
    "data.length": {
     "close": 125.663706,
     "tol": 0.0001
    },
    "data.curves.0.closed": true,
    "data.gap": {
     "close": 0,
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_create_intersection_curve",
   "intent": "A body (all faces) with x 30: a 50 x 20 rectangle",
   "args": {
    "first": [
     "$blk.data.bodies.0.id"
    ],
    "plane": {
     "origin": [
      30,
      0,
      0
     ],
     "normal": [
      1,
      0,
      0
     ]
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.count": 4,
    "data.length": {
     "close": 140,
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_create_intersection_curve",
   "intent": "Face with face: the lid top (z 15) meets the cylinder side in a circle",
   "args": {
    "first": [
     "$side.data.items.0.id"
    ],
    "second": [
     "$lidtop.data.items.0.id"
    ]
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.count": 1,
    "data.length": {
     "close": 125.663706,
     "tol": 0.0001
    },
    "data.curves.0.start.2": {
     "close": 15,
     "tol": 0.0001
    },
    "data.gap": {
     "close": 0,
     "tol": 0.0001
    }
   }
  },
  {
   "call": "nx_create_intersection_curve",
   "args": {
    "first": [
     "$blk.data.bodies.0.id"
    ]
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_check_model",
   "args": {},
   "expect": {
    "data.healthy": true
   }
  }
 ]
}
