{
 "covers": {
  "nx_create_topology_environment": ["acceleration", "scenery", "connection"],
  "nx_create_topology_condition": ["fixed", "force", "pressure"],
  "nx_get_topology_study": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "bar",
   "args": {"shape": "block", "length": 100, "width": 20, "height": 10}},
  {"call": "nx_create_primitive", "setup": true, "save": "base",
   "args": {"shape": "block", "origin": [-10, -10, -10], "length": 10, "width": 40, "height": 30}},
  {"call": "nx_set_material", "setup": true, "args": {"material": "Steel"}},
  {"call": "nx_find_geometry", "save": "tip",
   "args": {"owner": "$bar.data.bodies.0.id", "kind": "face", "geometry_type": "plane",
            "normal": [1, 0, 0], "order": "highest", "axis": "x", "limit": 1},
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_find_geometry", "save": "top",
   "args": {"owner": "$bar.data.bodies.0.id", "kind": "face", "geometry_type": "plane",
            "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1},
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_find_geometry", "save": "back",
   "args": {"owner": "$base.data.bodies.0.id", "kind": "face", "geometry_type": "plane",
            "normal": [-1, 0, 0], "order": "lowest", "axis": "x", "limit": 1},
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_create_topology_study", "save": "st",
   "args": {"design_space": "$bar.data.bodies.0.id", "mass_fraction": 0.5, "quality": 9},
   "expect": {"mutation_outcome": "committed", "data.design_mass": {"close": 0.15658, "tol": 0.0005}}},
  {"call": "nx_create_topology_environment",
   "args": {"study": "$st.data.study.id", "kind": "connection",
            "bodies": ["$bar.data.bodies.0.id", "$base.data.bodies.0.id"]},
   "expect": {"error.field": "/bodies/1", "mutation_outcome": "not_started"}},
  {"call": "nx_create_topology_environment",
   "args": {"study": "$st.data.study.id", "kind": "scenery", "bodies": ["$base.data.bodies.0.id"]},
   "expect": {"mutation_outcome": "committed", "data.scenery": {"count": 1}, "data.connections": 0}},
  {"call": "nx_create_topology_environment",
   "args": {"study": "$st.data.study.id", "kind": "connection",
            "bodies": ["$bar.data.bodies.0.id", "$base.data.bodies.0.id"]},
   "expect": {"mutation_outcome": "committed", "data.connections": 1, "data.scenery": {"count": 1}}},
  {"call": "nx_create_topology_environment",
   "args": {"study": "$st.data.study.id", "kind": "acceleration", "magnitude": 5},
   "expect": {"error.field": "/direction", "mutation_outcome": "not_started"}},
  {"call": "nx_create_topology_environment",
   "args": {"study": "$st.data.study.id", "kind": "acceleration", "magnitude": 5, "direction": "-z"},
   "expect": {"mutation_outcome": "committed", "data.acceleration.g": {"close": 5, "tol": 1e-6},
              "data.acceleration.direction": {"close": [0, 0, -1], "tol": 1e-9}}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "fixed", "faces": ["$back.data.items.0.id"]},
   "expect": {"mutation_outcome": "committed", "data.supports": 1, "data.faces": 1}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "force", "faces": ["$tip.data.items.0.id"],
            "magnitude": 100, "direction": "-z", "load_case": "tip"},
   "expect": {"mutation_outcome": "committed", "data.loads": 1, "data.load_case": "tip"}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "pressure", "faces": ["$top.data.items.0.id"],
            "magnitude": 0.1, "load_case": "slam"},
   "expect": {"mutation_outcome": "committed", "data.loads": 2, "data.load_case": "slam"}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "keep_in", "faces": ["$back.data.items.0.id"]},
   "expect": {"error.code": "NX_WRONG_OWNER", "mutation_outcome": "not_started"}},
  {"call": "nx_get_topology_study", "args": {"study": "$st.data.study.id"},
   "expect": {"data.items.0.load_cases": {"count": 2},
              "data.items.0.load_cases.0.name": "tip", "data.items.0.load_cases.0.supports": 1,
              "data.items.0.load_cases.0.loads": 1,
              "data.items.0.load_cases.1.name": "slam", "data.items.0.load_cases.1.supports": 1,
              "data.items.0.load_cases.1.loads": 1,
              "data.items.0.acceleration.g": {"close": 5, "tol": 1e-6},
              "data.items.0.scenery": {"count": 1}, "data.items.0.connections": 1,
              "data.items.0.supports": {"count": 1}, "data.items.0.loads": {"count": 2}}},
  {"call": "nx_create_topology_environment",
   "args": {"study": "$st.data.study.id", "kind": "acceleration", "magnitude": 0},
   "expect": {"mutation_outcome": "committed", "data.acceleration": {"equals": null}}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
 ]
}
