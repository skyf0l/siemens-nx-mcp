{
 "covers": {
  "nx_create_topology_condition": [
   "pinned",
   "pressure",
   "keep_out",
   "symmetry",
   "member_size",
   "extrude"
  ]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "plate",
   "args": {
    "shape": "block",
    "length": 100,
    "width": 60,
    "height": 10
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "args": {
    "shape": "cylinder",
    "origin": [
     15,
     15,
     0
    ],
    "diameter": 10,
    "height": 10,
    "combine": {
     "operation": "subtract",
     "targets": [
      "$plate.data.bodies.0.id"
     ]
    }
   }
  },
  {
   "call": "nx_create_primitive",
   "setup": true,
   "save": "boss",
   "args": {
    "shape": "block",
    "origin": [
     50,
     25,
     0
    ],
    "length": 10,
    "width": 10,
    "height": 10
   }
  },
  {
   "call": "nx_create_datum_plane",
   "setup": true,
   "save": "mid",
   "args": {
    "method": "point_normal",
    "origin": [
     50,
     30,
     5
    ],
    "normal": [
     0,
     1,
     0
    ]
   }
  },
  {
   "call": "nx_find_geometry",
   "save": "hole",
   "args": {
    "owner": "$plate.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "cylinder"
   },
   "expect": {
    "data.items": {
     "count": 1
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "save": "top",
   "args": {
    "owner": "$plate.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "normal": [
     0,
     0,
     1
    ],
    "order": "highest",
    "axis": "z",
    "limit": 1
   },
   "expect": {
    "data.items": {
     "count": 1
    }
   }
  },
  {
   "call": "nx_create_topology_study",
   "args": {
    "design_space": "$plate.data.bodies.0.id",
    "mass_fraction": 0.3,
    "quality": 9
   },
   "expect": {
    "error.code": "NX_INVALID_ARGUMENT",
    "error.field": "/material",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_create_topology_study",
   "args": {
    "design_space": "$plate.data.bodies.0.id",
    "mass_fraction": 0.3,
    "material": "Unobtainium",
    "quality": 9
   },
   "expect": {
    "error.code": "NX_NOT_FOUND",
    "error.field": "/material",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_create_topology_study",
   "save": "st",
   "args": {
    "design_space": "$plate.data.bodies.0.id",
    "mass_fraction": "30%",
    "material": "steel",
    "quality": 9
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.mass_fraction": {
     "close": 0.3,
     "tol": 1e-09
    },
    "data.target_mass": {
     "close": 0.1391,
     "tol": 0.002
    }
   }
  },
  {
   "call": "nx_create_topology_condition",
   "args": {
    "study": "$st.data.study.id",
    "kind": "pinned",
    "faces": [
     "$hole.data.items.0.id"
    ]
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.supports": 1,
    "data.faces": 1
   }
  },
  {
   "call": "nx_create_topology_condition",
   "args": {
    "study": "$st.data.study.id",
    "kind": "pressure",
    "faces": [
     "$top.data.items.0.id"
    ],
    "magnitude": 0.5
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.loads": 1,
    "data.condition.magnitude": {
     "close": 0.5,
     "tol": 1e-09
    },
    "data.condition.unit": "MPa"
   }
  },
  {
   "call": "nx_undo_operation",
   "args": {
    "part": "$part",
    "mode": "compensate"
   },
   "expect": {
    "ok": true,
    "data.compensated": true,
    "data.restored.0": {
     "matches": "pressure on 1 face\\(s\\) removed"
    }
   }
  },
  {
   "call": "nx_get_topology_study",
   "args": {
    "study": "$st.data.study.id"
   },
   "expect": {
    "data.items.0.loads": {
     "count": 0
    },
    "data.items.0.supports": {
     "count": 1
    }
   }
  },
  {
   "call": "nx_create_topology_condition",
   "args": {
    "study": "$st.data.study.id",
    "kind": "pressure",
    "faces": [
     "$top.data.items.0.id"
    ],
    "magnitude": 0.5
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.loads": 1,
    "data.condition.magnitude": {
     "close": 0.5,
     "tol": 1e-09
    },
    "data.condition.unit": "MPa"
   }
  },
  {
   "call": "nx_create_topology_condition",
   "args": {
    "study": "$st.data.study.id",
    "kind": "keep_out",
    "bodies": [
     "$boss.data.bodies.0.id"
    ]
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.faces": 0,
    "data.region.method": "keep_out",
    "data.region.bodies": 1,
    "data.region.regions": 1,
    "data.region.thickness": {
     "equals": null
    },
    "data.condition": {
     "equals": null
    }
   }
  },
  {
   "call": "nx_undo_operation",
   "args": {
    "part": "$part",
    "mode": "compensate"
   },
   "expect": {
    "ok": false,
    "error.code": "NX_UNSUPPORTED_OPTION",
    "error.message": {
     "matches": "keep_out"
    }
   }
  },
  {
   "call": "nx_create_topology_condition",
   "args": {
    "study": "$st.data.study.id",
    "kind": "keep_in",
    "faces": [
     "$hole.data.items.0.id"
    ]
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.region.method": "keep_in",
    "data.region.faces": 1,
    "data.region.regions": 1,
    "data.region.thickness": {
     "close": 5,
     "tol": 1e-09
    },
    "data.region.thickness_default": true,
    "warnings.0.message": {
     "matches": "grew 5 mm .*default depth"
    }
   }
  },
  {
   "call": "nx_create_topology_condition",
   "args": {
    "study": "$st.data.study.id",
    "kind": "symmetry",
    "planes": [
     "$mid.data.datum_plane.id"
    ]
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.kind": "symmetry",
    "data.shape.type": "symmetry",
    "data.shape.planes": 1
   }
  },
  {
   "call": "nx_create_topology_condition",
   "args": {
    "study": "$st.data.study.id",
    "kind": "member_size",
    "size": 4
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.kind": "member_size",
    "data.shape.size": {
     "close": 4,
     "tol": 1e-09
    }
   }
  },
  {
   "call": "nx_create_topology_condition",
   "args": {
    "study": "$st.data.study.id",
    "kind": "extrude",
    "direction": "z"
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.kind": "extrude",
    "data.loads": 1,
    "data.supports": 1,
    "data.shape.direction": {
     "close": [
      0,
      0,
      1
     ],
     "tol": 1e-09
    }
   }
  },
  {
   "call": "nx_create_topology_condition",
   "args": {
    "study": "$st.data.study.id",
    "kind": "keep_in",
    "bodies": [
     "$plate.data.bodies.0.id"
    ]
   },
   "expect": {
    "error.field": "/bodies/0",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_get_topology_study",
   "args": {
    "study": "$st.data.study.id"
   },
   "expect": {
    "data.items.0.supports.0.type": "pinned",
    "data.items.0.loads.0.type": "pressure",
    "data.items.0.solved": false,
    "data.items.0.material": {
     "matches": "Steel"
    }
   }
  },
  {
   "call": "nx_check_model",
   "args": {},
   "expect": {
    "data.healthy": true
   }
  }
 ]
}
