{
 "covers": {
  "nx_set_topology_contour": [],
  "nx_create_topology_condition": ["fixed", "force"],
  "nx_run_topology_study": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "bar",
   "args": {"shape": "block", "length": 100, "width": 20, "height": 10}},
  {"call": "nx_set_material", "setup": true, "args": {"material": "Steel"}},
  {"call": "nx_find_geometry", "save": "root",
   "args": {"owner": "$bar.data.bodies.0.id", "kind": "face", "geometry_type": "plane",
            "normal": [-1, 0, 0], "order": "lowest", "axis": "x", "limit": 1},
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_find_geometry", "save": "tip",
   "args": {"owner": "$bar.data.bodies.0.id", "kind": "face", "geometry_type": "plane",
            "normal": [1, 0, 0], "order": "highest", "axis": "x", "limit": 1},
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_create_topology_study", "save": "st",
   "args": {"design_space": "$bar.data.bodies.0.id", "mass_fraction": 0.5, "quality": 9,
            "name": "post_study"},
   "expect": {"mutation_outcome": "committed", "data.design_mass": {"close": 0.15658, "tol": 0.0005}}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "fixed", "faces": ["$root.data.items.0.id"]},
   "expect": {"mutation_outcome": "committed", "data.supports": 1}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "force", "faces": ["$tip.data.items.0.id"],
            "magnitude": 100, "direction": "-z", "load_case": "down"},
   "expect": {"mutation_outcome": "committed", "data.loads": 1}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "force", "faces": ["$tip.data.items.0.id"],
            "magnitude": 300, "direction": "-y", "load_case": "side"},
   "expect": {"mutation_outcome": "committed", "data.loads": 2}},
  {"call": "nx_set_topology_contour", "args": {"study": "$st.data.study.id"},
   "expect": {"error.code": "NX_NOT_FOUND", "mutation_outcome": "not_started"}},
  {"call": "nx_run_topology_study", "save": "solved", "args": {"study": "$st.data.study.id"},
   "expect": {"mutation_outcome": "committed", "data.load_cases": {"count": 2},
              "data.load_cases.0.name": "down", "data.load_cases.1.name": "side",
              "data.load_cases.0.max_stress": {"close": 76, "tol": 25},
              "data.load_cases.1.max_stress": {"close": 58, "tol": 20}}},
  {"call": "nx_set_topology_contour", "args": {"study": "$st.data.study.id", "result": "stress"},
   "expect": {"mutation_outcome": "committed", "data.shown": true, "data.load_case": "down",
              "data.unit": "MPa", "data.min": {"close": 0, "tol": 1e-6},
              "data.max": {"close": "$solved.data.load_cases.0.max_stress", "tol": 0.01}}},
  {"call": "nx_set_topology_contour",
   "args": {"study": "$st.data.study.id", "result": "displacement", "load_case": "side",
            "style": "smooth"},
   "expect": {"data.shown": true, "data.load_case": "side", "data.unit": "mm",
              "data.max": {"close": "$solved.data.load_cases.1.max_displacement", "tol": 1e-4}}},
  {"call": "nx_set_topology_contour",
   "args": {"study": "$st.data.study.id", "result": "displacement_z", "load_case": "down"},
   "expect": {"data.unit": "mm", "data.min": {"close": -0.29, "tol": 0.08},
              "data.max": {"close": 0, "tol": 0.001}}},
  {"call": "nx_set_topology_contour",
   "args": {"study": "$st.data.study.id", "result": "principal_stress"},
   "expect": {"data.unit": "MPa", "data.min": {"close": -100, "tol": 35},
              "data.max": {"close": 87, "tol": 30}}},
  {"call": "nx_set_topology_contour",
   "args": {"study": "$st.data.study.id", "result": "safety_factor"},
   "expect": {"data.unit": null, "data.min": {"close": 1.8, "tol": 0.6},
              "data.max": {"close": 1000000, "tol": 1}}},
  {"call": "nx_set_topology_contour",
   "args": {"study": "$st.data.study.id", "load_case": "slam"},
   "expect": {"error.code": "NX_NOT_FOUND", "error.field": "/load_case",
              "mutation_outcome": "not_started"}},
  {"call": "nx_set_topology_contour", "args": {"study": "$st.data.study.id", "result": "none"},
   "expect": {"mutation_outcome": "committed", "data.shown": false, "data.max": null}},
  {"call": "nx_set_topology_contour",
   "args": {"study": "$st.data.study.id", "result": "stress", "load_case": "side"},
   "expect": {"data.shown": true,
              "data.max": {"close": "$solved.data.load_cases.1.max_stress", "tol": 0.01}}},
  {"call": "nx_set_topology_contour", "args": {"study": "$st.data.study.id", "result": "none"},
   "expect": {"data.shown": false}},
  {"call": "nx_get_topology_study", "args": {"study": "$st.data.study.id"},
   "expect": {"data.items.0.solved": true, "data.items.0.load_cases": {"count": 2}}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
 ]
}
