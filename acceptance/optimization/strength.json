{
 "covers": {
  "nx_analyze_topology_study": [],
  "nx_create_topology_environment": ["acceleration"],
  "nx_create_topology_condition": ["fixed", "force"]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "bar",
   "args": {"shape": "block", "length": 100, "width": 20, "height": 10}},
  {"call": "nx_set_material", "setup": true, "args": {"material": "Steel"}},
  {"call": "nx_find_geometry", "save": "root",
   "args": {"owner": "$bar.data.bodies.0.id", "kind": "face", "geometry_type": "plane",
            "normal": [-1, 0, 0], "order": "lowest", "axis": "x", "limit": 1},
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_find_geometry", "save": "tip",
   "args": {"owner": "$bar.data.bodies.0.id", "kind": "face", "geometry_type": "plane",
            "normal": [1, 0, 0], "order": "highest", "axis": "x", "limit": 1},
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_create_topology_study", "save": "st",
   "args": {"design_space": "$bar.data.bodies.0.id", "mass_fraction": 0.5, "quality": 9},
   "expect": {"mutation_outcome": "committed", "data.target_mass": {"close": 0.07829, "tol": 0.0001}}},
  {"call": "nx_analyze_topology_study", "args": {"study": "$st.data.study.id"},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "mutation_outcome": "not_started"}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "fixed", "faces": ["$root.data.items.0.id"]},
   "expect": {"mutation_outcome": "committed", "data.supports": 1}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "force", "faces": ["$tip.data.items.0.id"],
            "magnitude": 100, "direction": "-z"},
   "expect": {"mutation_outcome": "committed", "data.loads": 1}},
  {"call": "nx_analyze_topology_study", "args": {"study": "$st.data.study.id"},
   "expect": {"mutation_outcome": "committed",
              "data.max_displacement": {"close": 0.0967, "tol": 0.015},
              "data.max_stress": {"close": 30, "tol": 7.5},
              "data.stress_at.0": {"close": 0, "tol": 10},
              "data.stress_at.1": {"close": 10, "tol": 10.5},
              "data.stress_at.2": {"matches": "^[^e]*$"},
              "data.displacement_at.0": {"close": 100, "tol": 1},
              "data.yield_strength": {"close": 137.9, "tol": 0.1},
              "data.safety_factor": {"close": 5.0, "tol": 0.9},
              "data.analyzed_fraction": {"close": 0.98, "tol": 0.02},
              "data.load_cases": {"count": 1}, "data.material": "Steel"}},
  {"call": "nx_get_topology_study", "args": {"study": "$st.data.study.id"},
   "expect": {"data.items.0.solved": false, "data.items.0.target_mass": {"close": 0.07829, "tol": 0.0001}}},
  {"call": "nx_create_topology_environment",
   "args": {"study": "$st.data.study.id", "kind": "acceleration", "magnitude": 100, "direction": "-z"},
   "expect": {"mutation_outcome": "committed", "data.acceleration.g": {"close": 100, "tol": 1e-6}}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "force", "faces": ["$tip.data.items.0.id"],
            "magnitude": 200, "direction": "-z", "load_case": "double"},
   "expect": {"mutation_outcome": "committed", "data.loads": 2, "data.load_case": "double"}},
  {"call": "nx_analyze_topology_study", "args": {"study": "$st.data.study.id"},
   "expect": {"mutation_outcome": "committed", "data.load_cases": {"count": 2},
              "data.load_cases.1.name": "double",
              "data.load_cases.0.max_displacement": {"close": 0.152, "tol": 0.025},
              "data.load_cases.0.max_stress": {"close": 53, "tol": 13},
              "data.load_cases.1.max_displacement": {"close": 0.249, "tol": 0.04},
              "data.load_cases.1.max_stress": {"close": 83, "tol": 20},
              "data.max_displacement": {"close": 0.249, "tol": 0.04}}},
  {"call": "nx_delete_objects", "args": {"objects": ["$st.data.study.id"]},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
 ]
}
