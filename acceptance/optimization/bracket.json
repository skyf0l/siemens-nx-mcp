{
 "covers": {
  "nx_create_topology_study": [],
  "nx_create_topology_condition": ["fixed", "force", "keep_in"],
  "nx_run_topology_study": [],
  "nx_get_topology_study": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "plate",
   "args": {"shape": "block", "length": 100, "width": 60, "height": 10}},
  {"call": "nx_create_primitive", "setup": true,
   "args": {"shape": "cylinder", "origin": [15, 15, 0], "diameter": 10, "height": 10,
            "combine": {"operation": "subtract", "targets": ["$plate.data.bodies.0.id"]}}},
  {"call": "nx_create_primitive", "setup": true,
   "args": {"shape": "cylinder", "origin": [15, 45, 0], "diameter": 10, "height": 10,
            "combine": {"operation": "subtract", "targets": ["$plate.data.bodies.0.id"]}}},
  {"call": "nx_find_geometry", "save": "holes",
   "args": {"owner": "$plate.data.bodies.0.id", "kind": "face", "geometry_type": "cylinder"},
   "expect": {"data.items": {"count": 2}}},
  {"call": "nx_find_geometry", "save": "end",
   "args": {"owner": "$plate.data.bodies.0.id", "kind": "face", "geometry_type": "plane",
            "normal": [1, 0, 0], "order": "highest", "axis": "x", "limit": 1},
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_create_topology_study", "save": "st",
   "args": {"design_space": "$plate.data.bodies.0.id", "mass_fraction": 0.4,
            "material": "Aluminum_6061", "quality": 9, "name": "bracket_40"},
   "expect": {"mutation_outcome": "committed", "data.design_mass": {"close": 0.1584016, "tol": 0.0001},
              "data.target_mass": {"close": 0.0633606, "tol": 0.0001}, "data.mass_fraction": 0.4,
              "data.quality": 9, "data.material": {"matches": "Aluminum_6061"}}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "fixed",
            "faces": ["$holes.data.items.0.id", "$holes.data.items.1.id"]},
   "expect": {"mutation_outcome": "committed", "data.supports": 1, "data.faces": 2,
              "data.condition.type": "fixed", "data.condition.face_refs": {"count": 2},
              "data.condition.load_cases": {"count": 1}}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "fixed",
            "faces": ["$holes.data.items.1.id", "$holes.data.items.0.id"]},
   "expect": {"error.code": "NX_ALREADY_EXISTS", "error.field": "/faces",
              "error.details.supports_index": 0, "mutation_outcome": "not_started"}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "force", "faces": ["$end.data.items.0.id"],
            "magnitude": 1000, "direction": "-z"},
   "expect": {"mutation_outcome": "committed", "data.loads": 1, "data.faces": 1,
              "data.condition.type": "force",
              "data.condition.magnitude": {"close": 1000, "tol": 1e-6},
              "data.condition.unit": "N",
              "data.condition.direction": {"close": [0, 0, -1], "tol": 1e-9}}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "keep_in",
            "faces": ["$holes.data.items.0.id", "$holes.data.items.1.id"], "thickness": 4},
   "expect": {"mutation_outcome": "committed", "data.faces": 2, "data.supports": 1}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$st.data.study.id", "kind": "force", "faces": ["$end.data.items.0.id"],
            "magnitude": 1000},
   "expect": {"error.field": "/direction", "mutation_outcome": "not_started"}},
  {"call": "nx_create_topology_condition",
   "args": {"study": "$plate.data.feature.id", "kind": "fixed", "faces": ["$end.data.items.0.id"]},
   "expect": {"error.code": "NX_WRONG_KIND", "mutation_outcome": "not_started"}},
  {"call": "nx_get_topology_study", "args": {},
   "expect": {"data.items": {"count": 1}, "data.items.0.solved": false,
              "data.items.0.supports": {"count": 1}, "data.items.0.loads": {"count": 1},
              "data.items.0.supports.0.face_refs": {"count": 2},
              "data.items.0.loads.0.magnitude": {"close": 1000, "tol": 1e-6},
              "data.items.0.loads.0.direction": {"close": [0, 0, -1], "tol": 1e-9},
              "data.items.0.target_mass": {"close": 0.0633606, "tol": 0.0001},
              "data.items.0.target_fraction": {"close": 0.4, "tol": 1e-6}}},
  {"call": "nx_measure_mass", "args": {},
   "expect": {"data.bodies": {"count": 1}, "data.volume": {"close": 58429.2, "tol": 1},
              "warnings": {"count": 2}, "warnings.0.message": {"matches": "^Skipped 1 empty or topology result body"},
              "warnings.1.message": {"matches": "^1 of 1 bodies have no material"}}},
  {"call": "nx_run_topology_study", "save": "solved", "args": {"study": "$st.data.study.id"},
   "expect": {"mutation_outcome": "committed", "data.bodies": {"count": 1},
              "data.mass_fraction": {"close": 0.38, "tol": 0.04},
              "data.reduction_percent": {"close": 62, "tol": 4},
              "data.mass": {"close": 0.0598, "tol": 0.004},
              "data.kept": {"count": 3}, "data.all_kept": true,
              "data.kept.0.gap": {"close": 0, "tol": 0.5},
              "data.kept.0.contact_share": {"close": 1, "tol": 0.25},
              "data.kept.1.contact_share": {"close": 1, "tol": 0.25},
              "data.target_mass": {"close": 0.0633606, "tol": 0.0001},
              "data.target_fraction": {"close": 0.4, "tol": 1e-6},
              "data.max_stress": {"close": 160, "tol": 80},
              "data.max_displacement": {"close": 0.86, "tol": 0.4}}},
  {"call": "nx_get_topology_study", "args": {"study": "$st.data.study.id"},
   "expect": {"data.items.0.solved": true, "data.items.0.bodies": {"count": 1},
              "data.items.0.target_mass": {"close": 0.0633606, "tol": 0.0001},
              "data.items.0.mass_fraction": {"close": 0.38, "tol": 0.04}}},
  {"call": "nx_measure_mass", "args": {},
   "expect": {"data.bodies": {"count": 1}, "data.volume": {"close": 58429.2, "tol": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$solved.data.bodies.0.id"]},
   "expect": {"data.bodies": {"count": 1}, "data.volume": {"close": 22200, "tol": 2400}}},
  {"call": "nx_delete_objects", "args": {"objects": ["$st.data.study.id"]},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_get_topology_study", "args": {}, "expect": {"data.items": {"count": 0}}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.healthy": true}}
 ]
}
