[
 {
  "tool": "nx_create_part",
  "args": {
   "path": "smoke/sketch_constraints/accept.prt"
  },
  "save": "part",
  "intent": "Fresh scratch part"
 },
 {
  "tool": "nx_create_sketch",
  "args": {
   "plane": "XY",
   "name": "SKC_ACCEPT"
  },
  "save": "sk"
 },
 {
  "tool": "nx_sketch_line",
  "args": {
   "sketch_id": "$sk.object.id",
   "start": {
    "x": 0,
    "y": 0
   },
   "end": {
    "x": 40,
    "y": 0
   }
  },
  "save": "l1"
 },
 {
  "tool": "nx_sketch_line",
  "args": {
   "sketch_id": "$sk.object.id",
   "start": {
    "x": 5,
    "y": 20
   },
   "end": {
    "x": 45,
    "y": 20
   }
  },
  "save": "l2"
 },
 {
  "tool": "nx_sketch_line",
  "args": {
   "sketch_id": "$sk.object.id",
   "start": {
    "x": 60,
    "y": 5
   },
   "end": {
    "x": 70,
    "y": 30
   }
  },
  "save": "l3"
 },
 {
  "tool": "nx_sketch_arc",
  "args": {
   "sketch_id": "$sk.object.id",
   "cx": 80,
   "cy": -10,
   "radius": 5,
   "start_angle": 0,
   "end_angle": 180
  },
  "save": "a1"
 },
 {
  "tool": "nx_sketch_arc",
  "args": {
   "sketch_id": "$sk.object.id",
   "cx": 20,
   "cy": 40,
   "radius": 3,
   "start_angle": 0,
   "end_angle": 360
  },
  "save": "c1"
 },
 {
  "tool": "nx_sketch_line",
  "args": {
   "sketch_id": "$sk.object.id",
   "start": {
    "x": -10,
    "y": 10
   },
   "end": {
    "x": -10,
    "y": 40
   }
  },
  "save": "l4"
 },
 {
  "tool": "nx_sketch_constraint",
  "args": {
   "constraint_type": "fix",
   "targets": [
    "$l1.object.id"
   ]
  },
  "intent": "Keep L1 stationary so dimensions move the other curves"
 },
 {
  "tool": "nx_sketch_relation",
  "args": {
   "sketch_id": "$sk.object.id",
   "curve1": "$l1.object.id",
   "curve2": "$l2.object.id",
   "relation": "parallel"
  },
  "intent": "Make L2 parallel to L1 (before any dimension exists)"
 },
 {
  "tool": "nx_sketch_point_dimension",
  "args": {
   "sketch_id": "$sk.object.id",
   "first": "$l1.object.id",
   "first_point": "end",
   "second": "$l3.object.id",
   "second_point": "start",
   "kind": "horizontal",
   "value": 25
  },
  "save": "dh",
  "intent": "L3 start 25 mm right of L1 end"
 },
 {
  "tool": "nx_sketch_point_dimension",
  "args": {
   "sketch_id": "$sk.object.id",
   "first": "$l1.object.id",
   "first_point": "end",
   "second": "$l3.object.id",
   "second_point": "start",
   "kind": "vertical"
  },
  "save": "dv",
  "intent": "Fix the current vertical offset (5 mm)"
 },
 {
  "tool": "nx_sketch_point_dimension",
  "args": {
   "sketch_id": "$sk.object.id",
   "first": "$l3.object.id",
   "first_point": "start",
   "second": "$l3.object.id",
   "second_point": "end",
   "kind": "distance",
   "value": 30
  },
  "save": "dd",
  "intent": "L3 length 30 via its end points"
 },
 {
  "tool": "nx_sketch_curve_dimension",
  "args": {
   "sketch_id": "$sk.object.id",
   "first": "$l1.object.id",
   "second": "$l3.object.id",
   "kind": "angle",
   "value": 60
  },
  "save": "da",
  "intent": "L3 at 60 degrees to L1"
 },
 {
  "tool": "nx_sketch_curve_dimension",
  "args": {
   "sketch_id": "$sk.object.id",
   "first": "$l1.object.id",
   "second": "$l2.object.id",
   "kind": "parallel_distance",
   "value": 15
  },
  "save": "dp",
  "intent": "L2 15 mm from L1"
 },
 {
  "tool": "nx_sketch_curve_dimension",
  "args": {
   "sketch_id": "$sk.object.id",
   "first": "$l1.object.id",
   "second": "$a1.object.id",
   "kind": "perpendicular_distance",
   "value": 12
  },
  "save": "dc",
  "intent": "Arc center 12 mm from L1"
 },
 {
  "tool": "nx_sketch_midpoint",
  "args": {
   "sketch_id": "$sk.object.id",
   "point_curve": "$c1.object.id",
   "point": "center",
   "target_curve": "$l2.object.id"
  },
  "save": "mid",
  "intent": "Circle center on the midpoint of L2"
 },
 {
  "tool": "nx_sketch_point_on_curve",
  "args": {
   "sketch_id": "$sk.object.id",
   "point_curve": "$l4.object.id",
   "point": "start",
   "curve": "$l1.object.id"
  },
  "save": "poc",
  "intent": "L4 start on L1 (extended)"
 },
 {
  "tool": "nx_sketch_point_dimension",
  "args": {
   "sketch_id": "$sk.object.id",
   "first": "$a1.object.id",
   "first_point": "center",
   "second": "$l2.object.id",
   "second_point": "mid",
   "kind": "distance"
  },
  "save": "dm",
  "intent": "Measure and fix arc center to L2 midpoint"
 },
 {
  "tool": "nx_sketch_midpoint",
  "args": {
   "sketch_id": "$sk.object.id",
   "point_curve": "$l4.object.id",
   "point": "end",
   "target_curve": "$a1.object.id",
   "on_curve": false
  },
  "save": "mideq",
  "intent": "L4 end equidistant from Arc1 ends (on its bisector x=80) only"
 },
 {
  "tool": "nx_sketch_point_on_curve",
  "args": {
   "sketch_id": "$sk.object.id",
   "point_curve": "$l2.object.id",
   "point": "end",
   "curve": "$c1.object.id"
  },
  "save": "poc2",
  "intent": "L2 end on the circle"
 },
 {
  "tool": "nx_sketch_info",
  "args": {
   "sketch_id": "$sk.object.id"
  },
  "mutation": false
 },
 {
  "tool": "nx_sketch_midpoint",
  "args": {
   "sketch_id": "$sk.object.id",
   "point_curve": "$l4.object.id",
   "point": "end",
   "target_curve": "$c1.object.id"
  },
  "expect_error": true,
  "intent": "A full circle has no midpoint (NX_INVALID_ARGUMENT)"
 },
 {
  "tool": "nx_list_sketches",
  "mutation": false,
  "save": "sks2",
  "intent": "IDs of the part are stale after a rolled-back call; re-find them"
 },
 {
  "tool": "nx_sketch_info",
  "args": {
   "sketch_id": "$sks2.objects.0.id"
  },
  "mutation": false,
  "save": "info2"
 },
 {
  "tool": "nx_sketch_curve_dimension",
  "args": {
   "sketch_id": "$sks2.objects.0.id",
   "first": "$info2.curves.0.object.id",
   "second": "$info2.curves.2.object.id",
   "kind": "parallel_distance",
   "value": 5
  },
  "expect_error": true,
  "intent": "Non-parallel lines are rejected (NX_INVALID_ARGUMENT)"
 },
 {
  "tool": "nx_list_sketches",
  "mutation": false,
  "save": "sks3",
  "intent": "IDs of the part are stale after a rolled-back call; re-find them"
 },
 {
  "tool": "nx_sketch_info",
  "args": {
   "sketch_id": "$sks3.objects.0.id"
  },
  "mutation": false,
  "save": "info3"
 },
 {
  "tool": "nx_sketch_point_dimension",
  "args": {
   "sketch_id": "$sks3.objects.0.id",
   "first": "$info3.curves.0.object.id",
   "first_point": "end",
   "second": "$info3.curves.2.object.id",
   "second_point": "start",
   "kind": "horizontal",
   "value": 30
  },
  "expect_error": true,
  "intent": "A second dimension on the same point pair is refused by NX (NX_SKETCH_CONFLICT)"
 },
 {
  "tool": "nx_list_sketches",
  "mutation": false,
  "save": "sks4",
  "intent": "IDs of the part are stale after a rolled-back call; re-find them"
 },
 {
  "tool": "nx_sketch_info",
  "args": {
   "sketch_id": "$sks4.objects.0.id"
  },
  "mutation": false,
  "save": "info4"
 },
 {
  "tool": "nx_sketch_point_dimension",
  "args": {
   "sketch_id": "$sks4.objects.0.id",
   "first": "$info4.curves.0.object.id",
   "first_point": "start",
   "second": "$info4.curves.2.object.id",
   "second_point": "start",
   "kind": "vertical",
   "value": 7
  },
  "expect_error": true,
  "intent": "Contradicts the existing 5 mm vertical dimension while L1 is fixed: over-constrained, rolls back"
 },
 {
  "tool": "nx_list_sketches",
  "mutation": false,
  "save": "sks5"
 },
 {
  "tool": "nx_sketch_info",
  "args": {
   "sketch_id": "$sks5.objects.0.id"
  },
  "mutation": false,
  "save": "info5"
 },
 {
  "tool": "nx_sketch_diagnostics",
  "args": {
   "sketch_id": "$sks5.objects.0.id"
  },
  "mutation": false,
  "intent": "Works on NX 2406 since the shared _expression_record made GetExpressionParents optional"
 },
 {
  "tool": "nx_sketch_conflicts",
  "args": {
   "sketch_id": "$sks5.objects.0.id"
  },
  "mutation": false
 },
 {
  "tool": "nx_set_expression",
  "args": {
   "expression": "$dp.expression.name",
   "formula": "18"
  },
  "intent": "Drive L2 to 18 mm from L1; the circle center follows the midpoint. (the sketch is still active: the curves follow when the sketch is finished)"
 },
 {
  "tool": "nx_finish_sketch",
  "args": {
   "sketch_id": "$sks5.objects.0.id"
  },
  "intent": "Finishing solves the sketch with the edited expression"
 },
 {
  "tool": "nx_sketch_info",
  "args": {
   "sketch_id": "$sks5.objects.0.id"
  },
  "mutation": false,
  "intent": "expect L2 at y=18 and the circle centre at its midpoint",
  "save": "final"
 }
]
