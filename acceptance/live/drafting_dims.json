[
 {
  "tool": "nx_create_part",
  "args": {
   "path": "smoke/drafting_dims/dd_accept.prt",
   "units": "mm"
  },
  "intent": "Scratch part for drafting_dims acceptance"
 },
 {
  "tool": "nx_create_sketch",
  "args": {
   "plane": "XY"
  },
  "save": "sk"
 },
 {
  "tool": "nx_sketch_line",
  "args": {
   "sketch_id": "$sk.object.id",
   "start": {
    "x": 0,
    "y": 0
   },
   "end": {
    "x": 60,
    "y": 0
   }
  }
 },
 {
  "tool": "nx_sketch_line",
  "args": {
   "sketch_id": "$sk.object.id",
   "start": {
    "x": 60,
    "y": 0
   },
   "end": {
    "x": 60,
    "y": 20
   }
  }
 },
 {
  "tool": "nx_sketch_line",
  "args": {
   "sketch_id": "$sk.object.id",
   "start": {
    "x": 60,
    "y": 20
   },
   "end": {
    "x": 50,
    "y": 40
   }
  }
 },
 {
  "tool": "nx_sketch_line",
  "args": {
   "sketch_id": "$sk.object.id",
   "start": {
    "x": 50,
    "y": 40
   },
   "end": {
    "x": 0,
    "y": 40
   }
  }
 },
 {
  "tool": "nx_sketch_line",
  "args": {
   "sketch_id": "$sk.object.id",
   "start": {
    "x": 0,
    "y": 40
   },
   "end": {
    "x": 0,
    "y": 0
   }
  }
 },
 {
  "tool": "nx_finish_sketch",
  "args": {
   "sketch_id": "$sk.object.id"
  }
 },
 {
  "tool": "nx_extrude",
  "args": {
   "sketch_id": "$sk.object.id",
   "distance": 20
  },
  "save": "ext"
 },
 {
  "tool": "nx_hole",
  "args": {
   "body": "$ext.body.id",
   "diameter": 12,
   "depth": 20,
   "x": 20,
   "y": 20,
   "z": 20,
   "direction": [
    0,
    0,
    -1
   ]
  },
  "intent": "Through hole R6 at (20,20)"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "kind": "edge",
   "near": [
    30,
    0,
    20
   ],
   "geometry_type": "line"
  },
  "save": "ce",
  "mutation": false
 },
 {
  "tool": "nx_chamfer",
  "args": {
   "edges": [
    "$ce.items.0.object.id"
   ],
   "offset": 3
  },
  "intent": "45 degree chamfer 3 mm on the front top edge"
 },
 {
  "tool": "nx_measure_volume",
  "args": {},
  "mutation": false,
  "intent": "Expect 46000 - 720*pi - 270 = 43468.05"
 },
 {
  "tool": "nx_create_drawing_sheet",
  "args": {
   "name": "DD_THIRD",
   "size": "A3",
   "scale": 1,
   "units": "mm",
   "projection": "third_angle"
  },
  "save": "sheet3"
 },
 {
  "tool": "nx_add_base_view",
  "args": {
   "drawing": "$sheet3.object.id",
   "body": "$ext.body.id",
   "view": "top",
   "position": [
    120,
    180
   ]
  },
  "save": "top3"
 },
 {
  "tool": "nx_add_projection_view",
  "args": {
   "base_view": "$top3.object.id",
   "direction": "right",
   "spacing": 110
  },
  "save": "right3"
 },
 {
  "tool": "nx_add_projection_view",
  "args": {
   "base_view": "$top3.object.id",
   "direction": "bottom",
   "spacing": 90
  },
  "save": "bottom3"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "kind": "edge",
   "near": [
    26,
    20,
    20
   ],
   "geometry_type": "circle"
  },
  "save": "hole",
  "mutation": false
 },
 {
  "tool": "nx_add_radial_dimension",
  "args": {
   "view": "$top3.object.id",
   "edge": "$hole.items.0.object.id",
   "kind": "radius",
   "origin": [
    150,
    215
   ]
  },
  "save": "rad",
  "intent": "Expect R6"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "kind": "edge",
   "near": [
    26,
    20,
    20
   ],
   "geometry_type": "circle"
  },
  "save": "hole",
  "mutation": false
 },
 {
  "tool": "nx_add_radial_dimension",
  "args": {
   "view": "$top3.object.id",
   "edge": "$hole.items.0.object.id",
   "kind": "diameter",
   "origin": [
    70,
    228
   ]
  },
  "save": "dia",
  "intent": "Expect 12"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "kind": "edge",
   "near": [
    55,
    30,
    20
   ],
   "geometry_type": "line"
  },
  "save": "slant",
  "mutation": false
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "kind": "edge",
   "near": [
    25,
    40,
    20
   ],
   "geometry_type": "line"
  },
  "save": "back",
  "mutation": false
 },
 {
  "tool": "nx_add_angular_dimension",
  "args": {
   "view": "$top3.object.id",
   "first": "$slant.items.0.object.id",
   "second": "$back.items.0.object.id",
