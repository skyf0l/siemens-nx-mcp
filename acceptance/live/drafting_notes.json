[
 {
  "tool": "nx_create_part",
  "args": {
   "path": "smoke/drafting_notes/acceptance.prt",
   "units": "mm"
  },
  "intent": "Scratch part for drawing annotations"
 },
 {
  "tool": "nx_create_sketch",
  "args": {
   "plane": "XY",
   "name": "PROFILE"
  },
  "save": "sk"
 },
 {
  "tool": "nx_sketch_rectangle",
  "args": {
   "sketch_id": "$sk.object.id",
   "corner1": {
    "x": 0,
    "y": 0
   },
   "corner2": {
    "x": 80,
    "y": 50
   }
  }
 },
 {
  "tool": "nx_finish_sketch",
  "args": {
   "sketch_id": "$sk.object.id"
  }
 },
 {
  "tool": "nx_extrude",
  "args": {
   "sketch_id": "$sk.object.id",
   "distance": 20
  },
  "save": "ext"
 },
 {
  "tool": "nx_hole",
  "args": {
   "diameter": 20,
   "depth": 20,
   "x": 30,
   "y": 25,
   "z": 20,
   "direction": [
    0,
    0,
    -1
   ]
  }
 },
 {
  "tool": "nx_list_bodies",
  "args": {},
  "mutation": false,
  "save": "b"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "owner": "$b.objects.0.id",
   "kind": "edge",
   "geometry_type": "line",
   "near": [
    80,
    50,
    10
   ],
   "limit": 1
  },
  "mutation": false,
  "save": "corner"
 },
 {
  "tool": "nx_blend",
  "args": {
   "edges": [
    "$corner.items.0.object.id"
   ],
   "radius": 8
  }
 },
 {
  "tool": "nx_list_bodies",
  "args": {},
  "mutation": false,
  "save": "b"
 },
 {
  "tool": "nx_create_drawing",
  "args": {
   "name": "NOTES",
   "size": "A3",
   "scale": 1.0
  },
  "save": "dwg"
 },
 {
  "tool": "nx_add_base_view",
  "args": {
   "drawing": "$dwg.object.id",
   "body": "$b.objects.0.id",
   "view": "top",
   "position": [
    130,
    190
   ]
  },
  "save": "top"
 },
 {
  "tool": "nx_add_projection_view",
  "args": {
   "base_view": "$top.object.id",
   "direction": "bottom",
   "spacing": 90
  },
  "save": "front"
 },
 {
  "tool": "nx_add_note",
  "args": {
   "text": [
    "GENERAL NOTES",
    "1. BREAK SHARP EDGES 0.5",
    "2. MATERIAL: AL 6061-T6"
   ],
   "origin": [
    250,
    270
   ]
  },
  "save": "n1"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "owner": "$b.objects.0.id",
   "limit": 1,
   "kind": "face",
   "geometry_type": "plane",
   "normal": [
    0,
    0,
    1
   ],
   "near": [
    60,
    10,
    20
   ]
  },
  "mutation": false,
  "save": "top_face"
 },
 {
  "tool": "nx_add_note",
  "args": {
   "text": [
    "TOP FACE"
   ],
   "origin": [
    200,
    230
   ],
   "leader_to": "$top_face.items.0.object.id",
   "view": "$top.object.id"
  },
  "save": "n2"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "owner": "$b.objects.0.id",
   "limit": 1,
   "kind": "edge",
   "geometry_type": "circle",
   "near": [
    30,
    15,
    20
   ]
  },
  "mutation": false,
  "save": "hole_edge"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "owner": "$b.objects.0.id",
   "limit": 1,
   "kind": "edge",
   "geometry_type": "circle",
   "near": [
    80,
    50,
    20
   ]
  },
  "mutation": false,
  "save": "blend_edge"
 },
 {
  "tool": "nx_add_center_mark",
  "args": {
   "view": "$top.object.id",
   "edges": [
    "$hole_edge.items.0.object.id",
    "$blend_edge.items.0.object.id"
   ]
  },
  "save": "cm"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "owner": "$b.objects.0.id",
