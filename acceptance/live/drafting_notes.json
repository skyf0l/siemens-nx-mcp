    30,
    15,
    10
   ]
  },
  "mutation": false,
  "save": "hole_face"
 },
 {
  "tool": "nx_add_centerline",
  "args": {
   "view": "$front.object.id",
   "objects": [
    "$hole_face.items.0.object.id"
   ],
   "kind": "3d"
  },
  "save": "cl3"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "owner": "$b.objects.0.id",
   "limit": 1,
   "kind": "edge",
   "geometry_type": "line",
   "near": [
    10,
    0,
    20
   ]
  },
  "mutation": false,
  "save": "edge_y0"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "owner": "$b.objects.0.id",
   "limit": 1,
