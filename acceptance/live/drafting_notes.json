  }
 },
 {
  "tool": "nx_set_expression",
  "args": {
   "expression": "p4",
   "formula": "12"
  },
  "intent": "Grow the blend radius 8 -> 12; associative center mark must follow"
 },
 {
  "tool": "nx_list_annotations",
  "args": {},
