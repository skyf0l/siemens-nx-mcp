[
 {
  "tool": "nx_create_part",
  "args": {
   "path": "smoke/feature_tree/ft_acceptance.prt"
  },
  "save": "part"
 },
 {
  "tool": "nx_create_sketch",
  "args": {
   "plane": "XY",
   "name": "BLOCK_SK"
  },
  "save": "sk1"
 },
 {
  "tool": "nx_sketch_rectangle",
  "args": {
   "sketch_id": "$sk1.object.id",
   "corner1": {
    "x": 0,
    "y": 0
   },
   "corner2": {
    "x": 60,
    "y": 40
   }
  }
 },
 {
  "tool": "nx_finish_sketch",
  "args": {
   "sketch_id": "$sk1.object.id"
  }
 },
 {
  "tool": "nx_extrude",
  "args": {
   "sketch_id": "$sk1.object.id",
   "distance": 20
  },
  "save": "block",
  "intent": "60x40x20 block = 48000 mm3"
 },
 {
  "tool": "nx_create_sketch",
  "args": {
   "plane": "XY",
   "name": "BOSS_SK",
   "origin": [
    0,
    0,
    20
   ]
  },
  "save": "sk2"
 },
 {
  "tool": "nx_sketch_primitive",
  "args": {
   "sketch_id": "$sk2.object.id",
   "primitive": "circle",
   "center": [
    30,
    20
   ],
   "radius": 10
  }
 },
 {
  "tool": "nx_finish_sketch",
  "args": {
   "sketch_id": "$sk2.object.id"
  }
 },
 {
  "tool": "nx_extrude",
  "args": {
   "sketch_id": "$sk2.object.id",
   "distance": 15,
   "boolean": "unite",
   "targets": [
    "$block.body.id"
   ]
  },
  "save": "boss",
  "intent": "R10 x 15 boss, +1500*pi"
 },
 {
  "tool": "nx_hole",
  "args": {
   "diameter": 8,
   "depth": 35,
   "x": 30,
   "y": 20,
   "z": 35,
   "direction": [
    0,
    0,
    -1
   ],
   "body": "$block.body.id"
  },
  "save": "hole",
  "intent": "D8 through boss and block, -560*pi"
 },
 {
  "tool": "nx_find_geometry",
  "args": {
   "owner": "$block.body.id",
   "kind": "edge",
   "geometry_type": "circle",
   "radius": 10,
   "near": [
    40,
    20,
    35
   ],
   "limit": 1
  },
  "save": "edge",
  "mutation": false
 },
 {
  "tool": "nx_blend",
  "args": {
   "edges": [
    "$edge.items.0.object.id"
   ],
   "radius": 2
  },
  "save": "blend",
  "intent": "R2 blend on the boss top edge (child of the boss), -51.526"
 },
 {
  "tool": "nx_measure_volume",
  "args": {},
  "save": "v_full",
  "mutation": false,
  "intent": "expect 50901.571"
 },
 {
  "tool": "nx_list_features",
  "args": {},
  "save": "tl0",
  "mutation": false
 },
 {
  "tool": "nx_suppress_features",
  "args": {
   "features": [
    "$boss.feature.id"
   ],
   "suppress": true
  },
  "save": "sup",
  "intent": "boss + dependent blend suppressed"
 },
 {
  "tool": "nx_measure_volume",
  "args": {},
  "save": "v_sup",
  "mutation": false,
  "intent": "expect 48000 - 320*pi = 46994.690"
 },
 {
  "tool": "nx_measure_distance",
  "args": {
   "obj1": "$edge.items.0.object.id",
   "obj2": "$block.body.id"
  },
  "mutation": false,
  "expect_error": true,
  "intent": "old edge ID must be stale"
 },
 {
  "tool": "nx_suppress_features",
  "args": {
   "features": [
    "$boss.feature.id"
   ],
   "suppress": false
  },
  "save": "unsup",
  "intent": "boss restored; blend reported in still_suppressed_dependents"
 },
 {
  "tool": "nx_measure_volume",
  "args": {},
  "save": "v_unsup1",
  "mutation": false,
  "intent": "expect 48000 + 940*pi = 50953.097"
 },
 {
  "tool": "nx_suppress_features",
  "args": {
   "features": [
    "$blend.feature.id"
   ],
   "suppress": false
  },
  "save": "unsup2",
  "intent": "blend restored"
 },
 {
  "tool": "nx_measure_volume",
  "args": {},
  "save": "v_unsup2",
  "mutation": false,
  "intent": "expect 50901.571"
 },
 {
  "tool": "nx_make_current_feature",
  "args": {
   "feature": "$block.feature.id"
  },
  "save": "cur",
  "intent": "roll back to the block"
 },
 {
  "tool": "nx_measure_volume",
  "args": {},
  "save": "v_cur",
  "mutation": false,
  "intent": "expect 48000"
 },
 {
  "tool": "nx_make_current_feature",
  "args": {},
  "save": "last",
  "intent": "last feature current again"
 },
 {
  "tool": "nx_measure_volume",
  "args": {},
  "save": "v_last",
  "mutation": false,
  "intent": "expect 50901.571"
 },
 {
  "tool": "nx_reorder_feature",
  "args": {
   "feature": "$blend.feature.id",
   "target": "$hole.feature.id",
   "position": "before"
  },
  "save": "reo",
  "intent": "independent hole/blend swap"
 },
 {
  "tool": "nx_list_features",
  "args": {},
  "save": "tl1",
  "mutation": false
 },
 {
  "tool": "nx_measure_volume",
  "args": {},
  "save": "v_reo",
  "mutation": false,
  "intent": "expect 50901.571"
 },
 {
  "tool": "nx_measure_volume",
  "args": {
   "body": "$block.body.id"
  },
  "save": "v_body",
  "mutation": false,
  "intent": "original body ID survives suppress/make-current/reorder; expect 50901.571"
 },
 {
  "tool": "nx_reorder_feature",
  "args": {
   "feature": "$blend.feature.id",
   "target": "$boss.feature.id",
   "position": "before"
  },
  "expect_error": true,
  "intent": "blend before its parent boss: rejected"
 },
 {
  "tool": "nx_list_features",
  "args": {},
  "save": "tl2",
  "mutation": false
 },
 {
  "tool": "nx_measure_volume",
  "args": {},
  "save": "v_end",
  "mutation": false,
  "intent": "after the rolled-back reject: expect 50901.571 (all IDs of the part are stale after a rollback)"
 }
]
