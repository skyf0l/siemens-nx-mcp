{
 "covers": {},
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_activate_application",
   "setup": true,
   "args": {
    "application": "sheet_metal"
   }
  },
  {
   "call": "nx_set_sheet_metal_defaults",
   "setup": true,
   "args": {
    "thickness": 2,
    "bend_radius": 3,
    "neutral_factor": 0.33
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "args": {
    "placement": {
     "principal": "xy"
    }
   },
   "save": "s"
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       100,
       80
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id"
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "setup": true,
   "save": "tab",
   "args": {
    "operation": "tab",
    "parameters": {
     "section": "$s.data.sketch.id",
     "thickness": 2
    }
   },
   "expect": {
    "data.volume": {
     "close": 16000,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "args": {
    "placement": {
     "principal": "xy"
    }
   },
   "save": "l"
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$l.data.sketch.id",
    "curves": [
     {
      "type": "line",
      "start": [
       50,
       0
      ],
      "end": [
       50,
       80
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$l.data.sketch.id"
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "web",
   "args": {
    "owner": "$tab.data.body.id",
    "kind": "face",
    "near": [
     50,
     40,
     0
    ],
    "limit": 1,
    "geometry_type": "plane"
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "args": {
    "operation": "joggle",
    "parameters": {
     "faces": [
      "$web.data.items.0.id"
     ],
     "section": "$l.data.sketch.id",
     "height": 5
    }
   },
   "expect": {
    "error.code": "NX_LICENSE_UNAVAILABLE",
    "error.nx_code": 948801,
    "mutation_outcome": "rolled_back"
   }
  },
  {
   "call": "nx_get_sheet_metal",
   "args": {},
   "expect": {
    "data.items.0.bend_count": 0,
    "data.items.0.thickness": {
     "close": 2,
     "tol": 1e-09
    }
   }
  }
 ]
}
