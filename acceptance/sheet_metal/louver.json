{
 "covers": {
  "nx_create_sheet_metal_feature": [
   "louver"
  ]
 },
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_activate_application",
   "setup": true,
   "args": {
    "application": "sheet_metal"
   }
  },
  {
   "call": "nx_set_sheet_metal_defaults",
   "setup": true,
   "args": {
    "thickness": 2,
    "bend_radius": 3,
    "neutral_factor": 0.33
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "args": {
    "placement": {
     "principal": "xy"
    }
   },
   "save": "s"
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       100,
       80
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id"
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "setup": true,
   "save": "tab",
   "args": {
    "operation": "tab",
    "parameters": {
     "section": "$s.data.sketch.id",
     "thickness": 2
    }
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "args": {
    "placement": {
     "principal": "xy"
    }
   },
   "save": "l"
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$l.data.sketch.id",
    "curves": [
     {
      "type": "line",
      "start": [
       30,
       40
      ],
      "end": [
       70,
       40
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$l.data.sketch.id"
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "args": {
    "operation": "louver",
    "parameters": {
     "section": "$l.data.sketch.id",
     "height": 3,
     "width": 8
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.thickness": {
     "close": 2,
     "tol": 1e-09
    },
    "data.bend_count": 0,
    "data.volume": {
     "close": 16065.032874765995,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_measure_bounds",
   "args": {
    "bodies": [
     "$tab.data.body.id"
    ],
    "precision": "exact"
   },
   "expect": {
    "data.min": {
     "close": [
      0,
      0,
      -2
     ],
     "tol": 1e-06
    },
    "data.max": {
     "close": [
      100,
      80,
      3
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "args": {
    "placement": {
     "principal": "xy"
    }
   },
   "save": "l2"
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$l2.data.sketch.id",
    "curves": [
     {
      "type": "line",
      "start": [
       30,
       15
      ],
      "end": [
       70,
       15
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$l2.data.sketch.id"
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "args": {
    "operation": "louver",
    "parameters": {
     "section": "$l2.data.sketch.id",
     "height": 3,
     "width": 8,
     "style": "lanced",
     "reverse": true
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.thickness": {
     "close": 2,
     "tol": 1e-09
    },
    "data.bend_count": 0,
    "data.volume": {
     "close": 16044.18812780881,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_measure_bounds",
   "args": {
    "bodies": [
     "$tab.data.body.id"
    ],
    "precision": "exact"
   },
   "expect": {
    "data.min": {
     "close": [
      0,
      0,
      -5
     ],
     "tol": 1e-06
    },
    "data.max": {
     "close": [
      100,
      80,
      3
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "args": {
    "operation": "louver",
    "parameters": {
     "section": "$l2.data.sketch.id",
     "height": 3,
     "width": 8,
     "style": "open"
    }
   },
   "expect": {
    "error.category": "invalid_argument",
    "error.field": "/parameters/style",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "args": {
    "operation": "louver",
    "parameters": {
     "section": "$l2.data.sketch.id",
     "height": 7,
     "width": 8
    }
   },
   "expect": {
    "error.category": "geometry_failed",
    "error.nx_code": 3675041,
    "mutation_outcome": "rolled_back"
   }
  }
 ]
}
