{
 "covers": {
  "nx_create_sheet_metal_feature": [
   "bulge_relief"
  ]
 },
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_activate_application",
   "setup": true,
   "args": {
    "application": "sheet_metal"
   }
  },
  {
   "call": "nx_set_sheet_metal_defaults",
   "setup": true,
   "args": {
    "thickness": 2,
    "bend_radius": 3,
    "neutral_factor": 0.33
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "args": {
    "placement": {
     "principal": "xy"
    }
   },
   "save": "s"
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       100,
       80
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id"
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "setup": true,
   "save": "tab",
   "args": {
    "operation": "tab",
    "parameters": {
     "section": "$s.data.sketch.id",
     "thickness": 2
    }
   },
   "expect": {
    "data.volume": {
     "close": 16000,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e1",
   "args": {
    "owner": "$tab.data.body.id",
    "kind": "edge",
    "near": [
     50,
     0,
     0
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "setup": true,
   "save": "fl",
   "args": {
    "operation": "flange",
    "parameters": {
     "edges": [
      "$e1.data.items.0.id"
     ],
     "length": 20
    }
   },
   "expect": {
    "data.volume": {
     "close": 19656.63706143592,
     "tol": 1e-06
    },
    "data.bend_count": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "arc",
   "args": {
    "owner": "$tab.data.body.id",
    "kind": "edge",
    "near": [
     100,
     1.4645,
     -0.5355
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "save": "br",
   "args": {
    "operation": "bulge_relief",
    "parameters": {
     "edges": [
      "$arc.data.items.0.id"
     ],
     "height": 3,
     "width": 6,
     "radius": 3
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.bend_count": 1,
    "data.volume": {
     "close": 19625.76653987844,
     "tol": 1e-06
    }
   }
  }
 ]
}
