{
 "covers": {
  "nx_create_sheet_metal_feature": [
   "lightening_cutout"
  ]
 },
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_activate_application",
   "setup": true,
   "args": {
    "application": "sheet_metal"
   }
  },
  {
   "call": "nx_set_sheet_metal_defaults",
   "setup": true,
   "args": {
    "thickness": 2,
    "bend_radius": 3,
    "neutral_factor": 0.33
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "args": {
    "placement": {
     "principal": "xy"
    }
   },
   "save": "s"
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       100,
       80
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id"
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "setup": true,
   "save": "tab",
   "args": {
    "operation": "tab",
    "parameters": {
     "section": "$s.data.sketch.id",
     "thickness": 2
    }
   },
   "expect": {
    "data.volume": {
     "close": 16000,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "c",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$c.data.sketch.id",
    "curves": [
     {
      "type": "circle",
      "center": [
       50,
       40
      ],
      "radius": 12
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$c.data.sketch.id"
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "save": "lc",
   "args": {
    "operation": "lightening_cutout",
    "parameters": {
     "section": "$c.data.sketch.id",
     "length": 4,
     "angle": 45,
     "radius": 2
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.bend_count": 0,
    "data.thickness": {
     "close": 2,
     "tol": 1e-06
    }
   }
  }
 ]
}
