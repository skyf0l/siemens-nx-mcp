{
 "covers": {
  "nx_create_sheet_metal_feature": [
   "flat_solid"
  ]
 },
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_activate_application",
   "setup": true,
   "args": {
    "application": "sheet_metal"
   }
  },
  {
   "call": "nx_set_sheet_metal_defaults",
   "setup": true,
   "args": {
    "thickness": 2,
    "bend_radius": 3,
    "neutral_factor": 0.33
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "args": {
    "placement": {
     "principal": "xy"
    }
   },
   "save": "s"
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       100,
       80
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id"
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "setup": true,
   "save": "tab",
   "args": {
    "operation": "tab",
    "parameters": {
     "section": "$s.data.sketch.id",
     "thickness": 2
    }
   },
   "expect": {
    "data.volume": {
     "close": 16000,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e1",
   "args": {
    "owner": "$tab.data.body.id",
    "kind": "edge",
    "near": [
     50,
     0,
     0
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "setup": true,
   "save": "fl",
   "args": {
    "operation": "flange",
    "parameters": {
     "edges": [
      "$e1.data.items.0.id"
     ],
     "length": 20
    }
   },
   "expect": {
    "data.volume": {
     "close": 19656.63706143592,
     "tol": 1e-06
    },
    "data.bend_count": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "up",
   "args": {
    "owner": "$tab.data.body.id",
    "kind": "face",
    "near": [
     50,
     40,
     0
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "x",
   "args": {
    "owner": "$tab.data.body.id",
    "kind": "edge",
    "near": [
     50,
     80,
     0
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "save": "flat",
   "args": {
    "operation": "flat_solid",
    "parameters": {
     "face": "$up.data.items.0.id",
     "edge": "$x.data.items.0.id"
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.thickness": {
     "close": 2,
     "tol": 1e-06
    },
    "data.volume": {
     "close": 19549.82291121387,
     "tol": 1e-06
    },
    "data.flat_extents.0": {
     "close": 100,
     "tol": 1e-06
    },
    "data.flat_extents.1": {
     "close": 97.74911455606933,
     "tol": 1e-06
    },
    "data.bends.0.state": "flat"
   }
  }
 ]
}
