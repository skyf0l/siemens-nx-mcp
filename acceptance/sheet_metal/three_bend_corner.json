{
 "covers": {
  "nx_create_sheet_metal_feature": [
   "three_bend_corner"
  ]
 },
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_activate_application",
   "setup": true,
   "args": {
    "application": "sheet_metal"
   }
  },
  {
   "call": "nx_set_sheet_metal_defaults",
   "setup": true,
   "args": {
    "thickness": 2,
    "bend_radius": 3,
    "neutral_factor": 0.33
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "args": {
    "placement": {
     "principal": "xy"
    }
   },
   "save": "s"
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       100,
       80
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$s.data.sketch.id"
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "setup": true,
   "save": "tab",
   "args": {
    "operation": "tab",
    "parameters": {
     "section": "$s.data.sketch.id",
     "thickness": 2
    }
   },
   "expect": {
    "data.volume": {
     "close": 16000,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "e1",
   "args": {
    "owner": "$tab.data.body.id",
    "kind": "edge",
    "near": [
     50,
     0,
     0
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "setup": true,
   "save": "fl",
   "args": {
    "operation": "flange",
    "parameters": {
     "edges": [
      "$e1.data.items.0.id"
     ],
     "length": 20
    }
   },
   "expect": {
    "data.volume": {
     "close": 19656.63706143592,
     "tol": 1e-06
    },
    "data.bend_count": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "ea",
   "args": {
    "owner": "$tab.data.body.id",
    "kind": "edge",
    "near": [
     0,
     40,
     -2
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "eb",
   "args": {
    "owner": "$tab.data.body.id",
    "kind": "edge",
    "near": [
     0,
     0,
     11.5
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "setup": true,
   "save": "fl2",
   "args": {
    "operation": "flange",
    "parameters": {
     "edges": [
      "$ea.data.items.0.id",
      "$eb.data.items.0.id"
     ],
     "length": 20
    }
   },
   "expect": {
    "data.bend_count": 3,
    "data.volume": {
     "close": 22957.911,
     "tol": 0.001
    }
   }
  },
  {
   "call": "nx_get_sheet_metal",
   "setup": true,
   "args": {},
   "save": "i"
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "save": "c",
   "args": {
    "operation": "three_bend_corner",
    "parameters": {
     "faces": [
      "$i.data.items.0.bends.1.face.id",
      "$i.data.items.0.bends.2.face.id"
     ]
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.bend_count": 3,
    "data.volume": {
     "close": 23212.54868699743,
     "tol": 1e-06
    },
    "data.thickness": {
     "close": 2,
     "tol": 1e-09
    }
   }
  },
  {
   "call": "nx_create_sheet_metal_feature",
   "args": {
    "operation": "three_bend_corner",
    "parameters": {
     "faces": [
      "$i.data.items.0.bends.1.face.id"
     ]
    }
   },
   "expect": {
    "error.field": "/parameters/faces",
    "mutation_outcome": "not_started"
   }
  }
 ]
}
