{
 "covers": {
  "nx_create_sheet_metal_feature": [
   "from_solid"
  ]
 },
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_activate_application", "setup": true, "args": {"application": "sheet_metal"}},
  {"call": "nx_set_sheet_metal_defaults", "setup": true, "args": {"thickness": 2, "bend_radius": 3, "neutral_factor": 0.33}},
  {"call": "nx_create_sketch", "setup": true, "save": "s", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$s.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [80, 50]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "x", "args": {"sketch": "$s.data.sketch.id", "end": {"type": "distance", "value": 30}},
   "expect": {"data.volume": {"close": 120000, "tol": 1e-06}}},
  {"call": "nx_find_geometry", "setup": true, "save": "top", "args": {"owner": "$x.data.bodies.0.id", "kind": "face", "near": [40, 25, 30], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "side", "args": {"owner": "$x.data.bodies.0.id", "kind": "face", "near": [40, 0, 15], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "e", "args": {"owner": "$x.data.bodies.0.id", "kind": "edge", "near": [40, 0, 30], "limit": 1}},
  {"call": "nx_create_sheet_metal_feature", "save": "fs", "args": {"operation": "from_solid", "parameters": {
   "faces": ["$top.data.items.0.id", "$side.data.items.0.id"], "edges": ["$e.data.items.0.id"], "thickness": 2, "radius": 4}},
   "expect": {"mutation_outcome": "committed", "data.thickness": {"close": 2, "tol": 1e-06}, "data.bend_count": 1,
    "data.volume": {"close": 12776.63706143593, "tol": 1e-06}, "data.bends.0.radius": {"close": 4, "tol": 1e-06}}}
 ]
}
