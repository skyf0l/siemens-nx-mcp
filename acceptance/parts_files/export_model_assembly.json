{
  "covers": {"nx_export_model": ["stl", "jt", "step", "iges"]},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_create_part", "setup": true, "save": "asm", "args": {"path": "$run/ma/pf_ma_asm.prt", "display": true}},
    {"call": "nx_create_component", "setup": true, "save": "ca",
     "args": {"part": "pf_ma_asm", "path": "$fixture", "name": "BLK_A"}},
    {"call": "nx_create_component", "setup": true, "save": "cb",
     "args": {"part": "pf_ma_asm", "path": "$fixture", "name": "BLK_B", "pose": {"translation": [100, 0, 0]}}},
    {"call": "nx_list_objects", "setup": true, "save": "ba", "args": {"part": "pf_ma_asm", "kind": "body", "owner": "$ca.data.component.id"}},
    {"call": "nx_list_objects", "setup": true, "save": "bb", "args": {"part": "pf_ma_asm", "kind": "body", "owner": "$cb.data.component.id"}},
    {"call": "nx_export_model", "args": {"part": "pf_ma_asm", "path": "$run/ma/asm.stl", "format": "stl"},
     "intent": "Acceptance: an assembly without bodies of its own exports every component body to one STL in assembly coordinates",
     "expect": {"mutation_outcome": "committed", "data.bodies": 2, "data.triangles": 24, "data.encoding": "binary",
                "data.size": {"matches": "^[1-9]\\d*$"},
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.06},
                "data.bounds.max": {"close": [140, 20, 10], "tol": 0.06},
                "data.part_saved": false, "data.part_modified": true}},
    {"call": "nx_export_model",
     "args": {"part": "pf_ma_asm", "path": "$run/ma/b.stl", "format": "stl", "bodies": ["$bb.data.items.0.id"]},
     "intent": "Acceptance: a component's occurrence body is accepted while its assembly is the work part",
     "expect": {"mutation_outcome": "committed", "data.bodies": 1, "data.triangles": 12,
                "data.bounds.min": {"close": [100, 0, 0], "tol": 0.06},
                "data.bounds.max": {"close": [140, 20, 10], "tol": 0.06}}},
    {"call": "nx_export_model", "args": {"part": "pf_ma_asm", "path": "$run/ma/unsaved.jt", "format": "jt"},
     "expect": {"error.code": "NX_UNSAVED_PART", "mutation_outcome": "not_started",
                "error.details.parts": {"count": 1}}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "$asm.data.part.id"}},
    {"call": "nx_export_model", "args": {"part": "pf_ma_asm", "path": "$run/ma/asm.jt", "format": "jt"},
     "intent": "Acceptance: JT writes the saved assembly natively, one monolithic file covering both components",
     "expect": {"mutation_outcome": "committed", "data.bodies": 2, "data.file_units": "mm",
                "data.size": {"matches": "^[1-9]\\d*$"}, "data.shapes": {"matches": "^[1-9]\\d*$"},
                "data.bounds.min": {"close": [0, 0, 0], "tol": 1.2},
                "data.bounds.max": {"close": [140, 20, 10], "tol": 1.2},
                "data.part_modified": false}},
    {"call": "nx_export_model",
     "args": {"part": "pf_ma_asm", "path": "$run/ma/one.jt", "format": "jt", "bodies": ["$bb.data.items.0.id"]},
     "expect": {"mutation_outcome": "committed", "data.bodies": 1, "data.shapes": 1,
                "data.bounds.min": {"close": [100, 0, 0], "tol": 1.2},
                "data.bounds.max": {"close": [140, 20, 10], "tol": 1.2}}},
    {"call": "nx_export_model", "args": {"part": "pf_ma_asm", "path": "$run/ma/asm.step", "format": "step"},
     "expect": {"mutation_outcome": "committed", "data.bodies": 2, "data.solids": {"matches": "^[12]$"}, "data.schema": "AP214"}},
    {"call": "nx_export_model",
     "args": {"part": "pf_ma_asm", "path": "$run/ma/sel.step", "format": "step",
              "bodies": ["$ba.data.items.0.id", "$bb.data.items.0.id"]},
     "intent": "Acceptance: two placements of one part pass the solid check, which counts each part once",
     "expect": {"mutation_outcome": "committed", "data.bodies": 2, "data.solids": {"matches": "^[12]$"}}},
    {"call": "nx_export_model", "args": {"part": "pf_ma_asm", "path": "$run/ma/asm.igs", "format": "iges"},
     "expect": {"mutation_outcome": "committed", "data.bodies": 2, "data.file_units": "mm"}},
    {"call": "nx_list_files", "args": {"path": "$run/ma", "prefix": "asm."},
     "expect": {"page.total": 4}}
  ]
}
