{
  "covers": {"nx_create_part_family": [], "nx_get_part_family": []},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_open_part", "setup": true, "save": "fx", "args": {"path": "$fixture"}},
    {"call": "nx_get_part_family", "args": {},
     "expect": {"ok": true, "data.role": "none", "data.members": {"count": 0}}},
    {"call": "nx_create_part_family",
     "args": {"expressions": ["p0", "p2"], "directory": "$run/fam",
              "members": [{"name": "pf_block_50", "values": [50, 12.5]},
                          {"name": "pf_block_60", "values": ["60", "p1+1"]}]},
     "expect": {"mutation_outcome": "committed", "data.template_saved": true,
                "data.expressions": ["p0", "p2"], "data.members": {"count": 2},
                "data.members.0.values.p0": {"close": 50, "tol": 1e-9},
                "data.members.0.values.p2": {"close": 12.5, "tol": 1e-9},
                "data.members.0.up_to_date": true,
                "data.members.1.values.p0": {"close": 60, "tol": 1e-9},
                "data.members.1.values.p2": {"close": 21, "tol": 1e-9},
                "data.members.1.path": {"matches": "/fam/pf_block_60[.]prt$"}}},
    {"call": "nx_get_part_family", "args": {},
     "expect": {"data.role": "template", "data.columns": ["p0", "p2"],
                "data.members": {"count": 2}, "data.members.0.name": "pf_block_50",
                "data.members.0.values.p0": "50", "data.members.0.exists": true,
                "data.members.1.values.p2": "p1+1", "data.members.1.exists": true,
                "data.directory": {"matches": "/fam$"}}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$fixture", "modified": true},
     "expect": {"page.total": 0}},
    {"call": "nx_list_files", "args": {"path": "$run/fam"},
     "expect": {"page.total": 2}},
    {"call": "nx_create_part_family",
     "args": {"expressions": ["p0"], "directory": "$run/fam2",
              "members": [{"name": "pf_again", "values": [70]}]},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
    {"call": "nx_open_part", "setup": true, "args": {"path": "$run/fam/pf_block_50.prt", "display": true}},
    {"call": "nx_get_part_family", "args": {"part": "pf_block_50"},
     "expect": {"data.role": "member", "data.up_to_date": true,
                "data.template": {"matches": "(?i)parts_files_part_family"}}}
  ]
}
