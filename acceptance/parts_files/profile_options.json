{
  "covers": {"nx_export_profile": [], "nx_import_model": ["dxf_dwg"]},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_primitive", "setup": true, "args": {"shape": "block", "length": 80, "width": 40, "height": 10}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1}},
    {"call": "nx_export_profile", "save": "p1",
     "args": {"source": "$top.data.items.0.id", "path": "$run/po/top.dxf", "origin": "min_corner"},
     "intent": "Acceptance: min_corner moves the profile so it starts at 0,0 (the face frame's origin is NX's face point)",
     "expect": {"mutation_outcome": "committed", "data.entity_counts": {"equals": {"LINE": 4}},
                "data.frame.origin": {"close": [0, 0, 10], "tol": 1e-6}, "data.units": "mm", "data.replaced": false}},
    {"call": "nx_import_model", "args": {"path": "$run/po/top.dxf", "target": "new_part", "new_part_path": "$run/po/po_back_mm.prt"},
     "expect": {"ok": true, "data.curve_count": 4, "data.bounds.min": {"close": [0, 0, 0], "tol": 1e-6},
                "data.bounds.max": {"close": [80, 40, 0], "tol": 1e-6}}},
    {"call": "nx_export_profile", "args": {"source": "$top.data.items.0.id", "path": "$run/po/top.dxf", "origin": "min_corner"},
     "expect": {"ok": false, "error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started",
                "error.details.suggested_path": {"matches": "po/top-2[.]dxf$"}}},
    {"call": "nx_export_profile",
     "args": {"source": "$top.data.items.0.id", "path": "$run/po/top.dxf", "origin": "min_corner", "units": "in", "overwrite": true,
              "frame": [[0, 0, 10], [2, 0, 0], [0, 3, 0]]},
     "intent": "Acceptance: overwrite replaces the file; inch output; frame axes of any length",
     "expect": {"mutation_outcome": "committed", "data.replaced": true, "data.units": "in",
                "data.frame.x_axis": {"close": [1, 0, 0], "tol": 1e-9}}},
    {"call": "nx_import_model", "args": {"part": "$part", "path": "$run/po/top.dxf", "options": {"units": "in"}},
     "intent": "Acceptance: an inch DXF into this mm part is refused before NX (NX would take the numbers as mm)",
     "expect": {"ok": false, "error.code": "NX_UNSUPPORTED_OPTION", "error.field": "/options/units", "mutation_outcome": "not_started"}},
    {"call": "nx_import_model", "args": {"path": "$run/po/top.dxf", "options": {"units": "in"}, "target": "new_part",
                                         "new_part_path": "$run/po/po_back_in.prt"},
     "intent": "Acceptance: the new part takes the inch units of the file",
     "expect": {"ok": true, "data.file_units": "in", "data.bounds.max": {"close": [3.1496062992, 1.5748031496, 0], "tol": 1e-6}}},
    {"call": "nx_export_profile",
     "args": {"source": "$top.data.items.0.id", "path": "$run/po/skew.dxf", "frame": [[0, 0, 10], [1, 0, 0], [1, 1, 0]]},
     "expect": {"ok": false, "error.field": "/frame", "error.message": {"contains": "45 deg"}}},
    {"call": "nx_export_profile",
     "args": {"source": "$top.data.items.0.id", "path": "$run/po/off.dxf", "frame": [[0, 0, 15], [1, 0, 0], [0, 1, 0]]},
     "expect": {"ok": false, "error.code": "NX_WRONG_GEOMETRY", "error.message": {"contains": "5 mm off the source plane"}}},
    {"call": "nx_export_model", "args": {"part": "$part", "path": "$run/po/blk.stp"},
     "intent": "Acceptance: STEP export reports the exported bodies' box",
     "expect": {"ok": true, "data.bounds.min": {"close": [0, 0, 0], "tol": 1e-6}, "data.bounds.max": {"close": [80, 40, 10], "tol": 1e-6}}}
  ]
}
