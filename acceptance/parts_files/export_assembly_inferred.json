{
  "covers": {"nx_export_assembly": ["zip", "clone"]},
  "part": null,
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/ei/parts/pf_ei_blk.prt"}},
    {"call": "nx_save_part", "setup": true, "args": {}},
    {"call": "nx_create_part", "setup": true, "save": "asm", "args": {"path": "$run/ei/pf_ei_asm.prt"}},
    {"call": "nx_create_component", "setup": true, "args": {"part": "pf_ei_asm", "path": "$run/ei/parts/pf_ei_blk.prt", "name": "BLK1"}},
    {"call": "nx_create_component", "setup": true,
     "args": {"part": "pf_ei_asm", "path": "$run/ei/parts/pf_ei_blk.prt", "name": "BLK2", "pose": {"translation": [50, 0, 0]}}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ei_asm", "path": "$run/ei/pkg.zip"},
     "expect": {"error.code": "NX_UNSAVED_PART", "mutation_outcome": "not_started",
                "error.details.part": {"matches": "pf_ei_asm\\.prt$"}, "error.details.parts": {"count": 1}}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "$asm.data.part.id"}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ei_asm", "path": "$run/ei/pkg.zip"},
     "expect": {"mutation_outcome": "committed", "data.format": "zip", "data.file_count": 2,
                "data.component_count": 2}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ei_asm", "path": "$run/ei/copy"},
     "expect": {"error.field": "/format", "mutation_outcome": "not_started"}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ei_asm", "path": "$run/ei/copy", "prefix": "V2_"},
     "expect": {"mutation_outcome": "committed", "data.format": "clone", "data.file_count": 2,
                "data.component_count": 2, "data.top_part": {"matches": "/ei/copy/V2_pf_ei_asm\\.prt$"}}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run/ei/copy"},
     "expect": {"page.total": 0}},
    {"call": "nx_list_files", "args": {"path": "$run/ei"},
     "expect": {"page.total": 4}}
  ]
}
