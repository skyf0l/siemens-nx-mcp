{
  "covers": {"nx_create_part": [], "nx_activate_part": []},
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "save": "a", "args": {"path": "$part", "units": "mm"}},
    {"call": "engineer", "args": {"code": "from nx_mcp.kit import parts as kp\nservices.host._remember_model()  # the development tool's own undo mark is no engineer edit\np = [x for x in session.Parts if str(x.Leaf).lower().startswith('parts_files_create_no_display') and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nkp.show(NXOpen, session.Parts, p)\nresult = p.Leaf"}, "intent": "Acceptance: the engineer looks at the scenario's part (a tab click, no edit): it is the displayed part whatever NX showed before (engineer tab guard)", "expect": {"ok": true, "data.noticed": false}},
    {"call": "nx_create_primitive", "setup": true, "args": {"shape": "block", "length": 20, "width": 20, "height": 20}},
    {"call": "nx_create_checkpoint", "setup": true, "args": {"label": "cnd before b"}},
    {"call": "nx_create_part", "save": "b", "args": {"path": "$run/cnd/pf_nodisp_b.prt", "units": "in", "display": false},
     "intent": "Acceptance: create a part without display: the work and display parts stay",
     "expect": {"mutation_outcome": "committed", "data.work": false, "data.display": false, "data.units": "in",
                "units.length": "mm", "data.path": {"matches": "/cnd/pf_nodisp_b\\.prt$"}, "warnings": {"count": 1},
                "warnings.0.message": "2 parts are loaded: calls without refs now take part"}},
    {"call": "nx_list_parts", "args": {"active_only": true},
     "expect": {"page.total": 1, "data.items.0.path": {"matches": "parts_files_create_no_display"},
                "data.items.0.work": true, "data.items.0.display": true}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run/cnd"},
     "expect": {"page.total": 1, "data.items.0.work": false, "data.items.0.display": false,
                "data.items.0.owned": true, "data.items.0.units": "in"}},
    {"call": "nx_create_primitive", "save": "x", "args": {"part": "$part", "shape": "block", "length": 5, "width": 5, "height": 5,
                                                         "origin": [0, 0, 20]},
     "intent": "Acceptance: the next model call lands in the work part, not in the new part",
     "expect": {"mutation_outcome": "committed", "part.file": {"matches": "^parts_files_create_no_display"}}},
    {"call": "nx_activate_part", "args": {"part": "$b.data.part.id", "display": true},
     "intent": "Acceptance: display the new part for the first time (its undo marks stay)",
     "expect": {"mutation_outcome": "committed", "data.work": true, "data.display": true, "units.length": "in"}},
    {"call": "nx_activate_part", "args": {"part": "$a.data.part.id", "display": true},
     "expect": {"mutation_outcome": "committed", "data.work": true, "data.display": true, "units.length": "mm"}},
    {"call": "nx_undo_operation", "args": {"part": "$part"},
     "intent": "Acceptance: the block made after the load can still be undone after both display switches",
     "expect": {"mutation_outcome": "committed", "data.undone_operation_id": "$x.operation_id", "data.undo_depth": 1}},
    {"call": "nx_list_checkpoints", "args": {},
     "intent": "Acceptance: another part's load ends no checkpoint of this part (per part)",
     "expect": {"data.checkpoints": {"contains": {"label": "cnd before b", "available": true,
                                                  "expired_reason": null, "operations_after": 0}}}},
    {"call": "nx_create_part", "args": {"path": "$run/cnd/pf_nodisp_c.prt", "display": true},
     "intent": "Acceptance: display true (the default) shows the new part as before",
     "expect": {"mutation_outcome": "committed", "data.work": true, "data.display": true}}
  ]
}
