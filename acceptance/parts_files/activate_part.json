{
  "covers": {"nx_activate_part": []},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_create_part", "setup": true, "save": "blk", "args": {"path": "$run/act/pf_act_blk.prt"}},
    {"call": "engineer", "args": {"code": "from nx_mcp.kit import parts as kp\nservices.host._remember_model()  # the development tool's own undo mark is no engineer edit\np = [x for x in session.Parts if str(x.Leaf).lower().startswith('pf_act_blk') and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nkp.show(NXOpen, session.Parts, p)\nresult = p.Leaf"}, "intent": "Acceptance: the engineer looks at pf_act_blk.prt (a tab click, no edit): it is the displayed part whatever NX showed before (engineer tab guard)", "expect": {"ok": true, "data.noticed": false}},
    {"call": "nx_save_part", "setup": true, "args": {}},
    {"call": "nx_create_part", "setup": true, "save": "asm", "args": {"path": "$run/act/pf_act_asm.prt", "display": true}},
    {"call": "nx_create_component", "setup": true, "args": {"part": "pf_act_asm", "path": "$run/act/pf_act_blk.prt", "name": "BLK"}},
    {"call": "nx_activate_part", "args": {"part": "$blk.data.part.id", "display": false},
     "expect": {"mutation_outcome": "committed", "data.work": true, "data.display": false,
                "data.path": {"matches": "pf_act_blk\\.prt$"}}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run/act", "active_only": true},
     "expect": {"page.total": 2}},
    {"call": "nx_activate_part", "args": {"part": "$asm.data.part.id"},
     "expect": {"data.work": true, "data.display": true, "data.units": "mm"}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run/act", "active_only": true},
     "expect": {"page.total": 1, "data.items.0.path": {"matches": "pf_act_asm\\.prt$"}}},
    {"call": "nx_open_part", "setup": true, "save": "fx", "args": {"path": "$fixture", "display": true}},
    {"call": "nx_list_objects", "setup": true, "save": "bodies", "args": {"part": "$fixture", "kind": "body"}},
    {"call": "nx_activate_part", "args": {"part": "$asm.data.part.id", "display": false},
     "intent": "Acceptance: work without display outside the displayed assembly is no longer refused: the work part stays and a note says how calls reach the part",
     "expect": {"mutation_outcome": "committed", "data.work": false, "data.display": false,
                "warnings.0.message": {"matches": "pf_act_asm[.]prt is loaded .* Calls reach it with \"part\": \"pf_act_asm[.]prt\""}}},
    {"call": "nx_activate_part", "args": {"part": "$asm.data.part.id", "work": false, "display": true},
     "expect": {"mutation_outcome": "committed", "data.display": true}},
    {"call": "nx_activate_part", "args": {"part": "$fx.data.part.id", "work": false, "display": false},
     "expect": {"error.category": "invalid_argument", "error.field": "/work", "mutation_outcome": "not_started"}},
    {"call": "nx_activate_part", "args": {"part": "$bodies.data.items.0.id"},
     "expect": {"error.code": "NX_WRONG_KIND", "mutation_outcome": "not_started"}},
    {"call": "nx_activate_part", "args": {"part": "p:999999999"},
     "expect": {"error.code": {"matches": "^NX_(NOT_FOUND|STALE_REFERENCE)$"}, "mutation_outcome": "not_started"}},
    {"call": "nx_create_part", "setup": true, "save": "tmp", "args": {"path": "$run/act/pf_act_tmp.prt"}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "$tmp.data.part.id", "save": false}},
    {"call": "nx_activate_part", "args": {"part": "$tmp.data.part.id"},
     "expect": {"error.category": "stale_reference", "mutation_outcome": "not_started", "error.field": "/part",
                "error.hint": {"matches": "nx_list_parts"}, "error.details.loaded_parts.0.kind": "part"}}
  ]
}
