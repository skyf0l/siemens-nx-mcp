{
  "covers": {"nx_save_part": []},
  "fixture": "fixtures/drawing_out_of_date.prt",
  "part": null,
  "steps": [
    {"call": "nx_open_part", "setup": true, "save": "fx", "args": {"path": "$fixture"}},
    {"call": "nx_save_part", "args": {},
     "expect": {"mutation_outcome": "committed", "data.updated_views": {"count": 4},
                "data.updated_views.0.kind": "drawing_view", "data.updated_views.0.name": "Front@1",
                "data.saved_files": {"count": 1},
                "warnings": {"contains": {"code": "NX_NOTE"}}}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "$fx.data.part.id", "save": false}},
    {"call": "nx_open_part", "setup": true, "save": "again", "args": {"path": "$fixture"}},
    {"call": "nx_activate_drawing_sheet", "args": {"sheet": "SHT1"},
     "expect": {"data.sheet.name": "SHT1", "warnings": {"count": 0}}},
    {"call": "nx_save_part", "args": {},
     "intent": "Acceptance: the reopened part has no out-of-date view left, so a save finds nothing to write (an out-of-date view would make it save)",
     "expect": {"mutation_outcome": "not_applicable", "data.saved": false, "warnings": {"count": 1},
                "warnings.0.code": "NX_NO_EFFECT", "warnings.0.message": {"contains": "no unsaved changes"}}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "$again.data.part.id", "save": false}}
  ]
}
