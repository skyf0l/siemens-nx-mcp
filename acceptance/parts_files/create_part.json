{
  "covers": {"nx_create_part": []},
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "args": {"path": "$part", "units": "mm"},
     "expect": {"mutation_outcome": "committed", "data.units": "mm", "data.part.kind": "part",
                "data.path": {"matches": "^smoke/.+\\.prt$"}}},
     {"call": "engineer", "args": {"code": "from nx_mcp.kit import parts as kp\nservices.host._remember_model()  # the development tool's own undo mark is no engineer edit\np = [x for x in session.Parts if str(x.Leaf).lower().startswith('parts_files_create_part') and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nkp.show(NXOpen, session.Parts, p)\nresult = p.Leaf"}, "intent": "Acceptance: the engineer looks at the scenario's part (a tab click, no edit): it is the displayed part whatever NX showed before (engineer tab guard)", "expect": {"ok": true, "data.noticed": false}},
    {"call": "nx_create_part", "save": "inch", "args": {"path": "$run/pf_create_in.prt", "units": "in", "display": true},
     "expect": {"mutation_outcome": "committed", "data.units": "in", "units.length": "in", "data.work": true,
                "data.part.name": {"matches": "(?i)^pf_create_in$"}}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run", "active_only": true},
     "expect": {"page.total": 1, "data.items.0.units": "in", "units.length": "in", "data.items.0.owned": true}},
    {"call": "nx_create_part", "args": {"path": "$run/pf_create_in.prt", "units": "in"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "error.field": "/path", "mutation_outcome": "not_started"}},
    {"call": "nx_create_part", "args": {"path": "$run/elsewhere/PF_CREATE_IN.prt"},
     "expect": {"error.code": "NX_NAME_CONFLICT", "error.field": "/path", "mutation_outcome": "not_started",
                "error.details.loaded_part_path": {"matches": "(?i)pf_create_in\\.prt$"}}},
    {"call": "nx_list_files", "args": {"path": "$run/elsewhere"},
     "expect": {"error.code": "NX_FILE_NOT_FOUND"}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "$inch.data.part.id"}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "$inch.data.part.id", "save": false}},
    {"call": "nx_create_part", "args": {"path": "$run/pf_create_in.prt"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
    {"call": "nx_create_part", "args": {"path": "../outside.prt"},
     "expect": {"error.code": "NX_PATH_OUTSIDE_WORKSPACE", "mutation_outcome": "not_started"}},
    {"call": "nx_create_part", "args": {"path": ".Nx-Mcp/x.prt"},
     "expect": {"error.code": "NX_PATH_RESERVED", "mutation_outcome": "not_started"}},
    {"call": "nx_create_part", "args": {"path": "$run/x.step"},
     "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "mutation_outcome": "not_started"}},
    {"call": "nx_create_part", "args": {"path": "$run/pf_create_x.prt", "units": "cm"},
     "expect": {"error.category": "invalid_argument", "error.field": "/units", "mutation_outcome": "not_started"}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
     "expect": {"page.total": 1}}
  ]
}
