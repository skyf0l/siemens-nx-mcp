{
  "covers": {"nx_export_model": ["step_ap242"]},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_open_part", "setup": true, "args": {"path": "$fixture"}},
    {"call": "nx_list_objects", "setup": true, "save": "bodies", "args": {"kind": "body"}},
    {"call": "nx_export_model", "args": {"path": "$run/ap242/saved.step", "format": "step_ap242"},
     "expect": {"mutation_outcome": "committed", "data.schema": "AP242", "data.solids": 1,
                "data.file_units": "mm", "data.part_saved": false, "data.part_modified": false}},
    {"call": "nx_create_transform", "setup": true,
     "args": {"bodies": ["$bodies.data.items.0.id"], "transform": {"translation": [200, 0, 0]}, "copy": true}},
    {"call": "nx_export_model", "args": {"path": "$run/ap242/memory.stp", "format": "step_ap242"},
     "expect": {"mutation_outcome": "committed", "data.schema": "AP242", "data.solids": 2,
                "data.part_saved": false, "data.part_modified": true}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$fixture", "modified": true},
     "expect": {"page.total": 1}},
    {"call": "nx_list_files", "args": {"path": "$run/ap242"},
     "expect": {"page.total": 2}}
  ]
}
