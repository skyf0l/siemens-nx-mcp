{
  "covers": {"nx_export_model": ["dxf", "dwg"]},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_open_part", "setup": true, "save": "fx", "args": {"path": "$fixture"}},
    {"call": "nx_list_objects", "setup": true, "save": "bodies", "args": {"kind": "body"}},
    {"call": "nx_export_model", "args": {"path": "$run/dx/saved.dxf"},
     "expect": {"mutation_outcome": "committed", "data.format": "dxf", "data.schema": {"matches": "^AC10[0-9][0-9]$"},
                "data.file_units": "mm", "data.units": "mm", "data.bodies": 1, "data.surfaces": 6,
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.001},
                "data.bounds.max": {"close": [40, 20, 10], "tol": 0.001},
                "data.sha256": {"matches": "^[0-9a-f]{64}$"}, "data.part_saved": false, "data.part_modified": false}},
    {"call": "nx_export_model", "args": {"path": "$run/dx/saved.dwg", "format": "dwg"},
     "expect": {"mutation_outcome": "committed", "data.format": "dwg", "data.encoding": "binary",
                "data.schema": {"matches": "^AC10[0-9][0-9]$"}, "data.sha256": {"matches": "^[0-9a-f]{64}$"},
                "data.part_modified": false}},
    {"call": "nx_create_transform", "setup": true,
     "args": {"bodies": ["$bodies.data.items.0.id"], "transform": {"translation": [200, 0, 0]},
              "copy": true}},
    {"call": "nx_list_objects", "setup": true, "save": "two", "args": {"kind": "body"}},
    {"call": "nx_export_model", "args": {"path": "$run/dx/memory.dxf", "format": "dxf"},
     "expect": {"mutation_outcome": "committed", "data.bodies": 2, "data.surfaces": 12,
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.001},
                "data.bounds.max": {"close": [240, 20, 10], "tol": 0.001},
                "data.part_saved": false, "data.part_modified": true}},
    {"call": "nx_export_model",
     "args": {"path": "$run/dx/copy.dxf", "bodies": ["$two.data.items.1.id"]},
     "expect": {"mutation_outcome": "committed", "data.bodies": 1, "data.surfaces": 6,
                "data.bounds.min": {"close": [200, 0, 0], "tol": 0.001},
                "data.bounds.max": {"close": [240, 20, 10], "tol": 0.001}}},
    {"call": "nx_export_model", "args": {"path": "$run/dx/memory.dwg"},
     "expect": {"mutation_outcome": "committed", "data.format": "dwg", "data.bodies": 2,
                "data.part_modified": true}},
    {"call": "nx_create_primitive", "setup": true, "save": "cyl",
     "args": {"shape": "cylinder", "diameter": 20, "height": 2, "origin": [100, 50, 0]}},
    {"call": "nx_export_model",
     "args": {"path": "$run/dx/cylinder.dxf", "bodies": ["$cyl.data.bodies.0.id"]},
     "expect": {"mutation_outcome": "committed", "data.bodies": 1,
                "data.bounds.min": {"close": [90, 40, 0], "tol": 0.3},
                "data.bounds.max": {"close": [110, 60, 2], "tol": 0.3}}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$fixture", "modified": true},
     "expect": {"page.total": 1}},
    {"call": "nx_export_model", "args": {"path": "$run/dx/saved.dxf"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "$run/dx/wrong.dwg", "format": "dxf"},
     "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "error.field": "/path",
                "mutation_outcome": "not_started"}},
    {"call": "nx_list_files", "args": {"path": "$run/dx"},
     "expect": {"page.total": 6}}
  ]
}
