{
  "covers": {"nx_export_model": ["step"]},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_open_part", "setup": true, "save": "fx", "args": {"path": "$fixture"}},
    {"call": "nx_list_objects", "setup": true, "save": "bodies", "args": {"kind": "body"}},
    {"call": "nx_export_model", "args": {"path": "$run/em/a.step", "format": "step"},
     "expect": {"mutation_outcome": "committed", "data.solids": 1, "data.bodies": 1, "data.schema": "AP214",
                "data.units": "mm", "data.file_units": "mm", "data.part_saved": false, "data.part_modified": false,
                "data.sha256": {"matches": "^[0-9a-f]{64}$"}, "data.path": {"matches": "/em/a\\.step$"}}},
    {"call": "nx_import_model", "setup": true, "args": {"path": "$run/em/a.step", "format": "step"}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$fixture", "modified": true},
     "expect": {"page.total": 1}},
    {"call": "nx_export_model", "args": {"path": "$run/em/b.stp", "format": "step"},
     "expect": {"mutation_outcome": "committed", "data.solids": 2, "data.bodies": 2,
                "data.part_saved": false, "data.part_modified": true}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$fixture", "modified": true},
     "expect": {"page.total": 1}},
    {"call": "nx_export_model", "args": {"path": "$run/em/c.step", "format": "step",
                                         "bodies": ["$bodies.data.items.0.id"]},
     "expect": {"data.solids": 1, "data.bodies": 1, "data.part_modified": true}},
    {"call": "nx_list_files", "args": {"path": "$run/em"},
     "expect": {"page.total": 3}},
    {"call": "nx_export_model", "args": {"path": "$run/em/d.step", "format": "step",
                                         "bodies": ["$bodies.data.items.0.id", "$bodies.data.items.0.id"]},
     "expect": {"error.category": "invalid_argument", "error.field": "/bodies/1", "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "$run/em/a.step", "format": "step"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "$run/em/a.igs", "format": "step"},
     "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "$run/em/a.stl", "format": "step"},
     "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "error.field": "/path", "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "$run/em/a.dxf", "format": "dxf"},
     "expect": {"error.category": "invalid_argument", "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "../em_outside.step", "format": "step"},
     "expect": {"error.code": "NX_PATH_OUTSIDE_WORKSPACE", "mutation_outcome": "not_started"}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/em/pf_export_asm.prt"}},
    {"call": "nx_create_component", "setup": true, "args": {"path": "$fixture", "name": "FX"}},
    {"call": "nx_activate_part", "setup": true, "args": {"part": "$fx.data.part.id", "display": false}},
    {"call": "nx_export_model", "args": {"path": "$run/em/e.step", "format": "step"},
     "expect": {"error.code": "NX_WRONG_PART_CONTEXT", "mutation_outcome": "not_started"}},
    {"call": "nx_list_files", "args": {"path": "$run/em"},
     "expect": {"page.total": 3}}
  ]
}
