{
  "covers": {"nx_get_kf_rules": [], "nx_set_kf_rule": ["child", "dynamic"], "nx_update_kf_rules": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_set_expression", "setup": true, "args": {"name": "plate_len", "formula": "40", "units": "mm"}},
    {"call": "nx_get_kf_rules", "args": {},
     "expect": {"ok": true, "data.instance": "root:", "data.class_name": null,
                "data.rules.0.name": "plate_len", "data.rules.0.chain": "root:plate_len:",
                "data.rules.0.value": {"close": 40, "tol": 1e-9}, "data.rules.0.type": "number",
                "data.rules.0.expression": true}},
    {"call": "nx_set_kf_rule", "args": {"kind": "dynamic", "name": "twice", "formula": "plate_len: * 2"},
     "expect": {"mutation_outcome": "committed", "data.created": true,
                "data.rule.value": {"close": 80, "tol": 1e-9}, "data.rule.expression": false}},
    {"call": "nx_set_kf_rule",
     "args": {"kind": "dynamic", "name": "label", "formula": "\"plate \" + format(\"%g\", plate_len:)", "rule_type": "string"},
     "expect": {"mutation_outcome": "committed", "data.rule.value": "plate 40", "data.rule.type": "string"}},
    {"call": "nx_set_kf_rule",
     "args": {"kind": "child", "name": "size", "class_name": "ug_expression", "parameters": [{"name": "Value", "value": 25}]},
     "expect": {"mutation_outcome": "committed", "data.created": true, "data.rule.child": "ug_expression",
                "data.rule.type": "instance", "data.rules.0.name": "Value",
                "data.rules.0.value": {"close": 25, "tol": 1e-9}}},
    {"call": "nx_get_kf_rules", "args": {"instance": "root:size:", "rules": ["Value"]},
     "expect": {"data.class_name": "ug_expression", "data.rules.0.value": {"close": 25, "tol": 1e-9}}},
    {"call": "nx_set_kf_rule",
     "args": {"kind": "child", "name": "size", "class_name": "ug_expression", "parameters": [{"name": "Value", "value": "plate_len: / 2"}]},
     "expect": {"mutation_outcome": "committed", "data.created": false, "data.rules.0.value": {"close": 20, "tol": 1e-9}}},
    {"call": "nx_set_expression", "setup": true, "args": {"name": "plate_len", "formula": "50"}},
    {"call": "nx_update_kf_rules", "args": {},
     "expect": {"mutation_outcome": "committed", "data.failed": {"count": 0}, "data.rules": 4}},
    {"call": "nx_get_kf_rules", "args": {"rules": ["twice", "label"]},
     "expect": {"data.rules.0.value": {"close": 100, "tol": 1e-9}, "data.rules.1.value": "plate 50"}},
    {"call": "nx_set_kf_rule", "args": {"kind": "child", "name": "other", "class_name": "no_such_kf_class"},
     "expect": {"error.code": "NX_NOT_FOUND", "error.field": "/class_name"}},
    {"call": "nx_set_kf_rule", "args": {"kind": "dynamic", "name": "size", "formula": "1"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
    {"call": "nx_set_kf_rule", "args": {"kind": "dynamic", "name": "plate_len", "formula": "1"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "error.field": "/name"}},
    {"call": "nx_get_kf_rules", "args": {"instance": "root:nothing:"},
     "expect": {"error.code": "NX_NOT_FOUND", "error.field": "/instance"}}
  ]
}
