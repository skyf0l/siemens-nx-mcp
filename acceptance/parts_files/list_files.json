{
  "covers": {"nx_list_files": []},
  "part": null,
  "steps": [
    {"call": "nx_create_directory", "setup": true, "args": {"path": "$run/ls/sub"}},
    {"call": "nx_upload_file", "setup": true,
     "args": {"path": "$run/ls/a.txt", "data_base64": "eA==", "offset": 0, "total_size": 1,
              "sha256": "2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881"}},
    {"call": "nx_upload_file", "setup": true,
     "args": {"path": "$run/ls/b.txt", "data_base64": "aGVsbG8gd29ybGQ=", "offset": 0, "total_size": 11,
              "sha256": "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9"}},
    {"call": "nx_list_files", "args": {"path": "$run/ls"},
     "expect": {"mutation_outcome": "not_applicable", "page.total": 3, "data.items.0.kind": "file",
                "data.items.0.size": 1,
                "data.items.0.sha256": "2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881",
                "data.items.2.kind": "directory", "data.path": {"matches": "^smoke/.+/ls$"}}},
    {"call": "nx_list_files", "args": {"path": "$run/ls", "limit": 2},
     "expect": {"data.items": {"count": 2}, "page.next_offset": 2}},
    {"call": "nx_list_files", "args": {"path": "$run/ls", "offset": 2, "limit": 2},
     "expect": {"data.items": {"count": 1}, "page.next_offset": null}},
    {"call": "nx_list_files", "args": {"path": "$run/ls", "prefix": "B"},
     "expect": {"page.total": 1, "data.items.0.size": 11}},
    {"call": "nx_list_files", "args": {"limit": 200},
     "expect": {"data.path": ".", "data.items": {"contains": {"path": "smoke", "kind": "directory"}}}},
    {"call": "nx_list_files", "args": {"path": "$run/ls/a.txt"},
     "expect": {"error.code": "NX_WRONG_KIND", "error.field": "/path"}},
    {"call": "nx_list_files", "args": {"path": "$run/ls/missing"},
     "expect": {"error.code": "NX_FILE_NOT_FOUND", "error.field": "/path",
                "error.hint": {"matches": "nx_create_directory"}, "error.message": {"matches": "ls/missing"}}},
    {"call": "nx_list_files", "args": {"path": ".NX-MCP"},
     "expect": {"error.code": "NX_PATH_RESERVED"}},
    {"call": "nx_list_files", "args": {"path": ".."},
     "expect": {"error.code": "NX_PATH_OUTSIDE_WORKSPACE"}}
  ]
}
