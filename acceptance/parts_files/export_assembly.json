{
  "covers": {"nx_export_assembly": ["zip", "clone"]},
  "part": null,
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/ea/parts/pf_ea_blk.prt"}},
    {"call": "nx_save_part", "setup": true, "args": {}},
    {"call": "nx_create_part", "setup": true, "save": "g_pf_ea_plate", "args": {"path": "$run/ea/parts/pf_ea_plate.prt"}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "$g_pf_ea_plate.data.part.id"}},
    {"call": "nx_create_part", "setup": true, "save": "asm", "args": {"path": "$run/ea/pf_ea_asm.prt", "display": true}},
    {"call": "nx_create_component", "setup": true, "args": {"part": "pf_ea_asm", "path": "$run/ea/parts/pf_ea_blk.prt", "name": "BLK1"}},
    {"call": "nx_create_component", "setup": true,
     "args": {"part": "pf_ea_asm", "path": "$run/ea/parts/pf_ea_blk.prt", "name": "BLK2", "pose": {"translation": [50, 0, 0]}}},
    {"call": "nx_create_component", "setup": true, "args": {"part": "pf_ea_asm", "path": "$run/ea/parts/pf_ea_plate.prt", "name": "PLATE"}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ea_asm", "path": "$run/ea/pkg.zip", "format": "zip"},
     "expect": {"error.code": "NX_UNSAVED_PART", "mutation_outcome": "not_started",
                "error.details.part": {"matches": "pf_ea_asm\\.prt$"}}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "$asm.data.part.id"}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ea_asm", "path": "$run/ea/pkg.zip", "format": "zip"},
     "expect": {"mutation_outcome": "committed", "data.format": "zip", "data.file_count": 3,
                "data.component_count": 3, "data.sha256": {"matches": "^[0-9a-f]{64}$"},
                "data.top_part": {"matches": "/ea/pf_ea_asm\\.prt$"},
                "data.files.0.sha256": {"matches": "^[0-9a-f]{64}$"}}},
    {"call": "nx_download_file", "args": {"path": "$run/ea/pkg.zip"},
     "expect": {"data.sha256": {"matches": "^[0-9a-f]{64}$"}}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ea_asm", "path": "$run/ea/pkg.zip", "format": "zip"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ea_asm", "path": "$run/ea/pkg.tar", "format": "zip"},
     "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "mutation_outcome": "not_started"}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ea_asm", "path": "$run/ea/pkg2.zip", "format": "zip", "prefix": "Z_"},
     "expect": {"error.field": "/prefix", "mutation_outcome": "not_started"}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ea_asm", "path": "$run/ec/copy", "format": "clone", "prefix": "C_"},
     "expect": {"mutation_outcome": "committed", "data.format": "clone", "data.file_count": 3,
                "data.component_count": 3, "data.top_part": {"matches": "/ec/copy/C_pf_ea_asm\\.prt$"}}},
    {"call": "nx_list_files", "args": {"path": "$run/ec/copy/parts"},
     "expect": {"page.total": 2, "data.items.0.path": {"matches": "C_pf_ea_blk\\.prt$"}}},
    {"call": "nx_list_files", "args": {"path": "$run/ec/copy", "prefix": "nx-project-manifest"},
     "expect": {"page.total": 1}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run/ec"},
     "expect": {"page.total": 0}},
    {"call": "nx_list_parts", "args": {"active_only": true},
     "expect": {"data.items.0.path": {"matches": "pf_ea_asm\\.prt$"}}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ea_asm", "path": "$run/ec/copy2", "format": "clone", "prefix": "D_", "activate": true},
     "expect": {"mutation_outcome": "committed", "data.part.kind": "part", "data.file_count": 3}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run/ec/copy2", "active_only": true},
     "expect": {"page.total": 1, "data.items.0.path": {"matches": "D_pf_ea_asm\\.prt$"}, "data.items.0.owned": true}},
    {"call": "nx_activate_part", "setup": true, "args": {"part": "$asm.data.part.id"}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ea_asm", "path": "$run/ec/copy3", "format": "clone", "prefix": "D_"},
     "expect": {"error.code": "NX_NAME_CONFLICT", "mutation_outcome": "not_started"}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ea_asm", "path": "$run/ec/copy4", "format": "clone"},
     "expect": {"error.field": "/prefix", "mutation_outcome": "not_started"}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ea_asm", "path": "$run/ec/copy5", "format": "clone", "prefix": "a b"},
     "expect": {"error.category": "invalid_argument", "error.field": "/prefix"}},
    {"call": "nx_export_assembly", "args": {"part": "pf_ea_asm", "path": "$run/ec/copy", "format": "clone", "prefix": "E_"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
    {"call": "nx_list_files", "args": {"path": "$run/ec"},
     "expect": {"page.total": 2}}
  ]
}
