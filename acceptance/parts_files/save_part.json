{
  "covers": {"nx_save_part": []},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_open_part", "setup": true, "save": "fx", "args": {"path": "$fixture"}},
    {"call": "nx_create_datum_plane", "setup": true,
     "args": {"method": "point_normal", "origin": [5, 5, 5], "normal": [0, 0, 1]}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$fixture", "modified": true},
     "expect": {"page.total": 1}},
    {"call": "nx_save_part", "args": {},
     "expect": {"mutation_outcome": "committed",
                "data.saved_files.0": {"matches": "parts_files_save_part_parts_files_block_mm\\.prt$"},
                "data.saved_files": {"count": 1}, "data.part.kind": "part",
                "warnings": {"contains": {"code": "NX_NOTE"}}}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$fixture", "modified": false},
     "expect": {"page.total": 1}},
    {"call": "nx_save_part", "save": "as", "args": {"part": "$fx.data.part.id", "path": "$run/sv/pf_saved_as.prt"},
     "expect": {"mutation_outcome": "committed", "data.saved_as": true,
                "data.path": {"matches": "/sv/pf_saved_as\\.prt$"}}},
    {"call": "nx_list_files", "args": {"path": "$run/sv"},
     "expect": {"page.total": 1, "data.items.0.path": {"matches": "pf_saved_as\\.prt$"}}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run/sv"},
     "expect": {"page.total": 1, "data.items.0.modified": false, "data.items.0.owned": true,
                "data.items.0.work": true}},
    {"call": "nx_save_part", "args": {"path": "$run/sv/pf_saved_as.prt"},
     "expect": {"mutation_outcome": "committed", "data.saved_files": {"count": 1},
                "data.saved_files.0": {"matches": "/sv/pf_saved_as\\.prt$"}, "data.part.kind": "part"}},
    {"call": "nx_save_part", "args": {"part": "$fx.data.part.id", "path": "$fixture"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "error.field": "/path", "mutation_outcome": "not_started",
                "error.hint": {"matches": "omit path"}}},
    {"call": "nx_create_part", "setup": true, "save": "clash", "args": {"path": "$run/pf_clash.prt"}},
    {"call": "nx_create_datum_plane", "setup": true,
     "args": {"part": "pf_clash", "method": "point_normal", "origin": [0, 0, 1], "normal": [0, 0, 1]}},
    {"call": "nx_save_part", "args": {"part": "$fx.data.part.id"},
     "expect": {"mutation_outcome": "committed",
                "data.other_modified_parts": {"contains": {"kind": "part", "name": "pf_clash"}}}},
    {"call": "nx_save_part", "args": {"part": "$fx.data.part.id", "path": "$run/z/PF_CLASH.prt"},
     "expect": {"error.code": "NX_NAME_CONFLICT", "mutation_outcome": "not_started"}},
    {"call": "nx_list_files", "args": {"path": "$run/z"},
     "expect": {"error.code": "NX_FILE_NOT_FOUND"}},
    {"call": "nx_save_part", "args": {"part": "$clash.data.part.id"},
     "expect": {"mutation_outcome": "committed", "data.saved_files.0": {"matches": "pf_clash\\.prt$"}}},
    {"call": "nx_save_part", "args": {"part": "$clash.data.part.id", "path": "../pf_outside.prt"},
     "expect": {"error.code": "NX_PATH_OUTSIDE_WORKSPACE", "mutation_outcome": "not_started"}},
    {"call": "nx_save_part", "args": {"part": "$clash.data.part.id", "path": "$run/pf_wrong.step"},
     "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "mutation_outcome": "not_started"}},
    {"call": "nx_save_part", "args": {"part": "p:999999999"},
     "expect": {"error.code": {"matches": "^NX_(NOT_FOUND|STALE_REFERENCE)$"}, "mutation_outcome": "not_started",
                "error.hint": {"matches": "nx_list_parts"}}},
    {"call": "nx_create_part", "setup": true, "save": "own", "args": {"path": "$run/sv2/pf_own.prt"}},
    {"call": "nx_save_part", "args": {"part": "$own.data.part.id", "path": "$run/sv2/pf_own.prt"},
     "expect": {"mutation_outcome": "committed", "data.saved_files": {"count": 1},
                "data.saved_files.0": {"matches": "/sv2/pf_own\\.prt$"}}},
    {"call": "nx_save_part", "args": {"part": "$own.data.part.id", "path": "$run/sv2/pf_own.prt"},
     "expect": {"mutation_outcome": "committed", "data.saved_files.0": {"matches": "/sv2/pf_own\\.prt$"}}},
    {"call": "nx_list_files", "args": {"path": "$run/sv2"},
     "expect": {"page.total": 1}},
    {"call": "nx_save_part", "args": {"part": "$fx.data.part.id", "path": "$run/sv3/pf_saved_as.prt"},
     "expect": {"mutation_outcome": {"matches": "^(committed|rolled_back)$"}}}
  ]
}
