  {"call": "nx_undo_operation", "args": {"part": "mc_b"}, "intent": "Acceptance: NX's undo of B's block would cross A's close (NX would load A again): the default undo compensates it instead (bench3t)", "expect": {"mutation_outcome": "committed", "data.compensated": true, "data.undone": ["$b1.operation_id"], "changes.deleted": {"count_kind": {"feature": 1, "body": 1}}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/mc/mc_a"}, "intent": "Acceptance: A was not loaded again", "expect": {"page.total": 0}},
