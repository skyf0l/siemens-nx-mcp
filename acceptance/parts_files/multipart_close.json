  {"call": "nx_create_sheet_metal_feature", "setup": true, "args": {"operation": "tab", "parameters": {"section": "$smsk.data.sketch.id", "thickness": 2}}},
  {"call": "nx_close_part", "args": {"part": "mc_comp2", "force": true}, "intent": "Acceptance: the active tab closes; the most recently active tab (the sheet-metal part, tabbed by its Sheet Metal call) comes back in Sheet Metal, no dialog", "expect": {"mutation_outcome": "committed", "data.undo_marks": "kept", "data.displayed.id": "$sm.data.part.id"}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/mc"}, "expect": {"page.total": 1, "data.items.0.part.id": "$sm.data.part.id", "data.items.0.display": true}}
