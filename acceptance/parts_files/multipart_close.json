  {"call": "nx_create_primitive", "args": {"part": "mc_b", "shape": "block", "length": 5, "width": 5, "height": 5, "origin": [30, 0, 0]}, "expect": {"mutation_outcome": "committed", "part.file": "mc_b.prt"}},
  {"call": "nx_close_part", "args": {"part": "mc_b", "save": false}, "intent": "Acceptance: an agent's own close right after working in its part closes without force", "expect": {"mutation_outcome": "committed", "data.closed_count": 1, "data.undo_marks": "kept"}},
