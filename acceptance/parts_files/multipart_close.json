  {"call": "engineer", "args": {"code": "from nx_mcp.kit import parts as kp\nservices.host._remember_model()  # the development tool's own undo mark is no engineer edit\np = [x for x in session.Parts if str(x.Leaf).lower().startswith('mc_comp2') and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nkp.show(NXOpen, session.Parts, p)\nservices.host._remember_model()  # nor is the mark of a show from no display part\nresult = p.Leaf"}, "intent": "Acceptance: the engineer looks at mc_comp2.prt (a tab click, no edit): after the assembly's close NX shows the tab active before (on a clean NX none), so the next activate meets the same display either way (engineer tab guard)", "expect": {"ok": true, "data.noticed": false}},
  {"call": "nx_activate_part", "args": {"part": "mc_comp2", "display": true}, "intent": "Acceptance: activate takes a file name (display true: its tab stays active)", "expect": {"mutation_outcome": "committed", "data.display": true, "data.work": true, "data.part.name": {"matches": "(?i)^mc_comp2$"}}},
  {"call": "nx_save_part", "args": {"part": "mc_c.prt"}, "intent": "Acceptance: a save while the last call worked in another part never warns about other agents (bench3t: 14 false notes)", "expect": {"mutation_outcome": "committed", "data.path": {"matches": "mc_c[.]prt$"}, "warnings": {"count": 1}, "warnings.0.message": {"matches": "^Saving expires NX undo marks"}}},
  {"call": "nx_save_part", "args": {"part": "$run/mc/mc_comp2.prt"}, "expect": {"mutation_outcome": "committed", "data.path": {"matches": "mc_comp2[.]prt$"}}},
  {"call": "nx_create_part", "args": {"path": "$run/mc_other/MC_C.prt"}, "intent": "Acceptance: a file name a loaded part uses (another agent's too) is taken; a unique name is suggested", "expect": {"ok": false, "error.code": "NX_NAME_CONFLICT", "mutation_outcome": "not_started", "error.message": {"matches": "^The file name mc_c[.]prt is taken"}, "error.hint": {"contains": "unique"}, "error.details.suggested_path": {"matches": "mc_other/MC_C_2[.]prt$"}}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/mc/mc_d.prt", "units": "mm", "display": false}},
  {"call": "nx_create_part", "args": {"path": "$run/mc/mc_d.prt"}, "intent": "Acceptance: the same new file again (loaded, not saved yet): taken, never 'activate it'", "expect": {"ok": false, "error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started", "error.message": {"matches": "^The file name mc_d[.]prt is taken: that file is already loaded"}, "error.details.suggested_path": {"matches": "mc/mc_d_2[.]prt$"}}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "mc_c", "save": false, "force": true}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "mc_d", "save": false, "force": true}},
  {"call": "nx_create_part", "setup": true, "save": "sm", "args": {"path": "$run/mc/mc_sm.prt", "units": "mm", "display": false}},
