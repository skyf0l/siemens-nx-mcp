  {"call": "nx_close_part", "args": {"part": "mc_asm", "save": false}, "intent": "Acceptance: the assembly close unloads comp1 and keeps comp2, which a call worked in after the assembly was loaded", "expect": {"mutation_outcome": "committed", "data.closed_count": 2, "data.unloaded_components": {"count": 1}, "data.unloaded_components.0.name": {"matches": "(?i)^mc_comp1$"}, "data.kept_components": {"count": 1}, "data.kept_components.0.part.name": {"matches": "(?i)^mc_comp2$"}, "data.kept_components.0.reason": {"contains": "in use"}}},
