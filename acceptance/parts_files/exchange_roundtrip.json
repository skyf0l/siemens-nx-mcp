{
  "covers": {"nx_export_model": ["iges", "step"], "nx_import_model": ["dxf_dwg", "iges", "step"],
             "nx_export_profile": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id",
              "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]},
                         {"type": "circle", "center": [20, 10], "radius": 3}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"mutation_outcome": "committed", "data.volume": {"close": 7717.2567, "tol": 0.001}}},
    {"call": "nx_export_profile", "args": {"source": "$sk.data.sketch.id", "path": "$run/rt/plate.dxf"},
     "expect": {"mutation_outcome": "committed", "data.entity_count": 5,
                "data.entity_counts": {"equals": {"LINE": 4, "CIRCLE": 1}}, "data.units": "mm"}},
    {"call": "nx_export_model", "args": {"path": "$run/rt/plate.igs"},
     "expect": {"mutation_outcome": "committed", "data.format": "iges", "data.units": "mm",
                "data.file_units": "mm"}},
    {"call": "nx_export_model", "args": {"path": "$run/rt/plate.stp"},
     "expect": {"mutation_outcome": "committed", "data.format": "step", "data.schema": "AP214",
                "data.solids": 1}},
    {"call": "nx_export_model", "args": {"path": "$run/rt/plate2.step", "options": {"binary": false}},
     "expect": {"error.field": "/options/binary", "mutation_outcome": "not_started"}},
    {"call": "nx_import_model",
     "args": {"path": "$run/rt/plate.dxf", "target": "new_part", "new_part_path": "$run/rt/pf_rt_dxf.prt"},
     "expect": {"mutation_outcome": "committed", "data.format": "dxf_dwg", "data.curve_count": 5,
                "data.solids": 0, "data.file_units": "mm",
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.0001},
                "data.bounds.max": {"close": [40, 20, 0], "tol": 0.0001}}},
    {"call": "nx_import_model",
     "args": {"path": "$run/rt/plate.igs", "target": "new_part", "new_part_path": "$run/rt/pf_rt_igs.prt"},
     "expect": {"mutation_outcome": "committed", "data.format": "iges", "data.solids": 1, "data.sheets": 0,
                "data.volume": {"close": 7717.2567, "tol": 0.5},
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.001},
                "data.bounds.max": {"close": [40, 20, 10], "tol": 0.001}}},
    {"call": "nx_import_model",
     "args": {"path": "$run/rt/plate.stp", "target": "new_part", "new_part_path": "$run/rt/pf_rt_stp.prt"},
     "expect": {"mutation_outcome": "committed", "data.format": "step", "data.solids": 1,
                "data.volume": {"close": 7717.2567, "tol": 0.01},
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.0001},
                "data.bounds.max": {"close": [40, 20, 10], "tol": 0.0001}}},
    {"call": "nx_import_model", "args": {"part": "pf_rt_stp", "path": "$run/rt/plate.igs", "options": {"units": "mm"}},
     "expect": {"error.field": "/options/units", "mutation_outcome": "not_started"}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run/rt"},
     "expect": {"page.total": 3}}
  ]
}
