{
  "covers": {"nx_set_kf_rule": ["child", "dynamic"], "nx_get_kf_rules": [], "nx_delete_kf_rule": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_get_kf_rules", "args": {"class_name": "ug_block"},
     "intent": "Acceptance: a class's input parameters with their defaults, without the KF base parameters every class has",
     "expect": {"ok": true, "data.class_name": "ug_block", "data.parameters.3.name": {"matches": "."},
                "data.parameters.0.default": {"matches": "."}}},
    {"call": "nx_get_kf_rules", "args": {"class_name": "no_such_class_x"},
     "expect": {"ok": false, "error.code": "NX_NOT_FOUND", "error.field": "/class_name", "mutation_outcome": "not_applicable"}},
    {"call": "nx_set_kf_rule",
     "args": {"kind": "child", "name": "box2", "class_name": "ug_block",
              "parameters": [{"name": "Length", "value": 15}, {"name": "Width", "value": 25},
                             {"name": "Height", "value": 5}, {"name": "Origin", "value": "Point(0,50,0)"}]},
     "expect": {"mutation_outcome": "committed", "data.created": true, "data.rule.child": "ug_block",
                "data.rules.0.value": {"close": 15, "tol": 1e-9}, "data.rules.0.formula": "15"}},
    {"call": "nx_set_kf_rule",
     "args": {"kind": "child", "name": "box2", "class_name": "ug_block", "parameters": [{"name": "Height", "value": 9}]},
     "intent": "Acceptance: changing one parameter of an existing child keeps the others (NX alone resets them to the class defaults)",
     "expect": {"mutation_outcome": "committed", "data.created": false, "data.kept_parameters": {"count": 3},
                "data.rules.0.name": "Height", "data.rules.0.value": {"close": 9, "tol": 1e-9}}},
    {"call": "nx_get_kf_rules", "args": {"instance": "root:box2:", "rules": ["Length", "width", "Height", "origin"]},
     "expect": {"data.rules.0.value": {"close": 15, "tol": 1e-9}, "data.rules.1.value": {"close": 25, "tol": 1e-9},
                "data.rules.2.value": {"close": 9, "tol": 1e-9}, "data.rules.3.type": "point",
                "data.rules.3.value.1": {"close": 50, "tol": 1e-9}, "data.rules.3.formula": "Point(0,50,0)"}},
    {"call": "nx_set_kf_rule",
     "args": {"kind": "child", "name": "box2", "class_name": "ug_block", "replace": true, "parameters": [{"name": "Height", "value": 7}]},
     "intent": "Acceptance: replace resets the parameters not given to the class defaults",
     "expect": {"mutation_outcome": "committed", "data.created": false}},
    {"call": "nx_get_kf_rules", "args": {"instance": "root:box2:", "rules": ["Length", "Height"]},
     "expect": {"data.rules.0.value": {"close": 1, "tol": 1e-9}, "data.rules.1.value": {"close": 7, "tol": 1e-9}}},
    {"call": "nx_set_kf_rule",
     "args": {"kind": "child", "name": "rib_t", "class_name": "ug_expression", "parameters": [{"name": "Valeu", "value": 4}]},
     "intent": "Acceptance: a misspelled class parameter is refused before NX with the close match",
     "expect": {"ok": false, "error.code": "NX_INVALID_ARGUMENT", "error.field": "/parameters/0/name",
                "mutation_outcome": "not_started", "error.message": {"contains": "value"}}},
    {"call": "nx_set_kf_rule",
     "args": {"kind": "child", "name": "rib_t", "class_name": "ug_expression", "parameters": [{"name": "Value", "value": "10 mm"}]},
     "intent": "Acceptance: a value with units is a KF syntax error named on its parameter, rolled back",
     "expect": {"ok": false, "error.code": "NX_INVALID_FORMULA", "error.field": "/parameters/0/value"}},
    {"call": "nx_set_kf_rule",
     "args": {"kind": "child", "name": "rib_t", "class_name": "ug_expression", "parameters": [{"name": "Value", "value": 3.5}]},
     "expect": {"mutation_outcome": "committed", "data.created": true}},
    {"call": "nx_set_kf_rule",
     "args": {"kind": "child", "name": "rib_t", "class_name": "ug_expression", "parameters": [{"name": "Value", "value": 11}]},
     "intent": "Acceptance: the expression the KF child drives is reported as modified",
     "expect": {"mutation_outcome": "committed", "changes.modified.0.kind": "expression",
                "changes.modified.0.name": {"contains": "rib_t"}}},
    {"call": "nx_set_kf_rule", "args": {"kind": "dynamic", "name": "dr1", "formula": "2 * 3"},
     "expect": {"mutation_outcome": "committed", "data.rule.formula": "2 * 3", "data.rule.value": {"close": 6, "tol": 1e-9}}},
    {"call": "nx_delete_kf_rule", "args": {"name": "dr1"},
     "expect": {"mutation_outcome": "committed", "data.kind": "dynamic", "data.name": "dr1"}},
    {"call": "nx_delete_kf_rule", "args": {"name": "box2"},
     "expect": {"mutation_outcome": "committed", "data.kind": "child", "data.class_name": "ug_block"}},
    {"call": "nx_list_objects", "args": {"kind": "body"},
     "intent": "Acceptance: deleting the child removed the body it made",
     "expect": {"page.total": 0}},
    {"call": "nx_delete_kf_rule", "args": {"name": "dr1"},
     "expect": {"ok": false, "error.code": "NX_NOT_FOUND", "mutation_outcome": "not_started"}}
  ]
}
