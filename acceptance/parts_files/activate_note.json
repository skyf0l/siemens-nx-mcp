{
  "covers": {"nx_activate_part": []},
  "part": null,
  "steps": [
    {"call": "nx_create_part", "setup": true, "save": "a", "args": {"path": "$run/actn/pf_actn_a.prt", "display": true}},
    {"call": "nx_create_part", "setup": true, "save": "b", "args": {"path": "$run/actn/pf_actn_b.prt"}},
    {"call": "nx_activate_part", "args": {"part": "$b.data.part.id"},
     "intent": "Acceptance: with two agent parts loaded the default activation gives the part its own tab behind the active one, and the note says why the work part did not change",
     "expect": {"mutation_outcome": "committed", "data.work": false, "data.display": false,
                "warnings.0.code": "NX_NOTE",
                "warnings.0.message": {"matches": "pf_actn_b[.]prt is loaded in its own NX tab behind it.*The work part did not change: "}}},
    {"call": "nx_activate_part", "args": {"part": "$b.data.part.id"},
     "intent": "Acceptance: the same activation again changes nothing: not_applicable with NX_NO_EFFECT",
     "expect": {"mutation_outcome": "not_applicable", "data.work": false, "data.display": false,
                "warnings.0.code": "NX_NO_EFFECT",
                "warnings.0.message": {"matches": "^Nothing changed: "}}},
    {"call": "nx_activate_part", "args": {"part": "$b.data.part.id", "display": true},
     "expect": {"mutation_outcome": "committed", "data.display": true, "data.work": true}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run/actn", "active_only": true},
     "expect": {"page.total": 1, "data.items.0.path": {"matches": "pf_actn_b[.]prt$"}}}
  ]
}
