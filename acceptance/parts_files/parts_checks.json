{
  "covers": {"nx_save_part": [], "nx_activate_part": [], "nx_set_attributes": [], "nx_create_part_family": [],
             "nx_create_directory": [], "nx_upload_file": [], "nx_create_part": []},
  "fixture": null,
  "part": null,
  "steps": [
    {"call": "nx_create_part", "save": "t", "args": {"path": "$run/pc/pc_tmpl.prt", "units": "mm", "display": false}},
    {"call": "nx_create_part", "save": "inch", "args": {"path": "$run/pc/pc_inch.prt", "units": "in", "display": false},
     "intent": "Acceptance: the units block names the new part's units although it is not the work part",
     "expect": {"ok": true, "data.units": "in", "units.length": "in"}},
    {"call": "nx_create_primitive", "setup": true, "args": {"part": "pc_tmpl", "shape": "block", "length": 40, "width": 20, "height": 10}},
    {"call": "nx_set_expression", "setup": true, "save": "len", "args": {"part": "pc_tmpl", "name": "plate_len", "formula": "40", "units": "mm"}},
    {"call": "nx_save_part", "args": {"part": "pc_tmpl"},
     "expect": {"mutation_outcome": "committed", "data.saved": true, "data.saved_files": {"count": 1}}},
    {"call": "nx_save_part", "args": {"part": "pc_tmpl"},
     "intent": "Acceptance: a part without unsaved changes is left as it is",
     "expect": {"mutation_outcome": "not_applicable", "data.saved": false, "data.saved_files": {"count": 0},
                "warnings.0.code": "NX_NO_EFFECT"}},
    {"call": "nx_save_part", "args": {"part": "pc_tmpl", "path": "$run/pc/pc_tmpl.prt"},
     "expect": {"mutation_outcome": "not_applicable", "data.saved": false}},
    {"call": "nx_upload_file", "setup": true, "args": {"path": "$run/pc/taken.prt", "data_base64": "eA==", "offset": 0, "total_size": 1,
                                                       "sha256": "2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881"}},
    {"call": "nx_save_part", "args": {"part": "pc_tmpl", "path": "$run/pc/taken.prt"},
     "expect": {"ok": false, "error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started",
                "error.details.suggested_path": {"matches": "pc/taken-2[.]prt$"}}},
    {"call": "nx_activate_part", "args": {"part": "pc_inch", "display": false},
     "intent": "Acceptance: an activate that changes nothing says so instead of a plain committed",
     "expect": {"ok": true, "mutation_outcome": "not_applicable", "warnings.0.code": "NX_NO_EFFECT"}},
    {"call": "nx_set_attributes", "args": {"part": "pc_tmpl", "objects": ["$len.data.expression.id"], "attributes": {"T": "x"}},
     "intent": "Acceptance: an expression cannot carry user attributes: refused before NX on its field",
     "expect": {"ok": false, "error.code": "NX_WRONG_KIND", "error.field": "/objects/0", "mutation_outcome": "not_started"}},
    {"call": "nx_set_attributes", "setup": true, "args": {"part": "pc_tmpl", "values": [{"name": "DUE", "type": "date", "value": "2027-01-31"}]}},
    {"call": "nx_set_attributes", "args": {"part": "pc_tmpl", "values": [{"name": "DUE", "value": "2026-13-45"}]},
     "expect": {"ok": false, "error.code": "NX_INVALID_ARGUMENT", "error.field": "/values/0/value",
                "error.message": {"contains": "month"}}},
    {"call": "nx_set_attributes", "args": {"part": "pc_tmpl", "delete": ["NOPE"]},
     "expect": {"ok": true, "data.items.0.deleted": {"count": 0}, "warnings.0.message": {"contains": "NOPE"}}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "pc_tmpl"}},
    {"call": "nx_create_part_family",
     "args": {"part": "pc_tmpl", "expressions": ["plate_len"], "directory": "$run/pc/fam",
              "members": [{"name": "pc_m10", "values": ["10 mm"]}, {"name": "pc_m1in", "values": ["1 in"]}]},
     "intent": "Acceptance: values with units become numbers in the expression's units before NX",
     "expect": {"ok": true, "mutation_outcome": "committed",
                "data.members.0.values.plate_len": {"close": 10, "tol": 1e-9},
                "data.members.1.values.plate_len": {"close": 25.4, "tol": 1e-9}}},
    {"call": "nx_create_directory", "args": {"path": "$run/pc/part.prt"},
     "expect": {"ok": false, "error.code": "NX_INVALID_ARGUMENT", "error.field": "/path", "mutation_outcome": "not_started"}},
    {"call": "nx_create_directory", "args": {"path": "$run/pc/bad<name>?"},
     "expect": {"ok": false, "error.code": "NX_INVALID_ARGUMENT", "error.message": {"contains": "contains"}}},
    {"call": "nx_upload_file", "args": {"path": "$run/pc/bom.csv", "content": "item,qty\nA,1\n"},
     "expect": {"ok": true, "data.committed": true, "data.received": 13}}
  ]
}
