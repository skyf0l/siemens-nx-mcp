{
  "covers": {"nx_export_profile": []},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_open_part", "setup": true, "args": {"path": "$fixture"}},
    {"call": "nx_list_objects", "setup": true, "save": "sk", "args": {"kind": "sketch"}},
    {"call": "nx_list_objects", "setup": true, "save": "fc", "args": {"kind": "face", "type": "plane"}},
    {"call": "nx_list_objects", "setup": true, "save": "body", "args": {"kind": "body"}},
    {"call": "nx_export_profile", "args": {"source": "$sk.data.items.0.id", "path": "$run/dxf/sketch.dxf"},
     "expect": {"mutation_outcome": "committed", "data.entity_count": 6,
                "data.entity_counts": {"equals": {"LINE": 4, "ARC": 1, "CIRCLE": 1}},
                "data.units": "mm", "data.source_units": "mm",
                "data.frame.origin": {"close": [0, 0, 0], "tol": 1e-9},
                "data.frame.normal": {"close": [0, 0, 1], "tol": 1e-9},
                "data.sha256": {"matches": "^[0-9a-f]{64}$"}, "data.path": {"matches": "/dxf/sketch\\.dxf$"}}},
    {"call": "nx_export_profile", "args": {"source": "$sk.data.items.0.id", "path": "$run/dxf/mirror.dxf",
                                           "frame": [[0, 0, 0], [-1, 0, 0], [0, 1, 0]], "layer": "OUTLINE"},
     "expect": {"data.entity_count": 6, "data.frame.normal": {"close": [0, 0, -1], "tol": 1e-9},
                "data.frame.x_axis": {"close": [-1, 0, 0], "tol": 1e-9}}},
    {"call": "nx_export_profile", "args": {"source": "$fc.data.items.0.id", "path": "$run/dxf/face.dxf"},
     "expect": {"data.entity_counts": {"equals": {"LINE": 4}}, "data.entity_count": 4}},
    {"call": "nx_list_objects", "setup": true, "save": "edges",
     "args": {"kind": "edge", "owner": "$fc.data.items.0.id"}},
    {"call": "nx_export_profile", "args": {"source": "$fc.data.items.0.id", "path": "$run/dxf/layers.dxf",
                                           "layer": "OUTLINE", "layers": [["$edges.data.items.0.id", "CUT"]]},
     "expect": {"mutation_outcome": "committed", "data.entity_count": 4}},
    {"call": "nx_list_files", "args": {"path": "$run/dxf"},
     "expect": {"page.total": 4}},
    {"call": "nx_export_profile", "args": {"source": "$sk.data.items.0.id", "path": "$run/dxf/sketch.dxf"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
    {"call": "nx_export_profile", "args": {"source": "$sk.data.items.0.id", "path": "$run/dxf/x.txt"},
     "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "mutation_outcome": "not_started"}},
    {"call": "nx_export_profile", "args": {"source": "$sk.data.items.0.id", "path": "$run/dxf/x.dxf", "layer": "bad layer"},
     "expect": {"error.category": "invalid_argument", "error.field": "/layer"}},
    {"call": "nx_export_profile", "args": {"source": "$sk.data.items.0.id", "path": "$run/dxf/x.dxf",
                                           "frame": [[0, 0, 0], [1, 0, 0], [1, 1, 0]]},
     "expect": {"error.category": "invalid_argument", "error.field": "/frame"}},
    {"call": "nx_export_profile", "args": {"source": "$sk.data.items.0.id", "path": "$run/dxf/x.dxf",
                                           "frame": [[0, 0, 0], [1, 0, 0], [0, 0, 1]]},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/frame", "mutation_outcome": "not_started"}},
    {"call": "nx_export_profile", "args": {"source": "$sk.data.items.0.id", "path": "$run/dxf/x.dxf",
                                           "frame": [[0, 0, 5], [1, 0, 0], [0, 1, 0]]},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/frame", "mutation_outcome": "not_started"}},
    {"call": "nx_export_profile", "args": {"source": "$sk.data.items.0.id", "path": "$run/dxf/x.dxf",
                                           "layers": [["$edges.data.items.0.id", "CUT"]]},
     "expect": {"error.category": "invalid_argument", "error.field": "/layers/0/0"}},
    {"call": "nx_export_profile", "args": {"source": "$fc.data.items.0.id", "path": "$run/dxf/x.dxf",
                                           "layers": [["$edges.data.items.0.id", "bad/name"]]},
     "expect": {"error.category": "invalid_argument", "error.field": "/layers/0/1"}},
    {"call": "nx_export_profile", "args": {"source": "$body.data.items.0.id", "path": "$run/dxf/x.dxf"},
     "expect": {"error.code": "NX_WRONG_KIND", "mutation_outcome": "not_started"}},
    {"call": "nx_list_files", "args": {"path": "$run/dxf"},
     "expect": {"page.total": 4}}
  ]
}
