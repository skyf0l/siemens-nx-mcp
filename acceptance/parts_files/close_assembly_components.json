{
 "covers": {
  "nx_close_part": []
 },
 "part": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/ca/ca_cover.prt"}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "ca_cover"}},
  {"call": "nx_create_part", "setup": true, "save": "bolt", "args": {"path": "$run/ca/ca_bolt.prt"}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "$bolt.data.part.id"}},
  {"call": "nx_create_part", "setup": true, "save": "kit", "args": {"path": "$run/ca/ca_kit.prt"}},
  {"call": "nx_create_component", "setup": true, "args": {"part": "ca_kit", "path": "$run/ca/ca_cover.prt", "name": "COVER"}},
  {"call": "nx_create_component", "setup": true, "args": {"part": "ca_kit", "path": "$run/ca/ca_bolt.prt", "name": "BOLT", "pose": {"translation": [0, 0, 30]}}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "$kit.data.part.id"}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/ca"}, "expect": {"page.total": 3}},
  {"call": "nx_close_part", "args": {"part": "$kit.data.part.id", "save": false, "unload_components": false}, "expect": {"mutation_outcome": "committed", "data.closed_count": 1, "data.closed.0.name": {"matches": "(?i)^ca_kit$"}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/ca"}, "expect": {"page.total": 2}},
  {"call": "nx_open_part", "setup": true, "save": "kit2", "args": {"path": "$run/ca/ca_kit.prt"}},
  {"call": "nx_close_part", "args": {"part": "$kit2.data.part.id", "save": false}, "intent": "Acceptance: cover and bolt were created by name: closing the kit keeps them loaded", "expect": {"mutation_outcome": "committed", "data.closed_count": 1, "data.closed.0.name": {"matches": "(?i)^ca_kit$"}, "data.kept_components": {"count": 2}, "data.kept_components.0.reason": {"matches": "^created or opened by name"}, "data.kept_components.1.reason": {"matches": "^created or opened by name"}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/ca"}, "expect": {"page.total": 2}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "ca_cover", "save": false, "force": true}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "ca_bolt", "save": false, "force": true}},
  {"call": "nx_open_part", "setup": true, "save": "kit3", "args": {"path": "$run/ca/ca_kit.prt", "load_components": true}},
  {"call": "nx_close_part", "args": {"part": "$kit3.data.part.id", "save": false}, "intent": "Acceptance: parts only the kit's open loaded close with the kit", "expect": {"mutation_outcome": "committed", "data.closed_count": 3, "data.unloaded_components": {"count": 2}, "data.closed.0.name": {"matches": "(?i)^ca_kit$"}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/ca"}, "expect": {"page.total": 0}},
  {"call": "nx_open_part", "setup": true, "save": "kit4", "args": {"path": "$run/ca/ca_kit.prt", "load_components": true}},
  {"call": "nx_set_attributes", "setup": true, "args": {"part": "ca_bolt", "values": [{"name": "MCP_CLOSE_NOTE", "type": "string", "value": "dirty"}]}},
  {"call": "nx_close_part", "args": {"part": "$kit4.data.part.id", "save": false}, "intent": "Acceptance: a component the kit loaded but with unsaved changes stays loaded", "expect": {"mutation_outcome": "committed", "data.closed_count": 2, "data.kept_components": {"count": 1}, "data.kept_components.0.part.name": {"matches": "(?i)^ca_bolt$"}, "data.kept_components.0.reason": {"contains": "unsaved changes"}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/ca", "modified": true}, "expect": {"page.total": 1}},
  {"call": "nx_open_part", "setup": true, "args": {"path": "$run/ca/ca_cover.prt"}},
  {"call": "nx_open_part", "setup": true, "save": "kit5", "args": {"path": "$run/ca/ca_kit.prt"}},
  {"call": "nx_close_part", "args": {"part": "$kit5.data.part.id", "save": false, "force": true}, "intent": "Acceptance: a part opened by name before the kit stays loaded after the kit closes", "expect": {"mutation_outcome": "committed", "data.closed_count": 1, "data.kept_components": {"count": 2}}},
  {"call": "nx_close_part", "args": {"part": "$run/ca/ca_bolt.prt", "save": false, "force": true}, "expect": {"mutation_outcome": "committed", "data.closed_count": 1}},
  {"call": "nx_close_part", "args": {"part": "ca_cover", "save": false, "force": true}, "expect": {"mutation_outcome": "committed", "data.closed_count": 1}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/ca"}, "expect": {"page.total": 0}}
 ]
}
