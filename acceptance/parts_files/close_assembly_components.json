{
 "covers": {
  "nx_close_part": []
 },
 "part": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/ca/ca_cover.prt"}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "save": "bolt", "args": {"path": "$run/ca/ca_bolt.prt"}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "save": "kit", "args": {"path": "$run/ca/ca_kit.prt"}},
  {"call": "nx_create_component", "setup": true, "args": {"path": "$run/ca/ca_cover.prt", "name": "COVER"}},
  {"call": "nx_create_component", "setup": true, "args": {"path": "$run/ca/ca_bolt.prt", "name": "BOLT", "pose": {"translation": [0, 0, 30]}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/ca"}, "expect": {"page.total": 3}},
  {"call": "nx_close_part", "args": {"part": "$kit.data.part.id", "save": false, "unload_components": false},
   "intent": "Acceptance: close the kit only; its component parts stay loaded",
   "expect": {"mutation_outcome": "committed", "data.closed_count": 1, "data.closed.0.name": {"matches": "(?i)^ca_kit$"}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/ca"}, "expect": {"page.total": 2}},
  {"call": "nx_open_part", "setup": true, "save": "kit2", "args": {"path": "$run/ca/ca_kit.prt"}},
  {"call": "nx_close_part", "args": {"part": "$kit2.data.part.id", "save": false},
   "intent": "Acceptance: closing the kit closes the cover and bolt the agent created",
   "expect": {"mutation_outcome": "committed", "data.closed_count": 3, "data.unloaded_components": {"count": 2},
              "data.closed.0.name": {"matches": "(?i)^ca_kit$"}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/ca"}, "expect": {"page.total": 0}},
  {"call": "nx_open_part", "setup": true, "args": {"path": "$run/ca/ca_kit.prt"}},
  {"call": "nx_open_part", "setup": true, "args": {"path": "$run/ca/ca_bolt.prt"}},
  {"call": "nx_set_attributes", "setup": true, "args": {"values": [{"name": "MCP_CLOSE_NOTE", "type": "string", "value": "dirty"}]}},
  {"call": "nx_open_part", "setup": true, "save": "now", "args": {"path": "$run/ca/ca_kit.prt"}},
  {"call": "nx_close_part", "args": {"part": "$now.data.part.id", "save": false},
   "intent": "Acceptance: a component part with unsaved changes is kept, never discarded",
   "expect": {"mutation_outcome": "committed", "data.kept_components": {"count": 1},
              "data.kept_components.0.part.name": {"matches": "(?i)^ca_bolt$"},
              "data.kept_components.0.reason": {"contains": "unsaved changes"}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/ca", "modified": true}, "expect": {"page.total": 1}},
  {"call": "nx_close_part", "args": {"part": "$run/ca/ca_bolt.prt", "save": false},
   "expect": {"mutation_outcome": "committed", "data.closed_count": 1}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/ca"}, "expect": {"page.total": 0}}
 ]
}
