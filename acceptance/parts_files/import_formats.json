{
  "covers": {"nx_import_model": ["iges", "parasolid", "stl", "dxf_dwg"]},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": "new",
  "steps": [
    {"call": "nx_open_part", "setup": true, "args": {"path": "$fixture"}},
    {"call": "nx_export_model", "setup": true, "args": {"path": "$run/if/block.igs", "format": "iges"}},
    {"call": "nx_export_model", "setup": true, "args": {"path": "$run/if/block.x_t", "format": "parasolid"}},
    {"call": "nx_export_model", "setup": true, "args": {"path": "$run/if/block.x_b", "format": "parasolid"}},
    {"call": "nx_export_model", "setup": true, "args": {"path": "$run/if/block.stl", "format": "stl"}},
    {"call": "nx_export_model", "setup": true,
     "args": {"path": "$run/if/block_text.stl", "format": "stl", "options": {"binary": false}}},
    {"call": "nx_upload_file", "setup": true,
     "args": {"path": "$run/if/plate.dxf", "offset": 0, "total_size": 462,
              "sha256": "f9914c00857f498da2e95e7e988d9c04020f58c985078add111a5dcece660e35",
              "data_base64": ""}},
    {"call": "nx_upload_file", "setup": true,
     "args": {"path": "$run/if/minimal_2013.dxf", "offset": 0, "total_size": 591,
              "sha256": "914c8b13a4cde33844f4ce723afea8b4f06650f9bf6b546f56cedf0485f8e363",
              "data_base64": ""}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part"}},
    {"call": "nx_import_model", "args": {"path": "$run/if/block.igs", "format": "iges"},
     "expect": {"mutation_outcome": "committed", "data.format": "iges", "data.target": "work_part",
                "data.solids": 1, "data.sheets": 0, "data.body_count": 1, "data.file_units": "mm",
                "data.volume": {"close": 8000, "tol": 0.01},
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.001},
                "data.bounds.max": {"close": [40, 20, 10], "tol": 0.001},
                "data.staging": {"matches": "^imports/op_"}}},
    {"call": "nx_import_model", "args": {"path": "$run/if/block.igs", "format": "iges", "options": {"sew": false}},
     "expect": {"mutation_outcome": "committed", "data.solids": 0, "data.sheets": 6, "data.volume": null,
                "data.bounds.max": {"close": [40, 20, 10], "tol": 0.001}}},
    {"call": "nx_import_model", "args": {"path": "$run/if/block.x_t", "format": "parasolid"},
     "expect": {"mutation_outcome": "committed", "data.solids": 1, "data.facet_bodies": 0,
                "data.volume": {"close": 8000, "tol": 0.01},
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.001},
                "data.bounds.max": {"close": [40, 20, 10], "tol": 0.001}}},
    {"call": "nx_import_model", "args": {"path": "$run/if/block.x_b", "format": "parasolid"},
     "expect": {"mutation_outcome": "committed", "data.solids": 1, "data.volume": {"close": 8000, "tol": 0.01},
                "data.bounds.max": {"close": [40, 20, 10], "tol": 0.001}}},
    {"call": "nx_import_model", "args": {"path": "$run/if/block.stl", "format": "stl"},
     "expect": {"mutation_outcome": "committed", "data.facet_bodies": 1, "data.body_count": 0,
                "data.volume": null, "data.file_units": "mm",
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.001},
                "data.bounds.max": {"close": [40, 20, 10], "tol": 0.001}}},
    {"call": "nx_import_model",
     "args": {"path": "$run/if/block_text.stl", "format": "stl", "options": {"units": "in"}},
     "expect": {"mutation_outcome": "committed", "data.facet_bodies": 1, "data.file_units": "in",
                "data.bounds.max": {"close": [1016, 508, 254], "tol": 0.01}}},
    {"call": "nx_import_model", "args": {"path": "$run/if/plate.dxf", "format": "dxf_dwg"},
     "expect": {"mutation_outcome": "committed", "data.curve_count": 5, "data.curves": {"count": 5},
                "data.body_count": 0, "data.sketch": null, "data.file_units": "mm",
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.001},
                "data.bounds.max": {"close": [40, 20, 0], "tol": 0.001}}},
    {"call": "nx_list_objects", "args": {"kind": "body"},
     "expect": {"page.total": 9}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk",
     "args": {"placement": {"principal": "xz", "origin": [0, 0, 50]}}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_import_model",
     "args": {"path": "$run/if/plate.dxf", "format": "dxf_dwg", "target": "sketch", "sketch": "$sk.data.sketch.id"},
     "expect": {"mutation_outcome": "committed", "data.target": "sketch", "data.curve_count": 5,
                "data.sketch.kind": "sketch",
                "data.bounds.min": {"close": [0, 0, 50], "tol": 0.001},
                "data.bounds.max": {"close": [40, 0, 70], "tol": 0.001}}},
    {"call": "nx_get_sketch", "args": {"sketch": "$sk.data.sketch.id"},
     "expect": {"data.active": false, "data.curves": {"count": 5},
                "data.curves.0.start": {"close": [0, 0], "tol": 0.001},
                "data.curves.0.end": {"close": [40, 0], "tol": 0.001}}},
    {"call": "nx_import_model",
     "args": {"path": "$run/if/minimal_2013.dxf", "format": "dxf_dwg"},
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/path",
                "error.message": {"matches": "handles or an OBJECTS section"}, "mutation_outcome": "not_started"}},
    {"call": "nx_import_model", "args": {"path": "$run/if/block.igs", "format": "iges", "flatten": false},
     "expect": {"error.field": "/flatten", "mutation_outcome": "not_started"}},
    {"call": "nx_import_model", "args": {"path": "$run/if/block.igs", "format": "stl"},
     "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "mutation_outcome": "not_started"}},
    {"call": "nx_import_model", "args": {"path": "$run/if/block.stl", "format": "stl", "target": "sketch",
                                         "sketch": "$sk.data.sketch.id"},
     "expect": {"error.field": "/target", "mutation_outcome": "not_started"}},
    {"call": "nx_import_model",
     "args": {"path": "$run/if/block.stl", "format": "stl", "target": "new_part", "new_part_path": "$run/if/pf_mesh.prt"},
     "expect": {"mutation_outcome": "committed", "data.target": "new_part", "data.facet_bodies": 1,
                "data.part.name": {"matches": "(?i)pf_mesh"},
                "data.bounds.max": {"close": [40, 20, 10], "tol": 0.001}}},
    {"call": "nx_import_model",
     "args": {"path": "$run/if/block.x_t", "format": "parasolid", "target": "new_part", "new_part_path": "$run/if/pf_solid.prt"},
     "expect": {"mutation_outcome": "committed", "data.target": "new_part", "data.solids": 1,
                "data.volume": {"close": 8000, "tol": 0.01}}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run/if"},
     "expect": {"page.total": 2, "data.items.0.owned": true, "data.items.1.owned": true}}
  ]
}
