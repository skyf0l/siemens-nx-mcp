{
  "covers": {"nx_download_file": ["metadata", "image", "chunk"]},
  "part": null,
  "steps": [
    {"call": "nx_upload_file", "setup": true,
     "args": {"path": "$run/dl/hello.txt", "data_base64": "aGVsbG8gd29ybGQ=", "offset": 0, "total_size": 11,
              "sha256": "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9"}},
    {"call": "nx_upload_file", "setup": true,
     "args": {"path": "$run/dl/tiny.png",
              "data_base64": "iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAIAAAB7QOjdAAAADUlEQVR4nGP4zwAE/wEHAAH/4iOeWQAAAABJRU5ErkJggg==",
              "offset": 0, "total_size": 70,
              "sha256": "6c54d5b23a761aa92da26a45323650a806dee032e1670974e7d48bb0d3c2832a"}},
    {"call": "nx_download_file", "args": {"path": "$run/dl/hello.txt"},
     "expect": {"mutation_outcome": "not_applicable", "data.delivery": "metadata", "data.size": 11,
                "data.sha256": "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9"}},
    {"call": "nx_download_file", "args": {"path": "$run/dl/hello.txt", "delivery": "chunk", "length": 6},
     "expect": {"data.data_base64": "aGVsbG8g", "data.bytes_returned": 6, "data.next_offset": 6, "data.eof": false}},
    {"call": "nx_download_file", "args": {"path": "$run/dl/hello.txt", "delivery": "chunk", "offset": 6},
     "expect": {"data.data_base64": "d29ybGQ=", "data.bytes_returned": 5, "data.next_offset": null, "data.eof": true}},
    {"call": "nx_download_file", "args": {"path": "$run/dl/tiny.png", "delivery": "image"},
     "expect": {"data.image.width": 2, "data.image.height": 1, "data.image.mime_type": "image/png",
                "data.image.inline": true,
                "data.image.sha256": "6c54d5b23a761aa92da26a45323650a806dee032e1670974e7d48bb0d3c2832a"}},
    {"call": "nx_download_file", "args": {"path": "$run/dl/hello.txt", "delivery": "image"},
     "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "error.field": "/path", "mutation_outcome": "not_applicable"}},
    {"call": "nx_download_file", "args": {"path": "$run/dl/hello.txt", "offset": 2},
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/offset"}},
    {"call": "nx_download_file", "args": {"path": "$run/dl/hello.txt", "delivery": "chunk", "length": 262145},
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/length"}},
    {"call": "nx_download_file", "args": {"path": "$run/dl/missing.txt"},
     "expect": {"error.code": "NX_FILE_NOT_FOUND"}},
    {"call": "nx_download_file", "args": {"path": ".nx-mcp/operations/x.json"},
     "expect": {"error.code": "NX_PATH_RESERVED"}},
    {"call": "nx_download_file", "args": {"path": "../outside.txt"},
     "expect": {"error.code": "NX_PATH_OUTSIDE_WORKSPACE"}}
  ]
}
