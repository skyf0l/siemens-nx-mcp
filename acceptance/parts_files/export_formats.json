{
  "covers": {"nx_export_model": ["stl", "iges", "parasolid", "jt"]},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_open_part", "setup": true, "save": "fx", "args": {"path": "$fixture"}},
    {"call": "nx_list_objects", "setup": true, "save": "bodies", "args": {"kind": "body"}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/saved.stl", "format": "stl"},
     "expect": {"mutation_outcome": "committed", "data.encoding": "binary", "data.bodies": 1,
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.06},
                "data.bounds.max": {"close": [40, 20, 10], "tol": 0.06},
                "data.units": "mm", "data.part_saved": false, "data.part_modified": false}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/saved.igs", "format": "iges"},
     "expect": {"mutation_outcome": "committed", "data.schema": "5.3", "data.file_units": "mm",
                "data.bounds.max": {"close": [40, 20, 10], "tol": 0.01},
                "data.part_modified": false}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/saved.x_t", "format": "parasolid"},
     "expect": {"mutation_outcome": "committed", "data.encoding": "text",
                "data.schema": {"matches": "^SCH_\\d+"}, "data.part_modified": false}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/saved.jt", "format": "jt"},
     "expect": {"mutation_outcome": "committed", "data.schema": "10.9", "data.shapes": 1,
                "data.file_units": "mm", "data.bounds.max": {"close": [40, 20, 10], "tol": 0.3},
                "data.part_modified": false}},
    {"call": "nx_create_transform", "setup": true,
     "args": {"bodies": ["$bodies.data.items.0.id"], "transform": {"translation": [200, 0, 0]},
              "copy": true}},
    {"call": "nx_list_objects", "setup": true, "save": "two", "args": {"kind": "body"}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$fixture", "modified": true},
     "expect": {"page.total": 1}},
    {"call": "nx_export_model",
     "args": {"path": "$run/ef/memory.stl", "format": "stl",
              "options": {"binary": false, "chordal_tolerance": "0.01 mm", "angular_tolerance": 10}},
     "expect": {"mutation_outcome": "committed", "data.encoding": "text", "data.bodies": 2,
                "data.tolerances.chordal": {"close": 0.01, "tol": 1e-9},
                "data.tolerances.angular": {"close": 10, "tol": 1e-9},
                "data.bounds.min": {"close": [0, 0, 0], "tol": 0.01},
                "data.bounds.max": {"close": [240, 20, 10], "tol": 0.01},
                "data.part_saved": false, "data.part_modified": true}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/memory.igs", "format": "iges"},
     "expect": {"mutation_outcome": "committed", "data.bodies": 2,
                "data.bounds.max": {"close": [240, 20, 10], "tol": 0.01},
                "data.part_saved": false, "data.part_modified": true}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/memory.x_b", "format": "parasolid"},
     "expect": {"mutation_outcome": "committed", "data.encoding": "binary", "data.bodies": 2,
                "data.part_saved": false, "data.part_modified": true}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/memory.jt", "format": "jt"},
     "expect": {"error.code": "NX_UNSAVED_PART", "mutation_outcome": "not_started"}},
    {"call": "nx_export_model",
     "args": {"path": "$run/ef/copy.stl", "format": "stl", "bodies": ["$two.data.items.1.id"]},
     "expect": {"mutation_outcome": "committed", "data.bodies": 1,
                "data.bounds.min": {"close": [200, 0, 0], "tol": 0.06},
                "data.bounds.max": {"close": [240, 20, 10], "tol": 0.06}}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$fixture", "modified": true},
     "expect": {"page.total": 1}},
    {"call": "nx_save_part", "setup": true, "args": {}},
    {"call": "nx_list_objects", "setup": true, "save": "saved", "args": {"kind": "body"}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/saved2.jt", "format": "jt"},
     "expect": {"mutation_outcome": "committed", "data.shapes": 2, "data.bodies": 2,
                "data.bounds.min": {"close": [0, 0, 0], "tol": 1.2},
                "data.bounds.max": {"close": [240, 20, 10], "tol": 1.2},
                "data.part_modified": false}},
    {"call": "nx_export_model",
     "args": {"path": "$run/ef/copy.jt", "format": "jt", "bodies": ["$saved.data.items.1.id"]},
     "expect": {"mutation_outcome": "committed", "data.shapes": 1, "data.bodies": 1,
                "data.bounds.min": {"close": [200, 0, 0], "tol": 1.2}}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/memory.stl", "format": "stl"},
     "expect": {"error.code": "NX_ALREADY_EXISTS", "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/wrong.step", "format": "stl"},
     "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "error.field": "/path",
                "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/wrong.jt", "format": "jt",
                                         "options": {"binary": true}},
     "expect": {"error.category": "invalid_argument", "error.field": "/options/binary",
                "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/neg.stl", "format": "stl",
                                         "options": {"chordal_tolerance": -0.01}},
     "intent": "Acceptance: a negative STL chordal tolerance never reaches the translator",
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/options/chordal_tolerance",
                "error.message": {"matches": "> 0"}, "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/neg_mm.stl", "format": "stl",
                                         "options": {"chordal_tolerance": "-0.5 mm"}},
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/options/chordal_tolerance",
                "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/zero.stl", "format": "stl",
                                         "options": {"angular_tolerance": 0}},
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/options/angular_tolerance",
                "mutation_outcome": "not_started"}},
    {"call": "nx_export_model", "args": {"path": "$run/ef/wide.stl", "format": "stl",
                                         "options": {"angular_tolerance": 120}},
     "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/options/angular_tolerance",
                "error.message": {"matches": "<= 90"}, "mutation_outcome": "not_started"}},
    {"call": "nx_list_files", "args": {"path": "$run/ef"},
     "expect": {"page.total": 10}}
  ]
}
