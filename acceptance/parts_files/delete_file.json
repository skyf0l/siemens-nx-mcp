{
  "covers": {"nx_delete_file": []},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_upload_file", "setup": true, "args": {"path": "$run/del/notes.txt", "content": "hello"}},
    {"call": "nx_delete_file", "args": {"path": "$run/del/notes.txt"},
     "intent": "Acceptance: a file an NX MCP tool wrote is deleted, and the result names that tool",
     "expect": {"mutation_outcome": "committed", "data.size": 5, "data.created_by": "nx_upload_file",
                "data.path": {"matches": "/del/notes[.]txt$"}}},
    {"call": "nx_list_files", "args": {"path": "$run/del"},
     "expect": {"page.total": 0}},
    {"call": "nx_delete_file", "args": {"path": "$run/del/notes.txt"},
     "expect": {"error.code": "NX_FILE_NOT_FOUND", "mutation_outcome": "not_started"}},
    {"call": "nx_delete_file", "args": {"path": "$fixture"},
     "intent": "Acceptance: a file no NX MCP tool wrote (the copied fixture) is never deleted",
     "expect": {"error.code": "NX_READ_ONLY", "error.field": "/path", "mutation_outcome": "not_started"}},
    {"call": "nx_open_part", "setup": true, "save": "fx", "args": {"path": "$fixture"}},
    {"call": "nx_export_model", "setup": true, "args": {"path": "$run/del/block.stl", "format": "stl"}},
    {"call": "nx_delete_file", "args": {"path": "$run/del/block.stl"},
     "intent": "Acceptance: an export written in NX is deletable from the sidecar",
     "expect": {"mutation_outcome": "committed", "data.created_by": "nx_export_model",
                "data.path": {"matches": "/del/block[.]stl$"}}},
    {"call": "nx_create_part", "setup": true, "save": "made", "args": {"path": "$run/del/pf_del_made.prt"}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "pf_del_made"}},
    {"call": "nx_delete_file", "args": {"path": "$run/del/pf_del_made.prt"},
     "intent": "Acceptance: the file of a loaded part is refused until the part is closed",
     "expect": {"error.code": "NX_PART_IN_USE", "error.hint": {"matches": "nx_close_part"},
                "mutation_outcome": "not_started"}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "$made.data.part.id", "save": false}},
    {"call": "nx_delete_file", "args": {"path": "$run/del/pf_del_made.prt"},
     "expect": {"mutation_outcome": "committed", "data.created_by": "nx_create_part"}},
    {"call": "nx_list_files", "args": {"path": "$run/del"},
     "expect": {"page.total": 0}},
    {"call": "nx_delete_file", "args": {"path": "$run"},
     "expect": {"error.code": {"matches": "^NX_(WRONG_KIND|FILE_NOT_FOUND)$"}, "mutation_outcome": "not_started"}}
  ]
}
