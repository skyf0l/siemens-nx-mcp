{
  "covers": {"nx_import_model": ["step"]},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": "new",
  "steps": [
    {"call": "nx_open_part", "setup": true, "args": {"path": "$fixture"}},
    {"call": "engineer", "args": {"code": "from nx_mcp.kit import parts as kp\nservices.host._remember_model()  # the development tool's own undo mark is no engineer edit\np = [x for x in session.Parts if str(x.Leaf).lower().startswith('parts_files_import_model_parts_files_block') and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nkp.show(NXOpen, session.Parts, p)\nresult = p.Leaf"}, "intent": "Acceptance: the engineer looks at the opened fixture (a tab click, no edit): it is the displayed part whatever NX showed before (engineer tab guard)", "expect": {"ok": true, "data.noticed": false}},
    {"call": "nx_export_model", "setup": true, "args": {"path": "$run/im/block.step", "format": "step"}},
    {"call": "nx_create_part", "setup": true, "save": "target", "args": {"path": "$part", "display": true}},
    {"call": "nx_import_model", "args": {"part": "$part", "path": "$run/im/block.step", "format": "step"},
     "expect": {"mutation_outcome": "committed", "data.body_count": 1, "data.components_created": 0,
                "data.target": "work_part", "data.flatten": true, "data.bodies": {"count": 1},
                "data.staging": {"matches": "^imports/op_"}, "changes.references": "preserved"}},
    {"call": "nx_list_objects", "args": {"part": "$part", "kind": "body"},
     "expect": {"page.total": 1}},
    {"call": "nx_list_parts", "args": {"active_only": true},
     "expect": {"data.items.0.modified": true, "data.items.0.path": {"matches": "parts_files_import_model_"}}},
    {"call": "nx_import_model", "args": {"part": "$part", "path": "$run/im/block.step", "format": "step", "flatten": false},
     "expect": {"mutation_outcome": "committed", "data.body_count": 1, "data.flatten": false}},
    {"call": "nx_list_objects", "args": {"part": "$part", "kind": "body"},
     "expect": {"page.total": 2}},
    {"call": "nx_import_model", "args": {"path": "$run/im/block.step", "format": "step",
                                         "target": "new_part", "new_part_path": "$run/im/pf_imported.prt"},
     "expect": {"mutation_outcome": "committed", "data.target": "new_part", "data.body_count": 1,
                "data.part.name": {"matches": "(?i)pf_imported"}}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run/im", "active_only": true},
     "expect": {"page.total": 1, "data.items.0.path": {"matches": "pf_imported\\.prt$"},
                "data.items.0.owned": true}},
    {"call": "nx_upload_file", "setup": true,
     "args": {"path": "$run/im/cut.step", "data_base64": "SVNPLTEwMzAzLTIxOwpEQVRBOwo=", "offset": 0,
              "total_size": 20, "sha256": "e5f6eb4d36b76d3cf4effe0022b603a62ea6ac04220d5e84189c94d0e85f5970"}},
    {"call": "nx_import_model", "args": {"part": "pf_imported", "path": "$run/im/cut.step", "format": "step"},
     "expect": {"error.category": "invalid_argument", "error.field": "/path", "mutation_outcome": "not_started"}},
    {"call": "nx_import_model", "args": {"part": "pf_imported", "path": "$run/im/block.step", "format": "step", "target": "new_part"},
     "expect": {"error.field": "/new_part_path", "mutation_outcome": "not_started"}},
    {"call": "nx_import_model", "args": {"path": "$run/im/block.step", "format": "step",
                                         "target": "new_part", "new_part_path": "$run/other/PF_IMPORTED.prt"},
     "expect": {"error.code": "NX_NAME_CONFLICT", "mutation_outcome": "not_started"}},
    {"call": "nx_import_model", "args": {"part": "pf_imported", "path": "$run/im/missing.step", "format": "step"},
     "expect": {"error.code": "NX_FILE_NOT_FOUND", "mutation_outcome": "not_started"}},
    {"call": "nx_import_model", "args": {"part": "pf_imported", "path": "$run/im/block.txt", "format": "step"},
     "expect": {"error.code": "NX_UNSUPPORTED_FILE_TYPE", "mutation_outcome": "not_started"}},
    {"call": "nx_import_model", "args": {"path": "$run/im/block.step", "format": "jt"},
     "expect": {"error.category": "invalid_argument", "error.field": "/format", "mutation_outcome": "not_started"}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
     "expect": {"page.total": 3}}
  ]
}
