{
  "covers": {"nx_open_part": [], "nx_export_assembly": ["clone"]},
  "part": null,
  "fixture": null,
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/sf/sf_blk_sub.prt", "display": false}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/sf/sub/sf_pin_sub.prt", "display": false}},
    {"call": "nx_create_primitive", "setup": true, "args": {"part": "sf_pin_sub", "shape": "block", "length": 10, "width": 20, "height": 30}},
    {"call": "nx_create_primitive", "setup": true, "args": {"part": "sf_blk_sub", "shape": "block", "length": 5, "width": 5, "height": 5}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "sf_pin_sub"}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "sf_blk_sub"}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/sf/sf_asm_sub.prt", "display": false}},
    {"call": "nx_create_component", "setup": true, "args": {"part": "sf_asm_sub", "path": "$run/sf/sub/sf_pin_sub.prt", "name": "PIN"}},
    {"call": "nx_create_component", "setup": true, "args": {"part": "sf_asm_sub", "path": "$run/sf/sf_blk_sub.prt", "name": "BLK"}},
    {"call": "nx_save_part", "setup": true, "args": {"part": "sf_asm_sub"}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "sf_asm_sub", "save": false}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "sf_pin_sub", "save": false}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "sf_blk_sub", "save": false}},
    {"call": "nx_open_part", "save": "asm", "args": {"path": "$run/sf/sf_asm_sub.prt", "load_components": true, "display": false},
     "intent": "Acceptance: a component saved in a subfolder loads (as saved) although NX's session may load components from the assembly's folder only",
     "expect": {"ok": true, "mutation_outcome": "committed", "data.components_loaded": 2}},
    {"call": "nx_list_components", "save": "pin", "args": {"part": "sf_asm_sub", "name_contains": "PIN"},
     "expect": {"data.items.0.load_state": "fully_loaded", "data.items.0.part_path": {"matches": "sf/sub/sf_pin_sub[.]prt$"}}},
    {"call": "nx_measure_bounds", "args": {"part": "sf_asm_sub", "bodies": ["$pin.data.items.0.id"]},
     "intent": "Acceptance: the subfolder component's geometry is there (10 x 20 x 30 block)",
     "expect": {"data.min": {"close": [0, 0, 0], "tol": 1e-6}, "data.max": {"close": [10, 20, 30], "tol": 1e-6}}},
    {"call": "nx_export_assembly", "args": {"part": "sf_asm_sub", "path": "$run/sf_clone", "prefix": "c_"},
     "expect": {"ok": true, "data.format": "clone", "data.file_count": 3}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "sf_asm_sub", "save": false}},
    {"call": "nx_open_part", "args": {"path": "$run/sf_clone/c_sf_asm_sub.prt", "load_components": true, "display": false},
     "intent": "Acceptance: the clone's own subfolder component loads after the clone",
     "expect": {"ok": true, "mutation_outcome": "committed", "data.components_loaded": 2}},
    {"call": "nx_list_components", "args": {"part": "c_sf_asm_sub", "name_contains": "PIN"},
     "expect": {"data.items.0.load_state": "fully_loaded", "data.items.0.part_path": {"matches": "sf_clone/sub/c_sf_pin_sub[.]prt$"}}}
  ]
}
