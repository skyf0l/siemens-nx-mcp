{
  "covers": {"nx_open_part": []},
  "fixture": "fixtures/parts_files_block_mm.prt",
  "part": null,
  "steps": [
    {"call": "nx_open_part", "save": "fx", "args": {"path": "$fixture"},
     "expect": {"mutation_outcome": "committed", "data.already_loaded": false, "data.work": true,
                "data.display": true, "data.units": "mm", "data.part.kind": "part",
                "data.path": {"matches": "parts_files_open_part_parts_files_block_mm\\.prt$"}}},
    {"call": "nx_list_objects", "args": {"kind": "body"},
     "expect": {"page.total": 1}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/pf_open_other.prt", "display": true}},
    {"call": "nx_open_part", "args": {"path": "$fixture", "display": false},
     "expect": {"error.code": "NX_WRONG_PART_CONTEXT", "error.field": "/display", "mutation_outcome": "not_started"}},
    {"call": "nx_open_part", "args": {"path": "$fixture", "work": false, "display": false},
     "expect": {"data.already_loaded": true, "data.work": false, "data.display": false}},
    {"call": "nx_open_part", "args": {"path": "$fixture", "load_components": true, "display": true},
     "expect": {"data.already_loaded": true, "data.display": true, "data.components_loaded": 0}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
     "expect": {"page.total": 2}},
    {"call": "nx_upload_file", "setup": true,
     "args": {"path": "$run/dup/parts_files_open_part_parts_files_block_mm.prt", "data_base64": "eA==",
              "offset": 0, "total_size": 1,
              "sha256": "2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881"}},
    {"call": "nx_open_part", "args": {"path": "$run/dup/parts_files_open_part_parts_files_block_mm.prt"},
     "expect": {"error.code": "NX_NAME_CONFLICT", "mutation_outcome": "not_started",
                "error.details.loaded_part_path": {"matches": "parts_files_open_part_parts_files_block_mm\\.prt$"}}},
    {"call": "nx_open_part", "args": {"path": "$run/none.prt"},
     "expect": {"error.code": "NX_FILE_NOT_FOUND", "mutation_outcome": "not_started"}},
    {"call": "nx_open_part", "args": {"path": "$run/dup/../../../../outside.prt"},
     "expect": {"error.code": "NX_PATH_OUTSIDE_WORKSPACE", "mutation_outcome": "not_started"}},
    {"call": "nx_open_part", "args": {"path": "$run/dup"},
     "expect": {"error.code": "NX_FILE_NOT_FOUND", "mutation_outcome": "not_started"}},
    {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
     "expect": {"page.total": 2}},
    {"call": "nx_close_part", "setup": true, "args": {"part": "$fx.data.part.id", "save": false}},
    {"call": "nx_open_part", "save": "again", "args": {"path": "$fixture"},
     "expect": {"mutation_outcome": "committed", "data.already_loaded": false, "data.units": "mm",
                "units.length": "mm", "data.part.id": {"matches": "^p:"}}},
    {"call": "nx_activate_part", "args": {"part": "$fx.data.part.id"},
     "expect": {"error.category": "stale_reference", "mutation_outcome": "not_started",
                "error.hint": {"matches": "nx_list_parts"},
                "error.details.loaded_parts.0.kind": "part"}},
    {"call": "nx_activate_part", "args": {"part": "$again.data.part.id", "display": true},
     "expect": {"mutation_outcome": "committed", "data.work": true, "data.display": true}}
  ]
}
