{
 "covers": {
  "nx_create_drawing_dimension": ["chain", "baseline", "ordinate", "linear"],
  "nx_edit_dimension": []
 },
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {"call": "nx_open_part", "setup": true, "save": "part", "args": {"path": "$fixture"}},
  {"call": "nx_create_drawing_sheet", "setup": true, "save": "sh",
   "args": {"name": "SHT1", "size": "a3", "projection": "first_angle"}},
  {"call": "nx_create_drawing_view", "setup": true, "save": "top",
   "args": {"type": "base", "sheet": "$sh.data.sheet.id", "orientation": "top", "position": [120, 200]}},
  {"call": "nx_find_geometry", "setup": true, "save": "h1",
   "args": {"kind": "edge", "geometry_type": "circle", "near": [25, 25, 20], "limit": 1, "radius": 8}},
  {"call": "nx_find_geometry", "setup": true, "save": "h2",
   "args": {"kind": "edge", "geometry_type": "circle", "near": [60, 25, 20], "limit": 1, "radius": 5}},
  {"call": "nx_find_geometry", "setup": true, "save": "left",
   "args": {"kind": "edge", "geometry_type": "line", "near": [0, 25, 20], "limit": 1}},
  {"call": "nx_create_drawing_dimension",
   "args": {"view": "$top.data.view.id", "kind": "chain", "datum": "$left.data.items.0.id",
            "objects": ["$h1.data.items.0.id", "$h2.data.items.0.id"], "object_point": "center"},
   "expect": {"data.dimensions.0.value": {"close": 25, "tol": 1e-6}, "data.dimensions.1.value": {"close": 35, "tol": 1e-6},
    "data.origin": {"close": [95, 243.35], "tol": 1e-3}}},
  {"call": "nx_create_drawing_dimension",
   "args": {"view": "$top.data.view.id", "kind": "baseline", "datum": "$left.data.items.0.id",
            "objects": ["$h1.data.items.0.id", "$h2.data.items.0.id"], "object_point": "center"},
   "intent": "Acceptance: a second default set steps out past the first instead of lying on it",
   "expect": {"data.dimensions.1.value": {"close": 60, "tol": 1e-6},
    "data.origin": {"close": [95, 255.35], "tol": 1e-3}}},
  {"call": "nx_create_drawing_dimension",
   "args": {"view": "$top.data.view.id", "kind": "baseline", "datum": "$left.data.items.0.id",
            "objects": ["$h1.data.items.0.id", "$h2.data.items.0.id"], "object_point": "center", "margin": 45},
   "intent": "Acceptance: margin is the gap from the view border to the set's line",
   "expect": {"data.margin": {"close": 45, "tol": 1e-9}, "data.origin": {"close": [95, 276.35], "tol": 1e-3}}},
  {"call": "nx_create_drawing_dimension",
   "args": {"view": "$top.data.view.id", "kind": "ordinate", "datum": "$left.data.items.0.id",
            "objects": ["$h1.data.items.0.id", "$h2.data.items.0.id"], "direction": "vertical", "margin": 20},
   "expect": {"data.dimensions.0.value": {"close": 25, "tol": 1e-6}, "data.margin": {"close": 20, "tol": 1e-9},
    "data.margin_line": {"close": 68.65, "tol": 1e-3}}},
  {"call": "nx_create_drawing_dimension",
   "args": {"view": "$top.data.view.id", "kind": "ordinate", "datum": "$left.data.items.0.id",
            "objects": ["$h1.data.items.0.id"], "margin": 100},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/margin", "mutation_outcome": "not_started"}},
  {"call": "nx_create_drawing_dimension",
   "args": {"view": "$top.data.view.id", "kind": "ordinate", "datum": "$left.data.items.0.id",
            "objects": ["$h1.data.items.0.id"], "margin": -5},
   "expect": {"error.field": "/margin", "mutation_outcome": "not_started"}},
  {"call": "nx_create_drawing_dimension", "save": "lin",
   "args": {"view": "$top.data.view.id", "kind": "horizontal", "first": "$left.data.items.0.id",
            "second": "$h1.data.items.0.id", "origin": [107, 150]},
   "intent": "Acceptance: a linear dimension to a hole edge measures to the hole's centre",
   "expect": {"data.dimension.value": {"close": 25, "tol": 1e-6}, "data.dimension.expected": {"close": 25, "tol": 1e-6}}},
  {"call": "nx_edit_dimension",
   "args": {"dimension": "$lin.data.dimension.id", "edges": ["$left.data.items.0.id", "$h2.data.items.0.id"]},
   "expect": {"mutation_outcome": "committed", "data.value": {"close": 60, "tol": 1e-6}}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "$part.data.part.id", "save": false}}
 ]
}
