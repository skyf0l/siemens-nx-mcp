{
 "covers": {
  "nx_create_drawing_sheet": [],
  "nx_activate_drawing_sheet": [],
  "nx_create_drawing_view": [
   "base",
   "projected",
   "section"
  ],
  "nx_edit_drawing_view": [],
  "nx_get_drawing_view": [],
  "nx_export_drawing": []
 },
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {"call": "nx_open_part", "setup": true, "save": "part", "args": {"path": "$fixture"}},
  {"call": "nx_find_geometry", "setup": true, "save": "h1",
   "args": {"kind": "edge", "geometry_type": "circle", "near": [25, 25, 20], "limit": 1, "radius": 8}},
  {"call": "nx_create_drawing_sheet", "save": "sh",
   "args": {"name": "Sheet1", "size": "A3", "scale": "1:2", "projection": "Third Angle"},
   "expect": {"mutation_outcome": "committed", "data.size": "a3", "data.scale": {"close": 0.5, "tol": 1e-12},
              "data.projection": "third_angle", "data.dimensions": {"close": [420, 297], "tol": 1e-6}}},
  {"call": "nx_create_drawing_sheet", "args": {"size": "Letter"},
   "expect": {"error.category": "invalid_argument", "error.field": "/size", "mutation_outcome": "not_started"}},
  {"call": "nx_create_drawing_sheet", "args": {"projection": "frist"},
   "expect": {"error.field": "/projection", "error.message": {"contains": "did you mean 'first_angle'"},
              "mutation_outcome": "not_started"}},
  {"call": "nx_activate_drawing_sheet", "args": {}, "expect": {"data.modeling": true}},
  {"call": "nx_activate_drawing_sheet", "args": {"sheet": "sheet1"},
   "expect": {"data.sheet.name": "Sheet1", "data.modeling": false}},
  {"call": "nx_create_drawing_view", "save": "top",
   "args": {"type": "base", "orientation": "Top", "position": [120, 200]},
   "expect": {"mutation_outcome": "committed", "data.sheet.name": "Sheet1", "data.scale": {"close": 0.5, "tol": 1e-9},
              "data.position": {"close": [120, 200], "tol": 1e-6}, "data.orientation": "top",
              "data.bounds": {"close": [101.15, 181.15, 153.85, 218.85], "tol": 1e-4},
              "data.center": {"close": [127.5, 200], "tol": 1e-4}, "data.overlaps": {"count": 0}}},
  {"call": "nx_create_drawing_view", "save": "below",
   "args": {"type": "projected", "parent": "$top.data.view.id", "direction": "Below"},
   "expect": {"mutation_outcome": "committed", "data.gap": {"close": 20, "tol": 1e-4},
              "data.bounds.3": {"close": 161.15, "tol": 1e-4}, "data.scale": {"close": 0.5, "tol": 1e-9},
              "data.orientation": "front", "data.parent.name": {"matches": "."},
              "data.overlaps": {"count": 0}}},
  {"call": "nx_create_drawing_view",
   "args": {"type": "projected", "parent": "$top.data.view.id", "direction": "right", "spacing": 30},
   "expect": {"mutation_outcome": "committed", "data.gap": {"close": 30, "tol": 1e-4},
              "data.bounds.0": {"close": 183.85, "tol": 1e-4}, "data.position.1": {"close": 200, "tol": 1e-6}}},
  {"call": "nx_create_drawing_view",
   "args": {"type": "projected", "parent": "$top.data.view.id", "direction": "left", "position": [40, 250]},
   "expect": {"mutation_outcome": "committed", "data.position": {"close": [40, 200], "tol": 1e-6},
              "warnings.0.message": {"contains": "stays aligned"}}},
  {"call": "nx_create_drawing_view", "args": {"type": "base", "orientation": "iso", "position": [120, 200]},
   "expect": {"mutation_outcome": "committed", "data.orientation": "isometric",
              "data.overlaps.0.id": {"matches": "^v:"}, "warnings.0.message": {"contains": "border overlaps"}}},
  {"call": "nx_create_drawing_view", "args": {"type": "section", "parent": "$top.data.view.id"},
   "expect": {"error.category": "invalid_argument", "mutation_outcome": "not_started", "error.field": "/arrow_direction",
              "error.message": {"contains": "arrow_direction, position, cut"}, "error.hint": {"contains": "cut_point"}}},
  {"call": "nx_create_drawing_view",
   "args": {"type": "section", "parent": "$top.data.view.id", "cut": "$h1.data.items.0.id", "cut_point": "center",
            "arrow_direction": [0, 1], "position": [330, 100], "scale": "1:2"},
   "expect": {"mutation_outcome": "committed", "data.scale": {"close": 0.5, "tol": 1e-9},
              "data.position": {"close": [330, 100], "tol": 1e-6},
              "data.cut_planes.0.normal": {"close": [0, 1, 0], "tol": 1e-6},
              "data.cut_planes.0.offset": {"close": 25, "tol": 1e-6}}},
  {"call": "nx_create_drawing_view", "args": {"type": "base", "orientation": "front", "scale": "1:0"},
   "expect": {"error.category": "invalid_argument", "error.field": "/scale", "mutation_outcome": "not_started"}},
  {"call": "nx_edit_drawing_view", "args": {"view": "$top.data.view.id", "scale": "1:1"},
   "expect": {"mutation_outcome": "committed", "data.scale": {"close": 1, "tol": 1e-9},
              "warnings": {"contains": {"code": "NX_UPDATE_WARNING"}}}},
  {"call": "nx_get_drawing_view", "args": {"view": "$below.data.view.id"},
   "expect": {"data.scale": {"close": 0.5, "tol": 1e-9}, "data.orientation": "front",
              "data.parent.id": {"matches": "^v:"}, "data.construction_geometry": false,
              "data.style.visible_font": 0, "data.style.hidden_font": 0}},
  {"call": "nx_edit_drawing_view", "args": {"view": "$top.data.view.id", "style": {"hidden_font": 0}},
   "expect": {"mutation_outcome": "committed", "data.style.hidden_font": 0}},
  {"call": "nx_get_drawing_view", "args": {"view": "$below.data.view.id"},
   "expect": {"data.style.visible_font": 0, "data.style.hidden_font": 0}},
  {"call": "nx_export_drawing", "args": {"path": "$run/natural.pdf", "format": "PDF"},
   "expect": {"mutation_outcome": "committed", "data.format": "pdf", "data.sheets": {"count": 1}}},
  {"call": "nx_export_drawing", "args": {"path": "$run/natural.dxf", "sheets": ["SHEET1"]},
   "expect": {"mutation_outcome": "committed", "data.format": "dxf", "data.sheets.0.name": "Sheet1"}},
  {"call": "nx_export_drawing", "args": {"path": "$run/mismatch.dxf", "format": "pdf"},
   "expect": {"error.category": "invalid_argument", "error.field": "/path", "mutation_outcome": "not_started"}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "$part.data.part.id", "save": false}}
 ]
}
