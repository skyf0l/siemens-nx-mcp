{
 "covers": {
  "nx_create_gdt": [
   "fcf",
   "view_datum_feature",
   "view_fcf"
  ],
  "nx_create_drawing_symbol": [
   "surface_finish",
   "weld"
  ],
  "nx_create_centerline": [
   "center_mark",
   "axis"
  ]
 },
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {
   "call": "nx_open_part",
   "setup": true,
   "save": "part",
   "args": {
    "path": "$fixture"
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h1",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     25,
     25,
     20
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h2",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     60,
     25,
     20
    ],
    "limit": 1,
    "radius": 5
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "front",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     40,
     0,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "cyl",
   "args": {
    "kind": "face",
    "geometry_type": "cylinder",
    "near": [
     25,
     25,
     10
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top_face",
   "args": {
    "kind": "face",
    "geometry_type": "plane",
    "near": [
     40,
     10,
     20
    ],
    "limit": 1,
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_create_drawing_sheet",
   "setup": true,
   "save": "sh",
   "args": {
    "name": "SHT1",
    "size": "a3",
    "projection": "first_angle"
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "top",
   "args": {
    "type": "base",
    "sheet": "$sh.data.sheet.id",
    "orientation": "top",
    "position": [
     120,
     200
    ]
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "fv",
   "args": {
    "type": "projected",
    "parent": "$top.data.view.id",
    "direction": "bottom",
    "position": [
     120,
     140
    ]
   }
  },
  {
   "call": "nx_create_gdt",
   "args": {
    "kind": "fcf",
    "faces": [
     "$top_face.data.items.0.id"
    ],
    "position": [
     40,
     25,
     20
    ],
    "frame": {
     "characteristic": "flatness",
     "tolerance": "0.05 mm"
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.frame.characteristic": "flatness",
    "data.frame.tolerance": {
     "close": 0.05,
     "tol": 1e-09
    },
    "data.frame.datums": {
     "count": 0
    },
    "data.frame.zone": "none"
   }
  },
  {
   "call": "nx_create_gdt",
   "save": "db",
   "args": {
    "kind": "view_datum_feature",
    "letter": "b",
    "view": "$top.data.view.id",
    "object": "$front.data.items.0.id"
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.letter": "B",
    "data.leader.point": {
     "close": [
      135,
      175
     ],
     "tol": 1
    },
    "data.origin": {
     "close": [
      155,
      195
     ],
     "tol": 1
    }
   }
  },
  {
   "call": "nx_create_gdt",
   "args": {
    "kind": "view_fcf",
    "view": "$top.data.view.id",
    "object": "$h1.data.items.0.id",
    "frame": {
     "characteristic": "position",
     "tolerance": "0.1 mm",
     "zone": "diameter",
     "datums": [
      "$db.data.annotation.id"
     ]
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.frame.datums": [
     "B"
    ],
    "data.frame.tolerance": {
     "close": 0.1,
     "tol": 1e-09
    },
    "data.leader.point": {
     "close": [
      120,
      200
     ],
     "tol": 8.01
    },
    "data.origin": {
     "close": [
      140,
      220
     ],
     "tol": 8.01
    }
   }
  },
  {
   "call": "nx_create_gdt",
   "args": {
    "kind": "view_fcf",
    "view": "$top.data.view.id",
    "object": "$h1.data.items.0.id"
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/frame",
    "error.message": {
     "contains": "required for kind view_fcf"
    },
    "error.hint": {
     "contains": "characteristic"
    }
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$front.data.items.0.id",
    "symbol": "surface_finish",
    "roughness_ra": "3.2 um"
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.text": [
     "Ra 3.2"
    ],
    "data.symbol": {
     "equals": {
      "type": "surface_finish",
      "roughness_ra": 3.2,
      "removal": "required"
     }
    },
    "data.origin": {
     "close": [
      155,
      195
     ],
     "tol": 1
    }
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$front.data.items.0.id",
    "origin": [
     220,
     150
    ],
    "symbol": "weld",
    "weld": "fillet",
    "size": 5,
    "side": "both"
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.text": [
     "5"
    ],
    "data.symbol": {
     "equals": {
      "type": "weld",
      "weld": "fillet",
      "size": 5.0,
      "side": "both"
     }
    }
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$front.data.items.0.id",
    "symbol": "surface_finish",
    "roughness_ra": "N8"
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/roughness_ra"
   }
  },
  {
   "call": "nx_create_centerline",
   "args": {
    "view": "$top.data.view.id",
    "kind": "center_mark",
    "objects": [
     "$h1.data.items.0.id",
     "$h2.data.items.0.id"
    ]
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.origins": {
     "count": 2
    },
    "data.origins.0": {
     "close": [
      120,
      200
     ],
     "tol": 0.001
    },
    "data.origins.1": {
     "close": [
      155,
      200
     ],
     "tol": 0.001
    }
   }
  },
  {
   "call": "nx_create_centerline",
   "args": {
    "view": "$top.data.view.id",
    "kind": "center_mark",
    "objects": [
     "$h1.data.items.0.id"
    ]
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.origins.0": {
     "close": [
      120,
      200
     ],
     "tol": 0.001
    },
    "warnings.0.message": {
     "contains": "already had a center mark"
    }
   }
  },
  {
   "call": "nx_create_centerline",
   "args": {
    "view": "$top.data.view.id",
    "kind": "axis",
    "objects": [
     "$cyl.data.items.0.id"
    ]
   },
   "expect": {
    "error.code": "NX_UNSUPPORTED_GEOMETRY",
    "mutation_outcome": "not_started",
    "error.details.views": {
     "count": 1
    }
   }
  }
 ]
}
