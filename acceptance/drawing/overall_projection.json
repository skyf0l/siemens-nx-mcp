{
 "covers": {
  "nx_create_drawing_view": ["projected"],
  "nx_create_drawing_dimension": ["horizontal", "vertical", "linear"],
  "nx_list_view_edges": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [120, 100]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "blk",
   "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
  {"call": "nx_find_geometry", "setup": true, "save": "c1",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [0, 0, 5], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "c2",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [120, 0, 5], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "c3",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [120, 100, 5], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "c4",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [0, 100, 5], "limit": 1}},
  {"call": "nx_create_blend", "setup": true,
   "args": {"edges": ["$c1.data.items.0.id", "$c2.data.items.0.id", "$c3.data.items.0.id", "$c4.data.items.0.id"], "radius": 5}},
  {"call": "nx_create_drawing_sheet", "setup": true, "save": "sh", "args": {"name": "SHT1", "size": "a3", "projection": "first_angle"}},
  {"call": "nx_create_drawing_view", "setup": true, "save": "fv",
   "args": {"type": "base", "sheet": "$sh.data.sheet.id", "orientation": "front", "position": [250, 220]}},
  {"call": "nx_create_drawing_view", "save": "tv", "args": {"type": "projected", "parent": "$fv.data.view.id", "orientation": "top"},
   "expect": {"mutation_outcome": "committed", "data.orientation": "top", "data.toward_viewer": {"close": [0, 0, 1], "tol": 1e-9},
    "data.center": {"close": [250, 127.3], "tol": 1e-6}, "data.bounds": {"close": [183.65, 70.95, 316.35, 183.65], "tol": 1e-6},
    "data.gap": {"close": 20, "tol": 1e-6}, "data.parent.id": "$fv.data.view.id"}},
  {"call": "nx_create_drawing_view", "save": "rv", "args": {"type": "projected", "parent": "$fv.data.view.id", "orientation": "right"},
   "expect": {"data.orientation": "right", "data.toward_viewer": {"close": [1, 0, 0], "tol": 1e-9},
    "data.center": {"close": [107.3, 215], "tol": 1e-6}, "data.gap": {"close": 20, "tol": 1e-6}}},
  {"call": "nx_create_drawing_view", "args": {"type": "projected", "parent": "$fv.data.view.id", "orientation": "top", "direction": "top"},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/direction", "mutation_outcome": "not_started",
    "error.message": {"contains": "first angle sheet the top view lies bottom of the parent, not top"},
    "error.details.projects.left": "right"}},
  {"call": "nx_create_drawing_view", "args": {"type": "projected", "parent": "$fv.data.view.id", "orientation": "back"},
   "expect": {"error.field": "/orientation", "mutation_outcome": "not_started", "error.hint": {"contains": "base view"}}},
  {"call": "nx_list_objects", "args": {"kind": "drawing_view"},
   "expect": {"page.total": 3, "data.items.1.details.center": {"close": [250, 127.3], "tol": 1e-6},
    "data.items.1.details.position": {"count": 2},
    "data.items.1.details.bounds": {"close": [183.65, 70.95, 316.35, 183.65], "tol": 1e-6},
    "data.items.2.details.center": {"close": [107.3, 215], "tol": 1e-6}}},
  {"call": "nx_list_view_edges", "save": "th", "args": {"view": "$tv.data.view.id", "orientation": "horizontal"},
   "expect": {"page.total": 2, "data.items.0.length": {"close": 110, "tol": 1e-6}}},
  {"call": "nx_list_view_edges", "save": "tvv", "args": {"view": "$tv.data.view.id", "orientation": "vertical"},
   "expect": {"page.total": 2, "data.items.0.length": {"close": 90, "tol": 1e-6}, "data.items.0.center.0": {"close": 190, "tol": 1e-6}}},
  {"call": "nx_create_drawing_dimension", "args": {"view": "$tv.data.view.id", "kind": "horizontal", "first": "$th.data.items.0.id"},
   "expect": {"mutation_outcome": "committed", "data.dimension.value": {"close": 110, "tol": 1e-6},
    "warnings.0.code": "NX_NOTE",
    "warnings.0.message": {"matches": "measures 110 but the body spans 120 along it: for the overall size give first e:[0-9]+ and second e:[0-9]+ [(]the outer edges at both ends[)]"}}},
  {"call": "nx_create_drawing_dimension", "args": {"view": "$tv.data.view.id", "kind": "horizontal", "first": "$tvv.data.items.0.id", "second": "$tvv.data.items.1.id"},
   "expect": {"data.dimension.value": {"close": 120, "tol": 1e-6}, "warnings": {"count": 0}}},
  {"call": "nx_create_drawing_dimension", "args": {"view": "$tv.data.view.id", "kind": "vertical", "first": "$tvv.data.items.0.id"},
   "expect": {"data.dimension.value": {"close": 90, "tol": 1e-6},
    "warnings.0.code": "NX_NOTE", "warnings.0.message": {"contains": "measures 90 but the body spans 100"}}},
  {"call": "nx_create_drawing_dimension", "args": {"view": "$fv.data.view.id", "kind": "linear", "first": "$th.data.items.0.id", "orientation": "horizontal"},
   "expect": {"data.dimension.value": {"close": 110, "tol": 1e-6},
    "warnings.0.message": {"contains": "spans 120"}}}
 ]
}
