      40,
      10,
      40
     ],
     [
      100,
      20,
      40
     ],
     [
      160,
      8,
      40
     ]
    ],
    "form": "simple",
    "diameter": 8,
    "depth": {
     "type": "distance",
     "value": 25
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "ce",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
