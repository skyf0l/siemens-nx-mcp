{
 "covers": {
  "nx_create_drawing_view": [
   "auxiliary",
   "broken",
   "half_section",
   "stepped_section",
   "revolved_section",
   "break_out"
  ]
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_sketch",
   "setup": true,
   "save": "sk",
   "args": {
    "placement": {
     "principal": "xy"
    }
   }
  },
  {
   "call": "nx_create_sketch_curves",
   "setup": true,
   "args": {
    "sketch": "$sk.data.sketch.id",
    "curves": [
     {
      "type": "rectangle",
      "corner1": [
       0,
       0
      ],
      "corner2": [
       200,
       30
      ]
     }
    ]
   }
  },
  {
   "call": "nx_finish_sketch",
   "setup": true,
   "args": {
    "sketch": "$sk.data.sketch.id"
   }
  },
  {
   "call": "nx_create_extrude",
   "setup": true,
   "save": "blk",
   "args": {
    "sketch": "$sk.data.sketch.id",
    "end": {
     "type": "distance",
     "value": 40
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top",
   "args": {
    "owner": "$blk.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "normal": [
     0,
     0,
     1
    ],
    "limit": 1,
    "order": "highest",
    "axis": "z"
   }
  },
  {
   "call": "nx_create_hole",
   "setup": true,
   "args": {
    "face": "$top.data.items.0.id",
    "positions": [
