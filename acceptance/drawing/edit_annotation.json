{
 "covers": {
  "nx_edit_annotation": []
 },
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {
   "call": "nx_open_part",
   "setup": true,
   "save": "part",
   "args": {
    "path": "$fixture"
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h1",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     25,
     25,
     20
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h2",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     60,
     25,
     20
    ],
    "limit": 1,
    "radius": 5
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "ch",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     75,
     45,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "back",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     35,
     50,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "front",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     40,
     0,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "left",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     0,
     25,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "cyl",
   "args": {
    "kind": "face",
    "geometry_type": "cylinder",
    "near": [
     25,
     25,
     10
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top_face",
   "args": {
    "kind": "face",
    "geometry_type": "plane",
    "near": [
     40,
     10,
     20
    ],
    "limit": 1,
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_create_drawing_sheet",
   "setup": true,
   "save": "sh",
   "args": {
    "name": "SHT1",
    "size": "a3",
    "projection": "first_angle"
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "top",
   "args": {
    "type": "base",
    "sheet": "$sh.data.sheet.id",
    "orientation": "top",
    "position": [
     120,
     200
    ]
   }
  },
  {
   "call": "nx_create_note",
   "setup": true,
   "save": "note",
   "args": {
    "text": [
     "NOTE"
    ],
    "origin": [
     40,
     40
    ]
   }
  },
  {
   "call": "nx_create_centerline",
   "setup": true,
   "save": "cm",
   "args": {
    "view": "$top.data.view.id",
    "kind": "center_mark",
    "objects": [
     "$h1.data.items.0.id"
    ]
   }
  },
  {
   "call": "nx_create_drawing_dimension",
   "setup": true,
   "save": "dim",
   "args": {
    "view": "$top.data.view.id",
    "kind": "radius",
    "first": "$h1.data.items.0.id"
   }
  },
  {
   "call": "nx_create_drawing_table",
   "setup": true,
   "save": "rev",
   "args": {
    "kind": "revision",
    "sheet": "$sh.data.sheet.id",
    "position": [
     250,
     290
    ],
    "rows": [
     [
      "A",
      "First"
     ]
    ],
    "widths": [
     10,
     60
    ]
   }
  },
  {
   "call": "nx_create_gdt",
   "setup": true,
   "save": "fcf",
   "args": {
    "kind": "fcf",
    "faces": [
     "$top_face.data.items.0.id"
    ],
    "position": [
     40,
     25,
     20
    ],
    "frame": {
     "characteristic": "flatness",
     "tolerance": 0.05
    }
   }
  },
  {
   "call": "nx_edit_annotation",
   "args": {
    "annotation": "$note.data.annotation.id",
    "position": [
     45,
     50
    ],
    "name": "GENERAL_NOTE"
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.position": {
     "close": [
      45,
      50
     ],
     "tol": 1e-06
    },
    "data.name": "GENERAL_NOTE",
    "data.frame": "sheet",
    "data.annotation.kind": "annotation"
   }
  },
  {
   "call": "nx_edit_annotation",
   "args": {
    "annotation": "$dim.data.dimension.id",
    "position": [
     150,
     250
    ]
   },
   "expect": {
    "data.position": {
     "close": [
      150,
      250
     ],
     "tol": 1e-06
    },
    "data.annotation.kind": "dimension"
   }
  },
  {
   "call": "nx_edit_annotation",
   "args": {
    "annotation": "$rev.data.table.id",
    "position": [
     240,
     280
    ]
   },
   "expect": {
    "data.position": {
     "close": [
      240,
      280
     ],
     "tol": 1e-06
    },
    "data.annotation.kind": "drawing_table"
   }
  },
  {
   "call": "nx_edit_annotation",
   "args": {
    "annotation": "$fcf.data.annotation.id",
    "name": "FLATNESS_TOP"
   },
   "expect": {
    "data.name": "FLATNESS_TOP"
   }
  },
  {
   "call": "nx_edit_annotation",
   "args": {
    "annotation": "$fcf.data.annotation.id",
    "position": "$fcf.data.position"
   },
   "expect": {
    "data.frame": "work_part_absolute",
    "data.position": {
     "close": [
      40,
      25,
      0
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_edit_annotation",
   "args": {
    "annotation": "$cm.data.annotations.0.id",
    "position": [
     10,
     10
    ]
   },
   "expect": {
    "error.category": "unsupported",
    "mutation_outcome": "rolled_back",
    "error.field": "/position"
   }
  },
  {
   "call": "nx_edit_annotation",
   "args": {
    "annotation": "$note.data.annotation.id",
    "position": [
     1,
     2,
     3
    ]
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/position"
   }
  },
  {
   "call": "nx_edit_annotation",
   "args": {
    "annotation": "$note.data.annotation.id"
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_edit_annotation",
   "args": {
    "annotation": "$top.data.view.id",
    "name": "X"
   },
   "expect": {
    "error.category": "wrong_kind",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_close_part",
   "setup": true,
   "args": {
    "part": "$part.data.part.id",
    "save": false
   }
  }
 ]
}
