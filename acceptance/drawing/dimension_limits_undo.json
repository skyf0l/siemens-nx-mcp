{
 "covers": {
  "nx_edit_dimension": [],
  "nx_create_gdt": []
 },
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {
   "call": "nx_open_part",
   "setup": true,
   "save": "part",
   "args": {
    "path": "$fixture"
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "back",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     35,
     50,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "front",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     40,
     0,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "right",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     80,
     20,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h1",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     25,
     25,
     20
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_create_drawing_sheet",
   "setup": true,
   "save": "sh",
   "args": {
    "name": "SHT1",
    "size": "a3",
    "projection": "first_angle"
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "top",
   "args": {
    "type": "base",
    "sheet": "$sh.data.sheet.id",
    "orientation": "top",
    "position": [
     120,
     200
    ]
   }
  },
  {
   "call": "nx_create_drawing_dimension",
   "setup": true,
   "save": "dim",
   "args": {
    "view": "$top.data.view.id",
    "kind": "horizontal",
    "first": "$back.data.items.0.id"
   }
  },
  {
   "call": "nx_edit_dimension",
   "save": "lim",
   "args": {
    "dimension": "$dim.data.dimension.id",
    "format": {
     "decimals": 2,
     "trailing_zeros": true,
     "decimal_separator": "period"
    },
    "tolerance": {
     "type": "limits",
     "upper": 0.1,
     "lower": -0.1
    }
   },
   "expect": {
    "data.tolerance.decimals": 2,
    "data.text": {
     "matches": "^70\\.10/69\\.90$"
    },
    "data.display": {
     "matches": "^70\\.10/69\\.90$"
    },
    "changes.modified": {
     "count": 1
    }
   },
   "intent": "Acceptance: limits text without NX markup; tolerance decimals follow the format's"
  },
  {
   "call": "nx_undo_operation",
   "args": {
    "operation": "$lim.operation_id",
    "mode": "compensate"
   },
   "expect": {
    "data.compensated": true,
    "data.restored": {
     "count": 1
    }
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "fv",
   "args": {
    "type": "projected",
    "parent": "$top.data.view.id",
    "direction": "bottom",
    "position": [
     120,
     140
    ]
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "topface",
   "args": {
    "kind": "face",
    "geometry_type": "plane",
    "near": [
     40,
     25,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_create_gdt",
   "args": {
    "kind": "view_datum_feature",
    "letter": "A",
    "view": "$fv.data.view.id",
    "object": "$topface.data.items.0.id"
   },
   "expect": {
    "mutation_outcome": "committed",
    "warnings": {
     "contains": {
      "code": "NX_UPDATE_WARNING"
     }
    },
    "warnings.0.message": {
     "matches": "edge-on"
    }
   },
   "intent": "Acceptance: a face seen edge-on is warned as edge-on, not behind material"
  }
 ]
}
