     [
      70,
      10,
      20
     ],
     [
      10,
      40,
      20
     ],
     [
      70,
      40,
      20
     ]
    ],
    "form": "simple",
    "diameter": 6,
    "depth": {
     "type": "distance",
     "value": 10
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top",
   "args": {
    "owner": "$blk.data.bodies.0.id",
