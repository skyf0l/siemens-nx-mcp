     "diameter": 11,
     "depth": 4
    }
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top",
   "args": {
    "owner": "$blk.data.bodies.0.id",
    "kind": "face",
    "geometry_type": "plane",
    "normal": [
     0,
     0,
     1
    ],
    "limit": 1,
    "order": "highest",
    "axis": "z"
   }
  },
  {
   "call": "nx_create_hole",
   "setup": true,
   "save": "h3",
   "args": {
    "face": "$top.data.items.0.id",
    "positions": [
