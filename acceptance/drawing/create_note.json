{
 "covers": {
  "nx_create_note": []
 },
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {
   "call": "nx_open_part",
   "setup": true,
   "save": "part",
   "args": {
    "path": "$fixture"
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h1",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     25,
     25,
     20
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h2",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     60,
     25,
     20
    ],
    "limit": 1,
    "radius": 5
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "ch",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     75,
     45,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "back",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     35,
     50,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "front",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     40,
     0,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "left",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     0,
     25,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "cyl",
   "args": {
    "kind": "face",
    "geometry_type": "cylinder",
    "near": [
     25,
     25,
     10
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top_face",
   "args": {
    "kind": "face",
    "geometry_type": "plane",
    "near": [
     40,
     10,
     20
    ],
    "limit": 1,
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_create_drawing_sheet",
   "setup": true,
   "save": "sh",
   "args": {
    "name": "SHT1",
    "size": "a3",
    "projection": "first_angle"
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "top",
   "args": {
    "type": "base",
    "sheet": "$sh.data.sheet.id",
    "orientation": "top",
    "position": [
     120,
     200
    ]
   }
  },
  {
   "call": "nx_create_note",
   "args": {
    "text": [
     "BREAK ALL EDGES",
     "",
     "MATERIAL S235"
    ],
    "origin": [
     40,
     40
    ]
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.text": [
     "BREAK ALL EDGES",
     "",
     "MATERIAL S235"
    ],
    "data.origin": {
     "close": [
      40,
      40
     ],
     "tol": 1e-06
    },
    "data.sheet.name": "SHT1",
    "changes.created": {
     "count_kind": {
      "annotation": 1
     }
    }
   }
  },
  {
   "call": "nx_create_note",
   "args": {
    "text": [
     "SEE HOLE"
    ],
    "origin": [
     60,
     260
    ],
    "view": "$top.data.view.id",
    "leader_to": "$h1.data.items.0.id"
   },
   "expect": {
    "data.leader.object.kind": "edge",
    "data.leader.view.name": "Top@1",
    "data.origin": {
     "close": [
      60,
      260
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_note",
   "args": {
    "text": [
     "TOP FACE <$s>"
    ],
    "origin": [
     200,
     270
    ],
    "view": "$top.data.view.id",
    "leader_to": "$top_face.data.items.0.id",
    "sheet": "$sh.data.sheet.id"
   },
   "expect": {
    "data.text": [
     "TOP FACE <$s>"
    ],
    "data.leader.object.kind": "face"
   }
  },
  {
   "call": "nx_create_note",
   "args": {
    "text": [
     "X"
    ],
    "origin": [
     10,
     10
    ],
    "leader_to": "$h1.data.items.0.id"
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/view"
   }
  },
  {
   "call": "nx_create_note",
   "args": {
    "text": [
     " "
    ],
    "origin": [
     10,
     10
    ]
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/text"
   }
  },
  {
   "call": "nx_create_note",
   "args": {
    "text": [
     "a\nb"
    ],
    "origin": [
     10,
     10
    ]
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/text/0"
   }
  },
  {
   "call": "nx_create_note",
   "args": {
    "text": [
     "X"
    ],
    "origin": [
     10
    ]
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/origin"
   }
  },
  {
   "call": "nx_create_note",
   "args": {
    "text": "BREAK ALL SHARP EDGES\nMATERIAL: STEEL",
    "origin": [
     40,
     80
    ]
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.text": [
     "BREAK ALL SHARP EDGES",
     "MATERIAL: STEEL"
    ],
    "data.origin": {
     "close": [
      40,
      80
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_close_part",
   "setup": true,
   "args": {
    "part": "$part.data.part.id",
    "save": false
   }
  }
 ]
}
