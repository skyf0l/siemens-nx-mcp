{
 "covers": {
  "nx_create_centerline": [
   "center_mark",
   "axis",
   "between_edges"
  ]
 },
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {
   "call": "nx_open_part",
   "setup": true,
   "save": "part",
   "args": {
    "path": "$fixture"
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h1",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     25,
     25,
     20
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h2",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     60,
     25,
     20
    ],
    "limit": 1,
    "radius": 5
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "ch",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     75,
     45,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "back",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     35,
     50,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "front",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     40,
     0,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "left",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     0,
     25,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "cyl",
   "args": {
    "kind": "face",
    "geometry_type": "cylinder",
    "near": [
     25,
     25,
     10
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top_face",
   "args": {
    "kind": "face",
    "geometry_type": "plane",
    "near": [
     40,
     10,
     20
    ],
    "limit": 1,
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_create_drawing_sheet",
   "setup": true,
   "save": "sh",
   "args": {
    "name": "SHT1",
    "size": "a3",
    "projection": "first_angle"
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "top",
   "args": {
    "type": "base",
    "sheet": "$sh.data.sheet.id",
    "orientation": "top",
    "position": [
     120,
     200
    ]
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "fv",
   "args": {
    "type": "projected",
    "parent": "$top.data.view.id",
    "direction": "bottom",
    "spacing": 60
   }
  },
  {
   "call": "nx_create_centerline",
   "args": {
    "view": "$top.data.view.id",
    "kind": "center_mark",
    "objects": [
     "$h1.data.items.0.id",
     "$h2.data.items.0.id"
    ]
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.annotations": {
     "count": 2
    },
    "changes.created": {
     "count_kind": {
      "annotation": 2
     }
    }
   }
  },
  {
   "call": "nx_create_centerline",
   "args": {
    "view": "$fv.data.view.id",
    "kind": "axis",
    "objects": [
     "$cyl.data.items.0.id"
    ]
   },
   "expect": {
    "data.origin.0": {
     "close": 120,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_centerline",
   "args": {
    "view": "$top.data.view.id",
    "kind": "between_edges",
    "objects": [
     "$front.data.items.0.id",
     "$back.data.items.0.id"
    ]
   },
   "expect": {
    "data.origin.1": {
     "close": 200,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_centerline",
   "args": {
    "view": "$fv.data.view.id",
    "kind": "center_mark",
    "objects": [
     "$h1.data.items.0.id"
    ]
   },
   "expect": {
    "error.category": "unsupported",
    "mutation_outcome": "not_started",
    "error.field": "/objects/0",
    "error.code": "NX_UNSUPPORTED_GEOMETRY"
   }
  },
  {
   "call": "nx_create_centerline",
   "args": {
    "view": "$top.data.view.id",
    "kind": "axis",
    "objects": [
     "$cyl.data.items.0.id"
    ]
   },
   "expect": {
    "error.category": "unsupported",
    "mutation_outcome": "not_started",
    "error.field": "/objects/0",
    "error.code": "NX_UNSUPPORTED_GEOMETRY"
   }
  },
  {
   "call": "nx_create_centerline",
   "args": {
    "view": "$top.data.view.id",
    "kind": "between_edges",
    "objects": [
     "$front.data.items.0.id",
     "$left.data.items.0.id"
    ]
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/objects"
   }
  },
  {
   "call": "nx_create_centerline",
   "args": {
    "view": "$top.data.view.id",
    "kind": "center_mark",
    "objects": [
     "$back.data.items.0.id"
    ]
   },
   "expect": {
    "error.category": "wrong_kind",
    "mutation_outcome": "not_started",
    "error.field": "/objects/0",
    "error.code": "NX_WRONG_GEOMETRY"
   }
  },
  {
   "call": "nx_create_centerline",
   "args": {
    "view": "$top.data.view.id",
    "kind": "axis",
    "objects": [
     "$cyl.data.items.0.id",
     "$cyl.data.items.0.id"
    ]
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/objects/1"
   }
  },
  {
   "call": "nx_close_part",
   "setup": true,
   "args": {
    "part": "$part.data.part.id",
    "save": false
   }
  }
 ]
}
