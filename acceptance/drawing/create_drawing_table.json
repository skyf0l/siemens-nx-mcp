     10
    ],
    "rows": [
     [
      "PART",
      "BLOCK"
     ],
     [
      "DRAWN",
      "AGENT"
     ]
    ],
    "widths": [
     30,
     "2 in"
    ],
    "row_height": 8
   },
   "expect": {
    "data.kind": "title_block",
    "data.rows": [
     [
      "PART",
      "BLOCK"
     ],
     [
      "DRAWN",
      "AGENT"
     ]
    ],
    "data.columns.1.width": {
