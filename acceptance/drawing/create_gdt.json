    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "left",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     0,
     25,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "cyl",
   "args": {
    "kind": "face",
    "geometry_type": "cylinder",
