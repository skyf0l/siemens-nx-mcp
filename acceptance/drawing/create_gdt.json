   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h1",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     25,
     25,
     20
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h2",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     60,
     25,
     20
    ],
    "limit": 1,
    "radius": 5
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "ch",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     75,
     45,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "back",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     35,
     50,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "front",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
