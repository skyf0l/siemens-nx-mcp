    "limit": 1,
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_create_gdt",
   "args": {
    "kind": "fcf",
    "faces": [
     "$top_face.data.items.0.id"
    ],
    "position": [
     40,
     25,
     20
    ],
    "frame": {
     "characteristic": "flatness",
     "tolerance": 0.05
