    "error.field": "/frame/material"
   }
  },
  {
   "call": "nx_create_gdt",
   "args": {
    "kind": "fcf",
    "faces": [
     "$top_face.data.items.0.id"
    ],
    "position": [
     40,
     25,
     20
    ],
