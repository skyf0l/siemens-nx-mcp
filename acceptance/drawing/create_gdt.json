  {
   "call": "nx_create_gdt",
   "args": {
    "kind": "fcf",
    "faces": [
     "$back.data.items.0.id"
    ],
    "position": [
     40,
     25,
     20
    ],
    "frame": {
     "characteristic": "flatness",
     "tolerance": 0.05
    }
   },
   "expect": {
    "error.category": "wrong_kind",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_close_part",
   "setup": true,
   "args": {
    "part": "$part.data.part.id",
    "save": false
   }
  }
 ]
}
