     150
    ],
    "symbol": "surface_finish",
    "roughness_ra": 12.5,
    "removal": "any"
   },
   "expect": {
    "data.text": [
     "Ra 12.5"
    ]
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$ch.items.0.object.id",
    "origin": [
     220,
     250
    ],
    "symbol": "weld",
    "weld": "fillet",
    "size": 5,
    "side": "both"
   },
   "expect": {
    "data.text": [
     "5"
    ],
    "data.origin": {
     "close": [
      220,
      250
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$back.items.0.object.id",
    "origin": [
     150,
     270
    ],
    "symbol": "weld",
    "weld": "v_butt",
    "size": 4,
    "side": "other"
   },
   "expect": {
    "data.text": [
     "4"
    ]
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$front.items.0.object.id",
    "origin": [
     150,
     150
    ],
    "symbol": "weld",
    "weld": "square_butt",
    "size": 3
   },
   "expect": {
    "data.text": [
     "3"
    ]
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$top_face.items.0.object.id",
    "origin": [
     200,
     260
    ],
    "symbol": "surface_finish",
    "roughness_ra": 0
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/roughness_ra"
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$top_face.items.0.object.id",
    "origin": [
     200,
     260
    ],
    "symbol": "weld",
    "size": 3
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/weld"
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$sh.data.sheet.id",
    "origin": [
     200,
     260
    ],
    "symbol": "surface_finish",
    "roughness_ra": 1.6
   },
   "expect": {
    "error.category": "wrong_kind",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_close_part",
   "setup": true,
   "args": {
    "part": "$part.data.part.id",
    "save": false
   }
  }
 ]
}
