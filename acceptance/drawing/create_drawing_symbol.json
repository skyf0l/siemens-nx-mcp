     35,
     50,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "front",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     40,
     0,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "left",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     0,
     25,
     20
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "cyl",
   "args": {
    "kind": "face",
    "geometry_type": "cylinder",
    "near": [
     25,
     25,
     10
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top_face",
   "args": {
    "kind": "face",
    "geometry_type": "plane",
    "near": [
     40,
     10,
     20
    ],
    "limit": 1,
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_create_drawing_sheet",
   "setup": true,
   "save": "sh",
   "args": {
    "name": "SHT1",
    "size": "a3",
    "projection": "first_angle"
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "top",
   "args": {
    "type": "base",
    "sheet": "$sh.data.sheet.id",
    "orientation": "top",
    "position": [
     120,
     200
    ]
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$top_face.items.0.object.id",
    "origin": [
     200,
     260
    ],
    "symbol": "surface_finish",
    "roughness_ra": 3.2
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.text": [
     "Ra 3.2"
    ],
    "data.origin": {
     "close": [
      200,
      260
     ],
     "tol": 1e-06
    },
    "data.leader.object.kind": "face"
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$back.items.0.object.id",
    "origin": [
     60,
     270
    ],
    "symbol": "surface_finish",
    "roughness_ra": 0.8,
    "removal": "prohibited"
   },
   "expect": {
    "data.text": [
     "Ra 0.8"
    ],
    "data.leader.object.kind": "edge"
   }
  },
  {
   "call": "nx_create_drawing_symbol",
   "args": {
    "view": "$top.data.view.id",
    "object": "$front.items.0.object.id",
