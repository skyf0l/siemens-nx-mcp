{
 "covers": {
  "nx_create_balloons": [],
  "nx_create_drawing_view": [
   "base",
   "projected"
  ],
  "nx_create_drawing_table": [
   "parts_list"
  ],
  "nx_edit_drawing_table": [
   "parts_list"
  ],
  "nx_get_drawing_table": [],
  "nx_update_annotations": []
 },
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": "new",
 "steps": [
  {
   "call": "nx_create_part",
   "setup": true,
   "save": "part",
   "args": {
    "path": "$part",
    "units": "mm"
   }
  },
  {
   "call": "nx_create_component",
   "setup": true,
   "args": {
    "path": "$fixture",
    "pose": {
     "translation": [
      0,
      0,
      0
     ]
    }
   }
  },
  {
   "call": "nx_create_component",
   "setup": true,
   "args": {
    "path": "$fixture",
    "pose": {
     "translation": [
      0,
      80,
      0
     ]
    }
   }
  },
  {
   "call": "nx_create_explosion",
   "setup": true,
   "save": "ex",
   "args": {
    "name": "EXPLODED"
   }
  },
  {
   "call": "nx_create_drawing_sheet",
   "setup": true,
   "save": "sh",
   "args": {
    "name": "SHT1",
    "size": "a3",
    "projection": "third_angle"
   }
  },
  {
   "call": "nx_create_drawing_view",
   "args": {
    "type": "base",
    "sheet": "$sh.data.sheet.id",
    "orientation": "top",
    "position": [
     130,
     160
    ]
   },
   "save": "top",
   "expect": {
    "data.position": {
     "close": [
      130,
      160
     ],
     "tol": 1e-06
    },
    "data.bounds": {
     "count": 4
    }
   }
  },
  {
   "call": "nx_create_drawing_view",
   "args": {
    "type": "base",
    "sheet": "$sh.data.sheet.id",
    "orientation": "isometric",
    "position": [
     320,
     200
    ],
    "explosion": "$ex.data.explosion.id",
    "scale": 0.5
   },
   "expect": {
    "data.scale": {
     "close": 0.5,
     "tol": 1e-09
    },
    "data.position": {
     "close": [
      320,
      200
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_drawing_view",
   "args": {
    "type": "projected",
    "parent": "$top.data.view.id",
    "direction": "right",
    "position": [
     240,
     160
    ]
   },
   "expect": {
    "data.position.0": {
     "close": 240,
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_drawing_view",
   "args": {
    "type": "base",
    "sheet": "$sh.data.sheet.id",
    "orientation": "top",
    "body": "$part.data.part.id",
    "position": [
     130,
     160
    ]
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/body"
   }
  },
  {
   "call": "nx_create_drawing_table",
   "args": {
    "kind": "parts_list",
    "sheet": "$sh.data.sheet.id",
    "position": [
     300,
     80
    ]
   },
   "save": "pl",
   "expect": {
    "data.kind": "parts_list",
    "data.rows": {
     "count": 1
    },
    "data.rows.0.1": {
     "matches": "BLOCK_MM$"
    },
    "data.rows.0.2": "2",
    "data.columns.2.title": "QTY",
    "data.automatic": true,
    "data.position": {
     "close": [
      300,
      80
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_drawing_table",
   "args": {
    "kind": "parts_list",
    "sheet": "$sh.data.sheet.id",
    "position": [
     300,
     40
    ]
   },
   "expect": {
    "error.category": "already_exists",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_create_balloons",
   "args": {
    "parts_list": "$pl.data.table.id",
    "view": "$top.data.view.id"
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.balloons": {
     "count": 1
    }
   }
  },
  {
   "call": "nx_create_balloons",
   "args": {
    "parts_list": "$pl.data.table.id",
    "view": "$top.data.view.id"
   },
   "expect": {
    "data.balloons": {
     "count": 0
    }
   }
  },
  {
   "call": "nx_edit_drawing_table",
   "args": {
    "table": "$pl.data.table.id",
    "kind": "parts_list",
    "columns": [
     {
      "action": "edit",
      "index": 1,
      "title": "COMPONENT",
      "width": 65
     },
     {
      "action": "append",
      "title": "NAME",
      "width": 30,
      "field": "<W$=@$PART_NAME>",
      "protected": true
     }
    ]
   },
   "expect": {
    "data.columns": {
     "count": 4
    },
    "data.columns.1.title": "COMPONENT",
    "data.columns.1.width": {
     "close": 65,
     "tol": 0.0001
    },
    "data.columns.3.protected": true
   }
  },
  {
   "call": "nx_edit_drawing_table",
   "args": {
    "table": "$pl.data.table.id",
    "kind": "parts_list",
    "columns": [
     {
      "action": "remove",
      "index": 3
     }
    ]
   },
   "expect": {
    "data.columns": {
     "count": 3
    }
   }
  },
  {
   "call": "nx_edit_drawing_table",
   "args": {
    "table": "$pl.data.table.id",
    "kind": "parts_list",
    "columns": [
     {
      "action": "append",
      "title": "X",
      "width": 20
     }
    ]
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/columns/0/field"
   }
  },
  {
   "call": "nx_edit_drawing_table",
   "args": {
    "table": "$pl.data.table.id",
    "kind": "parts_list",
    "columns": [
     {
      "action": "edit",
      "index": 9,
      "title": "X"
     }
    ]
   },
   "expect": {
    "error.category": "invalid_argument",
    "mutation_outcome": "not_started",
    "error.field": "/columns/0/index"
   }
  },
  {
   "call": "nx_get_drawing_table",
   "args": {
    "table": "$pl.data.table.id"
   },
   "expect": {
    "data.rows.0.2": "2",
    "data.columns.0.field": "$~C"
   }
  },
  {
   "call": "nx_update_annotations",
   "args": {
    "objects": [
     "$pl.data.table.id"
    ]
   },
   "expect": {
    "data.refreshed": {
     "count_kind": {
      "drawing_table": 1
     }
    }
   }
  },
  {
   "call": "nx_create_balloons",
   "args": {
    "parts_list": "$sh.data.sheet.id",
    "view": "$top.data.view.id"
   },
   "expect": {
    "error.category": "wrong_kind",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_close_part",
   "setup": true,
   "args": {
    "part": "$part.data.part.id",
    "save": false
   }
  }
 ]
}
