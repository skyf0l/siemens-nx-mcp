{
 "covers": {
  "nx_list_view_edges": [],
  "nx_create_drawing_dimension": [
   "horizontal",
   "vertical"
  ],
  "nx_edit_drawing_view": []
 },
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {
   "call": "nx_open_part",
   "setup": true,
   "save": "part",
   "args": {
    "path": "$fixture"
   }
  },
  {
   "call": "nx_create_drawing_sheet",
   "setup": true,
   "save": "sh",
   "args": {
    "name": "SHT1",
    "size": "a3",
    "projection": "first_angle"
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "top",
   "args": {
    "type": "base",
    "sheet": "$sh.data.sheet.id",
    "orientation": "top",
    "position": [
     120,
     200
    ]
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "fv",
   "args": {
    "type": "projected",
    "parent": "$top.data.view.id",
    "direction": "bottom",
    "spacing": 20
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "rv",
   "args": {
    "type": "projected",
    "parent": "$top.data.view.id",
    "direction": "right",
    "spacing": 20
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h1",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     25,
     25,
     20
    ],
    "limit": 1,
    "radius": 8
   }
  },
  {
   "call": "nx_list_view_edges",
   "save": "edges",
   "args": {
    "view": "$top.data.view.id"
   },
   "expect": {
    "ok": true,
    "page.total": 7,
    "data.scale": {
     "close": 1,
     "tol": 1e-09
    },
    "data.units": "mm",
    "data.items.0.type": "line",
    "data.items.0.orientation": "horizontal",
    "data.items.0.length": {
     "close": 80,
     "tol": 1e-06
    },
    "data.items.0.model_length": {
     "close": 80,
     "tol": 1e-06
    },
    "data.items.0.center": {
     "close": [
      135,
      175
     ],
     "tol": 1e-06
    },
    "data.items.1.center": {
     "close": [
      130,
      225
     ],
     "tol": 1e-06
    },
    "data.items.2.orientation": "vertical",
    "data.items.2.length": {
     "close": 50,
     "tol": 1e-06
    },
    "data.items.4.orientation": "inclined",
    "data.items.4.length": {
     "close": 14.142136,
     "tol": 1e-05
    },
    "data.items.5.type": "circle",
    "data.items.5.radius": {
     "close": 8,
     "tol": 1e-09
    }
   }
  },
  {
   "call": "nx_list_view_edges",
   "save": "fedges",
   "args": {
    "view": "$fv.data.view.id",
    "orientation": "vertical"
   },
   "expect": {
    "data.items": {
     "count": 3
    },
    "data.items.0.length": {
     "close": 20,
     "tol": 1e-06
    },
    "data.items.0.center": {
     "close": [
      95,
      132.3
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_list_view_edges",
   "args": {
    "view": "top",
    "geometry_type": "circle"
   },
   "expect": {
    "data.items": {
     "count": 2
    },
    "data.items.0.radius": {
     "close": 8,
     "tol": 1e-09
    },
    "data.items.0.center": {
     "close": [
      120,
      200
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_drawing_dimension",
   "save": "d1",
   "args": {
    "view": "$top.data.view.id",
    "kind": "horizontal",
    "first": "$edges.data.items.0.id"
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.dimension.value": {
     "close": 80,
     "tol": 1e-06
    },
    "data.origin": {
     "close": [
      135,
      158.65
     ],
     "tol": 1e-06
    },
    "data.bounds.3": {
     "close": 175,
     "tol": 0.001
    },
    "warnings": {
     "count": 0
    }
   }
  },
  {
   "call": "nx_create_drawing_dimension",
   "args": {
    "view": "$top.data.view.id",
    "kind": "horizontal",
    "first": "$edges.data.items.0.id"
   },
   "expect": {
    "data.dimension.value": {
     "close": 80,
     "tol": 1e-06
    },
    "data.origin": {
     "close": [
      135,
      241.35
     ],
     "tol": 1e-06
    },
    "warnings": {
     "count": 0
    }
   }
  },
  {
   "call": "nx_create_drawing_dimension",
   "args": {
    "view": "$fv.data.view.id",
    "kind": "vertical",
    "first": "$fedges.data.items.0.id"
   },
   "expect": {
    "data.dimension.value": {
     "close": 20,
     "tol": 1e-06
    },
    "data.origin": {
     "close": [
      78.65,
      132.3
     ],
     "tol": 1e-06
    },
    "warnings": {
     "count": 0
    }
   }
  },
  {
   "call": "nx_create_drawing_dimension",
   "args": {
    "view": "$top.data.view.id",
    "kind": "vertical",
    "first": "$edges.data.items.2.id",
    "orientation": "horizontal"
   },
   "expect": {
    "error.category": "invalid_argument",
    "error.field": "/orientation",
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_create_drawing_dimension",
   "args": {
    "view": "$top.data.view.id",
    "kind": "radius",
    "first": "$h1.data.items.0.id"
   },
   "expect": {
    "data.dimension.value": {
     "close": 8,
     "tol": 1e-09
    },
    "data.origin": {
     "close": [
      78.65,
      200
     ],
     "tol": 1e-06
    }
   }
  },
  {
   "call": "nx_create_drawing_dimension",
   "args": {
    "view": "$top.data.view.id",
    "kind": "linear",
    "first": "$edges.data.items.1.id",
    "orientation": "horizontal",
    "origin": [
     130,
     215
    ]
   },
   "expect": {
    "data.origin": {
     "close": [
      130,
      215
     ],
     "tol": 1e-06
    },
    "warnings.0.code": "NX_VIEW_OVERLAP"
   }
  },
  {
   "call": "nx_create_note",
   "args": {
    "text": [
     "OVER THE VIEW"
    ],
    "origin": [
     110,
     200
    ]
   },
   "expect": {
    "data.bounds.0": {
     "close": 110,
     "tol": 0.001
    },
    "data.bounds.1": {
     "close": 198.219,
     "tol": 0.01
    },
    "warnings.0.code": "NX_VIEW_OVERLAP"
   }
  },
  {
   "call": "nx_create_note",
   "args": {
    "text": [
     "CLEAR NOTE"
    ],
    "origin": [
     300,
     60
    ]
   },
   "expect": {
    "data.bounds.0": {
     "close": 300,
     "tol": 0.001
    },
    "warnings": {
     "count": 0
    }
   }
  },
  {
   "call": "nx_create_drawing_table",
   "args": {
    "kind": "revision",
    "sheet": "$sh.data.sheet.id",
    "position": [
     250,
     290
    ],
    "rows": [
     [
      "A",
      "First release",
      "TR"
     ]
    ],
    "widths": [
     10,
     60,
     15
    ]
   },
   "expect": {
    "data.bounds": {
     "close": [
      250,
      283,
      335,
      290
     ],
     "tol": 0.001
    },
    "warnings": {
     "count": 0
    }
   }
  },
  {
   "call": "nx_list_objects",
   "args": {
    "kind": "dimension",
    "limit": 1
   },
   "expect": {
    "data.items.0.details.bounds.3": {
     "close": 175,
     "tol": 0.001
    }
   }
  },
  {
   "call": "nx_get_dimension",
   "args": {
    "dimension": "$d1.data.dimension.id"
   },
   "expect": {
    "data.bounds.3": {
     "close": 175,
     "tol": 0.001
    }
   }
  },
  {
   "call": "nx_edit_drawing_view",
   "args": {
    "view": "$top.data.view.id",
    "scale": 1.5
   },
   "expect": {
    "data.scale": {
     "close": 1.5,
     "tol": 1e-09
    },
    "data.rescaled": {
     "count": 2
    },
    "data.rescaled.0.name": "ORTHO@2",
    "data.rescaled.1.name": "ORTHO@3",
    "changes.modified": {
     "count": 3
    }
   }
  },
  {
   "call": "nx_get_drawing_view",
   "save": "top2",
   "args": {
    "view": "$top.data.view.id"
   }
  },
  {
   "call": "nx_get_drawing_view",
   "args": {
    "view": "$fv.data.view.id"
   },
   "expect": {
    "data.scale": {
     "close": 1.5,
     "tol": 1e-09
    }
   }
  },
  {
   "call": "nx_get_drawing_view",
   "args": {
    "view": "$rv.data.view.id"
   },
   "expect": {
    "data.scale": {
     "close": 1.5,
     "tol": 1e-09
    }
   }
  },
  {
   "call": "nx_close_part",
   "setup": true,
   "args": {
    "part": "$part.data.part.id",
    "save": false
   }
  }
 ]
}
