{
 "covers": {
  "nx_export_drawing": [],
  "nx_update_annotations": [],
  "nx_activate_drawing_sheet": []
 },
 "fixture": "fixtures/drawing_out_of_date.prt",
 "part": null,
 "steps": [
  {"call": "nx_open_part", "setup": true, "save": "part", "args": {"path": "$fixture"}},
  {"call": "nx_activate_drawing_sheet", "args": {"sheet": "SHT1"},
   "expect": {"data.sheet.name": "SHT1", "data.sheets.0.views": {"count": 4},
    "warnings.0.code": "NX_NOTE", "warnings.0.message": {"contains": "4 drawing view(s) are out of date"}}},
  {"call": "nx_export_drawing", "args": {"path": "$run/stale.pdf"},
   "expect": {"ok": true, "data.format": "pdf", "data.updated_views": {"count": 4},
    "data.updated_views.0.name": "Front@1", "data.updated_views.3.name": "Isometric@4"}},
  {"call": "nx_activate_drawing_sheet", "args": {"sheet": "SHT1"},
   "expect": {"data.sheet.name": "SHT1", "warnings": {"count": 0}}},
  {"call": "nx_export_drawing", "args": {"path": "$run/fresh.pdf"},
   "expect": {"ok": true, "data.updated_views": {"count": 0}}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "$part.data.part.id", "save": false}},
  {"call": "nx_open_part", "setup": true, "save": "again", "args": {"path": "$fixture"}},
  {"call": "nx_update_annotations", "args": {},
   "expect": {"mutation_outcome": "committed", "data.refreshed": {"count": 4},
    "data.refreshed.0.kind": "drawing_view", "data.refreshed.2.name": "Right@3"}},
  {"call": "nx_update_annotations", "args": {},
   "expect": {"data.refreshed": {"count": 0}, "data.note": {"contains": "Nothing needed a refresh"}}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "$again.data.part.id", "save": false}}
 ]
}
