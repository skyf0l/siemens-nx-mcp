{
 "covers": {
  "nx_set_drafting_standard": []
 },
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {
   "call": "nx_open_part",
   "setup": true,
   "save": "part",
   "args": {
    "path": "$fixture"
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h1",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     25.0,
     25.0,
     20.0
    ],
    "limit": 1,
    "radius": 8.0
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "h2",
   "args": {
    "kind": "edge",
    "geometry_type": "circle",
    "near": [
     60.0,
     25.0,
     20.0
    ],
    "limit": 1,
    "radius": 5.0
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "back",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     35.0,
     50.0,
     20.0
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "front",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     40.0,
     0.0,
     20.0
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "left",
   "args": {
    "kind": "edge",
    "geometry_type": "line",
    "near": [
     0.0,
     25.0,
     20.0
    ],
    "limit": 1
   }
  },
  {
   "call": "nx_find_geometry",
   "setup": true,
   "save": "top_face",
   "args": {
    "kind": "face",
    "geometry_type": "plane",
    "near": [
     40.0,
     10.0,
     20.0
    ],
    "limit": 1,
    "normal": [
     0,
     0,
     1
    ]
   }
  },
  {
   "call": "nx_create_drawing_sheet",
   "setup": true,
   "save": "sh",
   "args": {
    "name": "SHT1",
    "size": "a3",
    "projection": "first_angle"
   }
  },
  {
   "call": "nx_create_drawing_view",
   "setup": true,
   "save": "top",
   "args": {
    "type": "base",
    "sheet": "$sh.data.sheet.id",
    "orientation": "top",
    "position": [
     120,
     200
    ]
   }
  },
  {
   "call": "nx_set_drafting_standard",
   "args": {
    "standard": "ASME"
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.standard": "ASME"
   }
  },
  {
   "call": "nx_create_gdt",
   "intent": "Acceptance: ASME shows one place by default; the frame shows every place of its tolerance",
   "args": {
    "kind": "view_fcf",
    "view": "$top.data.view.id",
    "object": "$back.data.items.0.id",
    "frame": {
     "characteristic": "flatness",
     "tolerance": 0.005
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.text": {
     "contains": "0.005"
    }
   }
  },
  {
   "call": "nx_create_drawing_dimension",
   "save": "d",
   "args": {
    "view": "$top.data.view.id",
    "kind": "horizontal",
    "first": "$back.data.items.0.id"
   },
   "expect": {
    "mutation_outcome": "committed"
   }
  },
  {
   "call": "nx_edit_dimension",
   "args": {
    "dimension": "$d.data.dimension.id",
    "tolerance": {
     "type": "bilateral",
     "upper": 0.1,
     "lower": 0
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.tolerance.lower": {
     "close": 0,
     "tol": 1e-09
    }
   }
  },
  {
   "call": "nx_edit_dimension",
   "args": {
    "dimension": "$d.data.dimension.id",
    "tolerance": {
     "type": "basic"
    }
   },
   "expect": {
    "mutation_outcome": "committed",
    "data.tolerance.type": "basic"
   }
  },
  {
   "call": "nx_set_drafting_standard",
   "args": {
    "standard": "ISO"
   },
   "expect": {
    "data.standard": "ISO"
   }
  }
 ]
}
