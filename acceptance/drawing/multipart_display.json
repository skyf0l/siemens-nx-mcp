{
 "covers": {},
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {"call": "nx_open_part", "setup": true, "save": "part", "args": {"path": "$fixture"}},
  {"call": "nx_find_geometry", "setup": true, "save": "back", "args": {"kind": "edge", "geometry_type": "line", "near": [35, 50, 20], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "front_edge", "args": {"kind": "edge", "geometry_type": "line", "near": [40, 0, 20], "limit": 1}},
  {"call": "nx_create_drawing_sheet", "setup": true, "save": "sh", "args": {"name": "SHT1", "size": "a3", "projection": "first_angle"}},
  {"call": "nx_create_drawing_view", "setup": true, "save": "top", "args": {"type": "base", "sheet": "$sh.data.sheet.id", "orientation": "top", "position": [120, 200]}},
  {"call": "nx_create_drawing_dimension", "setup": true, "save": "lin", "args": {"view": "$top.data.view.id", "kind": "linear", "first": "$front_edge.data.items.0.id", "second": "$back.data.items.0.id", "orientation": "vertical", "origin": [200, 200]}},
  {"call": "nx_create_note", "setup": true, "save": "note", "args": {"text": ["KEEP"], "origin": [40, 40]}},
  {"call": "nx_create_note", "setup": true, "save": "note2", "args": {"text": ["GONE"], "origin": [80, 40]}},

  {"call": "nx_get_drawing_view", "save": "dv", "args": {"view": "$top.data.view.id"},
   "intent": "Acceptance: the view read while its drawing part is displayed (the reference for the background read)",
   "expect": {"ok": true, "data.type": "base", "data.scale": {"close": 1, "tol": 1e-09},
              "data.position": {"close": [120, 200], "tol": 1e-06}, "data.sheet.name": "SHT1", "data.orientation": "top"}},
  {"call": "nx_list_view_edges", "save": "ve", "args": {"view": "$top.data.view.id"},
   "expect": {"ok": true, "page.total": 7, "data.items.0.type": "line", "data.items.0.length": {"close": 80, "tol": 1e-06},
              "data.items.0.center": {"close": [135, 175], "tol": 1e-06}, "data.items.5.radius": {"close": 8, "tol": 1e-09}}},
  {"call": "nx_get_dimension", "save": "gd", "args": {"dimension": "$lin.data.dimension.id"},
   "expect": {"ok": true, "data.type": "VerticalDimension", "data.value": {"close": 50, "tol": 1e-09},
              "data.origin": {"close": [200, 200], "tol": 1e-06}, "data.sheet.name": "SHT1", "data.associations": 2}},

  {"call": "nx_create_part", "setup": true, "save": "front", "args": {"path": "$run/mdr/mdr_front.prt", "units": "mm", "display": true}},
  {"call": "engineer", "args": {"code": "from nx_mcp.kit import parts as kp\nservices.host._remember_model()  # the development tool's own undo mark is no engineer edit\np = [x for x in session.Parts if str(x.Leaf).lower().startswith('mdr_front') and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nkp.show(NXOpen, session.Parts, p)\nresult = p.Leaf"}, "intent": "Acceptance: the engineer looks at mdr_front.prt (a tab click, no edit): it is the displayed part whatever NX showed before (engineer tab guard)", "expect": {"ok": true, "data.noticed": false}},
  {"call": "nx_create_primitive", "setup": true, "args": {"shape": "block", "length": 40, "width": 20, "height": 10, "part": "mdr_front"}},
  {"call": "nx_create_drawing_sheet", "setup": true, "save": "sh2", "args": {"part": "$part.data.part.id", "name": "SHT2", "size": "a4", "projection": "first_angle"}},

  {"call": "nx_get_drawing_view", "args": {"view": "$top.data.view.id"},
   "intent": "Acceptance: the same view read in the background drawing part: same numbers",
   "expect": {"ok": true, "part.file": "drawing_multipart_display_drawing_block_mm.prt", "data.type": "base",
              "data.scale": {"close": 1, "tol": 1e-09}, "data.position": {"close": [120, 200], "tol": 1e-06},
              "data.bounds": {"close": "$dv.data.bounds", "tol": 1e-06}, "data.center": {"close": "$dv.data.center", "tol": 1e-06},
              "data.sheet.name": "SHT1", "data.orientation": "top"}},
  {"call": "nx_list_view_edges", "args": {"view": "$top.data.view.id"},
   "intent": "Acceptance: the view's edges read in the background drawing part: same numbers",
   "expect": {"ok": true, "part.file": "drawing_multipart_display_drawing_block_mm.prt", "page.total": 7,
              "data.items.0.length": {"close": 80, "tol": 1e-06}, "data.items.0.center": {"close": [135, 175], "tol": 1e-06},
              "data.items.1.center": {"close": "$ve.data.items.1.center", "tol": 1e-06},
              "data.items.2.length": {"close": "$ve.data.items.2.length", "tol": 1e-06},
              "data.items.5.radius": {"close": 8, "tol": 1e-09}, "data.items.5.center": {"close": "$ve.data.items.5.center", "tol": 1e-06}}},
  {"call": "nx_get_dimension", "args": {"dimension": "$lin.data.dimension.id"},
   "intent": "Acceptance: the dimension read in the background drawing part: same numbers",
   "expect": {"ok": true, "part.file": "drawing_multipart_display_drawing_block_mm.prt", "data.type": "VerticalDimension",
              "data.value": {"close": 50, "tol": 1e-09}, "data.origin": {"close": [200, 200], "tol": 1e-06},
              "data.sheet.name": "SHT1", "data.associations": 2}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},

  {"call": "nx_edit_annotation", "args": {"annotation": "$note.data.annotation.id", "position": [60, 50], "name": "BG_NOTE"},
   "intent": "Acceptance: a sheet note of the background drawing part moved",
   "expect": {"mutation_outcome": "committed", "part.file": "drawing_multipart_display_drawing_block_mm.prt",
              "data.position": {"close": [60, 50], "tol": 1e-06}, "data.name": "BG_NOTE", "data.frame": "sheet"}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_list_objects", "args": {"part": "$part.data.part.id", "kind": "annotation", "name_contains": "BG_NOTE"},
   "intent": "Acceptance: the moved note reads back at its new position",
   "expect": {"page.total": 1, "data.items.0.id": "$note.data.annotation.id", "data.items.0.details.origin": {"close": [60, 50, 0], "tol": 1e-06}}},

  {"call": "nx_delete_objects", "args": {"objects": ["$lin.data.dimension.id", "$note2.data.annotation.id"]},
   "intent": "Acceptance: a dimension and a note on a sheet of the background drawing part deleted (displayed for the call)",
   "expect": {"ok": true, "mutation_outcome": "committed", "part.file": "drawing_multipart_display_drawing_block_mm.prt",
              "data.deleted": {"count_kind": {"dimension": 1, "annotation": 1}}}},
  {"call": "nx_list_objects", "args": {"part": "$part.data.part.id", "kind": "dimension"},
   "expect": {"page.total": 0}},
  {"call": "nx_list_objects", "args": {"part": "$part.data.part.id", "kind": "annotation"},
   "intent": "Acceptance: only the kept note is left (with the view's two automatic center marks)",
   "expect": {"page.total": 3, "data.items.0.id": "$note.data.annotation.id", "data.items.0.type": "Note",
              "data.items.1.type": "CenterMark", "data.items.2.type": "CenterMark"}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},

  {"call": "nx_delete_objects", "args": {"objects": ["$sh2.data.sheet.id"]},
   "intent": "Acceptance: a drawing sheet of the background drawing part deleted",
   "expect": {"ok": true, "mutation_outcome": "committed", "part.file": "drawing_multipart_display_drawing_block_mm.prt",
              "data.deleted.0.kind": "drawing_sheet"}},
  {"call": "nx_list_objects", "args": {"part": "$part.data.part.id", "kind": "drawing_sheet"},
   "expect": {"page.total": 1, "data.items.0.id": "$sh.data.sheet.id"}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "intent": "Acceptance: the engineer's display and work part are back",
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}}
 ]
}
