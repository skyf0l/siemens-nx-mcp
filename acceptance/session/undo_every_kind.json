{
 "covers": {},
 "fixture": "fixtures/drawing_block_mm.prt",
 "part": null,
 "steps": [
  {"call": "nx_open_part", "setup": true, "save": "part", "args": {"path": "$fixture"}},
  {"call": "nx_create_part", "setup": true, "save": "b", "args": {"path": "$run/uek/uek_b.prt", "units": "mm", "display": false}},
  {"call": "nx_create_drawing_sheet", "setup": true, "save": "sh", "args": {"part": "$part.data.part.id", "name": "SHT1", "size": "a3", "projection": "first_angle"}},
  {"call": "nx_create_drawing_view", "setup": true, "save": "top", "args": {"type": "base", "sheet": "$sh.data.sheet.id", "orientation": "top", "position": [120, 200]}},
  {"call": "nx_list_objects", "setup": true, "save": "ann0", "args": {"part": "$part.data.part.id", "kind": "annotation"}},

  {"call": "nx_create_note", "save": "note", "args": {"part": "$part.data.part.id", "text": ["UNDO ME"], "origin": [40, 40]},
   "intent": "Acceptance: a drawing note in the drawing part",
   "expect": {"mutation_outcome": "committed", "changes.created": {"count_kind": {"annotation": 1}}}},
  {"call": "nx_create_primitive", "save": "b1", "args": {"part": "uek_b", "shape": "block", "length": 10, "width": 10, "height": 10},
   "intent": "Acceptance: another part's later work keeps NX's undo from the note",
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 1000, "tol": 1e-06}}},
  {"call": "nx_undo_operation", "args": {"part": "$part.data.part.id"},
   "intent": "Acceptance: the note is undone by its kind's own deleter, said plainly; the other part stays",
   "expect": {"mutation_outcome": "committed", "data.compensated": true, "data.undone": ["$note.operation_id"],
              "changes.deleted": {"count_kind": {"annotation": 1}},
              "warnings": {"contains": {"code": "NX_NOTE"}},
              "warnings.0.message": {"matches": "^Undone by deleting what it created [(]1 annotation[)]; other parts and later work are untouched"}}},
  {"call": "nx_list_objects", "args": {"part": "$part.data.part.id", "kind": "annotation"},
   "intent": "Acceptance: the drawing has its annotations of before the note",
   "expect": {"page.total": "$ann0.page.total"}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$b1.data.bodies.0.id"]},
   "expect": {"data.volume": {"close": 1000, "tol": 1e-06}}},

  {"call": "nx_create_part", "setup": true, "save": "a", "args": {"path": "$run/uek/uek_a.prt", "units": "mm", "display": false}},
  {"call": "nx_create_primitive", "save": "a1", "args": {"part": "uek_a", "shape": "block", "length": 40, "width": 20, "height": 10},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_create_checkpoint", "save": "cp", "args": {"part": "uek_a", "label": "uek start"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_run_batch", "save": "batch", "args": {"part": "uek_a", "operations": [
     {"tool": "nx_create_sketch", "arguments": {"placement": {"principal": "xy"}, "name": "UEK_SK"}},
     {"tool": "nx_create_sketch_curves", "arguments": {"sketch": "$$0.data.sketch", "curves": [{"type": "line", "start": [0, 0], "end": [10, 0]}]}},
     {"tool": "nx_finish_sketch", "arguments": {"sketch": "$$0.data.sketch"}}]},
   "intent": "Acceptance: a sketch made and finished in one batch: the finish needs nothing undone",
   "expect": {"mutation_outcome": "committed", "data.count": 3, "warnings": {"count": 0}}},
  {"call": "nx_set_name", "save": "n1", "args": {"object": "$a1.data.feature.id", "name": "UEK_FIRST"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_set_name", "save": "n2", "args": {"object": "$a1.data.feature.id", "name": "UEK_SECOND"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_create_primitive", "args": {"part": "uek_b", "shape": "block", "length": 5, "width": 5, "height": 5, "origin": [30, 0, 0]},
   "intent": "Acceptance: other part's work after A's",
   "expect": {"mutation_outcome": "committed", "warnings": {"count": 0}}},
  {"call": "nx_list_checkpoints", "args": {"part": "uek_a"},
   "intent": "Acceptance: the restore's own check: restorable by compensation (two renames of one name, a finished sketch)",
   "expect": {"data.checkpoints.0.label": "uek start", "data.checkpoints.0.compensated": true,
              "data.checkpoints.0.restorable": true, "data.checkpoints.0.operations_after": 3}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "uek start", "part": "uek_a"},
   "intent": "Acceptance: the restore deletes the batch's sketch and sets the name back rename by rename",
   "expect": {"mutation_outcome": "committed", "data.compensated": true,
              "data.reverted": ["$batch.operation_id", "$n1.operation_id", "$n2.operation_id"],
              "data.restored": {"count": 2}}},
  {"call": "nx_list_objects", "args": {"part": "uek_a", "kind": "sketch"},
   "expect": {"page.total": 0}},
  {"call": "nx_list_objects", "args": {"part": "uek_a", "kind": "feature", "name_contains": "UEK_"},
   "intent": "Acceptance: no name the restore set back is left",
   "expect": {"page.total": 0}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$a1.data.bodies.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},

  {"call": "nx_undo_operation", "args": {"part": "uek_a", "operation": "$cp.operation_id"},
   "intent": "Acceptance: a session call is not in the undo history, and the error says why",
   "expect": {"ok": false, "error.code": "NX_NOT_FOUND", "mutation_outcome": "not_started",
              "error.message": {"matches": "changed no model: there is nothing to undo"}}},
  {"call": "nx_undo_operation", "args": {"part": "uek_a", "operation": "$n2.operation_id"},
   "intent": "Acceptance: an operation a restore reverted says so",
   "expect": {"ok": false, "error.code": "NX_NOT_FOUND", "error.message": {"matches": "was already undone by"},
              "error.hint": "nx_redo_operation repeats it"}},

  {"call": "nx_close_part", "setup": true, "args": {"part": "uek_a", "save": false, "force": true}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "uek_b", "save": false, "force": true}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "$part.data.part.id", "save": false, "force": true}}
 ]
}
