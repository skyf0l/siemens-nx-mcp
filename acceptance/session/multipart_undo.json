{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "a", "args": {"path": "$run/mu/mu_a.prt", "units": "mm"}},
  {"call": "nx_create_part", "setup": true, "save": "b", "args": {"path": "$run/mu/mu_b.prt", "units": "mm", "display": false}},

  {"call": "nx_create_primitive", "save": "a1", "args": {"part": "mu_a", "shape": "block", "length": 40, "width": 20, "height": 10},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 8000, "tol": 1e-06}, "part.file": "mu_a.prt"}},
  {"call": "nx_find_geometry", "save": "aedge", "args": {"part": "mu_a", "kind": "edge", "geometry_type": "line", "near": [40, 10, 10], "order": "nearest", "limit": 1}},
  {"call": "nx_create_blend", "save": "ablend", "args": {"edges": ["$aedge.data.items.0.id"], "radius": 2},
   "intent": "Acceptance: an operation of A that is not create-only (it consumes an edge)",
   "expect": {"mutation_outcome": "committed", "part.file": "mu_a.prt"}},
  {"call": "nx_create_primitive", "save": "b1", "args": {"part": "mu_b", "shape": "block", "length": 30, "width": 30, "height": 5},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 4500, "tol": 1e-06}, "part.file": "mu_b.prt"}},
  {"call": "nx_undo_operation", "args": {"part": "mu_a"},
   "intent": "Acceptance: NX's undo of A's blend would revert B's later block; the blend cannot be undone by deletion",
   "expect": {"ok": false, "error.code": "NX_CROSS_PART", "mutation_outcome": "not_started",
              "error.message": {"matches": "nx_create_primitive in mu_b[.]prt"},
              "error.details.operation_id": "$b1.operation_id",
              "error.details.in_the_way": {"contains": {"operation_id": "$b1.operation_id", "part": "mu_b.prt"}}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$a1.data.bodies.0.id"]},
   "intent": "Acceptance: the refused undo changed nothing; the blend removed (1 - pi/4) r^2 L = 80 - 20 pi",
   "expect": {"data.volume": {"close": 7982.8319, "tol": 0.001}}},

  {"call": "nx_create_primitive", "save": "a2", "args": {"part": "mu_a", "shape": "block", "length": 10, "width": 10, "height": 10, "origin": [60, 0, 0]},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 1000, "tol": 1e-06}}},
  {"call": "nx_create_primitive", "save": "b2", "args": {"part": "mu_b", "shape": "block", "length": 5, "width": 5, "height": 5, "origin": [40, 0, 0]},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 125, "tol": 1e-06}}},
  {"call": "nx_undo_operation", "save": "ua2", "args": {"part": "mu_a"},
   "intent": "Acceptance: A's block came before B's: it is undone by deleting what it created, B untouched",
   "expect": {"mutation_outcome": "committed", "data.compensated": true,
              "data.undone": ["$a2.operation_id"], "data.undo_depth": 2, "data.redo_depth": 1,
              "changes.deleted": {"contains": {"kind": "feature"}},
              "warnings": {"contains": {"code": "NX_UPDATE_WARNING"}}}},
  {"call": "nx_list_objects", "args": {"part": "mu_a", "kind": "body"},
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$b1.data.bodies.0.id", "$b2.data.bodies.0.id"]},
   "intent": "Acceptance: B's bodies are untouched by A's undo",
   "expect": {"data.volume": {"close": 4625, "tol": 1e-06}}},
  {"call": "nx_list_checkpoints", "args": {"part": "mu_a"},
   "intent": "Acceptance: A's own depth; the undo by deletion is no operation of its own",
   "expect": {"data.undo_depth": 2, "data.last_operation": "$ablend.operation_id"}},
  {"call": "nx_undo_operation", "args": {"part": "mu_a"},
   "intent": "Acceptance: A's blend is still refused (B's work and A's undo by deletion are in the way)",
   "expect": {"ok": false, "error.code": "NX_CROSS_PART", "mutation_outcome": "not_started"}},

  {"call": "nx_undo_operation", "save": "ub2", "args": {"part": "mu_b"},
   "intent": "Acceptance: NX's undo of B's block would bring back what A's undo deleted: B deletes instead",
   "expect": {"mutation_outcome": "committed", "data.compensated": true, "data.undone": ["$b2.operation_id"]}},
  {"call": "nx_redo_operation", "args": {},
   "intent": "Acceptance: both parts have calls to redo: a redo without part is ambiguous",
   "expect": {"ok": false, "error.code": "NX_AMBIGUOUS_PART", "mutation_outcome": "not_started"}},
  {"call": "nx_redo_operation", "args": {"part": "mu_a"},
   "intent": "Acceptance: A's redo repeats only A's undone block",
   "expect": {"mutation_outcome": "committed", "data.redone": ["$a2.operation_id"], "data.redo_depth": 0,
              "part.file": "mu_a.prt"}},
  {"call": "nx_redo_operation", "args": {},
   "intent": "Acceptance: only B has calls to redo now: its redo needs no part",
   "expect": {"mutation_outcome": "committed", "data.redone": ["$b2.operation_id"], "part.file": "mu_b.prt"}},
  {"call": "nx_list_objects", "args": {"part": "mu_a", "kind": "body"},
   "expect": {"data.items": {"count": 2}}},
  {"call": "nx_list_objects", "args": {"part": "mu_b", "kind": "body"},
   "expect": {"data.items": {"count": 2}}},

  {"call": "engineer", "args": {"code": "p = [x for x in session.Parts if str(x.Name).lower() == 'mu_a'][0]\nsession.SetUndoMark(NXOpen.Session.MarkVisibility.Visible, 'engineer edit')\np.Expressions.CreateExpression('Number', 'mu_eng=12')"},
   "intent": "Acceptance: the engineer adds an expression in A between agent calls (the host notices it)",
   "expect": {"ok": true, "data.noticed": true}},
  {"call": "nx_undo_operation", "args": {"part": "mu_b"},
   "intent": "Acceptance: no undo reaches back over the engineer's edit, in any part",
   "expect": {"ok": false, "error.code": "NX_NOT_FOUND", "error.details.reason": "engineer_change"}},
  {"call": "nx_undo_operation", "args": {"part": "mu_a", "mode": "delete_created"},
   "expect": {"ok": false, "error.code": "NX_NOT_FOUND", "error.details.reason": "engineer_change"}},
  {"call": "nx_list_objects", "args": {"part": "mu_a", "kind": "expression", "name_contains": "mu_eng"},
   "intent": "Acceptance: the engineer's expression stays",
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_create_primitive", "save": "a3", "args": {"part": "mu_a", "shape": "block", "length": 5, "width": 5, "height": 5, "origin": [80, 0, 0]},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_undo_operation", "args": {"part": "mu_a"},
   "intent": "Acceptance: work after the engineer's edit undoes with NX's undo; the edit stays",
   "expect": {"mutation_outcome": "committed", "data.undone": ["$a3.operation_id"], "data.undo_depth": 0}},
  {"call": "nx_list_objects", "args": {"part": "mu_a", "kind": "expression", "name_contains": "mu_eng"},
   "expect": {"data.items": {"count": 1}}},

  {"call": "nx_create_checkpoint", "save": "bcp", "args": {"part": "mu_b", "label": "mu b before preview"},
   "expect": {"mutation_outcome": "committed", "data.undo_depth": 0}},
  {"call": "nx_preview_changes", "save": "pv", "args": {"part": "mu_b", "operations": [
     {"tool": "nx_create_primitive", "arguments": {"shape": "block", "length": 2, "width": 2, "height": 2, "origin": [100, 0, 0]}}]},
   "expect": {"ok": true, "part.file": "mu_b.prt", "data.delta.bodies": 1}},
  {"call": "nx_create_primitive", "args": {"part": "mu_a", "shape": "block", "length": 4, "width": 4, "height": 4, "origin": [90, 0, 0]},
   "intent": "Acceptance: work in A after B's preview",
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_set_highlight", "args": {"part": "mu_a", "objects": []},
   "expect": {"ok": true}},
  {"call": "nx_finish_preview", "save": "acc", "args": {"preview_id": "$pv.data.preview_id", "action": "accept"},
   "intent": "Acceptance: the preview is accepted in its own part (no part key); A's work does not age it",
   "expect": {"mutation_outcome": "committed", "part.file": "mu_b.prt", "data.state": "applied", "warnings": {"count": 0}}},
  {"call": "nx_list_objects", "args": {"part": "mu_b", "kind": "body"},
   "expect": {"data.items": {"count": 3}}},
  {"call": "nx_finish_preview", "args": {"preview_id": "$pv.data.preview_id", "action": "accept"},
   "intent": "Acceptance: a consumed preview says so (never NX_AMBIGUOUS_PART)",
   "expect": {"ok": false, "error.code": "NX_STALE_PREVIEW", "error.message": {"matches": "already accepted"}}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "$bcp.data.checkpoint_id"},
   "intent": "Acceptance: B's checkpoint restores B (A's block came before B's accept: NX's undo)",
   "expect": {"mutation_outcome": "committed", "part.file": "mu_b.prt", "data.reverted": ["$acc.operation_id"]}},
  {"call": "nx_list_objects", "args": {"part": "mu_b", "kind": "body"},
   "expect": {"data.items": {"count": 2}}},
  {"call": "nx_list_objects", "args": {"part": "mu_a", "kind": "body"},
   "expect": {"data.items": {"count": 3}}}
 ]
}
