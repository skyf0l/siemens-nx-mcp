{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "cover", "args": {"path": "$run/p5/p5_cover.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "save": "blk", "args": {"shape": "block", "length": 40, "width": 20, "height": 10},
   "intent": "Acceptance: one part loaded, no part key: the work part, as before",
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_check_model", "direct": true, "args": {},
   "intent": "Acceptance: one part loaded: a direct core tool without part runs as before",
   "expect": {"ok": true, "data.healthy": true}},
  {"call": "nx_create_part", "save": "housing", "args": {"path": "$run/p5/p5_housing.prt", "units": "mm"},
   "intent": "Acceptance: the load that brings two parts says that calls without refs now take part",
   "expect": {"mutation_outcome": "committed",
              "warnings": {"contains": {"code": "NX_NOTE", "message": "2 parts are loaded: calls without refs now take part"}}}},

  {"call": "nx_check_model", "direct": true, "args": {},
   "intent": "Acceptance: two parts loaded, a direct core tool without part or refs is ambiguous",
   "expect": {"ok": false, "error.code": "NX_AMBIGUOUS_PART", "mutation_outcome": "not_applicable"}},
  {"call": "nx_check_model", "direct": true, "args": {"part": "p5_cover"},
   "intent": "Acceptance: the direct core tool takes part, which its listed schema names",
   "expect": {"ok": true, "data.healthy": true, "part.file": "p5_cover.prt", "part.from": "part"}},
  {"call": "nx_get_model_summary", "direct": true, "args": {"part": "p5_cover.prt"},
   "expect": {"ok": true, "part.file": "p5_cover.prt"}},
  {"call": "nx_list_objects", "direct": true, "args": {"kind": "body", "part": "p5_cover"},
   "expect": {"ok": true, "part.file": "p5_cover.prt"}},
  {"call": "nx_find_geometry", "direct": true, "args": {"kind": "face", "normal": "+z", "part": "p5_cover"},
   "intent": "Acceptance: every ref-less direct core tool takes part (bench3p: agents passed owner refs instead)",
   "expect": {"ok": true, "part.file": "p5_cover.prt", "data.items": {"count": 1}}},
  {"call": "nx_list_components", "direct": true, "args": {"part": "p5_housing"},
   "expect": {"ok": true, "part.file": "p5_housing.prt", "page.total": 0}},
  {"call": "nx_check_model", "args": {"part": "p5_housing"},
   "intent": "Acceptance: the same key through nx_invoke_read",
   "expect": {"ok": true, "part.file": "p5_housing.prt"}},

  {"call": "nx_create_primitive", "save": "hb", "args": {"part": "p5_housing", "shape": "block", "length": 10, "width": 10, "height": 10},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 1000, "tol": 1e-06}, "part.file": "p5_housing.prt"}},
  {"call": "nx_undo_operation", "direct": true, "args": {"part": "p5_housing", "expires_at": 1},
   "intent": "Acceptance: the ghost guard: a changing call whose client gave up never runs",
   "expect": {"ok": false, "error.code": "NX_CALL_EXPIRED", "mutation_outcome": "not_started"}},
  {"call": "nx_undo_operation", "direct": true, "args": {"part": "p5_housing", "expires_at": "soon"},
   "expect": {"ok": false, "error.code": "NX_INVALID_ARGUMENT", "error.field": "/expires_at", "mutation_outcome": "not_started"}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$hb.data.bodies.0.id"]},
   "intent": "Acceptance: the refused undos changed nothing",
   "expect": {"data.volume": {"close": 1000, "tol": 1e-06}}},
  {"call": "nx_undo_operation", "direct": true, "args": {"part": "p5_housing"},
   "intent": "Acceptance: a direct changing core tool with part and the sidecar's own expires_at runs",
   "expect": {"mutation_outcome": "committed", "data.undone": ["$hb.operation_id"], "part.file": "p5_housing.prt"}},

  {"call": "nx_get_status", "args": {"include": ["parts", "control"]},
   "intent": "Acceptance: status counts the agent's parts and shows the queue",
   "expect": {"data.parts.agent_loaded": 2, "data.control.queue.waiting": 0}},
  {"call": "nx_capture_view", "direct": true, "args": {"part": "p5_cover", "inline": false, "width": 320, "height": 240},
   "intent": "Acceptance: a display-bound direct core tool with part photographs that part",
   "expect": {"ok": true, "part.file": "p5_cover.prt"}}
 ]
}
