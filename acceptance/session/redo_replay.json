{
 "covers": {
  "nx_redo_operation": [],
  "nx_undo_operation": [],
  "nx_get_operation": []
 },
 "part": "new",
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},

  {"call": "nx_set_attributes", "save": "attr", "args": {"attributes": {"PART_NO": "ACC-REDO-1"}},
   "intent": "Acceptance: the attribute an undo reverts",
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_get_attributes", "args": {"names": ["PART_NO"]},
   "expect": {"data.items.0.attributes": {"count": 1}, "data.items.0.attributes.0.value": "ACC-REDO-1"}},
  {"call": "nx_undo_operation", "save": "un1", "args": {},
   "intent": "Acceptance: undo the attribute",
   "expect": {"mutation_outcome": "committed", "data.tool": "nx_set_attributes",
              "data.undone": {"count": 1}, "data.undone.0": "$attr.operation_id",
              "data.redo": {"count": 1}, "data.redo.0": {"count": 3},
              "data.redo.0.tool": "nx_set_attributes",
              "data.redo.0.arguments": {"equals": {"attributes": {"PART_NO": "ACC-REDO-1"}}},
              "data.redo.0.complete": true, "data.redo_depth": 1}},
  {"call": "nx_get_attributes", "args": {"names": ["PART_NO"]},
   "expect": {"data.items.0.attributes": {"count": 0}, "data.items.0.missing": ["PART_NO"]}},

  {"call": "nx_set_attributes",
   "args": {"attributes": {"PART_NO": "ACC-REDO-1"}, "operation_id": "$attr.operation_id"},
   "intent": "Acceptance: the same operation_id after its undo runs again, not a replay",
   "expect": {"ok": true, "mutation_outcome": "committed", "operation_id": "$attr.operation_id",
              "warnings": {"contains": {"code": "NX_UPDATE_WARNING"}},
              "data.items.0.attributes.0.value": "ACC-REDO-1"}},
  {"call": "nx_get_attributes", "args": {"names": ["PART_NO"]},
   "expect": {"data.items.0.attributes": {"count": 1}, "data.items.0.attributes.0.value": "ACC-REDO-1"}},
  {"call": "nx_get_operation", "args": {"operation": "$attr.operation_id"},
   "expect": {"data.state": "committed", "data.tool": "nx_set_attributes",
              "data.previous.reverted_by": "$un1.operation_id"}},
  {"call": "nx_set_attributes",
   "args": {"attributes": {"PART_NO": "ACC-REDO-1"}, "operation_id": "$attr.operation_id"},
   "intent": "Acceptance: repeating the re-run now replays it",
   "expect": {"mutation_outcome": "committed", "replayed": true}},

  {"call": "nx_undo_operation", "save": "un2", "args": {},
   "intent": "Acceptance: undo the attribute again, then redo it",
   "expect": {"mutation_outcome": "committed", "data.undone.0": "$attr.operation_id",
              "data.redo_depth": 1}},
  {"call": "nx_get_attributes", "args": {"names": ["PART_NO"]},
   "expect": {"data.items.0.attributes": {"count": 0}}},
  {"call": "nx_redo_operation", "save": "re1", "args": {},
   "intent": "Acceptance: redo repeats the undone attribute call",
   "expect": {"ok": true, "mutation_outcome": "committed",
              "data.redone": ["$attr.operation_id"], "data.redo_depth": 0,
              "data.results.0.tool": "nx_set_attributes",
              "data.results.0.data.items.0.attributes.0.value": "ACC-REDO-1"}},
  {"call": "nx_get_attributes", "args": {"names": ["PART_NO"]},
   "expect": {"data.items.0.attributes": {"count": 1}, "data.items.0.attributes.0.value": "ACC-REDO-1"}},
  {"call": "nx_redo_operation", "args": {},
   "intent": "Acceptance: nothing left to redo",
   "expect": {"ok": false, "error.code": "NX_NOT_FOUND", "mutation_outcome": "not_started",
              "error.details.redo_depth": 0}},

  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "save": "blk",
   "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_create_extrude",
   "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 5}, "direction": "-z"},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 4000, "tol": 1e-06}}},
  {"call": "nx_undo_operation", "args": {"steps": 2},
   "intent": "Acceptance: undo both extrudes",
   "expect": {"mutation_outcome": "committed", "data.undone": {"count": 2}, "data.redo_depth": 2,
              "data.redo.0.tool": "nx_create_extrude", "data.redo.1.arguments.end.value": 5}},
  {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"data.items": {"count": 0}}},
  {"call": "nx_redo_operation", "args": {"steps": 3},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/steps", "mutation_outcome": "not_started"}},
  {"call": "nx_redo_operation", "save": "re2", "args": {},
   "intent": "Acceptance: redo the first extrude only",
   "expect": {"mutation_outcome": "committed", "data.redone": ["$blk.operation_id"], "data.redo_depth": 1,
              "data.results.0.data.volume": {"close": 8000, "tol": 1e-06},
              "data.results.0.changes.created": {"count_kind": {"body": 1}}}},
  {"call": "nx_list_objects", "save": "b1", "args": {"kind": "body"}, "expect": {"data.items": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$b1.data.items.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_redo_operation", "args": {"steps": 1},
   "intent": "Acceptance: redo the second extrude",
   "expect": {"mutation_outcome": "committed", "data.redo_depth": 0,
              "data.results.0.data.volume": {"close": 4000, "tol": 1e-06}}},
  {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"data.items": {"count": 2}}},
  {"call": "nx_undo_operation", "args": {},
   "intent": "Acceptance: a redone call is an operation of its own",
   "expect": {"mutation_outcome": "committed", "data.undone": {"count": 1}, "data.redo_depth": 1}},
  {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"data.items": {"count": 1}}}
 ]
}
