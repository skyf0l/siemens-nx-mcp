{
 "covers": {
  "nx_undo_operation": [],
  "nx_restore_checkpoint": [],
  "nx_save_part": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "p", "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "blk",
   "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
  {"call": "nx_find_geometry", "setup": true, "save": "top",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "limit": 1, "order": "highest", "axis": "z"}},
  {"call": "nx_find_geometry", "setup": true, "save": "bottom",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, -1], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "e1",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [20, 0, 10], "limit": 1}},
  {"call": "nx_create_checkpoint", "setup": true, "save": "cp", "args": {"label": "acc-refs-block"}},
  {"call": "nx_create_blend", "save": "bl1", "args": {"edges": ["$e1.data.items.0.id"], "radius": 2},
   "expect": {"data.volume": {"close": 7965.663706143591, "tol": 1e-06}}},
  {"call": "nx_undo_operation", "args": {},
   "expect": {"mutation_outcome": "committed", "data.tool": "nx_create_blend", "changes.references": "listed",
              "changes.deleted": {"count_kind": {"feature": 1}}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$blk.data.bodies.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_measure_distance", "args": {"first": "$top.data.items.0.id", "second": "$bottom.data.items.0.id"},
   "expect": {"data.distance": {"close": 10, "tol": 1e-06}}},
  {"call": "nx_create_blend", "save": "bl2", "args": {"edges": ["$e1.data.items.0.id"], "radius": 2},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 7965.663706143591, "tol": 1e-06}}},
  {"call": "nx_get_feature", "args": {"feature": "$bl1.data.feature.id"},
   "expect": {"error.code": "NX_STALE_REFERENCE"}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "$cp.data.checkpoint_id"},
   "expect": {"mutation_outcome": "committed", "data.reverted": {"count": 1}, "changes.references": "listed"}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$blk.data.bodies.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_get_feature", "args": {"feature": "$blk.data.feature.id"},
   "expect": {"data.feature.id": {"matches": "^f:"}}},
  {"call": "nx_save_part", "args": {}, "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_activate_part", "args": {"part": "$p.data.part.id"},
   "expect": {"mutation_outcome": {"matches": "committed|not_applicable"}}},
  {"call": "nx_measure_distance", "args": {"first": "$top.data.items.0.id", "second": "$bottom.data.items.0.id"},
   "expect": {"data.distance": {"close": 10, "tol": 1e-06}}}
 ]
}
