{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "cover", "args": {"path": "$run/fx/fx_cover.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "cb", "args": {"part": "fx_cover", "shape": "block", "length": 40, "width": 20, "height": 10}},
  {"call": "nx_create_drawing_sheet", "setup": true, "save": "sh", "args": {"part": "fx_cover", "size": "A3", "scale": 1}},
  {"call": "nx_create_drawing_view", "setup": true, "args": {"part": "fx_cover", "type": "base", "orientation": "front", "position": [150, 150]}},
  {"call": "nx_activate_drawing_sheet", "setup": true, "args": {"part": "fx_cover"}},
  {"call": "nx_create_part", "setup": true, "save": "bolt", "args": {"path": "$run/fx/fx_bolt.prt", "units": "mm", "display": false}},
  {"call": "nx_create_primitive", "setup": true, "args": {"part": "fx_bolt", "shape": "cylinder", "diameter": 6, "height": 20}},

  {"call": "nx_capture_view", "direct": true, "args": {"part": "fx_cover", "path": "$run/fx/model.png"},
   "intent": "Acceptance: a model-view capture of a part with a sheet names the sheet it left out",
   "expect": {"ok": true, "part.file": "fx_cover.prt", "data.image.inline": false,
              "warnings": {"contains": {"code": "NX_NOTE"}}}},
  {"call": "nx_capture_view", "direct": true, "args": {"part": "fx_cover", "sheet": "sht1", "path": "$run/fx/sheet.png"},
   "intent": "Acceptance: sheet captures the drawing sheet without nx_activate_drawing_sheet first",
   "expect": {"ok": true, "mutation_outcome": "not_applicable", "data.sheet.name": "SHT1", "data.marks_part_modified": false}},
  {"call": "nx_capture_view", "direct": true, "args": {"sheet": "$sh.data.sheet.id", "path": "$run/fx/sheet_ref.png"},
   "intent": "Acceptance: a sheet ref pins its part: no part key needed with two parts loaded",
   "expect": {"ok": true, "data.sheet.id": "$sh.data.sheet.id", "part.file": "fx_cover.prt"}},
  {"call": "nx_capture_view", "direct": true, "args": {"part": "fx_cover", "path": "$run/fx/model2.png"},
   "intent": "Acceptance: the model view came back after the sheet capture",
   "expect": {"ok": true, "data.camera.view": {"matches": "."}}},

  {"call": "nx_save_part", "setup": true, "args": {"part": "fx_cover"}},
  {"call": "nx_activate_drawing_sheet", "args": {"part": "fx_cover", "sheet": "SHT1"},
   "intent": "Acceptance: opening a sheet is a read-only visit",
   "expect": {"mutation_outcome": "committed", "data.sheet.name": "SHT1"}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/fx/fx_cover"},
   "expect": {"page.total": 1, "data.items.0.modified": false}},
  {"call": "nx_activate_drawing_sheet", "args": {"part": "fx_cover"},
   "expect": {"mutation_outcome": "committed", "data.modeling": true}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/fx/fx_cover"},
   "intent": "Acceptance: back to the model view, the saved part is still unmodified",
   "expect": {"data.items.0.modified": false}},

  {"call": "nx_set_attributes", "save": "a1", "args": {"part": "fx_cover", "attributes": {"PART_NO": "PC-001"}},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_set_attributes", "save": "a2", "args": {"part": "fx_cover", "attributes": {"PART_NO": "PC-002"}},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_set_expression", "save": "x1", "args": {"part": "fx_cover", "name": "undo_test", "formula": "1"},
   "expect": {"mutation_outcome": "committed", "data.created": true}},
  {"call": "nx_set_name", "save": "n1", "args": {"object": "$cb.data.feature.id", "name": "COVER_BLOCK"},
   "expect": {"mutation_outcome": "committed", "data.name": "COVER_BLOCK"}},
  {"call": "nx_create_primitive", "args": {"part": "fx_bolt", "shape": "block", "length": 4, "width": 4, "height": 4, "origin": [20, 0, 0]},
   "intent": "Acceptance: another part's later work: NX's undo of fx_cover would revert it",
   "expect": {"mutation_outcome": "committed", "part.file": "fx_bolt.prt"}},
  {"call": "nx_undo_operation", "direct": true, "args": {"part": "fx_cover"},
   "intent": "Acceptance: the rename is undone by setting the previous name back, fx_bolt untouched",
   "expect": {"mutation_outcome": "committed", "data.compensated": true, "data.undone": ["$n1.operation_id"],
              "data.restored": {"count": 1}}},
  {"call": "nx_list_objects", "args": {"part": "fx_cover", "kind": "feature"},
   "expect": {"data.items": {"contains": {"id": "$cb.data.feature.id", "name": "BLOCK(1)"}}}},
  {"call": "nx_undo_operation", "direct": true, "args": {"part": "fx_cover"},
   "intent": "Acceptance: the expression the call created is deleted",
   "expect": {"mutation_outcome": "committed", "data.compensated": true, "data.undone": ["$x1.operation_id"],
              "data.restored.0": "expression undo_test deleted (the operation created it)"}},
  {"call": "nx_undo_operation", "direct": true, "args": {"part": "fx_cover"},
   "intent": "Acceptance: the attribute gets its previous value back",
   "expect": {"mutation_outcome": "committed", "data.compensated": true, "data.undone": ["$a2.operation_id"],
              "data.restored.0": "PART_NO of fx_cover.prt back to 'PC-001'"}},
  {"call": "nx_get_attributes", "args": {"part": "fx_cover", "names": ["PART_NO"]},
   "expect": {"data.items.0.attributes.0.value": "PC-001"}},
  {"call": "nx_set_attributes", "save": "a3", "args": {"part": "fx_cover", "attributes": {"PART_NO": "PC-009"}},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_undo_operation", "direct": true, "args": {"part": "fx_cover", "operation": "$a1.operation_id", "mode": "compensate"},
   "intent": "Acceptance: a value changed since is never overwritten; the hint says how to fix forward",
   "expect": {"ok": false, "error.code": "NX_DEPENDENCY_ORDER", "error.hint": {"contains": "nx_set_attributes"},
              "mutation_outcome": "not_started"}},
  {"call": "nx_get_attributes", "args": {"part": "fx_cover", "names": ["PART_NO"]},
   "expect": {"data.items.0.attributes.0.value": "PC-009"}},

  {"call": "nx_create_primitive", "save": "sph", "args": {"part": "fx_cover", "shape": "sphere", "diameter": 5, "origin": [300, 300, 300]},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_create_primitive", "args": {"part": "fx_bolt", "shape": "block", "length": 4, "width": 4, "height": 4, "origin": [40, 0, 0]},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_undo_operation", "direct": true, "args": {"part": "fx_cover", "mode": "delete_created"},
   "intent": "Acceptance: a primitive whose drawing views NX refreshed is undone by deleting it (bench3p sphere)",
   "expect": {"mutation_outcome": "committed", "data.compensated": true, "data.undone": ["$sph.operation_id"],
              "changes.deleted": {"count_kind": {"feature": 1, "body": 1}}}},

  {"call": "nx_set_attributes", "save": "rev", "args": {"part": "fx_cover", "attributes": {"REV": "A"}},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/fx/fx_tmp.prt", "units": "mm", "display": false}},
  {"call": "nx_close_part", "args": {"part": "fx_tmp", "save": false, "force": true},
   "intent": "Acceptance: another part's close cuts NX's undo history",
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_undo_operation", "direct": true, "args": {"part": "fx_cover", "operation": "$rev.operation_id"},
   "intent": "Acceptance: the default undo compensates across another part's close, as across other parts' later work (bench3t: the close refused it)",
   "expect": {"mutation_outcome": "committed", "data.compensated": true, "data.restored.0": "REV of fx_cover.prt removed",
              "warnings": {"contains": {"code": "NX_UPDATE_WARNING"}}}},

  {"call": "nx_create_primitive", "args": {"part": "fx_cover", "shape": "block", "length": 5, "width": 5, "height": 5, "origin": [50, 0, 0]},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_create_primitive", "args": {"part": "fx_bolt", "shape": "block", "length": 4, "width": 4, "height": 4, "origin": [60, 0, 0]},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_close_part", "args": {"part": "fx_cover", "save": false},
   "intent": "Acceptance: unsaved changes and another part's call last: busy, the hint says save it first",
   "expect": {"ok": false, "error.code": "NX_PART_BUSY", "error.hint": {"contains": "save it first"}}},
  {"call": "nx_save_part", "args": {"part": "fx_cover"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_create_primitive", "args": {"part": "fx_bolt", "shape": "block", "length": 4, "width": 4, "height": 4, "origin": [80, 0, 0]},
   "intent": "Acceptance: another agent's call comes after the owner's save",
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_close_part", "args": {"part": "fx_cover", "save": false},
   "intent": "Acceptance: an agent's own close after its own save closes without force (bench3p)",
   "expect": {"mutation_outcome": "committed", "data.closed_count": 1}},

  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/fx/fx_box.prt", "units": "mm", "display": false}},
  {"call": "nx_create_primitive", "setup": true, "args": {"part": "fx_box", "shape": "block", "length": 10, "width": 10, "height": 10}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "fx_box"}},
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/fx/fx_kit.prt", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "A", "args": {"part": "fx_kit", "path": "$run/fx/fx_box.prt", "name": "A"}},
  {"call": "nx_create_component", "setup": true, "save": "B",
   "args": {"part": "fx_kit", "path": "$run/fx/fx_box.prt", "name": "B", "pose": {"translation": [100, 0, 0]}}},
  {"call": "nx_create_component", "setup": true, "save": "C",
   "args": {"part": "fx_kit", "path": "$run/fx/fx_box.prt", "name": "C", "pose": {"translation": [10, 0, 0]}}},
  {"call": "nx_check_interference", "args": {"part": "fx_kit"},
   "intent": "Acceptance: pairs the box test skipped are not counted as clear",
   "expect": {"data.pair_count": 3, "data.checked_pairs": 1, "data.skipped_pairs": 2,
              "data.counts": {"equals": {"penetration": 0, "contact": 1, "below_clearance": 0, "clear": 0, "skipped": 2}},
              "data.skipped_reason": {"contains": "cannot touch"}}},
  {"call": "nx_get_explosion", "args": {"part": "fx_kit"},
   "intent": "Acceptance: no explosion yet",
   "expect": {"ok": false, "error.code": "NX_NOT_FOUND", "error.field": "/explosion"}},
  {"call": "nx_create_explosion", "save": "e1", "args": {"part": "fx_kit", "name": "EXP1", "display": false},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_get_explosion", "args": {"part": "fx_kit"},
   "intent": "Acceptance: explosion is optional when the part has exactly one",
   "expect": {"ok": true, "data.explosion.id": "$e1.data.explosion.id", "data.components": {"count": 3}}},
  {"call": "nx_create_explosion", "save": "e2", "args": {"part": "fx_kit", "name": "EXP2"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_get_explosion", "args": {"part": "fx_kit"},
   "intent": "Acceptance: with two, the displayed one",
   "expect": {"ok": true, "data.explosion.id": "$e2.data.explosion.id"}},
  {"call": "nx_set_explosion_display", "args": {"part": "fx_kit"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_get_explosion", "args": {"part": "fx_kit"},
   "intent": "Acceptance: two and none displayed: refused with the list",
   "expect": {"ok": false, "error.code": "NX_INVALID_ARGUMENT", "error.details.explosions": {"count": 2}}},

  {"call": "nx_save_part", "setup": true, "args": {"part": "fx_kit"}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "fx_kit", "save": false, "force": true}},
  {"call": "nx_open_part", "save": "kit", "args": {"path": "$run/fx/fx_kit.prt", "load_components": true},
   "expect": {"mutation_outcome": "committed", "data.already_loaded": false}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/fx/fx_kit"},
   "intent": "Acceptance: a kit opened with its components reads unmodified before any change",
   "expect": {"page.total": 1, "data.items.0.modified": false}}
 ]
}
