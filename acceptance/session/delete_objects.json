{
 "covers": {
  "nx_delete_objects": []
 },
 "part": "new",
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/del/del_pin.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "pin_sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$pin_sk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 5}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$pin_sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true,
   "args": {"sketch": "$pin_sk.data.sketch.id", "end": {"type": "distance", "value": 20}}},
  {"call": "nx_save_part", "setup": true, "args": {}},

  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "blk_sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$blk_sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$blk_sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "blk",
   "args": {"sketch": "$blk_sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
  {"call": "nx_find_geometry", "setup": true, "save": "e1",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [20, 0, 10], "limit": 1}},
  {"call": "nx_create_blend", "setup": true, "save": "bl", "args": {"edges": ["$e1.data.items.0.id"], "radius": 2}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk2", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "save": "c2",
   "args": {"sketch": "$sk2.data.sketch.id", "curves": [
    {"type": "line", "start": [0, 30], "end": [10, 30]},
    {"type": "line", "start": [0, 35], "end": [10, 35]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk2.data.sketch.id"}},
  {"call": "nx_create_section_view", "setup": true, "save": "sec",
   "args": {"plane": {"origin": [20, 10, 0], "normal": [1, 0, 0]}, "name": "DEL_CUT"}},

  {"call": "nx_delete_objects", "args": {"objects": ["$blk.data.bodies.0.id"]},
   "intent": "Acceptance: a body is not a deletable kind; the error names its features",
   "expect": {"error.code": "NX_WRONG_KIND", "mutation_outcome": "not_started", "error.field": "/objects/0",
              "error.details.features": {"count": 2}, "error.hint": {"contains": "details.features[0]"}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$blk.data.bodies.0.id"]},
   "expect": {"data.volume": {"close": 7965.663706143591, "tol": 1e-06}}},

  {"call": "nx_delete_objects", "args": {"objects": ["$sec.data.section.id", "$c2.data.curves.1.curve.id"]},
   "intent": "Acceptance: delete a section view and a sketch curve in one call",
   "expect": {"mutation_outcome": "committed", "data.deleted": {"count_kind": {"section_view": 1, "curve": 1}},
              "data.dependent_count": 0}},
  {"call": "nx_list_objects", "args": {"kind": "section_view"}, "expect": {"data.items": {"count": 0}}},
  {"call": "nx_get_sketch", "args": {"sketch": "$sk2.data.sketch.id", "include": ["geometry"]},
   "expect": {"data.curves": {"count": 1}, "data.curves.0.start": {"close": [0, 30], "tol": 1e-09}}},

  {"call": "nx_delete_objects", "args": {"objects": ["$blk.data.feature.id"]},
   "intent": "Acceptance: delete the extrude; NX deletes its blend and body with it",
   "expect": {"mutation_outcome": "committed", "data.deleted.0.kind": "feature",
              "data.dependents": {"count_kind": {"feature": 1, "body": 1}},
              "data.dependents.0.part": {"matches": "^p:[0-9]+$"},
              "data.dependent_count": 2, "changes.references": "listed"}},
  {"call": "nx_list_objects", "args": {"kind": "body"}, "expect": {"data.items": {"count": 0}}},
  {"call": "nx_get_feature", "args": {"feature": "$bl.data.feature.id"},
   "expect": {"error.code": "NX_STALE_REFERENCE"}},
  {"call": "nx_list_objects", "args": {"kind": "sketch"}, "expect": {"data.items": {"count": 2}}},

  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/del/del_asm.prt", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "A", "args": {"path": "$run/del/del_pin.prt", "name": "A"}},
  {"call": "nx_create_component", "setup": true, "save": "B",
   "args": {"path": "$run/del/del_pin.prt", "name": "B", "pose": {"translation": [30, 0, 0]}}},
  {"call": "nx_create_sketch", "setup": true, "save": "asm_sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$asm_sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [-10, -30], "corner2": [40, -20]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$asm_sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "plate",
   "args": {"sketch": "$asm_sk.data.sketch.id", "end": {"type": "distance", "value": 5}}},
  {"call": "nx_create_explosion", "setup": true, "save": "ex", "args": {"name": "DEL_E1"}},
  {"call": "nx_set_explosion_display", "setup": true, "args": {"explosion": "$ex.data.explosion.id"}},

  {"call": "nx_delete_objects", "args": {"objects": ["$plate.data.feature.id", "$A.data.component.id", "$ex.data.explosion.id"]},
   "intent": "Acceptance: the shown explosion fails after the feature and component went; all rolls back",
   "expect": {"error.code": "NX_IN_USE", "mutation_outcome": "rolled_back"}},
  {"call": "nx_list_components", "args": {}, "expect": {"data.items": {"count": 2}}},
  {"call": "nx_list_components", "setup": true, "save": "comps", "args": {"name_contains": "A"}},
  {"call": "nx_list_objects", "save": "exl", "args": {"kind": "explosion"}, "expect": {"data.items": {"count": 1}}},
  {"call": "nx_list_objects", "save": "plates", "args": {"kind": "body"}, "expect": {"data.items": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$plates.data.items.0.id"]},
   "expect": {"data.volume": {"close": 2500, "tol": 1e-06}}},

  {"call": "nx_set_explosion_display", "setup": true, "args": {}},
  {"call": "nx_delete_objects", "args": {"objects": ["$exl.data.items.0.id", "$comps.data.items.0.id"]},
   "intent": "Acceptance: delete the explosion and a component together",
   "expect": {"mutation_outcome": "committed", "data.deleted": {"count_kind": {"explosion": 1, "component": 1}}}},
  {"call": "nx_list_components", "args": {}, "expect": {"data.items": {"count": 1}, "data.items.0.name": "B"}},
  {"call": "nx_list_objects", "args": {"kind": "explosion"}, "expect": {"data.items": {"count": 0}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$plates.data.items.0.id"]},
   "expect": {"data.volume": {"close": 2500, "tol": 1e-06}}}
 ]
}
