{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "front", "args": {"path": "$run/ms/ms_front.prt", "units": "mm"}},
  {"call": "engineer", "args": {"code": "from nx_mcp.kit import parts as kp\nservices.host._remember_model()  # the development tool's own undo mark is no engineer edit\np = [x for x in session.Parts if str(x.Leaf).lower().startswith('ms_front') and str(x.FullPath).lower().startswith(r'$run'.lower())][0]\nkp.show(NXOpen, session.Parts, p)\nresult = p.Leaf"}, "intent": "Acceptance: the engineer looks at ms_front.prt (a tab click, no edit): it is the displayed part whatever NX showed before (engineer tab guard)", "expect": {"ok": true, "data.noticed": false}},
  {"call": "nx_create_primitive", "setup": true, "save": "fblk", "args": {"shape": "block", "length": 40, "width": 20, "height": 10}},
  {"call": "nx_create_part", "setup": true, "save": "back", "args": {"path": "$run/ms/ms_back.prt", "units": "mm", "display": false}},

  {"call": "nx_create_primitive", "save": "bblk", "args": {"shape": "block", "length": 30, "width": 30, "height": 5, "part": "ms_back"},
   "intent": "Acceptance: a model call on the background part runs there (quiet work part)",
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 4500, "tol": 1e-06},
              "part.file": "ms_back.prt", "part.from": "part"}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "intent": "Acceptance: the display and the work part never moved",
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}},
              "page.total": 2}},
  {"call": "nx_list_parts", "args": {"modified": true, "path_prefix": "$run/ms/ms_back"},
   "expect": {"data.items.0.display": false, "data.items.0.work": false}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$fblk.data.bodies.0.id"]},
   "intent": "Acceptance: the displayed part kept its own body",
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}, "part.file": "ms_front.prt"}},
  {"call": "nx_find_geometry", "save": "bedge", "args": {"part": "ms_back", "kind": "edge", "geometry_type": "line", "near": [30, 15, 5], "order": "nearest", "limit": 1},
   "intent": "Acceptance: a read of the background part (bound, no switch)",
   "expect": {"ok": true, "data.items": {"count": 1}, "part.file": "ms_back.prt"}},
  {"call": "nx_create_blend", "save": "blend", "args": {"edges": ["$bedge.data.items.0.id"], "radius": 2},
   "intent": "Acceptance: a ref-pinned blend on the background part runs there without part",
   "expect": {"mutation_outcome": "committed", "part.file": "ms_back.prt", "part.from": "refs"}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$bblk.data.bodies.0.id"]},
   "intent": "Acceptance: the blend removed (1 - pi/4) r^2 L = 120 - 30 pi from the back block",
   "expect": {"data.volume": {"close": 4474.2478, "tol": 0.001}, "part.file": "ms_back.prt"}},
  {"call": "nx_find_geometry", "save": "bedge2", "args": {"part": "ms_back", "kind": "edge", "geometry_type": "line", "near": [0, 15, 5], "order": "nearest", "limit": 1}},
  {"call": "nx_create_blend", "args": {"edges": ["$bedge2.data.items.0.id"], "radius": 200},
   "intent": "Acceptance: a failing call on the background part rolls back",
   "expect": {"ok": false, "error.code": "NX_BUILD_FAILED", "mutation_outcome": "rolled_back", "part.file": "ms_back.prt"}},
  {"call": "nx_list_parts", "args": {},
   "intent": "Acceptance: after the failure the display and work part are intact",
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$bblk.data.bodies.0.id"]},
   "expect": {"data.volume": {"close": 4474.2478, "tol": 0.001}}},

  {"call": "nx_create_drawing_sheet", "save": "sheet", "args": {"part": "ms_back", "name": "MS1", "size": "a3", "units": "mm", "projection": "first_angle"},
   "intent": "Acceptance: a drawing call on the background part switches the display and comes back",
   "expect": {"mutation_outcome": "committed", "part.file": "ms_back.prt"}},
  {"call": "nx_list_parts", "args": {},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_create_drawing_view", "save": "view", "args": {"type": "base", "sheet": "$sheet.data.sheet.id", "orientation": "top"},
   "intent": "Acceptance: a view on the background part's sheet (the sheet pins the part)",
   "expect": {"mutation_outcome": "committed", "part.file": "ms_back.prt", "part.from": "refs"}},
  {"call": "nx_list_parts", "args": {},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_create_primitive", "args": {"shape": "block", "length": 5, "width": 5, "height": 5, "origin": [50, 0, 0], "part": "ms_back"},
   "intent": "Acceptance: a background model call on a part with drawing views commits; its view refresh waits",
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 125, "tol": 1e-06},
              "warnings.0.code": "NX_NOTE", "warnings.0.message": {"matches": "^ms_back[.]prt is not displayed"}}},
  {"call": "nx_capture_view", "args": {"part": "ms_back", "path": "$run/ms/ms_back.png", "fit": true, "width": 400, "height": 300},
   "intent": "Acceptance: a capture of the background part shows what its own NX tab shows: its open sheet MS1",
   "expect": {"ok": true, "part.file": "ms_back.prt", "data.image.mime_type": "image/png", "data.sheet.name": "MS1"}},
  {"call": "nx_list_parts", "args": {},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_create_primitive", "args": {"shape": "block", "length": 10, "width": 10, "height": 10, "origin": [0, 0, 10], "part": "ms_front"},
   "intent": "Acceptance: the displayed part still takes its own calls",
   "expect": {"mutation_outcome": "committed", "part.file": "ms_front.prt"}},

  {"call": "nx_create_part", "setup": true, "save": "smp", "args": {"path": "$run/ms/ms_sheet.prt", "units": "mm", "display": false}},
  {"call": "nx_create_sketch", "save": "smsk", "args": {"part": "ms_sheet", "placement": {"principal": "xy"}, "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [100, 80]}], "finish": true},
   "intent": "Acceptance: a sketch in a background part",
   "expect": {"mutation_outcome": "committed", "part.file": "ms_sheet.prt", "data.active": false}},
  {"call": "nx_create_sheet_metal_feature", "save": "tab", "args": {"operation": "tab", "parameters": {"section": "$smsk.data.sketch.id", "thickness": 2}},
   "intent": "Acceptance: a sheet-metal feature on a background part from a Modeling display: Sheet Metal entered there, no dialog",
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 16000, "tol": 1e-06}, "part.file": "ms_sheet.prt"}},
  {"call": "nx_list_parts", "args": {},
   "expect": {"data.items": {"contains": {"part": {"id": "$front.data.part.id"}, "display": true, "work": true}}}},
  {"call": "nx_activate_application", "args": {"application": "modeling", "part": "ms_front"},
   "intent": "Acceptance: the displayed part is back in Modeling (the application was restored)",
   "expect": {"data.previous": "modeling", "data.changed": false}},
  {"call": "nx_get_sheet_metal", "args": {"part": "ms_sheet"},
   "expect": {"ok": true, "part.file": "ms_sheet.prt"}},
  {"call": "nx_create_primitive", "args": {"shape": "block", "length": 5, "width": 5, "height": 5, "origin": [0, 0, 20], "part": "ms_sheet"},
   "intent": "Acceptance: a Modeling call in the sheet-metal part while the display runs Modeling (quiet, no dialog)",
   "expect": {"mutation_outcome": "committed", "part.file": "ms_sheet.prt"}}
 ]
}
