{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "a", "args": {"path": "$run/hu/hu_a.prt", "units": "mm"}},
  {"call": "nx_create_part", "setup": true, "save": "b", "args": {"path": "$run/hu/hu_b.prt", "units": "mm", "display": false}},

  {"call": "nx_create_primitive", "save": "a1", "args": {"part": "hu_a", "shape": "block", "length": 40, "width": 20, "height": 10},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_create_checkpoint", "save": "cp", "args": {"part": "hu_a", "label": "hu start"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_find_geometry", "save": "aedge", "args": {"part": "hu_a", "kind": "edge", "geometry_type": "line", "near": [40, 10, 10], "order": "nearest", "limit": 1}},
  {"call": "nx_create_blend", "save": "ablend", "args": {"edges": ["$aedge.data.items.0.id"], "radius": 2},
   "expect": {"mutation_outcome": "committed", "part.file": "hu_a.prt"}},
  {"call": "nx_create_primitive", "save": "b1", "args": {"part": "hu_b", "shape": "block", "length": 30, "width": 30, "height": 5},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 4500, "tol": 1e-06}}},
  {"call": "nx_list_checkpoints", "args": {"part": "hu_a"},
   "intent": "Acceptance: a blend consumes edges but is undone by deleting it: the checkpoint is restorable by compensation",
   "expect": {"data.checkpoints": {"contains": {"label": "hu start", "part": "hu_a.prt", "available": true, "compensated": true, "restorable": true}},
              "data.undo_depth": 2, "data.last_operation": "$ablend.operation_id"}},
  {"call": "nx_undo_operation", "args": {"part": "hu_a"},
   "intent": "Acceptance: the blend is undone across B's later block by deleting it; the consumed edge comes back",
   "expect": {"mutation_outcome": "committed", "data.compensated": true, "data.undone": ["$ablend.operation_id"],
              "changes.deleted": {"contains": {"kind": "feature"}}}},
  {"call": "nx_measure_mass", "args": {"part": "hu_a", "scope": "part"},
   "intent": "Acceptance: the block is whole again (40 x 20 x 10)",
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_measure_mass", "args": {"part": "hu_b", "scope": "part"},
   "expect": {"data.volume": {"close": 4500, "tol": 1e-06}}},

  {"call": "nx_create_primitive", "setup": true, "save": "atmp", "args": {"part": "hu_a", "shape": "block", "length": 5, "width": 5, "height": 5, "origin": [100, 0, 0]}},
  {"call": "nx_delete_objects", "save": "adel", "args": {"part": "hu_a", "objects": ["$atmp.data.feature.id"]},
   "intent": "Acceptance: a delete with another part loaded says it is undone only until another part changes",
   "expect": {"mutation_outcome": "committed", "warnings": {"contains": {"code": "NX_NOTE"}}}},
  {"call": "nx_create_primitive", "save": "b2", "args": {"part": "hu_b", "shape": "block", "length": 5, "width": 5, "height": 5, "origin": [40, 0, 0]},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_list_checkpoints", "args": {"part": "hu_a"},
   "intent": "Acceptance: after B's later work the delete blocks a restore, and the listing says so",
   "expect": {"data.checkpoints": {"contains": {"label": "hu start", "available": true, "compensated": true, "restorable": false}},
              "data.checkpoints.0.blocked_by.operation_id": "$adel.operation_id",
              "data.undo_depth": 0, "data.last_operation": null,
              "data.undo_blocked_by.operation_id": "$adel.operation_id"}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "$cp.data.checkpoint_id"},
   "intent": "Acceptance: the restore is refused with retry never and a short summary of the work in the way",
   "expect": {"ok": false, "error.code": "NX_CROSS_PART", "error.retry": "never", "mutation_outcome": "not_started",
              "error.message": {"matches": "later operation[s]? in 1 other part"}}},
  {"call": "nx_undo_operation", "args": {"part": "hu_a", "steps": 50},
   "intent": "Acceptance: too many steps names the operation that stops the undo, not an engineer edit",
   "expect": {"ok": false, "error.code": "NX_INVALID_ARGUMENT", "error.field": "/steps",
              "error.message": {"matches": "nx_delete_objects"}}},
  {"call": "nx_create_checkpoint", "args": {"part": "hu_a", "label": ""},
   "intent": "Acceptance: an empty label is refused with a plain rule",
   "expect": {"ok": false, "error.field": "/label", "error.message": {"matches": "1-80 characters"}, "mutation_outcome": "not_started"}},

  {"call": "nx_create_part", "setup": true, "save": "c", "args": {"path": "$run/hu/hu_c.prt", "units": "mm", "display": false}},
  {"call": "nx_create_primitive", "save": "c1", "args": {"part": "hu_c", "shape": "block", "length": 10, "width": 10, "height": 10},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 1000, "tol": 1e-06}}},
  {"call": "nx_set_name", "save": "cname", "args": {"object": "$c1.data.feature.id", "name": "HU_BLOCK"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_undo_operation", "args": {"part": "hu_c", "steps": 2},
   "expect": {"mutation_outcome": "committed", "data.undone": ["$c1.operation_id", "$cname.operation_id"]}},
  {"call": "nx_redo_operation", "args": {"part": "hu_c", "steps": 2},
   "intent": "Acceptance: the rename's ref to the block's feature is remapped to the feature the redone block made",
   "expect": {"mutation_outcome": "committed", "data.redone": ["$c1.operation_id", "$cname.operation_id"],
              "data.results.0.run_as": "$c1.operation_id", "data.results.1.run_as": {"matches": "-redo1$"},
              "data.redo_depth": 0}},
  {"call": "nx_list_objects", "args": {"part": "hu_c", "kind": "feature", "name_contains": "HU_BLOCK"},
   "expect": {"data.items": {"count": 1}}},

  {"call": "nx_preview_changes", "save": "pv", "args": {"part": "hu_c", "operations": [
    {"tool": "nx_create_primitive", "arguments": {"shape": "block", "length": 5, "width": 5, "height": 5, "origin": [20, 0, 0]}}]},
   "expect": {"ok": true, "data.delta.bodies": 1}},
  {"call": "nx_finish_preview", "save": "acc", "args": {"preview_id": "$pv.data.preview_id", "action": "accept"},
   "expect": {"mutation_outcome": "committed", "data.state": "applied"}},
  {"call": "nx_undo_operation", "args": {"part": "hu_c"},
   "intent": "Acceptance: an undone accept offers its previewed call as the redo step",
   "expect": {"mutation_outcome": "committed", "data.undone": ["$acc.operation_id"], "data.redo.0.tool": "nx_create_primitive"}},
  {"call": "nx_redo_operation", "args": {"part": "hu_c"},
   "intent": "Acceptance: the redo runs the previewed call again (never the consumed preview)",
   "expect": {"mutation_outcome": "committed", "data.redone": ["$acc.operation_id"], "data.results.0.run_as": {"matches": "-redo1$"}}},
  {"call": "nx_measure_mass", "args": {"part": "hu_c", "scope": "part"},
   "expect": {"data.volume": {"close": 1125, "tol": 1e-06}}},
  {"call": "nx_undo_operation", "args": {"part": "hu_c"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_redo_operation", "args": {"part": "hu_c", "steps": 0, "skip": 1},
   "intent": "Acceptance: skip drops the next undone call without running it",
   "expect": {"mutation_outcome": "not_applicable", "data.skipped": {"count": 1}, "data.redo_depth": 0}},
  {"call": "nx_measure_mass", "args": {"part": "hu_c", "scope": "part"},
   "expect": {"data.volume": {"close": 1000, "tol": 1e-06}}},

  {"call": "nx_set_expression", "save": "ex", "args": {"part": "hu_c", "name": "hu_unused", "formula": "12", "units": "mm"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_delete_objects", "args": {"part": "hu_c", "objects": ["$ex.data.expression.id"]},
   "intent": "Acceptance: an unused user expression can be deleted",
   "expect": {"mutation_outcome": "committed", "data.deleted": {"count": 1}}},
  {"call": "nx_list_objects", "args": {"part": "hu_c", "kind": "expression", "name_contains": "hu_unused"},
   "expect": {"data.items": {"count": 0}}},
  {"call": "nx_create_sketch", "save": "sk", "args": {"part": "hu_c", "placement": {"principal": "xy"}, "name": "HU_SK"}},
  {"call": "nx_finish_sketch", "save": "skf", "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_delete_objects", "args": {"part": "hu_c", "objects": ["$sk.data.sketch.id", "$skf.data.feature.id"]},
   "intent": "Acceptance: a sketch listed with its own feature is deleted once, through the feature",
   "expect": {"mutation_outcome": "committed", "data.deleted": {"count": 2}}},
  {"call": "nx_list_objects", "args": {"part": "hu_c", "kind": "sketch"},
   "expect": {"data.items": {"count": 0}}}
 ]
}
