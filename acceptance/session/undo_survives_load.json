{
 "covers": {
  "nx_undo_operation": [],
  "nx_create_checkpoint": [],
  "nx_list_checkpoints": [],
  "nx_restore_checkpoint": []
 },
 "part": "new",
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "c", "args": {"path": "$run/usl/usl_c.prt", "display": false}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "$c.data.part.id"}},
  {"call": "nx_close_part", "setup": true, "args": {"part": "$c.data.part.id", "save": false}},
  {"call": "nx_create_part", "setup": true, "save": "a", "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "a1",
   "args": {"shape": "block", "length": 40, "width": 20, "height": 10}},
  {"call": "nx_create_checkpoint", "save": "u", "args": {"label": "usl before loads"},
   "expect": {"mutation_outcome": "committed", "data.undo_depth": 1}},

  {"call": "nx_create_part", "save": "b", "args": {"path": "$run/usl/usl_b.prt", "display": false},
   "intent": "Acceptance: another part is created without display: the work part and NX's undo marks stay",
   "expect": {"mutation_outcome": "committed", "data.work": false, "data.display": false,
              "warnings": {"count": 1}, "warnings.0.code": "NX_NOTE",
              "warnings.0.message": "2 parts are loaded: calls without refs now take part"}},
  {"call": "nx_open_part", "save": "copen", "args": {"path": "$run/usl/usl_c.prt", "work": false, "display": false},
   "intent": "Acceptance: a saved part is opened without display",
   "expect": {"mutation_outcome": "committed", "data.already_loaded": false, "data.work": false,
              "data.display": false}},
  {"call": "nx_list_checkpoints", "args": {},
   "intent": "Acceptance: the checkpoint's mark survived both loads; restoring it would unload them",
   "expect": {"data.checkpoints": {"contains": {"label": "usl before loads", "available": false,
                                                "expired_reason": "part_loaded"}},
              "data.undo_depth": 0}},

  {"call": "nx_create_primitive", "save": "a2", "args": {"part": "$part", "shape": "block", "length": 10, "width": 10, "height": 10,
                                                         "origin": [0, 0, 10]},
   "intent": "Acceptance: the work part is still A",
   "expect": {"mutation_outcome": "committed", "part.file": {"matches": "^session_undo_survives_load"}}},
  {"call": "nx_activate_part", "args": {"part": "$b.data.part.id"},
   "expect": {"mutation_outcome": "committed", "data.display": true}},
  {"call": "nx_activate_part", "args": {"part": "$a.data.part.id"},
   "intent": "Acceptance: B was displayed for the first time after A's operations; the marks stay",
   "expect": {"mutation_outcome": "committed", "data.display": true}},
  {"call": "nx_create_checkpoint", "save": "v", "args": {"part": "$part", "label": "usl after loads"},
   "expect": {"mutation_outcome": "committed", "data.undo_depth": 1}},
  {"call": "nx_create_primitive", "save": "a3", "args": {"part": "$part", "shape": "block", "length": 10, "width": 10, "height": 10,
                                                         "origin": [30, 0, 10]},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_list_checkpoints", "args": {},
   "expect": {"data.checkpoints": {"contains": {"label": "usl after loads", "available": true, "operations_after": 1}},
              "data.undo_depth": 2}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "$v.data.checkpoint_id"},
   "intent": "Acceptance: restore after other parts loaded and were displayed (redteam live4 inverse)",
   "expect": {"mutation_outcome": "committed", "data.reverted": {"count": 1}}},
  {"call": "nx_undo_operation", "args": {"part": "$part"},
   "intent": "Acceptance: undo in A after B was created and C opened",
   "expect": {"mutation_outcome": "committed", "data.undone_operation_id": "$a2.operation_id",
              "data.undo_depth": 0}},
  {"call": "nx_undo_operation", "args": {"part": "$part"},
   "intent": "Acceptance: the history ends at the loads: undoing across them would unload B and C",
   "expect": {"ok": false, "error.code": "NX_NOT_FOUND", "mutation_outcome": "not_started",
              "error.details.reason": "part_loaded",
              "error.message": {"matches": "usl_c\\.prt was loaded after it \\(nx_open_part\\)"}}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "$u.data.checkpoint_id"},
   "expect": {"ok": false, "error.code": "NX_STALE_CHECKPOINT", "mutation_outcome": "not_started",
              "error.message": {"matches": "usl_b\\.prt was loaded after it .*would unload it"}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run"},
   "intent": "Acceptance: nothing was unloaded",
   "expect": {"page.total": 3}},
  {"call": "nx_list_objects", "save": "bodies", "args": {"part": "$part", "kind": "body"},
   "expect": {"data.items": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$bodies.data.items.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}}
 ]
}
