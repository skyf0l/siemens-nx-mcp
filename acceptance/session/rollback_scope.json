{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "a", "args": {"path": "$run/rs/rs_a.prt", "units": "mm"}},
  {"call": "nx_create_part", "setup": true, "save": "b", "args": {"path": "$run/rs/rs_b.prt", "units": "mm", "display": false}},
  {"call": "nx_create_primitive", "save": "a1", "args": {"part": "rs_a", "shape": "block", "length": 40, "width": 20, "height": 10},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_create_datum_csys", "save": "dc", "args": {"part": "rs_a", "origin": [0, 0, 20], "x_axis": [1, 0, 0], "y_axis": [0, 1, 0]},
   "expect": {"mutation_outcome": "committed", "data.origin": {"close": [0, 0, 20], "tol": 1e-06}}},
  {"call": "nx_create_primitive", "save": "b1", "args": {"part": "rs_b", "shape": "block", "length": 30, "width": 30, "height": 5},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 4500, "tol": 1e-06}}},
  {"call": "nx_find_geometry", "setup": true, "save": "e", "args": {"owner": "$a1.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [0, 10, 0], "limit": 1}},

  {"call": "nx_create_blend", "args": {"edges": ["$e.data.items.0.id"], "radius": 50},
   "intent": "Acceptance: a blend NX cannot build is rolled back; no ref of the part or of another part changes",
   "expect": {"ok": false, "error.category": "geometry_failed", "mutation_outcome": "rolled_back",
              "changes.references": "preserved", "part.file": "rs_a.prt"}},
  {"call": "nx_list_objects", "args": {"part": "rs_a", "kind": "datum"},
   "intent": "Acceptance: the datum CSYS keeps its ref through the rollback",
   "expect": {"data.items": {"contains": {"id": "$dc.data.datum_csys.id"}}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$a1.data.bodies.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$b1.data.bodies.0.id"]},
   "intent": "Acceptance: the other part's refs are untouched by the rollback",
   "expect": {"data.volume": {"close": 4500, "tol": 1e-06}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/rs"},
   "intent": "Acceptance: part refs are never re-issued by a failed call",
   "expect": {"page.total": 2,
              "data.items": {"contains": {"part": {"id": "$a.data.part.id"}}}}},
  {"call": "nx_list_parts", "args": {"path_prefix": "$run/rs"},
   "expect": {"data.items": {"contains": {"part": {"id": "$b.data.part.id"}}}}},

  {"call": "nx_create_primitive", "save": "a2", "args": {"part": "rs_a", "shape": "block", "length": 10, "width": 10, "height": 10, "origin": [60, 0, 0]},
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 1000, "tol": 1e-06}}},
  {"call": "nx_undo_operation", "args": {"part": "rs_a"},
   "expect": {"mutation_outcome": "committed", "data.undone": ["$a2.operation_id"], "data.redo_depth": 1}},
  {"call": "nx_redo_operation", "args": {"part": "rs_b"},
   "intent": "Acceptance: another part's pending redo never decides this call's part",
   "expect": {"ok": false, "error.code": "NX_NOT_FOUND", "mutation_outcome": "not_started",
              "error.message": {"matches": "rs_b[.]prt"}, "part.file": "rs_b.prt", "error.details.redo_depth": 0}},
  {"call": "nx_list_objects", "args": {"part": "rs_a", "kind": "body"},
   "intent": "Acceptance: rs_a's undone block was not redone",
   "expect": {"page.total": 1}},
  {"call": "nx_redo_operation", "args": {"part": "rs_a"},
   "expect": {"mutation_outcome": "committed", "data.redone": ["$a2.operation_id"], "data.redo_depth": 0, "part.file": "rs_a.prt"}},
  {"call": "nx_list_objects", "args": {"part": "rs_a", "kind": "body"},
   "expect": {"page.total": 2}}
 ]
}
