{
 "covers": {
  "nx_run_batch": []
 },
 "part": "new",
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {
   "call": "nx_run_batch",
   "save": "b1",
   "args": {"operations": [
    {"tool": "nx_create_sketch", "arguments": {"placement": {"principal": "xy"}, "name": "BATCH_SK"}}
   ]},
   "expect": {
    "mutation_outcome": "committed",
    "data.count": 1,
    "data.results.0.index": 0,
    "data.results.0.tool": "nx_create_sketch",
    "data.results.0.data.active": true
   }
  },
  {
   "call": "nx_run_batch",
   "save": "b2",
   "args": {"operations": [
    {"tool": "nx_create_sketch_curves", "arguments": {
     "sketch": "$b1.data.results.0.data.sketch.id",
     "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
    {"tool": "nx_create_sketch_curves", "arguments": {
     "sketch": "$b1.data.results.0.data.sketch.id",
     "curves": [{"type": "circle", "center": [20, 10], "radius": 5}]}},
    {"tool": "nx_finish_sketch", "arguments": {"sketch": "$b1.data.results.0.data.sketch.id"}}
   ]},
   "expect": {
    "mutation_outcome": "committed",
    "data.count": 3,
    "data.results.0.data.curves": {"count": 4},
    "data.results.1.data.curves": {"count": 1},
    "data.results.2.data.curve_count": 5,
    "data.results.2.data.was_active": true,
    "units.length": "mm"
   }
  },
  {
   "call": "nx_create_extrude",
   "save": "ex",
   "args": {"sketch": "$b1.data.results.0.data.sketch.id", "end": {"type": "distance", "value": 10}},
   "expect": {
    "mutation_outcome": "committed",
    "data.volume": {"close": 7214.601837, "tol": 1e-3},
    "data.bodies": {"count": 1}
   }
  },
  {
   "call": "nx_run_batch",
   "intent": "Acceptance: the second step names a body as its sketch, so the whole batch rolls back",
   "args": {"operations": [
    {"tool": "nx_create_sketch", "arguments": {"placement": {"principal": "xz"}, "name": "BATCH_UNDONE"}},
    {"tool": "nx_create_sketch_curves", "arguments": {
     "sketch": "$ex.data.bodies.0.id",
     "curves": [{"type": "line", "start": [0, 0], "end": [10, 0]}]}}
   ]},
   "expect": {
    "ok": false,
    "error.category": "wrong_kind",
    "error.details.child_index": 1,
    "error.details.child_tool": "nx_create_sketch_curves",
    "mutation_outcome": "rolled_back"
   }
  },
  {
   "call": "nx_run_batch",
   "intent": "Acceptance: a heavy feature is not batchable; refused before any step runs",
   "args": {"operations": [
    {"tool": "nx_create_sketch", "arguments": {"placement": {"principal": "yz"}, "name": "BATCH_NEVER"}},
    {"tool": "nx_create_extrude", "arguments": {
     "sketch": "$b1.data.results.0.data.sketch.id", "end": {"type": "distance", "value": 5}}}
   ]},
   "expect": {
    "ok": false,
    "error.code": "NX_UNSUPPORTED_OPTION",
    "error.field": "/operations/1/tool",
    "error.details.child_index": 1,
    "mutation_outcome": "not_started"
   }
  },
  {
   "call": "nx_list_objects",
   "args": {"kind": "sketch"},
   "expect": {"page.total": 1, "data.items.0.name": "BATCH_SK"}
  },
  {
   "call": "nx_measure_mass",
   "args": {"scope": "part"},
   "expect": {"data.volume": {"close": 7214.601837, "tol": 1e-3}}
  }
 ]
}
