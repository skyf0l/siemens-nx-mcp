{
 "covers": {
  "nx_create_checkpoint": [],
  "nx_list_checkpoints": [],
  "nx_restore_checkpoint": [],
  "nx_undo_operation": [],
  "nx_set_name": []
 },
 "part": "new",
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true,
   "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "save": "blk",
   "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$blk.data.bodies.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},

  {"call": "nx_create_checkpoint", "save": "cp", "args": {"label": "acc-history-block"},
   "intent": "Acceptance: checkpoint before two blends",
   "expect": {"mutation_outcome": "committed", "data.label": "acc-history-block",
              "data.checkpoint_id": {"matches": "^cp_[0-9a-f]{32}$"}}},
  {"call": "nx_find_geometry", "setup": true, "save": "e1",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [20, 0, 10], "limit": 1}},
  {"call": "nx_create_blend", "save": "bl1", "args": {"edges": ["$e1.data.items.0.id"], "radius": 2},
   "expect": {"data.volume": {"close": 7965.663706143591, "tol": 1e-06}}},
  {"call": "nx_find_geometry", "setup": true, "save": "e2",
   "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [20, 20, 10], "limit": 1}},
  {"call": "nx_create_blend", "save": "bl2", "args": {"edges": ["$e2.data.items.0.id"], "radius": 2},
   "expect": {"data.volume": {"close": 7931.327412287183, "tol": 1e-06}}},
  {"call": "nx_list_checkpoints", "args": {},
   "expect": {"data.checkpoints": {"contains": {"label": "acc-history-block", "available": true, "operations_after": 2}},
              "data.last_operation": {"matches": "."}}},

  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "$cp.data.checkpoint_id"},
   "intent": "Acceptance: restore the checkpoint; both blends go",
   "expect": {"mutation_outcome": "committed", "data.reverted": {"count": 2},
              "data.label": "acc-history-block", "changes.references": "listed"}},
  {"call": "nx_list_objects", "save": "bodies", "args": {"kind": "body"}, "expect": {"data.items": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$bodies.data.items.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_get_feature", "args": {"feature": "$bl1.data.feature.id"},
   "expect": {"error.code": "NX_STALE_REFERENCE"}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "$cp.data.checkpoint_id"},
   "intent": "Acceptance: a restored checkpoint stays available; nothing left to revert",
   "expect": {"mutation_outcome": "not_applicable", "data.reverted": {"count": 0}}},
  {"call": "nx_list_objects", "save": "bodies", "args": {"kind": "body"}, "expect": {"data.items": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$bodies.data.items.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},

  {"call": "nx_find_geometry", "setup": true, "save": "e3",
   "args": {"owner": "$bodies.data.items.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [20, 0, 10], "limit": 1}},
  {"call": "nx_create_blend", "save": "bl3", "args": {"edges": ["$e3.data.items.0.id"], "radius": 2},
   "expect": {"data.volume": {"close": 7965.663706143591, "tol": 1e-06}}},
  {"call": "nx_undo_operation", "save": "un", "args": {},
   "intent": "Acceptance: undo the agent's last blend",
   "expect": {"mutation_outcome": "committed", "data.tool": "nx_create_blend",
              "data.undone": {"count": 1},
              "data.references": "listed", "changes.references": "listed",
              "data.redo": {"count": 1}, "data.redo.0.tool": "nx_create_blend",
              "data.redo.0.arguments.radius": 2, "data.redo.0.arguments.edges": {"count": 1},
              "data.redo.0.complete": true}},
  {"call": "nx_get_feature", "args": {"feature": "$bl3.data.feature.id"},
   "expect": {"error.code": "NX_STALE_REFERENCE"}},
  {"call": "nx_list_objects", "save": "bodies2", "args": {"kind": "body"}, "expect": {"data.items": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$bodies2.data.items.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_create_blend", "args": "$un.data.redo.0.arguments",
   "intent": "Acceptance: repeating the undo result's redo call restores the blend",
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 7965.663706143591, "tol": 1e-06}}},
  {"call": "nx_undo_operation", "args": {},
   "expect": {"mutation_outcome": "committed", "data.tool": "nx_create_blend"}},

  {"call": "nx_list_objects", "setup": true, "save": "feats", "args": {"kind": "feature", "name_contains": "EXTRUDE"}},
  {"call": "nx_set_name", "save": "named", "args": {"object": "$feats.data.items.0.id", "name": "ACC_BLOCK"},
   "intent": "Acceptance: rename the extrude",
   "expect": {"mutation_outcome": "committed", "data.requested": "ACC_BLOCK",
              "data.name": {"matches": "(?i)^acc_block$"}, "data.object.kind": "feature",
              "data.references": "preserved", "changes.references": "preserved"}},
  {"call": "nx_get_feature", "args": {"feature": "$named.data.object.id"},
   "expect": {"data.feature.name": {"matches": "(?i)^acc_block$"}}},
  {"call": "nx_get_feature", "args": {"feature": "$feats.data.items.0.id"},
   "intent": "Acceptance: the reference listed before the rename still works",
   "expect": {"data.feature.name": {"matches": "(?i)^acc_block$"}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$bodies2.data.items.0.id"]},
   "intent": "Acceptance: a rename leaves the part's other references valid",
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_set_name", "args": {"object": "$bodies2.data.items.0.id", "name": "acc body"},
   "expect": {"mutation_outcome": "committed", "data.requested": "acc body",
              "data.name": {"matches": "(?i)^acc body$"}, "data.object.kind": "body"}},
  {"call": "nx_set_name", "args": {"object": "$named.data.object.id", "name": ""},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.message": {"matches": "empty"},
              "mutation_outcome": "not_started"}},

  {"call": "nx_create_checkpoint", "save": "cpr", "args": {"label": "acc-history-retry"},
   "intent": "Acceptance: a checkpoint restored by its label, then by its id again",
   "expect": {"mutation_outcome": "committed", "data.label": "acc-history-retry"}},
  {"call": "nx_find_geometry", "setup": true, "save": "e4",
   "args": {"owner": "$bodies2.data.items.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [20, 0, 10], "limit": 1}},
  {"call": "nx_create_blend", "args": {"edges": ["$e4.data.items.0.id"], "radius": 2},
   "expect": {"data.volume": {"close": 7965.663706143591, "tol": 1e-06}}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "ACC-History-Retry"},
   "intent": "Acceptance: restore by label, case ignored",
   "expect": {"mutation_outcome": "committed", "data.label": "acc-history-retry",
              "data.checkpoint_id": {"matches": "^cp_[0-9a-f]{32}$"}, "data.reverted": {"count": 1}}},
  {"call": "nx_list_objects", "save": "b4", "args": {"kind": "body"}, "expect": {"data.items": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$b4.data.items.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_find_geometry", "setup": true, "save": "e5",
   "args": {"owner": "$b4.data.items.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [20, 0, 10], "limit": 1}},
  {"call": "nx_create_blend", "args": {"edges": ["$e5.data.items.0.id"], "radius": 2},
   "expect": {"data.volume": {"close": 7965.663706143591, "tol": 1e-06}}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "$cpr.data.checkpoint_id"},
   "intent": "Acceptance: the same checkpoint restores a second time",
   "expect": {"mutation_outcome": "committed", "data.reverted": {"count": 1}}},
  {"call": "nx_list_objects", "save": "b5", "args": {"kind": "body"}, "expect": {"data.items": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$b5.data.items.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_find_geometry", "setup": true, "save": "e6",
   "args": {"owner": "$b5.data.items.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [20, 0, 10], "limit": 1}},
  {"call": "nx_create_blend", "args": {"edges": ["$e6.data.items.0.id"], "radius": 2},
   "expect": {"data.volume": {"close": 7965.663706143591, "tol": 1e-06}}},
  {"call": "nx_create_checkpoint", "save": "cpl", "args": {"label": "acc-history-late"},
   "expect": {"mutation_outcome": "committed", "data.label": "acc-history-late"}},
  {"call": "nx_find_geometry", "setup": true, "save": "e7",
   "args": {"owner": "$b5.data.items.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [20, 20, 10], "limit": 1}},
  {"call": "nx_create_blend", "args": {"edges": ["$e7.data.items.0.id"], "radius": 2},
   "expect": {"data.volume": {"close": 7931.327412287183, "tol": 1e-06}}},
  {"call": "nx_undo_operation", "args": {"steps": 2},
   "intent": "Acceptance: undo the last two blends in one call",
   "expect": {"mutation_outcome": "committed", "data.undone": {"count": 2},
              "data.tool": "nx_create_blend", "changes.references": "listed"}},
  {"call": "nx_list_objects", "save": "b6", "args": {"kind": "body"}, "expect": {"data.items": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$b6.data.items.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}},
  {"call": "nx_list_checkpoints", "args": {"include_expired": true},
   "intent": "Acceptance: a checkpoint the undo went back past stays listed, expired",
   "expect": {"data.checkpoints": {"contains": {"label": "acc-history-late", "available": false,
                                                "expired_reason": "undone_past"}}}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "$cpl.data.checkpoint_id"},
   "expect": {"error.code": "NX_STALE_CHECKPOINT", "error.message": {"matches": "past"},
              "mutation_outcome": "not_started"}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "acc-no-such-checkpoint"},
   "expect": {"error.code": "NX_NOT_FOUND", "error.field": "/checkpoint_id",
              "error.details.checkpoints": {"contains": {"label": "acc-history-retry", "available": true}},
              "mutation_outcome": "not_started"}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "acc-history-retry"},
   "intent": "Acceptance: the earlier checkpoint survived the undo",
   "expect": {"mutation_outcome": "not_applicable", "data.reverted": {"count": 0}}},

  {"call": "nx_create_checkpoint", "save": "cp2", "args": {"label": "acc-history-saved"},
   "expect": {"mutation_outcome": "committed"}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_list_checkpoints", "args": {"include_expired": true},
   "intent": "Acceptance: a save expires checkpoints",
   "expect": {"data.checkpoints": {"contains": {"label": "acc-history-saved", "available": false,
                                                "expired_reason": "saved_or_closed"}},
              "data.undo_depth": 0, "data.last_operation": null}},
  {"call": "nx_restore_checkpoint", "args": {"checkpoint_id": "$cp2.data.checkpoint_id"},
   "expect": {"error.code": "NX_STALE_CHECKPOINT", "error.message": {"matches": "save"},
              "mutation_outcome": "not_started"}},
  {"call": "nx_undo_operation", "args": {},
   "expect": {"error.code": "NX_NOT_FOUND", "error.retry": "never", "mutation_outcome": "not_started"}},
  {"call": "nx_list_objects", "save": "bodies3", "args": {"kind": "body"}, "expect": {"data.items": {"count": 1}}},
  {"call": "nx_measure_mass", "args": {"bodies": ["$bodies3.data.items.0.id"]},
   "expect": {"data.volume": {"close": 8000, "tol": 1e-06}}}
 ]
}
