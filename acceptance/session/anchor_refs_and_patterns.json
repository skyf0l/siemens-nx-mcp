{
  "covers": {},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s",
     "args": {"placement": {"principal": "xy"},
              "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [10, 10]}], "finish": true}},
    {"call": "nx_create_extrude", "setup": true, "save": "blk",
     "args": {"sketch": "$s.data.sketch.id", "end": {"type": "distance", "value": 10}},
     "expect": {"data.volume": {"close": 1000, "tol": 1e-06}}},
    {"call": "nx_measure_mass", "args": {"bodies": ["$blk.data.bodies.0.anchor"]},
     "intent": "Acceptance: a body's anchor from a result row is accepted where a body ref is",
     "expect": {"ok": true, "data.volume": {"close": 1000, "tol": 1e-06}}},
    {"call": "nx_get_feature", "args": {"feature": "$blk.data.feature.anchor"},
     "intent": "Acceptance: a feature's anchor resolves like its ref",
     "expect": {"ok": true, "data.feature.id": {"matches": "^f:"}}},
    {"call": "nx_create_pattern", "save": "pf",
     "args": {"features": ["$blk.data.feature.id"], "layout": "linear",
              "parameters": {"direction": "x", "count": 3, "spacing": 20}},
     "expect": {"mutation_outcome": "committed", "data.new_bodies": 2}},
    {"call": "nx_measure_mass", "args": {"bodies": ["$pf.data.feature.id"]},
     "intent": "Acceptance: a Pattern Feature passed as bodies measures the copies it made",
     "expect": {"ok": true, "data.volume": {"close": 2000, "tol": 1e-06}}},
    {"call": "nx_list_objects", "save": "lb", "args": {"kind": "body"},
     "expect": {"page.total": 3}},
    {"call": "nx_measure_mass", "args": {"bodies": ["$lb.data.items.2.anchor"]},
     "intent": "Acceptance: the anchor of a pattern copy (its journal id holds ':') resolves",
     "expect": {"ok": true, "data.volume": {"close": 1000, "tol": 1e-06}}},
    {"call": "nx_measure_mass", "args": {"bodies": ["$s.data.feature.id"]},
     "intent": "Acceptance: a feature without bodies is refused naming it",
     "expect": {"error.code": "NX_NOT_FOUND", "error.message": {"matches": "has no bodies"}}},
    {"call": "nx_run_batch",
     "args": {"operations": [{"tool": "nx_create_sketch_curves",
                              "arguments": {"sketch": "s:PLACEHOLDER",
                                            "curves": [{"type": "line", "start": [0, 0], "end": [5, 0]}]}}]},
     "intent": "Acceptance: a malformed batch step is refused by the sidecar before NX",
     "expect": {"mutation_outcome": "not_started", "error.code": "NX_INVALID_ARGUMENT",
                "error.field": "/operations/0/arguments/sketch"}}
  ]
}
