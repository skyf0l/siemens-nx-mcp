{
 "covers": {},
 "part": null,
 "fixture": null,
 "steps": [
  {"call": "nx_create_part", "setup": true, "save": "cover", "args": {"path": "$run/mp/mp_cover_p0.prt", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "blkc", "args": {"shape": "block", "length": 40, "width": 20, "height": 10}},
  {"call": "nx_create_part", "setup": true, "save": "plate", "args": {"path": "$run/mp/mp_plate_p0.prt", "units": "mm"}},

  {"call": "nx_create_primitive", "save": "blkp", "args": {"shape": "block", "length": 30, "width": 30, "height": 5},
   "intent": "Acceptance: solo mode, two top-level parts, no part key: the work part as before",
   "expect": {"mutation_outcome": "committed", "data.volume": {"close": 4500, "tol": 1e-06},
              "part.file": "mp_plate_p0.prt", "part.from": "work"}},
  {"call": "nx_get_feature", "args": {"feature": "$blkc.data.feature.id"},
   "intent": "Acceptance: solo mode, a ref of the other part behaves as before (the tool's own refusal)",
   "expect": {"ok": false, "error.code": "NX_WRONG_OWNER", "part.file": "mp_cover_p0.prt", "part.from": "refs"}},
  {"call": "nx_get_status", "args": {"include": ["parts"]},
   "expect": {"data.parts.top_level": 2, "data.parts.targeting.mode": "solo",
              "data.parts.targeting.parts": 0}},

  {"call": "nx_get_model_summary", "args": {"part": "mp_plate_p0"},
   "intent": "Acceptance: part by file name without .prt",
   "expect": {"ok": true, "part.file": "mp_plate_p0.prt", "part.from": "part", "part.id": "$plate.data.part.id"}},
  {"call": "nx_set_attributes", "save": "attr",
   "args": {"attributes": {"MP_P0": "plate"}, "part": "mp_plate_p0.prt"},
   "intent": "Acceptance: a change in the named work part",
   "expect": {"mutation_outcome": "committed", "part.file": "mp_plate_p0.prt", "part.from": "part"}},
  {"call": "nx_set_attributes",
   "args": {"attributes": {"MP_P0": "plate"}, "part": "mp_plate_p0.prt", "operation_id": "$attr.operation_id"},
   "intent": "Acceptance: the same call in the same part replays",
   "expect": {"mutation_outcome": "committed", "replayed": true}},
  {"call": "nx_set_attributes", "args": {"attributes": {"MP_P0": "cover"}, "part": "MP_COVER_P0"},
   "intent": "Acceptance: part names a part that is not the work part: refused, nothing switched",
   "expect": {"ok": false, "error.code": "NX_WRONG_PART_CONTEXT", "error.field": "/part",
              "mutation_outcome": "not_started", "part.file": "mp_cover_p0.prt",
              "error.message": {"matches": "work part is mp_plate_p0\\.prt"},
              "error.hint": {"matches": "nx_activate_part"}}},

  {"call": "nx_get_status", "args": {"include": ["parts"]},
   "intent": "Acceptance: two distinct parts named: multi-agent mode",
   "expect": {"data.parts.targeting.mode": "multi", "data.parts.targeting.parts": 2,
              "data.parts.targeting.forced": false}},
  {"call": "nx_create_primitive", "args": {"shape": "block", "length": 10, "width": 10, "height": 10},
   "intent": "Acceptance: multi-agent mode, no part key, no refs: ambiguous",
   "expect": {"ok": false, "error.code": "NX_AMBIGUOUS_PART", "mutation_outcome": "not_started",
              "error.hint": {"matches": "mp_cover_p0\\.prt.*mp_plate_p0\\.prt|mp_plate_p0\\.prt.*mp_cover_p0\\.prt"},
              "error.details.top_level": 2, "error.details.loaded_parts": {"count": 2}}},
  {"call": "nx_get_feature", "args": {"feature": "$blkc.data.feature.id"},
   "intent": "Acceptance: multi-agent mode, refs pin a part that is not the work part",
   "expect": {"ok": false, "error.code": "NX_WRONG_PART_CONTEXT", "error.field": "/feature",
              "part.file": "mp_cover_p0.prt", "part.from": "refs"}},
  {"call": "nx_get_feature", "args": {"feature": "$blkp.data.feature.id"},
   "intent": "Acceptance: refs of the work part pin it",
   "expect": {"ok": true, "part.file": "mp_plate_p0.prt", "part.from": "refs"}},
  {"call": "nx_get_model_summary", "args": {"part": "$plate.data.part.id"},
   "expect": {"ok": true, "part.from": "part", "part.file": "mp_plate_p0.prt"}},
  {"call": "nx_get_model_summary", "args": {"part": "$run/mp/mp_plate_p0.prt"},
   "expect": {"ok": true, "part.from": "part", "part.file": "mp_plate_p0.prt"}},
  {"call": "nx_set_feature_suppression",
   "args": {"features": ["$blkp.data.feature.id"], "suppressed": true, "part": "mp_cover_p0"},
   "intent": "Acceptance: part contradicts the refs",
   "expect": {"ok": false, "error.code": "NX_WRONG_PART_CONTEXT", "error.field": "/part",
              "mutation_outcome": "not_started",
              "error.hint": {"matches": "Drop part \\(the refs pick mp_plate_p0\\.prt\\)"}}},
  {"call": "nx_get_model_summary", "args": {"part": "mp_nothing"},
   "expect": {"ok": false, "error.code": "NX_NOT_FOUND", "error.field": "/part",
              "error.hint": {"matches": "mp_cover_p0\\.prt"}}},
  {"call": "nx_get_model_summary", "args": {"part": ""},
   "expect": {"ok": false, "error.code": "NX_INVALID_ARGUMENT", "error.field": "/part"}},
  {"call": "nx_get_model_summary", "args": {"part": 5},
   "expect": {"ok": false, "error.code": "NX_INVALID_ARGUMENT", "error.field": "/part"}},
  {"call": "nx_get_model_summary", "args": {"part": "C:/elsewhere/mp_plate_p0.prt"},
   "expect": {"ok": false, "error.code": "NX_PATH_OUTSIDE_WORKSPACE", "error.field": "/part"}},

  {"call": "nx_activate_part", "setup": true, "args": {"part": "$cover.data.part.id"}},
  {"call": "nx_set_attributes",
   "args": {"attributes": {"MP_P0": "plate"}, "part": "mp_cover_p0", "operation_id": "$attr.operation_id"},
   "intent": "Acceptance: the same operation_id and arguments in another part",
   "expect": {"ok": false, "error.code": "NX_IDEMPOTENCY_CONFLICT",
              "error.message": {"matches": "another part \\(mp_plate_p0\\.prt\\)"}}},
  {"call": "nx_set_attributes", "args": {"attributes": {"MP_P0": "ghost"}, "part": "mp_cover_p0", "expires_at": 1},
   "intent": "Acceptance: an expired call never runs",
   "expect": {"ok": false, "error.code": "NX_CALL_EXPIRED", "mutation_outcome": "not_started"}},
  {"call": "nx_set_attributes",
   "args": {"attributes": {"MP_P0": "ghost"}, "part": "mp_cover_p0", "expires_at": "2000-01-01T00:00:00Z"},
   "expect": {"ok": false, "error.code": "NX_CALL_EXPIRED", "mutation_outcome": "not_started"}},
  {"call": "nx_get_attributes", "args": {"names": ["MP_P0"], "part": "mp_cover_p0", "expires_at": 1},
   "intent": "Acceptance: an expired read still answers; the ghost calls changed nothing",
   "expect": {"ok": true, "data.items.0.attributes": {"count": 0}, "part.file": "mp_cover_p0.prt"}}
 ]
}
