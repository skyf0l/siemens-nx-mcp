{
  "covers": {"nx_find_geometry": [], "nx_find_holes": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "curves": [
       {"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]},
       {"type": "circle", "center": [8, 10], "radius": 2}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "base",
     "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk2",
     "args": {"placement": {"principal": "xy", "origin": [0, 0, 10]}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk2.data.sketch.id", "curves": [{"type": "circle", "center": [28, 10], "radius": 4}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk2.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "boss",
     "args": {"sketch": "$sk2.data.sketch.id", "end": {"type": "distance", "value": 5},
              "combine": {"operation": "unite", "targets": ["$base.data.bodies.0.id"]}}},
    {"call": "nx_find_geometry", "args": {"owner": "$base.data.bodies.0.id", "kind": "face"},
     "expect": {"mutation_outcome": "not_applicable", "page.total": 9,
                "data.selector": {"matches": "\"order\":\"lowest\""}}},
    {"call": "nx_find_geometry", "args": {"owner": "$boss.data.feature.id", "kind": "face", "order": "highest"},
     "expect": {"page.total": 2, "data.items.0.type": "plane", "data.items.0.center.2": {"close": 15, "tol": 1e-6},
                "data.items.1.type": "cylinder", "data.items.1.radius": {"close": 4, "tol": 1e-9},
                "data.items.1.role": "boss", "data.selector": {"matches": "\"owner_kind\":\"feature\""}}},
    {"call": "nx_find_geometry", "args": {"owner": "$boss.data.feature.id", "kind": "face", "geometry_type": "cylinder"},
     "expect": {"page.total": 1, "data.items.0.axis_point.0": {"close": 28, "tol": 1e-6},
                "data.items.0.axis_point.1": {"close": 10, "tol": 1e-6}}},
    {"call": "nx_find_geometry", "args": {"owner": "$base.data.bodies.0.id", "kind": "face", "geometry_type": "cylinder"},
     "expect": {"page.total": 2}},
    {"call": "nx_find_geometry", "args": {"owner": "$base.data.feature.id", "kind": "face"},
     "expect": {"page.total": 7, "data.items.0.center.2": {"close": 0, "tol": 1e-6}}},
    {"call": "nx_find_holes", "args": {"owner": "$base.data.feature.id"},
     "expect": {"page.total": 1, "data.items.0.radius": {"close": 2, "tol": 1e-9}}},
    {"call": "nx_find_holes", "args": {"owner": "$boss.data.feature.id"},
     "expect": {"page.total": 0}}
  ]
}
