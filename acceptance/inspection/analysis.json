{
  "covers": {"nx_analyze_faces": [], "nx_analyze_curve": [], "nx_check_continuity": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s1", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "l1",
     "args": {"sketch": "$s1.data.sketch.id", "curves": [{"type": "line", "start": [0, 0], "end": [10, 0]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s1.data.sketch.id"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s2", "args": {"placement": {"principal": "xy", "origin": [0, 0, 10]}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$s2.data.sketch.id", "curves": [{"type": "line", "start": [0, 0], "end": [10, 0]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s2.data.sketch.id"}},
    {"call": "nx_create_loft", "setup": true, "save": "sheet1", "args": {"sections": ["$s1.data.sketch.id", "$s2.data.sketch.id"], "solid": false}},
    {"call": "nx_create_sketch", "setup": true, "save": "s3", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "l3",
     "args": {"sketch": "$s3.data.sketch.id", "curves": [{"type": "line", "start": [10, 0], "end": [20, 0]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s3.data.sketch.id"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s4", "args": {"placement": {"principal": "xy", "origin": [0, 0, 10]}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$s4.data.sketch.id", "curves": [{"type": "line", "start": [10, 0], "end": [20, 0]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s4.data.sketch.id"}},
    {"call": "nx_create_loft", "setup": true, "save": "sheet2", "args": {"sections": ["$s3.data.sketch.id", "$s4.data.sketch.id"], "solid": false}},
    {"call": "nx_create_sketch", "setup": true, "save": "s5", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "l5",
     "args": {"sketch": "$s5.data.sketch.id", "curves": [{"type": "line", "start": [10, 0], "end": [20, 10]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s5.data.sketch.id"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s6", "args": {"placement": {"principal": "xy", "origin": [0, 0, 10]}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$s6.data.sketch.id", "curves": [{"type": "line", "start": [10, 0], "end": [20, 10]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s6.data.sketch.id"}},
    {"call": "nx_create_loft", "setup": true, "save": "sheet3", "args": {"sections": ["$s5.data.sketch.id", "$s6.data.sketch.id"], "solid": false}},
    {"call": "nx_find_geometry", "setup": true, "save": "e1",
     "args": {"owner": "$sheet1.data.bodies.0.id", "kind": "edge", "near": [10, 0, 5], "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "e2",
     "args": {"owner": "$sheet2.data.bodies.0.id", "kind": "edge", "near": [10, 0, 5], "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "e3",
     "args": {"owner": "$sheet3.data.bodies.0.id", "kind": "edge", "near": [10, 0, 5], "limit": 1}},
    {"call": "nx_check_continuity", "args": {"first": "$e1.data.items.0.id", "second": "$e2.data.items.0.id"},
     "expect": {"mutation_outcome": "not_applicable", "data.mode": "surface", "data.g0": true, "data.g1": true, "data.g2": true,
                "data.gap": {"close": 0, "tol": 1e-6}, "data.angle": {"close": 0, "tol": 1e-6},
                "data.curvature": {"close": 0, "tol": 1e-9}, "data.samples": 40, "data.unresolved": 0}},
    {"call": "nx_check_continuity",
     "args": {"first": "$e1.data.items.0.id", "second": "$e3.data.items.0.id", "samples": 5, "tolerances": {"angle": 1}},
     "expect": {"data.g0": true, "data.g1": false, "data.g2": false, "data.angle": {"close": 45, "tol": 1e-6},
                "data.samples": 10, "data.tolerances.angle": 1, "data.tolerances.position": 0.001}},
    {"call": "nx_check_continuity", "args": {"first": "$e1.data.items.0.id", "second": "$e1.data.items.0.id"},
     "expect": {"error.category": "invalid_argument", "error.field": "/second"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s7", "args": {"placement": {"principal": "xy", "origin": [0, 0, 0]}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c7",
     "args": {"sketch": "$s7.data.sketch.id", "curves": [
       {"type": "rectangle", "corner1": [50, 0], "corner2": [90, 20]},
       {"type": "circle", "center": [70, 10], "radius": 5}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s7.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "blk",
     "args": {"sketch": "$s7.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "side",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [1, 0, 0], "order": "highest", "axis": "x", "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "bore",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "face", "geometry_type": "cylinder", "order": "lowest", "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "solid_edge",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "near": [70, 0, 10], "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "e1b",
     "args": {"owner": "$sheet1.data.bodies.0.id", "kind": "edge", "near": [10, 0, 5], "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "e3b",
     "args": {"owner": "$sheet3.data.bodies.0.id", "kind": "edge", "near": [10, 0, 5], "limit": 1}},
    {"call": "nx_check_continuity", "args": {"first": "$solid_edge.data.items.0.id", "second": "$e1b.data.items.0.id", "mode": "surface"},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.category": "wrong_kind", "error.field": "/first",
                "error.details.faces": 2, "error.hint": {"contains": "nx_create_extract"}}},
    {"call": "nx_check_continuity", "args": {"first": "$l1.data.curves.0.curve.id", "second": "$l3.data.curves.0.curve.id"},
     "expect": {"data.mode": "curve", "data.g0": true, "data.g1": true, "data.g2": true, "data.gap": {"close": 0, "tol": 1e-9},
                "data.angle": {"close": 0, "tol": 1e-6}, "data.curvature": {"close": 0, "tol": 1e-9},
                "data.junction.point": {"close": [10, 0, 0], "tol": 1e-9}, "data.junction.first_end": "end",
                "data.junction.second_end": "start", "data.samples": 2, "data.unresolved": 0}},
    {"call": "nx_check_continuity", "args": {"first": "$l1.data.curves.0.curve.id", "second": "$l5.data.curves.0.curve.id"},
     "expect": {"data.mode": "curve", "data.g0": true, "data.g1": false, "data.g2": false, "data.angle": {"close": 45, "tol": 1e-6}}},
    {"call": "nx_find_geometry", "setup": true, "save": "corner_edge",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "near": [90, 0, 5], "limit": 1}},
    {"call": "nx_check_continuity", "args": {"first": "$solid_edge.data.items.0.id", "second": "$corner_edge.data.items.0.id"},
     "expect": {"data.mode": "curve", "data.g0": true, "data.g1": false, "data.angle": {"close": 90, "tol": 1e-6},
                "data.junction.point": {"close": [90, 0, 10], "tol": 1e-6}}},
    {"call": "nx_check_continuity", "args": {"first": "$solid_edge.data.items.0.id", "second": "$e1b.data.items.0.id"},
     "expect": {"data.mode": "curve", "data.g0": false, "data.gap": {"close": 40, "tol": 1e-6}}},
    {"call": "nx_create_sketch", "setup": true, "save": "s8", "args": {"placement": {"principal": "xy", "origin": [0, 0, 30]}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c8",
     "args": {"sketch": "$s8.data.sketch.id", "curves": [
       {"type": "arc", "center": [40, 20], "radius": 5, "start_angle": 0, "end_angle": 90},
       {"type": "line", "start": [40, 25], "end": [30, 25]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s8.data.sketch.id"}},
    {"call": "nx_check_continuity", "args": {"first": "$c8.data.curves.0.curve.id", "second": "$c8.data.curves.1.curve.id"},
     "expect": {"data.mode": "curve", "data.g0": true, "data.g1": true, "data.g2": false,
                "data.angle": {"close": 0, "tol": 1e-6}, "data.curvature": {"close": 0.2, "tol": 1e-4},
                "data.junction.point": {"close": [40, 25, 30], "tol": 1e-9}, "data.junction.first_end": "end",
                "data.junction.second_end": "start"}},
    {"call": "nx_check_continuity",
     "args": {"first": "$e1b.data.items.0.id", "second": "$e3b.data.items.0.id", "samples": 5,
              "tolerances": {"position": "0.01mm", "angle": "0.5deg"}},
     "expect": {"data.tolerances.position": {"close": 0.01, "tol": 1e-12}, "data.tolerances.angle": {"close": 0.5, "tol": 1e-12},
                "data.g0": true, "data.g1": false, "data.angle": {"close": 45, "tol": 1e-6}}},
    {"call": "nx_check_continuity",
     "args": {"first": "$e1b.data.items.0.id", "second": "$e3b.data.items.0.id", "tolerances": {"position": "0 mm"}},
     "expect": {"error.category": "invalid_argument", "error.field": "/tolerances/position"}},
    {"call": "nx_analyze_faces",
     "args": {"faces": ["$top.data.items.0.id", "$side.data.items.0.id"], "samples_per_axis": 2, "pull_direction": [0, 0, 2], "minimum_draft": 1},
     "expect": {"data.sample_count": 8, "data.faces": {"count": 2}, "data.faces.0.samples": {"count": 4},
                "data.faces.0.face.kind": "face", "data.faces.1.samples.0.normal": {"close": [1, 0, 0], "tol": 1e-9},
                "data.pull_direction": {"close": [0, 0, 1], "tol": 1e-12},
                "data.faces.0.samples.0.draft": {"close": 90, "tol": 1e-6}, "data.faces.0.samples.0.verdict": "ok",
                "data.faces.0.samples.0.radii": [null, null], "data.faces.0.samples.0.curvatures": {"close": [0, 0], "tol": 1e-12},
                "data.faces.1.samples.3.draft": {"close": 0, "tol": 1e-6}, "data.faces.1.samples.3.verdict": "below_minimum",
                "data.below_minimum": 4, "warnings": {"count": 0}}},
    {"call": "nx_analyze_faces",
     "args": {"faces": ["$top.data.items.0.id", "$side.data.items.0.id"], "samples_per_axis": 2, "pull_direction": "+z", "minimum_draft": "1 deg"},
     "expect": {"data.pull_direction": {"close": [0, 0, 1], "tol": 1e-12}, "data.faces.0.samples.0.draft": {"close": 90, "tol": 1e-6},
                "data.faces.1.samples.3.verdict": "below_minimum", "data.below_minimum": 4}},
    {"call": "nx_analyze_faces",
     "args": {"faces": ["$top.data.items.0.id"], "samples_per_axis": 2, "pull_direction": "-z", "minimum_draft": 1},
     "expect": {"data.pull_direction": {"close": [0, 0, -1], "tol": 1e-12}, "data.faces.0.samples.0.draft": {"close": -90, "tol": 1e-6},
                "data.faces.0.samples.0.verdict": "negative", "data.faces.0.samples.3.verdict": "negative", "data.below_minimum": 4}},
    {"call": "nx_analyze_faces", "args": {"faces": ["$bore.data.items.0.id"], "samples_per_axis": 2},
     "expect": {"data.sample_count": 4, "data.faces.0.samples": {"count": 4}, "data.faces.0.samples.0.radii.1": null,
                "data.faces.0.samples.0.curvatures.1": {"close": 0, "tol": 1e-12}}},
    {"call": "nx_analyze_faces", "args": {"faces": ["$top.data.items.0.id"], "minimum_draft": 2},
     "expect": {"error.field": "/minimum_draft", "mutation_outcome": "not_applicable"}},
    {"call": "nx_analyze_faces", "args": {"faces": ["$top.data.items.0.id"], "samples_per_axis": 21},
     "expect": {"error.category": "invalid_argument"}},
    {"call": "nx_analyze_faces", "args": {"faces": ["$top.data.items.0.id"], "samples_per_axis": 1},
     "expect": {"ok": true, "data.sample_count": 0, "data.skipped_outside_trim": 1, "data.faces.0.samples": {"count": 0},
                "warnings": {"count": 1}, "warnings.0.code": "NX_NOTE",
                "warnings.0.message": {"matches": "every face .*samples_per_axis"}}},
    {"call": "nx_analyze_faces", "args": {"faces": ["$top.data.items.0.id", "$side.data.items.0.id"], "samples_per_axis": 1},
     "expect": {"data.sample_count": 1, "data.skipped_outside_trim": 1, "data.faces.1.samples": {"count": 1},
                "data.faces.1.samples.0.point": {"close": [90, 10, 5], "tol": 1e-6},
                "warnings.0.code": "NX_NOTE", "warnings.0.message": {"matches": "1 of 2 faces"}}},
    {"call": "nx_analyze_curve", "args": {"curve": "$c7.data.curves.4.curve.id", "samples": 3},
     "expect": {"data.samples": {"count": 3}, "data.samples.0.curvature": {"close": 0.2, "tol": 1e-9},
                "data.samples.1.radius": {"close": 5, "tol": 1e-9}, "data.samples.1.t": 0.5,
                "data.curve.kind": "curve"}},
    {"call": "nx_analyze_curve", "args": {"curve": "$c7.data.curves.0.curve.id", "samples": 2},
     "expect": {"data.samples.0.curvature": {"close": 0, "tol": 1e-12}, "data.samples.0.radius": null,
                "data.samples.0.tangent": {"close": [1, 0, 0], "tol": 1e-9}}},
    {"call": "nx_analyze_curve", "args": {"curve": "$solid_edge.data.items.0.id", "samples": 3},
     "expect": {"data.curve.kind": "edge", "data.samples": {"count": 3},
                "data.samples.1.point": {"close": [70, 0, 10], "tol": 1e-6},
                "data.samples.1.curvature": {"close": 0, "tol": 1e-9}, "data.samples.1.radius": null}},
    {"call": "nx_find_geometry", "setup": true, "save": "bore_edge",
     "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "circle", "near": [75, 10, 10], "limit": 1}},
    {"call": "nx_analyze_curve", "args": {"curve": "$bore_edge.data.items.0.id"},
     "expect": {"data.curve.kind": "edge", "data.samples": {"count": 11},
                "data.samples.0.curvature": {"close": 0.2, "tol": 1e-6}, "data.samples.5.radius": {"close": 5, "tol": 1e-4},
                "data.samples.10.curvature": {"close": 0.2, "tol": 1e-6}, "data.samples.5.point.2": {"close": 10, "tol": 1e-6}}}
  ]
}
