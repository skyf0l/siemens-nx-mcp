{
  "covers": {"nx_list_objects": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/insp/insp_list_box.prt", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [10, 10]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_save_part", "setup": true, "args": {}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_component", "setup": true, "save": "A", "args": {"part": "$part", "path": "$run/insp/insp_list_box.prt", "name": "A"}},
    {"call": "nx_create_component", "setup": true, "save": "B",
     "args": {"part": "$part", "path": "$run/insp/insp_list_box.prt", "name": "B", "pose": {"translation": [50, 0, 0]}}},
    {"call": "nx_list_objects", "args": {"part": "$part", "kind": "reference_set"},
     "expect": {"mutation_outcome": "not_applicable", "page.total": 0}},
    {"call": "nx_create_reference_set", "setup": true, "args": {"name": "INSP_SET", "objects": ["$A.data.component.id"]}},
    {"call": "nx_create_explosion", "setup": true, "args": {"part": "$part", "name": "INSP_EX"}},
    {"call": "nx_create_assembly_constraint", "setup": true, "args": {"type": "fix", "component": "$A.data.component.id"}},
    {"call": "nx_create_component_pattern", "setup": true,
     "args": {"component": "$B.data.component.id", "layout": {"linear": {"direction": [0, 1, 0], "count": 3, "spacing": 20}}}},
    {"call": "nx_list_objects", "args": {"part": "$part", "kind": "reference_set"},
     "expect": {"page.total": 1, "data.items.0.kind": "reference_set", "data.items.0.name": {"matches": "(?i)^insp_set$"},
                "data.items.0.details.member_count": 1}},
    {"call": "nx_list_objects", "args": {"part": "$part", "kind": "explosion", "name_contains": "insp"},
     "expect": {"page.total": 1, "data.items.0.kind": "explosion"}},
    {"call": "nx_list_objects", "args": {"part": "$part", "kind": "assembly_constraint"},
     "expect": {"data.items.0.kind": "assembly_constraint", "data.items": {"contains": {"type": "fix"}}}},
    {"call": "nx_list_objects", "args": {"part": "$part", "kind": "component_pattern"},
     "expect": {"page.total": 1, "data.items.0.kind": "component_pattern", "data.items.0.type": "linear"}},
    {"call": "nx_list_objects", "args": {"kind": "explosion", "owner": "$A.data.component.id"},
     "expect": {"error.category": "wrong_kind"}}
  ]
}
