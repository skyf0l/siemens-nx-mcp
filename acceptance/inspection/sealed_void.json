              "data.issues.0.object.kind": "body", "data.issues.0.object.name": {"matches": "^REVOLVED"}, "data.issues.0.shells": 2,
              "data.issues.0.voids": {"count": 1}, "data.issues.0.voids.0.faces": 4,
