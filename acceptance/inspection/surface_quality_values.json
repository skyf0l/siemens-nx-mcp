{
 "covers": {"nx_create_surface_analysis": ["slope", "distance"]},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "blk", "args": {"shape": "block", "length": 40, "width": 40, "height": 40}},
  {"call": "nx_find_geometry", "setup": true, "save": "e", "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [40, 20, 40], "limit": 1}},
  {"call": "nx_create_chamfer", "setup": true, "args": {"edges": ["$e.data.items.0.id"], "offset": 10, "angle": 60}},
  {"call": "nx_find_geometry", "setup": true, "save": "ramp", "args": {"kind": "face", "geometry_type": "plane", "normal": [0.5, 0, 0.8660254037844386], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "top", "args": {"kind": "face", "geometry_type": "plane", "normal": "+z", "limit": 1}},
  {"call": "nx_create_offset_surface", "setup": true, "save": "off", "args": {"faces": ["$top.data.items.0.id"], "distance": 5}},
  {"call": "nx_find_geometry", "setup": true, "save": "sheet", "args": {"owner": "$off.data.bodies.0.id", "kind": "face", "limit": 1}},
  {"call": "nx_create_surface_analysis", "save": "slope", "intent": "A 30 degree ramp: its normal is 30 deg from +z everywhere",
   "args": {"type": "slope", "faces": ["$ramp.data.items.0.id"]},
   "expect": {"mutation_outcome": "committed", "data.name": "NX_MCP_SLOPE", "data.faces": 1,
              "data.values.min": {"close": 30, "tol": 1e-6}, "data.values.max": {"close": 30, "tol": 1e-6},
              "data.values.samples": 25}},
  {"call": "nx_create_surface_analysis", "intent": "Against +x the ramp normal is 60 deg off",
   "args": {"type": "slope", "faces": ["$ramp.data.items.0.id"], "direction": "x", "samples_per_axis": 3},
   "expect": {"data.values.mean": {"close": 60, "tol": 1e-6}, "data.values.samples": 9}},
  {"call": "nx_create_surface_analysis", "intent": "Flat top and ramp together: 0 to 30",
   "args": {"type": "slope", "faces": ["$top.data.items.0.id", "$ramp.data.items.0.id"], "direction": [0, 0, 1]},
   "expect": {"data.values.min": {"close": 0, "tol": 1e-6}, "data.values.max": {"close": 30, "tol": 1e-6}, "data.faces": 2}},
  {"call": "nx_create_surface_analysis", "save": "dist", "intent": "The offset sheet sits 5 above the top plane",
   "args": {"type": "distance", "faces": ["$sheet.data.items.0.id"], "plane": {"origin": [0, 0, 40], "normal": [0, 0, 1]}},
   "expect": {"mutation_outcome": "committed", "data.name": "NX_MCP_DISTANCE",
              "data.values.min": {"close": 5, "tol": 1e-6}, "data.values.max": {"close": 5, "tol": 1e-6}}},
  {"call": "nx_create_surface_analysis", "save": "dist_top", "intent": "From the block's own top face as the plane",
   "args": {"type": "distance", "faces": ["$sheet.data.items.0.id"], "plane": "$top.data.items.0.id"},
   "expect": {"data.values.mean": {"close": 5, "tol": 1e-6}}},
  {"call": "nx_create_surface_analysis", "save": "dist_xy", "intent": "From the XY plane: the sheet at 45 is the farthest",
   "args": {"type": "distance", "faces": ["$sheet.data.items.0.id", "$ramp.data.items.0.id"], "plane": "xy"},
   "expect": {"data.values.max": {"close": 45, "tol": 1e-6}, "data.values.samples": 50}},
  {"call": "nx_undo_operation", "intent": "Undo the distance analyses, latest first", "args": {"operation": "$dist_xy.operation_id"}, "expect": {"ok": true}},
  {"call": "nx_undo_operation", "args": {"operation": "$dist_top.operation_id"}, "expect": {"ok": true}},
  {"call": "nx_undo_operation", "args": {"operation": "$dist.operation_id"}, "expect": {"ok": true}},
  {"call": "nx_create_surface_analysis", "args": {"type": "distance", "faces": ["$sheet.data.items.0.id"]},
   "expect": {"error.field": "/plane", "mutation_outcome": "not_started"}},
  {"call": "nx_create_surface_analysis", "args": {"type": "distance", "faces": ["$sheet.data.items.0.id"], "plane": "xy", "direction": "z"},
   "expect": {"error.field": "/direction", "mutation_outcome": "not_started"}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.errors": 0}}
 ]
}
