{
  "covers": {"nx_list_objects": [], "nx_find_geometry": [], "nx_measure_bounds": [], "nx_measure_distance": [],
             "nx_check_interference": [], "nx_resolve_reference": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/insp/insp_occ_box.prt", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [10, 10]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_save_part", "setup": true, "args": {}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_component", "setup": true, "save": "A", "args": {"path": "$run/insp/insp_occ_box.prt", "name": "A"}},
    {"call": "nx_create_component", "setup": true, "save": "B",
     "args": {"path": "$run/insp/insp_occ_box.prt", "name": "B", "pose": {"translation": [50, 0, 0]}}},
    {"call": "nx_list_objects", "args": {"kind": "body", "owner": "$A.data.component.id"},
     "expect": {"mutation_outcome": "not_applicable", "page.total": 1, "data.items.0.kind": "body",
                "data.items.0.type": "solid", "data.items.0.name": {"matches": "^A/"}}},
    {"call": "nx_list_objects", "args": {"kind": "face", "owner": "$B.data.component.id", "type": "plane", "limit": 6},
     "expect": {"page.total": 6, "data.items": {"contains": {"kind": "face", "type": "plane",
                "details": {"normal": [1, 0, 0]}}},
                "data.items.0.name": {"matches": "^B/"}}},
    {"call": "nx_list_objects", "args": {"kind": "edge", "owner": "$B.data.component.id"},
     "expect": {"page.total": 12, "data.items.0.kind": "edge", "data.items.0.type": "line"}},
    {"call": "nx_list_objects", "args": {"kind": "feature", "owner": "$A.data.component.id"},
     "expect": {"page.total": 3, "data.items": {"contains": {"kind": "feature", "type": "extrude"}},
                "warnings.0.code": "NX_NOTE", "warnings.0.message": {"contains": "no feature occurrences"}}},
    {"call": "nx_list_objects", "args": {"kind": "expression", "owner": "$A.data.component.id"},
     "expect": {"error.category": "wrong_kind", "error.field": "/owner"}},
    {"call": "nx_find_geometry", "save": "far", "args": {"kind": "body", "order": "highest", "axis": "x"},
     "expect": {"page.total": 2, "data.items.0.kind": "body", "data.items.0.type": "solid",
                "data.items.0.owner": {"matches": "^o:"}, "data.items.0.name": {"matches": "^B/"}, "data.items.0.volume": {"close": 1000, "tol": 1e-6},
                "data.items.0.min": {"close": [50, 0, 0], "tol": 1e-6}, "data.items.0.max": {"close": [60, 10, 10], "tol": 1e-6},
                "data.items.0.center": {"close": [55, 5, 5], "tol": 1e-6}, "data.items.1.name": {"matches": "^A/"},
                "warnings": {"count": 0}}},
    {"call": "nx_find_geometry", "args": {"kind": "body", "near": [0, 0, 20]},
     "expect": {"data.items.0.name": {"matches": "^A/"}, "data.items.0.distance": {"close": 10, "tol": 1e-6},
                "data.items.1.distance": {"close": 50.990195, "tol": 1e-4}}},
    {"call": "nx_find_geometry", "args": {"kind": "body", "owner": "$B.data.component.id"},
     "expect": {"page.total": 1, "data.items.0.name": {"matches": "^B/"}, "data.items.0.owner": {"matches": "^o:"}}},
    {"call": "nx_find_geometry", "args": {"kind": "body", "geometry_type": "plane"},
     "expect": {"error.category": "invalid_argument", "error.field": "/kind"}},
    {"call": "nx_resolve_reference", "args": {"selector": "$far.data.selector"},
     "expect": {"data.via": "selector", "data.object.name": {"matches": "^B/"}, "data.object.kind": "body", "data.rank": {"close": 55, "tol": 1e-6}}},
    {"call": "nx_create_explosion", "setup": true, "save": "ex", "args": {"name": "INSP_OCC_EX"}},
    {"call": "nx_edit_explosion", "setup": true,
     "args": {"explosion": "$ex.data.explosion.id", "placements": [{"component": "$B.data.component.id", "offset": [0, 0, 40]}]}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$B.data.component.id"]},
     "expect": {"data.min": {"close": [50, 0, 0], "tol": 1e-6}, "warnings": {"count": 0}}},
    {"call": "nx_set_explosion_display", "setup": true, "args": {"explosion": "$ex.data.explosion.id"}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$B.data.component.id"]},
     "expect": {"data.min": {"close": [50, 0, 0], "tol": 1e-6}, "data.max": {"close": [60, 10, 10], "tol": 1e-6},
                "warnings.0.code": "NX_NOTE", "warnings.0.message": {"matches": "INSP_OCC_EX.*assembled \\(unexploded\\)"}}},
    {"call": "nx_measure_distance", "args": {"first": "$A.data.component.id", "second": "$B.data.component.id"},
     "expect": {"data.distance": {"close": 40, "tol": 1e-6}, "warnings.0.code": "NX_NOTE", "warnings": {"count": 1}}},
    {"call": "nx_find_geometry", "args": {"owner": "$B.data.component.id", "normal": "+z", "limit": 1},
     "expect": {"data.items.0.center": {"close": [55, 5, 10], "tol": 1e-6}, "warnings.0.code": "NX_NOTE"}},
    {"call": "nx_check_interference", "args": {"objects": ["$A.data.component.id", "$B.data.component.id"], "include_clear": true},
     "expect": {"data.pairs.0.distance": {"close": 40, "tol": 1e-6}, "warnings": {"contains": {"code": "NX_NOTE"}}}},
    {"call": "nx_set_explosion_display", "setup": true, "args": {}},
    {"call": "nx_measure_distance", "args": {"first": "$A.data.component.id", "second": "$B.data.component.id"},
     "expect": {"data.distance": {"close": 40, "tol": 1e-6}, "warnings": {"count": 0}}}
  ]
}
