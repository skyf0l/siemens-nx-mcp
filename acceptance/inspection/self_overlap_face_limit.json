{
  "covers": {"nx_check_model": [], "nx_get_model_summary": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_primitive", "setup": true, "save": "plate", "args": {"length": 210, "width": 210, "height": 5}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk",
     "args": {"placement": {"principal": "xy"},
              "curves": [{"type": "rectangle", "corner1": [4, 4], "corner2": [6, 6]}], "finish": true}},
    {"call": "nx_create_extrude", "setup": true, "save": "boss",
     "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 8},
              "combine": {"operation": "unite", "targets": ["$plate.data.bodies.0.id"]}},
     "expect": {"data.volume": {"close": 220512, "tol": 1e-3}}},
    {"call": "nx_create_pattern", "setup": true,
     "intent": "A 21 x 21 grid of united 2 x 2 x 3 mm bosses: one solid of 6 + 441 x 5 = 2,211 faces, built in one call",
     "args": {"features": ["$boss.data.feature.id"], "layout": "linear",
              "parameters": {"direction": [1, 0, 0], "count": 21, "spacing": 10,
                             "direction2": [0, 1, 0], "count2": 21, "spacing2": 10}},
     "expect": {"data.count": 441}},
    {"call": "nx_measure_mass", "args": {"bodies": ["$plate.data.bodies.0.id"]},
     "expect": {"data.volume": {"close": 225792, "tol": 1e-2}}},
    {"call": "nx_check_model", "args": {},
     "intent": "Acceptance: a solid over 2,000 faces is not examined for voids or self-overlap (slow; the overlap check cannot be interrupted): two info issues, healthy",
     "expect": {"mutation_outcome": "not_applicable", "data.healthy": true, "data.errors": 0, "data.warnings": 0,
                "data.bodies_checked": 1, "page.total": 2,
                "data.issues.0.severity": "info", "data.issues.0.kind": "internal_void", "data.issues.0.object.kind": "body",
                "data.issues.0.message": {"matches": "^void check skipped: 2,211 faces \\(over 2,000\\); pass clash: true to force"},
                "data.issues.1.severity": "info", "data.issues.1.kind": "self_intersection", "data.issues.1.object.kind": "body",
                "data.issues.1.message": {"matches": "^self-intersection check skipped: 2,211 faces \\(over 2,000\\); pass clash: true to force"}}},
    {"call": "nx_get_model_summary", "args": {},
     "intent": "Acceptance: the overview has no self-overlap check: healthy, one body",
     "expect": {"data.health": {"healthy": true, "errors": 0, "warnings": 0, "scope": "part", "parts_checked": 1}, "data.counts.bodies": 1}}
  ]
}
