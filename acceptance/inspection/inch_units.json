{
  "covers": {"nx_measure_mass": [], "nx_measure_distance": [], "nx_measure_bounds": [], "nx_check_interference": [],
             "nx_measure_wall_thickness": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "in"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [2, 1]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "a", "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 0.5}}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk2", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk2.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [2.1, 0], "corner2": [3.1, 1]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk2.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "b", "args": {"sketch": "$sk2.data.sketch.id", "end": {"type": "distance", "value": 0.5}}},
    {"call": "nx_set_material", "setup": true,
     "args": {"bodies": ["$a.data.bodies.0.id"], "material": {"custom": {"name": "INSP_IN_1000", "density": 1000}}}},
    {"call": "nx_measure_mass", "args": {"bodies": ["$a.data.bodies.0.id"]},
     "expect": {"units.length": "in", "data.volume": {"close": 1, "tol": 1e-9}, "data.area": {"close": 7, "tol": 1e-9},
                "data.mass": {"close": 0.016387064, "tol": 1e-9},
                "data.center_of_gravity": {"close": [1, 0.5, 0.25], "tol": 1e-9},
                "data.inertia.0.0": {"close": 0.001706985833, "tol": 1e-9},
                "data.inertia.2.2": {"close": 0.006827943333, "tol": 1e-9}}},
    {"call": "nx_measure_distance", "args": {"first": "$a.data.bodies.0.id", "second": "$b.data.bodies.0.id"},
     "expect": {"data.distance": {"close": 0.1, "tol": 1e-9}, "data.points.1.0": {"close": 2.1, "tol": 1e-9}, "units.length": "in"}},
    {"call": "nx_measure_bounds", "args": {"precision": "exact"},
     "expect": {"data.min": {"close": [0, 0, 0], "tol": 1e-9}, "data.max": {"close": [3.1, 1, 0.5], "tol": 1e-9}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "limit": 1}},
    {"call": "nx_measure_wall_thickness", "args": {"body": "$a.data.bodies.0.id", "faces": ["$top.data.items.0.id"], "samples_per_axis": 2},
     "expect": {"data.minimum": {"close": 0.5, "tol": 1e-9}, "data.measured": 4}},
    {"call": "nx_check_interference",
     "args": {"objects": ["$a.data.bodies.0.id", "$b.data.bodies.0.id"], "clearance": "5 mm"},
     "expect": {"data.clearance": {"close": 0.196850393701, "tol": 1e-9}, "data.counts.below_clearance": 1,
                "data.pairs.0.distance": {"close": 0.1, "tol": 1e-9}}},
    {"call": "nx_check_interference",
     "args": {"objects": ["$a.data.bodies.0.id", "$b.data.bodies.0.id"], "clearance": 0.05},
     "expect": {"data.pairs": {"count": 0}, "data.skipped_pairs": 1}}
  ]
}
