{
  "covers": {"nx_check_interference": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s1",
     "args": {"placement": {"principal": "xz"},
              "curves": [{"type": "rectangle", "corner1": [10, 0], "corner2": [20, 10]}], "finish": true}},
    {"call": "nx_create_revolve", "setup": true, "save": "inner",
     "args": {"sketch": "$s1.data.sketch.id", "axis": {"principal": "z"}},
     "expect": {"data.volume": {"close": 9424.778, "tol": 0.1}}},
    {"call": "nx_create_sketch", "setup": true, "save": "s2",
     "args": {"placement": {"principal": "xz"},
              "curves": [{"type": "rectangle", "corner1": [20, 0], "corner2": [30, 10]}], "finish": true}},
    {"call": "nx_create_revolve", "setup": true, "save": "outer",
     "args": {"sketch": "$s2.data.sketch.id", "axis": {"principal": "z"}},
     "expect": {"data.volume": {"close": 15707.963, "tol": 0.1}}},
    {"call": "nx_create_sketch", "setup": true, "save": "s3",
     "args": {"placement": {"principal": "xz"},
              "curves": [{"type": "rectangle", "corner1": [25, 0], "corner2": [35, 10]}], "finish": true}},
    {"call": "nx_create_revolve", "setup": true, "save": "over",
     "args": {"sketch": "$s3.data.sketch.id", "axis": {"principal": "z"}},
     "expect": {"data.volume": {"close": 18849.556, "tol": 0.1}}},
    {"call": "nx_check_interference", "args": {"objects": ["$inner.data.bodies.0.id", "$outer.data.bodies.0.id"]},
     "intent": "Acceptance: two rings sharing a cylindrical face (r 20) touch: contact without overlap volume, not penetration",
     "expect": {"mutation_outcome": "not_applicable", "data.checked_pairs": 1,
                "data.counts": {"equals": {"penetration": 0, "contact": 1, "below_clearance": 0, "clear": 0, "skipped": 0}},
                "data.pairs.0.classification": "contact", "data.pairs.0.distance": {"close": 0, "tol": 1e-6}}},
    {"call": "nx_check_interference", "args": {"objects": ["$outer.data.bodies.0.id", "$over.data.bodies.0.id"]},
     "intent": "Acceptance: rings overlapping radially from 25 to 30 mm penetrate with the overlap ring's volume",
     "expect": {"data.counts.penetration": 1, "data.counts.contact": 0,
                "data.pairs.0.classification": "penetration",
                "data.pairs.0.overlap_volume": {"close": 8639.38, "tol": 1}}},
    {"call": "nx_list_objects", "args": {"kind": "body"},
     "intent": "Acceptance: the temporary interference bodies were rolled back",
     "expect": {"page.total": 3}}
  ]
}
