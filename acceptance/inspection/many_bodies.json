{
  "covers": {"nx_list_objects": [], "nx_find_geometry": [], "nx_measure_mass": [], "nx_measure_distance": [],
             "nx_check_model": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_primitive", "setup": true, "save": "seed",
     "args": {"origin": [100, -5, 0], "length": 40, "width": 10, "height": 2}},
    {"call": "nx_create_pattern", "setup": true, "save": "pat",
     "args": {"bodies": ["$seed.data.bodies.0.id"], "layout": "circular",
              "parameters": {"axis": "z", "count": 60, "angle": 6}},
     "expect": {"data.count": 60, "data.new_bodies": 59}},
    {"call": "nx_list_objects", "args": {"kind": "body", "limit": 200},
     "intent": "Acceptance: every Pattern Geometry copy names its pattern and its instance number; the seed has none",
     "expect": {"page.total": 60, "data.items.0.id": "$seed.data.bodies.0.id",
                "data.items.1.details.pattern": "$pat.data.feature.id", "data.items.1.details.instance": 1,
                "data.items.1.name": {"matches": ":1A\\)$"},
                "data.items.15.details.instance": 15, "data.items.59.details.instance": 59}},
    {"call": "nx_list_objects", "args": {"kind": "body", "compact": true, "limit": 200},
     "intent": "Acceptance: compact rows hold id, name and the box only",
     "expect": {"page.total": 60, "data.items": {"count": 60}, "data.items.0": {"count": 4},
                "data.items.0.min": {"close": [100, -5, 0], "tol": 0.01},
                "data.items.0.max": {"close": [140, 5, 2], "tol": 0.01},
                "data.items.15.min": {"close": [-5, 100, 0], "tol": 0.01},
                "data.items.15.max": {"close": [5, 140, 2], "tol": 0.01}}},
    {"call": "nx_list_objects", "args": {"kind": "feature", "compact": true},
     "expect": {"error.code": "NX_UNSUPPORTED_OPTION", "error.field": "/compact", "mutation_outcome": "not_applicable"}},
    {"call": "nx_find_geometry", "args": {"kind": "face", "near": [120, 0, 3], "limit": 3},
     "intent": "Acceptance: nearest faces of 360 without an owner, measured by box bound first: same exact distances",
     "expect": {"page.total": 360, "data.items.0.distance": {"close": 1, "tol": 1e-6},
                "data.items.0.type": "plane", "data.items.0.normal": {"close": [0, 0, 1], "tol": 1e-9},
                "data.items.1.distance": {"close": 3, "tol": 1e-6},
                "data.items.2.distance": {"close": 5.0990195135928, "tol": 1e-6},
                "data.items.0.point": {"close": [120, 0, 2], "tol": 1e-6}}},
    {"call": "nx_find_geometry", "args": {"kind": "face", "near": [120, 0, 3], "offset": 3, "limit": 1},
     "expect": {"page.total": 360, "data.items.0.distance": {"close": 5.0990195135928, "tol": 1e-6},
                "page.next_offset": 4}},
    {"call": "nx_find_geometry", "args": {"kind": "body", "near": [0, 120, 1], "limit": 1},
     "expect": {"page.total": 60, "data.items.0.distance": {"close": 0, "tol": 1e-6},
                "data.items.0.min": {"close": [-5, 100, 0], "tol": 0.01}}},
    {"call": "nx_measure_mass", "args": {"scope": "part"},
     "intent": "Acceptance: the mass of every body of a 60-body part, each body read in one UF call",
     "expect": {"data.volume": {"close": 48000, "tol": 1e-3}, "data.area": {"close": 60000, "tol": 1e-3},
                "data.bodies": {"count": 60}, "data.bodies.0.volume": {"close": 800, "tol": 1e-6},
                "data.center_of_gravity": {"close": [0, 0, 1], "tol": 1e-6}}},
    {"call": "nx_check_model", "args": {},
     "intent": "Acceptance: 60 solids exceed the 50 examined per call: healthy for what was examined, complete false",
     "expect": {"data.healthy": true, "data.complete": false, "data.bodies_checked": 60,
                "data.skipped": {"count": 1}, "data.skipped.0.check": "self_intersection",
                "data.skipped.0.reason": "call_limit", "data.skipped.0.bodies": 10, "data.skipped.0.faces": 60}},
    {"call": "nx_check_model", "args": {"clash": true},
     "expect": {"data.healthy": true, "data.complete": true, "data.skipped": {"count": 0}}},
    {"call": "nx_create_sketch", "setup": true, "save": "s1", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$s1.data.sketch.id", "curves": [
       {"type": "rectangle", "corner1": [0, 200], "corner2": [5, 205]},
       {"type": "rectangle", "corner1": [10, 200], "corner2": [15, 205]},
       {"type": "rectangle", "corner1": [20, 200], "corner2": [25, 205]},
       {"type": "rectangle", "corner1": [30, 200], "corner2": [35, 205]},
       {"type": "rectangle", "corner1": [40, 200], "corner2": [45, 205]},
       {"type": "rectangle", "corner1": [50, 200], "corner2": [55, 205]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s1.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "left",
     "args": {"sketch": "$s1.data.sketch.id", "end": {"type": "distance", "value": 5}},
     "expect": {"data.bodies": {"count": 6}}},
    {"call": "nx_create_sketch", "setup": true, "save": "s2", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$s2.data.sketch.id", "curves": [
       {"type": "rectangle", "corner1": [60, 200], "corner2": [65, 205]},
       {"type": "rectangle", "corner1": [70, 200], "corner2": [75, 205]},
       {"type": "rectangle", "corner1": [80, 200], "corner2": [85, 205]},
       {"type": "rectangle", "corner1": [90, 200], "corner2": [95, 205]},
       {"type": "rectangle", "corner1": [100, 200], "corner2": [105, 205]},
       {"type": "rectangle", "corner1": [110, 200], "corner2": [115, 205]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s2.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "right",
     "args": {"sketch": "$s2.data.sketch.id", "end": {"type": "distance", "value": 5}},
     "expect": {"data.bodies": {"count": 6}}},
    {"call": "nx_measure_distance", "args": {"first": "$left.data.feature.id", "second": "$right.data.feature.id"},
     "intent": "Acceptance: 36 body pairs, pruned by their box gaps: the closest pair is the same",
     "expect": {"data.distance": {"close": 5, "tol": 1e-6}, "data.pairs": 36, "data.touching": false,
                "data.points.0.0": {"close": 55, "tol": 1e-6}, "data.points.1.0": {"close": 60, "tol": 1e-6},
                "data.first.kind": "body", "data.second.kind": "body"}}
  ]
}
