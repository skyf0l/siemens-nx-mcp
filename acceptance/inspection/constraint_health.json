{
 "covers": {
  "nx_check_model": []
 },
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$run/ch/ch_pin.prt", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "circle", "center": [0, 0], "radius": 5}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 20}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_create_part", "setup": true, "save": "g_part", "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_component", "setup": true, "save": "P1", "args": {"part": "$part", "path": "$run/ch/ch_pin.prt", "name": "P1"}},
  {"call": "nx_create_component", "setup": true, "save": "P2", "args": {"part": "$part", "path": "$run/ch/ch_pin.prt", "name": "P2", "pose": {"translation": [30, 0, 0]}}},
  {"call": "nx_create_assembly_constraint", "setup": true, "args": {"type": "fix", "component": "$P2.data.component.id"}},
  {"call": "nx_find_geometry", "setup": true, "save": "e1", "args": {"owner": "$P1.data.component.id", "kind": "edge", "geometry_type": "circle", "order": "lowest", "axis": "z", "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "e2", "args": {"owner": "$P2.data.component.id", "kind": "edge", "geometry_type": "circle", "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_create_assembly_constraint", "setup": true, "save": "con", "args": {"type": "concentric", "component": "$P1.data.component.id", "geometry": "$e1.data.items.0.id", "target_component": "$P2.data.component.id", "target_geometry": "$e2.data.items.0.id"}},
  {"call": "nx_save_part", "setup": true, "args": {"part": "$g_part.data.part.id"}},
  {"call": "nx_check_model", "args": {"part": "$part", "scope": "assembly"},
   "expect": {"data.healthy": true, "data.errors": 0, "data.warnings": 0, "data.parts_checked": 2}},
  {"call": "nx_open_part", "setup": true, "args": {"path": "$run/ch/ch_pin.prt"}},
  {"call": "nx_find_geometry", "setup": true, "save": "top", "args": {"part": "ch_pin", "kind": "edge", "geometry_type": "circle", "order": "highest", "axis": "z", "limit": 1}},
  {"call": "nx_create_blend", "args": {"edges": ["$top.data.items.0.id"], "radius": 1},
   "intent": "Acceptance: a blend in the pin consumes the edge the assembly's concentric uses",
   "expect": {"mutation_outcome": "committed", "warnings": {"count": 1},
              "warnings.0.code": "NX_UPDATE_WARNING",
              "warnings.0.message": {"matches": "no longer solve: ac:\\d+ \\(concentric: CannotSolve\\) in .*\\.prt"}}},
  {"call": "nx_open_part", "setup": true, "args": {"path": "$part"}},
  {"call": "nx_list_objects", "args": {"part": "$part", "kind": "assembly_constraint"},
   "expect": {"page.total": 2, "data.items": {"contains": {"type": "concentric", "details": {"status": "CannotSolve", "suppressed": false}}}}},
  {"call": "nx_check_model", "args": {"part": "$part", "scope": "assembly"},
   "expect": {"data.healthy": false, "data.errors": 1, "data.warnings": 0,
              "data.issues.0.kind": "assembly_constraint", "data.issues.0.severity": "error",
              "data.issues.0.status": "CannotSolve", "data.issues.0.object.kind": "assembly_constraint",
              "data.issues.0.components": {"count": 2}, "data.issues.0.message": {"contains": "nx_edit_assembly_constraint"}}},
  {"call": "nx_check_model", "args": {"part": "$part", "scope": "part"},
   "expect": {"data.healthy": false, "data.errors": 1, "data.issues.0.status": "CannotSolve"}},
  {"call": "nx_get_model_summary", "args": {"part": "$part"},
   "expect": {"data.health.healthy": false, "data.health.errors": 1}},
  {"call": "nx_update_assembly", "args": {"part": "$part"},
   "expect": {"error.code": "NX_CONSTRAINT_UNSATISFIED", "mutation_outcome": "rolled_back",
              "error.details.constraints": {"count": 1}, "error.details.constraints.0.status": "CannotSolve"}},
  {"call": "nx_edit_assembly_constraint", "args": {"constraint": "$con.data.constraint.id", "suppressed": true},
   "expect": {"mutation_outcome": "committed", "data.suppressed": true}},
  {"call": "nx_check_model", "args": {"part": "$part", "scope": "assembly"},
   "expect": {"data.healthy": true, "data.errors": 0}}
 ]
}
