{
  "covers": {"nx_list_objects": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "ext",
     "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_list_objects", "save": "bodies", "args": {"kind": "body"},
     "expect": {"mutation_outcome": "not_applicable", "page.total": 1, "data.items.0.type": "solid",
                "data.items.0.kind": "body", "data.items.0.anchor": {"matches": ":EXTRUDE\\(2\\)#0$"}}},
    {"call": "nx_list_objects", "args": {"kind": "face", "owner": "$bodies.data.items.0.id", "type": "plane"},
     "expect": {"page.total": 6, "data.items": {"count": 6}}},
    {"call": "nx_list_objects", "args": {"kind": "face", "owner": "$ext.data.bodies.0.id", "limit": 2},
     "expect": {"data.items": {"count": 2}, "page.next_offset": 2, "page.total": 6}},
    {"call": "nx_list_objects", "args": {"kind": "edge", "owner": "$bodies.data.items.0.id"},
     "expect": {"page.total": 12}},
    {"call": "nx_list_objects", "args": {"kind": "face", "owner": "$bodies.data.items.0.id", "include": "adjacency", "limit": 1},
     "expect": {"data.items.0.details.edges": {"count": 4}, "data.items.0.details.normal": {"count": 3}}},
    {"call": "nx_list_objects", "args": {"kind": "edge", "owner": "$bodies.data.items.0.id", "include": "adjacency", "limit": 1},
     "expect": {"data.items.0.details.faces": {"count": 2}, "page.total": 12}},
    {"call": "nx_list_objects", "args": {"kind": "body", "include": "views"},
     "expect": {"error.code": "NX_UNSUPPORTED_OPTION", "error.field": "/include"}},
    {"call": "nx_list_objects", "args": {"kind": "feature", "name_contains": "extrude"},
     "expect": {"page.total": 1, "data.items.0.type": "extrude", "data.items.0.details.suppressed": false,
                "data.items.0.details.timestamp": 2, "data.items.0.details.errors": {"count": 0}}},
    {"call": "nx_set_expression", "setup": true, "args": {"name": "lo_wall", "formula": "2.5", "units": "mm"}},
    {"call": "nx_list_objects", "args": {"kind": "expression", "name_contains": "lo_wall"},
     "expect": {"page.total": 1, "data.items.0.kind": "expression", "data.items.0.type": "number",
                "data.items.0.details.formula": "2.5", "data.items.0.details.value": {"close": 2.5, "tol": 1e-9},
                "data.items.0.details.units": "mm", "data.items.0.details.editable": true}},
    {"call": "nx_list_objects", "args": {"kind": "expression", "owner": "$ext.data.feature.id"},
     "expect": {"data.items": {"contains": {"kind": "expression", "details": {"value": 10.0, "units": "mm"}}}}},
    {"call": "nx_list_objects", "args": {"kind": "datum", "type": "csys"},
     "expect": {"data.items.0.kind": "datum_csys", "data.items.0.type": "csys"}},
    {"call": "nx_list_objects", "args": {"kind": "sketch"},
     "expect": {"page.total": 1, "data.items.0.details.active": false}},
    {"call": "nx_list_objects", "args": {"kind": "datum", "type": "plane"},
     "expect": {"data.items.0.kind": "datum_plane"}},
    {"call": "nx_list_objects", "args": {"kind": "face", "owner": "f:999999999"},
     "expect": {"error.category": "not_found", "mutation_outcome": "not_applicable"}},
    {"call": "nx_list_objects", "args": {"kind": "body", "limit": 500},
     "expect": {"error.field": "/limit"}}
  ]
}
