{
  "covers": {"nx_measure_mass": [], "nx_export_mass_report": [], "nx_find_geometry": [], "nx_find_holes": [],
             "nx_measure_wall_thickness": [], "nx_analyze_faces": [], "nx_measure_section": [], "nx_analyze_curve": [],
             "nx_export_inspection_report": [], "nx_check_interference": [], "nx_list_objects": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_primitive", "setup": true, "save": "a",
     "args": {"shape": "block", "length": 100, "width": 50, "height": 20}},
    {"call": "nx_create_primitive", "setup": true, "save": "b",
     "args": {"shape": "block", "origin": [200, 30, 0], "length": 10, "width": 10, "height": 10}},
    {"call": "nx_set_material", "setup": true,
     "args": {"bodies": ["$a.data.bodies.0.id", "$b.data.bodies.0.id"], "material": {"custom": {"name": "INSP_1000", "density": 1000}}}},
    {"call": "nx_measure_mass", "args": {"bodies": ["$a.data.bodies.0.id", "$b.data.bodies.0.id"]},
     "intent": "Acceptance: products of inertia of two offset blocks sit in their own cells",
     "expect": {"data.mass": {"close": 0.101, "tol": 1e-9},
                "data.center_of_gravity": {"close": [51.534653465, 25.099009901, 9.950495050], "tol": 1e-6},
                "data.inertia.0.0": {"close": 24.307095710, "tol": 1e-5},
                "data.inertia.0.1": {"close": -1.534653465, "tol": 1e-6},
                "data.inertia.0.2": {"close": 0.767326733, "tol": 1e-6},
                "data.inertia.1.2": {"close": 0.049504950, "tol": 1e-6},
                "data.inertia.1.0": {"close": -1.534653465, "tol": 1e-6},
                "data.bodies.0.mass": {"close": 0.1, "tol": 1e-9}, "data.bodies.1.mass": {"close": 0.001, "tol": 1e-9},
                "data.bodies.1.density": {"close": 1000, "tol": 1e-6}, "data.bodies.0.material": "INSP_1000",
                "warnings": {"count": 0}}},
    {"call": "nx_export_mass_report",
     "args": {"part": "$part", "path": "$run/insp_details_weights.csv", "report_args": {"inertia": true}},
     "expect": {"mutation_outcome": "committed", "data.total.mass": {"close": 0.101, "tol": 1e-9},
                "data.path": {"matches": "insp_details_weights[.]csv$"}}},
    {"call": "nx_export_mass_report",
     "args": {"part": "$part", "path": "$run/insp_details_bad.csv", "report_args": {"group_by": "colour"}},
     "expect": {"error.field": {"matches": "^/report_args/"}, "mutation_outcome": "not_started"}},
    {"call": "nx_measure_section", "args": {"radial_axis": "z", "origin": [0, 35, 0], "bodies": ["$b.data.bodies.0.id"], "stations": 2},
     "expect": {"warnings.0.message": {"matches": "not revolved"}, "data.profile.0.spans.0": {"close": [200, 210], "tol": 1e-6}}},
    {"call": "nx_measure_section",
     "args": {"radial_axis": "z", "origin": [205, 35, 0], "bodies": ["$b.data.bodies.0.id"], "stations": 2},
     "expect": {"warnings": {"count": 0}, "data.profile.0.spans.0": {"close": [0, 5], "tol": 1e-6}}},
    {"call": "nx_create_primitive", "setup": true, "save": "ball",
     "args": {"shape": "sphere", "origin": [0, 100, 10], "diameter": 20}},
    {"call": "nx_measure_mass", "args": {"bodies": ["$ball.data.bodies.0.id"]},
     "expect": {"warnings.0.message": {"matches": "no material"}, "data.bodies.0.material": null}},
    {"call": "nx_find_geometry", "args": {"kind": "face", "radius": "10 mm"},
     "intent": "Acceptance: a radius on faces of any type finds the sphere",
     "expect": {"data.items": {"count": 1}, "data.items.0.type": "sphere", "data.items.0.radius": {"close": 10, "tol": 1e-6}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "limit": 1}},
    {"call": "nx_create_hole", "setup": true,
     "args": {"face": "$top.data.items.0.id", "positions": [[50, 25, 20]], "form": "counterbore", "diameter": 6,
              "depth": {"type": "distance", "value": 12}, "counterbore": {"diameter": 11, "depth": 4}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "limit": 1}},
    {"call": "nx_create_hole", "setup": true,
     "args": {"face": "$top.data.items.0.id", "positions": [[80, 25, 20]], "form": "threaded", "diameter": 6.8,
              "depth": {"type": "distance", "value": 15}, "thread": {"standard": "Metric Coarse", "size": "M8 x 1.25", "depth": 12}}},
    {"call": "nx_find_holes", "args": {"owner": "$a.data.bodies.0.id", "diameter": 11},
     "expect": {"data.groups": {"count": 1}, "data.groups.0.form": "counterbore",
                "data.groups.0.steps.0.diameter": {"close": 11, "tol": 1e-6}, "data.groups.0.steps.0.depth": {"close": 4, "tol": 1e-6},
                "data.groups.0.radii.0": {"close": 5.5, "tol": 1e-6}, "data.groups.0.feature.kind": "feature"}},
    {"call": "nx_find_holes", "args": {"owner": "$a.data.bodies.0.id", "diameter": 6.8},
     "expect": {"data.groups": {"count": 1}, "data.groups.0.thread.feature.kind": "feature"}},
    {"call": "nx_find_holes", "args": {"owner": "$a.data.bodies.0.id", "diameter": 6.79},
     "expect": {"data.groups": {"count": 0}, "warnings.0.message": {"matches": "nearest: 6[.]8"}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "limit": 1}},
    {"call": "nx_measure_wall_thickness", "args": {"faces": ["$top.data.items.0.id"], "samples_per_axis": 2},
     "intent": "Acceptance: the faces name the body in a part of three solids",
     "expect": {"data.body.id": "$a.data.bodies.0.id", "data.minimum": {"close": 20, "tol": 1e-6},
                "data.thinnest.thickness": {"close": 20, "tol": 1e-6}}},
    {"call": "nx_analyze_faces", "args": {"faces": ["$top.data.items.0.id"], "pull_direction": "z", "samples": "none", "samples_per_axis": 2},
     "expect": {"data.faces.0.samples": {"count": 0}, "data.faces.0.summary.min_draft": {"close": 90, "tol": 1e-6},
                "data.faces.0.summary.min_radius": null}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c",
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "line", "start": [0, -20], "end": [8.660254037844, -15]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_analyze_curve", "args": {"curve": "$c.data.curves.0.curve.id", "samples": 3},
     "expect": {"data.length": {"close": 10, "tol": 1e-6}, "data.samples.0.normal": null, "data.inflections": {"count": 0}}},
    {"call": "nx_list_objects", "args": {"kind": "body"},
     "expect": {"data.items.0.hidden": false}},
    {"call": "nx_export_inspection_report",
     "args": {"part": "$part", "path": "$run/insp_details/report.zip", "objects": ["$a.data.bodies.0.id", "$b.data.bodies.0.id"],
              "section_planes": [{"origin": [50, 25, 10], "normal": [0, 1, 0]}, {"origin": [0, 0, 500], "normal": [0, 0, 1]}]},
     "intent": "Acceptance: a section plane beside the model gives no image and a note",
     "expect": {"mutation_outcome": "committed", "data.captures": 2,
                "warnings": {"count": 1}, "warnings.0.message": {"matches": "section_planes/1 misses the model"}}},
    {"call": "nx_create_part", "setup": true, "save": "other", "args": {"path": "$run/insp_details_other.prt", "units": "mm"}},
    {"call": "nx_create_primitive", "setup": true, "save": "c2",
     "args": {"part": "insp_details_other", "shape": "block", "length": 50, "width": 50, "height": 20}},
    {"call": "nx_check_interference", "args": {"part": "$part", "objects": ["$a.data.bodies.0.id", "$c2.data.bodies.0.id"]},
     "intent": "Acceptance: a body of an unrelated part is refused, not compared in its own coordinates",
     "expect": {"error.field": "/objects/1", "error.code": {"matches": "NX_WRONG_OWNER|NX_WRONG_PART_CONTEXT"}}}
  ]
}
