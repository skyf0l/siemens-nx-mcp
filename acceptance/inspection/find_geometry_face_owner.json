{
  "covers": {
    "nx_find_geometry": [],
    "nx_resolve_reference": []
  },
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_primitive", "setup": true, "save": "blk",
     "args": {"shape": "block", "length": 40, "width": 20, "height": 10}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"kind": "face", "normal": "+z", "limit": 1}},
    {"call": "nx_find_geometry", "save": "rim", "args": {"kind": "edge", "owner": "$top.data.items.0.id"},
     "expect": {"ok": true, "page.total": 4, "data.items.0.type": "line",
                "data.items.0.center.2": {"close": 10, "tol": 1e-6},
                "data.items.3.center.2": {"close": 10, "tol": 1e-6},
                "data.selector": {"contains": ":face="}}},
    {"call": "nx_find_geometry", "save": "long",
     "args": {"kind": "edge", "owner": "$top.data.items.0.id", "parallel": "x", "order": "highest", "axis": "y"},
     "expect": {"page.total": 2, "data.items.0.center": {"close": [20, 20, 10], "tol": 1e-6}}},
    {"call": "nx_resolve_reference", "args": {"selector": "$long.data.selector"},
     "expect": {"data.via": "selector", "data.object.id": "$long.data.items.0.id"}},
    {"call": "nx_list_objects", "args": {"kind": "edge", "owner": "$top.data.items.0.id"},
     "expect": {"page.total": 4}},
    {"call": "nx_find_geometry", "args": {"kind": "face", "owner": "$top.data.items.0.id"},
     "expect": {"error.code": "NX_WRONG_KIND", "error.field": "/owner", "error.hint": {"contains": "kind \"edge\""}}}
  ]
}
