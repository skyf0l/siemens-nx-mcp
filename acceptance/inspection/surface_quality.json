{
 "covers": {"nx_check_face_continuity": [], "nx_create_surface_analysis": ["reflection", "curvature_comb", "continuity", "radius"]},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "blk", "args": {"shape": "block", "length": 40, "width": 40, "height": 40}},
  {"call": "nx_find_geometry", "setup": true, "save": "e", "args": {"owner": "$blk.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "order": "nearest", "near": [40, 40, 20], "limit": 1}},
  {"call": "nx_create_blend", "setup": true, "args": {"edges": ["$e.data.items.0.id"], "radius": 5}},
  {"call": "nx_find_geometry", "setup": true, "save": "bl", "args": {"kind": "face", "geometry_type": "cylinder", "order": "nearest", "near": [39, 39, 20], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "px", "args": {"kind": "face", "geometry_type": "plane", "order": "nearest", "near": [40, 10, 20], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "py", "args": {"kind": "face", "geometry_type": "plane", "order": "nearest", "near": [10, 40, 20], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "top", "args": {"kind": "face", "geometry_type": "plane", "order": "nearest", "near": [20, 20, 40], "limit": 1}},
  {"call": "nx_find_geometry", "setup": true, "save": "arc", "args": {"kind": "edge", "geometry_type": "circle", "order": "nearest", "near": [39, 39, 40], "limit": 1}},
  {"call": "nx_get_model_summary", "save": "before", "args": {}, "expect": {"data.counts.bodies": 1}},
  {"call": "nx_check_face_continuity", "args": {"faces": ["$bl.data.items.0.id", "$px.data.items.0.id"], "tolerances": {"angle": "0.5 deg", "curvature": 0.25}},
   "expect": {"mutation_outcome": "not_applicable", "data.edges": {"count": 1}, "data.g1": true, "data.g2": true,
              "data.angle": {"close": 0, "tol": 1e-3}, "data.curvature": {"close": 0.2, "tol": 1e-3},
              "data.nx.g0": true, "data.nx.g1": true, "data.samples": 9}},
  {"call": "nx_check_face_continuity", "args": {"faces": ["$bl.data.items.0.id", "$px.data.items.0.id", "$py.data.items.0.id"], "samples": 5},
   "expect": {"data.edges": {"count": 2}, "data.g1": true, "data.g2": false, "data.samples": 10,
              "data.edges.1.curvature": {"close": 0.2, "tol": 1e-3}}},
  {"call": "nx_check_face_continuity", "args": {"faces": ["$px.data.items.0.id", "$top.data.items.0.id"]},
   "expect": {"data.edges": {"count": 1}, "data.g1": false, "data.angle": {"close": 90, "tol": 1e-6},
              "data.curvature": {"close": 0, "tol": 1e-9}, "data.nx.g1": false}},
  {"call": "nx_check_face_continuity", "args": {"faces": ["$py.data.items.0.id", "$px.data.items.0.id"]},
   "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/faces"}},
  {"call": "nx_get_model_summary", "args": {}, "expect": {"data.counts": {"equals": "$before.data.counts"}}},
  {"call": "nx_create_surface_analysis", "save": "refl", "args": {"type": "reflection", "faces": ["$bl.data.items.0.id", "$px.data.items.0.id", "$py.data.items.0.id"], "lines": 16},
   "expect": {"mutation_outcome": "committed", "data.name": "NX_MCP_REFLECTION", "data.faces": 3, "data.analyses": 1}},
  {"call": "nx_create_surface_analysis", "args": {"type": "curvature_comb", "curves": ["$arc.data.items.0.id"], "density": 40},
   "expect": {"mutation_outcome": "committed", "data.name": "NX_MCP_CURVATURE_COMB", "data.curves": 1, "data.analyses": 2}},
  {"call": "nx_create_surface_analysis", "args": {"type": "continuity", "faces": ["$bl.data.items.0.id", "$px.data.items.0.id"], "angle": 0.5},
   "expect": {"mutation_outcome": "committed", "data.analyses": 3}},
  {"call": "nx_create_surface_analysis", "save": "rad", "args": {"type": "radius", "faces": ["$bl.data.items.0.id"], "radius_type": "minimum"},
   "expect": {"mutation_outcome": "committed", "data.analyses": 4}},
  {"call": "nx_undo_operation", "args": {"operation": "$rad.operation_id"}, "expect": {"ok": true}},
  {"call": "nx_create_surface_analysis", "args": {"type": "radius", "faces": ["$bl.data.items.0.id"], "radius_type": "mean"},
   "expect": {"data.analyses": 4}},
  {"call": "nx_create_surface_analysis", "args": {"type": "continuity", "faces": ["$bl.data.items.0.id"]},
   "expect": {"error.field": "/faces", "mutation_outcome": "not_started"}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.errors": 0}}
 ]
}
