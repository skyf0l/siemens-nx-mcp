{
 "covers": {"nx_analyze_body_changes": []},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_primitive", "setup": true, "save": "v1", "args": {"shape": "block", "length": 40, "width": 40, "height": 40}},
  {"call": "nx_create_primitive", "setup": true, "save": "v2", "args": {"shape": "block", "length": 40, "width": 40, "height": 40}},
  {"call": "nx_create_primitive", "setup": true, "save": "same", "args": {"shape": "block", "length": 40, "width": 40, "height": 40}},
  {"call": "nx_create_primitive", "setup": true, "save": "tall", "args": {"shape": "block", "length": 40, "width": 40, "height": 50}},
  {"call": "nx_find_geometry", "setup": true, "save": "top2", "args": {"owner": "$v2.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": "+z", "limit": 1}},
  {"call": "nx_create_hole", "setup": true, "args": {"face": "$top2.data.items.0.id", "positions": [[20, 20]], "depth": "through_all", "diameter": 10, "target": "$v2.data.bodies.0.id"}},
  {"call": "nx_analyze_body_changes", "intent": "Release 2 adds a through hole: top and bottom change, the wall is new",
   "args": {"control": "$v1.data.bodies.0.id", "sample": "$v2.data.bodies.0.id"},
   "expect": {"mutation_outcome": "not_applicable", "data.identical": false,
              "data.counts": {"equals": {"matching": 4, "changed": 2, "added": 1, "removed": 0}},
              "data.changed.0.area_change": {"close": -78.53981633974483, "tol": 1e-6},
              "data.volume.difference": {"close": -3141.592653589793, "tol": 1e-6},
              "data.volume.control": {"close": 64000, "tol": 1e-6},
              "data.area.difference": {"close": 1099.5574287564277, "tol": 1e-6},
              "data.added": {"count": 1}}},
  {"call": "nx_analyze_body_changes", "intent": "The reverse: the hole wall is removed",
   "args": {"control": "$v2.data.bodies.0.id", "sample": "$v1.data.bodies.0.id"},
   "expect": {"data.counts": {"equals": {"matching": 4, "changed": 2, "added": 0, "removed": 1}},
              "data.volume.difference": {"close": 3141.592653589793, "tol": 1e-6}}},
  {"call": "nx_analyze_body_changes", "args": {"control": "$v1.data.bodies.0.id", "sample": "$same.data.bodies.0.id"},
   "expect": {"data.identical": true, "data.counts.matching": 6, "data.volume.difference": 0, "data.area.difference": {"close": 0, "tol": 1e-6}}},
  {"call": "nx_analyze_body_changes", "intent": "10 taller: top moved (removed + added), four sides stretched",
   "args": {"control": "$v1.data.bodies.0.id", "sample": "$tall.data.bodies.0.id", "limit": 2},
   "expect": {"data.counts": {"equals": {"matching": 1, "changed": 4, "added": 1, "removed": 1}},
              "data.changed": {"count": 2}, "data.truncated": true,
              "data.volume.difference": {"close": 16000, "tol": 1e-6}}},
  {"call": "nx_analyze_body_changes", "args": {"control": "$v1.data.bodies.0.id", "sample": "$tall.data.bodies.0.id", "tolerance": 11},
   "expect": {"data.counts.matching": 6}},
  {"call": "nx_analyze_body_changes", "args": {"control": "$v1.data.bodies.0.id", "sample": "$v1.data.bodies.0.id"},
   "expect": {"error.code": "NX_INVALID_ARGUMENT", "error.field": "/sample"}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.errors": 0}}
 ]
}
