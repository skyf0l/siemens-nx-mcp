{
  "covers": {"nx_find_holes": [], "nx_find_geometry": [], "nx_list_objects": [], "nx_resolve_reference": [], "nx_create_anchor": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [60, 40]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "ext",
     "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 20}}},
    {"call": "nx_find_geometry", "save": "top", "args": {"normal": "+Z", "limit": 1},
     "expect": {"ok": true, "page.total": 1, "data.items.0.type": "plane",
                "data.items.0.center.2": {"close": 20, "tol": 1e-6},
                "data.items.0.normal": {"close": [0, 0, 1], "tol": 1e-9},
                "data.selector": {"matches": "\"geometry_type\":\"plane\",\"order\":\"highest\",\"axis\":\"z\""}}},
    {"call": "nx_find_geometry", "args": {"normal": "bottom", "limit": 1},
     "expect": {"data.items.0.center.2": {"close": 0, "tol": 1e-6},
                "data.items.0.normal": {"close": [0, 0, -1], "tol": 1e-9}}},
    {"call": "nx_find_geometry", "args": {"normal": "-x", "limit": 1},
     "expect": {"data.items.0.center.0": {"close": 0, "tol": 1e-6}, "data.selector": {"matches": "\"axis\":\"x\""}}},
    {"call": "nx_find_geometry", "args": {"normal": "+q"},
     "expect": {"error.category": "invalid_argument", "error.field": "/normal", "error.message": {"matches": "top"}}},
    {"call": "nx_find_geometry", "args": {"owner": "$ext.data.bodies.0.anchor", "normal": "+z"},
     "expect": {"page.total": 1, "data.items.0.center.2": {"close": 20, "tol": 1e-6}}},
    {"call": "nx_find_geometry", "args": {"owner": "EXTRUDE(1)"},
     "expect": {"error.category": "invalid_argument", "error.field": "/owner", "error.message": {"matches": "not a reference"}}},
    {"call": "nx_create_hole", "setup": true,
     "args": {"face": "$top.data.items.0.id", "positions": [[10, 10, 20]], "form": "simple", "diameter": 6,
              "depth": {"type": "distance", "value": 10}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top", "args": {"normal": "+z", "limit": 1}},
    {"call": "nx_create_hole", "setup": true,
     "args": {"face": "$top.data.items.0.id", "positions": [[30, 10, 20]], "form": "counterbore", "diameter": 4,
              "depth": {"type": "distance", "value": 12}, "counterbore": {"diameter": 10, "depth": 4}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top", "args": {"normal": "+z", "limit": 1}},
    {"call": "nx_create_hole", "setup": true,
     "args": {"face": "$top.data.items.0.id", "positions": [[50, 10, 20]], "form": "countersink", "diameter": 5,
              "depth": {"type": "distance", "value": 12}, "countersink": {"diameter": 10, "angle": 90}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top", "args": {"normal": "+z", "limit": 1}},
    {"call": "nx_create_hole", "setup": true, "save": "thru",
     "args": {"face": "$top.data.items.0.id", "positions": [[30, 30, 20]], "form": "simple", "diameter": 8,
              "depth": {"type": "through_all"}}},
    {"call": "nx_find_holes", "args": {},
     "expect": {"data.groups": {"count": 4}, "page.total": 4, "page.faces": 5, "data.items": {"count": 5}}},
    {"call": "nx_find_holes", "args": {"offset": 3, "limit": 1},
     "expect": {"data.groups": {"count": 1}, "page.total": 4, "page.returned": 1, "page.next_offset": null}},
    {"call": "nx_find_holes", "args": {"diameter": 4, "limit": 1},
     "expect": {"data.groups": {"count": 1}, "data.groups.0.diameters": {"close": [10, 4], "tol": 1e-9},
                "page.total": 1, "page.faces": 2, "data.items": {"count": 2}}},
    {"call": "nx_find_holes", "args": {"diameter": "6 mm"},
     "expect": {"data.groups": {"count": 1}, "data.groups.0.form": "simple", "data.groups.0.through": false,
                "data.groups.0.length": {"close": 10, "tol": 1e-6}, "data.groups.0.diameters": {"close": [6], "tol": 1e-9},
                "data.groups.0.ends.0.point": {"close": [10, 10, 20], "tol": 1e-6}, "data.groups.0.ends.0.open": true,
                "data.groups.0.ends.1.open": false, "data.groups.0.ends.1.point.2": {"close": 10, "tol": 1e-6}}},
    {"call": "nx_find_holes", "args": {"diameter": 10},
     "expect": {"data.groups": {"count": 1}, "data.groups.0.form": "counterbore", "data.groups.0.through": false,
                "data.groups.0.diameters": {"close": [10, 4], "tol": 1e-9}, "data.groups.0.length": {"close": 12, "tol": 1e-6},
                "data.groups.0.ends.0.diameter": {"close": 10, "tol": 1e-9},
                "data.groups.0.ends.0.point": {"close": [30, 10, 20], "tol": 1e-6}, "page.total": 1,
                "page.faces": 2, "data.items": {"count": 2}}},
    {"call": "nx_find_holes", "args": {"diameter": 5},
     "expect": {"data.groups": {"count": 1}, "data.groups.0.form": "countersink", "data.groups.0.through": false,
                "data.groups.0.ends.0.open": true, "data.groups.0.ends.0.diameter": {"close": 5, "tol": 1e-9}}},
    {"call": "nx_find_holes", "args": {"diameter": 8, "through": true},
     "expect": {"data.groups": {"count": 1}, "data.groups.0.form": "simple", "data.groups.0.through": true,
                "data.groups.0.length": {"close": 20, "tol": 1e-6}, "data.groups.0.ends": {"count": 2},
                "data.groups.0.ends.0.point.0": {"close": 30, "tol": 1e-6}, "data.groups.0.ends.1.open": true}},
    {"call": "nx_find_holes", "args": {"through": false}, "expect": {"data.groups": {"count": 3}}},
    {"call": "nx_find_holes", "args": {"owner": "$ext.data.bodies.0.anchor", "diameter": 8},
     "expect": {"data.groups": {"count": 1}}},
    {"call": "nx_find_holes", "args": {"diameter": 0}, "expect": {"error.field": "/diameter"}},
    {"call": "nx_find_geometry", "save": "bore8", "args": {"role": "bore", "radius": 4},
     "expect": {"page.total": 1, "data.items.0.role": "bore", "data.items.0.radius": {"close": 4, "tol": 1e-9},
                "data.selector": {"matches": "\"role\":\"bore\""}}},
    {"call": "nx_find_geometry", "args": {"role": "boss"}, "expect": {"ok": true, "page.total": 0}},
    {"call": "nx_resolve_reference", "args": {"selector": "$bore8.data.selector"},
     "expect": {"data.via": "selector", "data.object.kind": "face"}},
    {"call": "nx_resolve_reference", "args": {"anchor": "$bore8.data.items.0.id"},
     "expect": {"data.via": "reference", "data.object.kind": "face"}},
    {"call": "nx_resolve_reference", "args": {"anchor": "fc:not-a-ref"},
     "expect": {"error.category": "invalid_argument", "error.message": {"matches": "nx_create_anchor"}}},
    {"call": "nx_create_anchor", "save": "fa", "args": {"object": "$thru.data.feature.id"},
     "expect": {"data.object.kind": "feature", "data.anchor": {"matches": "HOLE"}}},
    {"call": "nx_resolve_reference", "args": {"anchor": "$fa.data.anchor"},
     "expect": {"data.via": "anchor", "data.object.kind": "feature"}},
    {"call": "nx_list_objects", "args": {"kind": "face", "type": "face cylinder"},
     "expect": {"ok": true, "page.total": 5}},
    {"call": "nx_list_objects", "args": {"kind": "face", "type": "Cylindrical"},
     "expect": {"ok": true, "page.total": 5}},
    {"call": "nx_list_objects", "args": {"kind": "face", "type": "hexagon"},
     "expect": {"error.field": "/type", "error.message": {"matches": "cylinder"}}},
    {"call": "nx_list_objects", "args": {"kind": "face", "owner": "$ext.data.bodies.0.anchor", "type": "planes"},
     "expect": {"ok": true, "page.total": 7}},
    {"call": "nx_list_objects", "args": {"kind": "face", "owner": "SIMPLE HOLE(3)"},
     "expect": {"error.category": "invalid_argument", "error.field": "/owner"}}
  ]
}
