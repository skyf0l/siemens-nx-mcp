{
  "covers": {"nx_find_geometry": [], "nx_find_holes": [], "nx_create_anchor": [], "nx_resolve_reference": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "curves": [
       {"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]},
       {"type": "circle", "center": [10, 10], "radius": 3},
       {"type": "circle", "center": [30, 10], "radius": 4}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "ext",
     "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_find_geometry", "save": "top",
     "args": {"kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "axis": "z", "limit": 1},
     "expect": {"mutation_outcome": "not_applicable", "page.total": 1, "data.items.0.kind": "face",
                "data.items.0.type": "plane", "data.items.0.center.2": {"close": 10, "tol": 1e-6},
                "data.items.0.normal": {"close": [0, 0, 1], "tol": 1e-9}, "units.length": "mm",
                "data.selector": {"matches": "\"order\":\"highest\""}}},
    {"call": "nx_find_geometry",
     "args": {"kind": "edge", "geometry_type": "line", "near": [20, 0, 10], "order": "nearest", "limit": 1},
     "expect": {"data.items.0.distance": {"close": 0, "tol": 1e-6}, "data.items.0.point": {"close": [20, 0, 10], "tol": 1e-6},
                "data.items.0.type": "line", "page.total": 12}},
    {"call": "nx_find_geometry",
     "args": {"kind": "face", "geometry_type": "cylinder", "radius": 4, "order": "lowest", "axis": "x"},
     "expect": {"page.total": 1, "data.items.0.radius": {"close": 4, "tol": 1e-9}, "data.items.0.role": "bore",
                "data.items.0.axis_point.0": {"close": 30, "tol": 1e-6}, "data.items.0.axis_point.1": {"close": 10, "tol": 1e-6}}},
    {"call": "nx_find_geometry",
     "args": {"kind": "edge", "geometry_type": "circle", "order": "lowest", "axis": "z"},
     "expect": {"page.total": 4, "data.items.0.center.2": {"close": 0, "tol": 1e-6}, "data.items.3.center.2": {"close": 10, "tol": 1e-6}}},
    {"call": "nx_find_geometry", "args": {"kind": "face", "order": "nearest"},
     "expect": {"error.category": "invalid_argument", "error.field": "/near", "mutation_outcome": "not_applicable"}},
    {"call": "nx_find_geometry", "args": {"kind": "face", "geometry_type": "circle", "order": "lowest"},
     "expect": {"error.field": "/geometry_type"}},
    {"call": "nx_find_holes", "args": {},
     "expect": {"page.total": 2, "data.groups": {"count": 2}, "data.items.0.full": true,
                "data.items.0.axis": {"close": [0, 0, 1], "tol": 1e-9}}},
    {"call": "nx_find_holes", "args": {"owner": "$ext.data.feature.id", "limit": 1},
     "expect": {"page.total": 2, "page.next_offset": 1, "data.items": {"count": 1}}},
    {"call": "nx_create_anchor", "save": "an", "args": {"object": "$top.data.items.0.id"},
     "expect": {"data.anchor": {"matches": ":face=RM"}, "data.object.kind": "face"}},
    {"call": "nx_create_anchor", "args": {"object": "$ext.data.feature.id"},
     "expect": {"error.category": "wrong_kind"}},
    {"call": "nx_resolve_reference", "args": {"anchor": "$an.data.anchor"},
     "expect": {"data.via": "anchor", "data.object.kind": "face", "data.object.name": {"matches": "\\(20,10,10\\)"}}},
    {"call": "nx_edit_feature", "setup": true,
     "args": {"feature": "$ext.data.feature.id", "parameters": [{"name": "distance", "value": 15}]}},
    {"call": "nx_resolve_reference", "args": {"selector": "$top.data.selector"},
     "expect": {"data.via": "selector", "data.rank": {"close": 15, "tol": 1e-6}, "data.object.kind": "face"}},
    {"call": "nx_resolve_reference", "args": {"anchor": "$an.data.anchor"},
     "expect": {"data.object.kind": "face", "data.object.name": {"matches": "\\(20,10,15\\)"}}},
    {"call": "nx_resolve_reference", "args": {"anchor": "$ext.data.bodies.0.anchor"},
     "expect": {"data.object.kind": "body", "data.via": "anchor"}},
    {"call": "nx_find_geometry", "save": "mid", "args": {"kind": "face", "geometry_type": "plane", "near": [20, 10, 7.5]},
     "expect": {"data.items.0.distance": {"close": 7.5, "tol": 1e-6}, "data.items.1.distance": {"close": 7.5, "tol": 1e-6}}},
    {"call": "nx_resolve_reference", "args": {"selector": "$mid.data.selector"},
     "expect": {"error.code": "NX_AMBIGUOUS_REFERENCE", "error.details.candidates": {"count": 2}}},
    {"call": "nx_resolve_reference", "args": {"selector": "{\"kind\": \"face\"}"},
     "expect": {"error.field": "/selector", "error.category": "invalid_argument"}},
    {"call": "nx_resolve_reference", "args": {"anchor": "@other/part.prt:face=RMx R1"},
     "expect": {"error.code": "NX_WRONG_OWNER"}}
  ]
}
