{
  "covers": {"nx_measure_distance": [], "nx_measure_angle": [], "nx_measure_mass": [], "nx_measure_bounds": [],
             "nx_measure_wall_thickness": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "a",
     "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk2", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true, "save": "c2",
     "args": {"sketch": "$sk2.data.sketch.id", "curves": [
       {"type": "line", "start": [100, 0], "end": [108.660254037844, 5]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk2.data.sketch.id"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk3", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk3.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [50, 0], "corner2": [60, 10]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk3.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "b",
     "args": {"sketch": "$sk3.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_set_material", "setup": true,
     "args": {"bodies": ["$a.data.bodies.0.id", "$b.data.bodies.0.id"], "material": {"custom": {"name": "INSP_1000", "density": 1000}}}},
    {"call": "nx_find_geometry", "setup": true, "save": "top",
     "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, 1], "order": "highest", "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "bottom",
     "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [0, 0, -1], "order": "lowest", "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "xface",
     "args": {"owner": "$a.data.bodies.0.id", "kind": "face", "geometry_type": "plane", "normal": [1, 0, 0], "order": "highest", "axis": "x", "limit": 1}},
    {"call": "nx_find_geometry", "setup": true, "save": "yedge",
     "args": {"owner": "$a.data.bodies.0.id", "kind": "edge", "geometry_type": "line", "near": [0, 10, 0], "limit": 1}},
    {"call": "nx_measure_distance", "args": {"first": "$a.data.bodies.0.id", "second": "$b.data.bodies.0.id"},
     "expect": {"mutation_outcome": "not_applicable", "data.distance": {"close": 10, "tol": 1e-6},
                "data.points.0.0": {"close": 40, "tol": 1e-6}, "data.points.1.0": {"close": 50, "tol": 1e-6},
                "data.pairs": 1, "units.length": "mm"}},
    {"call": "nx_measure_distance", "args": {"first": "$top.data.items.0.id", "second": "$bottom.data.items.0.id"},
     "expect": {"data.distance": {"close": 10, "tol": 1e-6}, "data.first.kind": "face"}},
    {"call": "nx_measure_distance", "args": {"first": "$a.data.feature.id", "second": "$b.data.feature.id"},
     "expect": {"data.distance": {"close": 10, "tol": 1e-6}, "data.first.kind": "body"}},
    {"call": "nx_measure_angle", "args": {"first": "$top.data.items.0.id", "second": "$xface.data.items.0.id"},
     "expect": {"data.angle": {"close": 90, "tol": 1e-9}, "data.directions.0": {"close": [0, 0, 1], "tol": 1e-9}}},
    {"call": "nx_measure_angle", "args": {"first": "$top.data.items.0.id", "second": "$bottom.data.items.0.id"},
     "expect": {"data.angle": {"close": 180, "tol": 1e-9}, "data.directions.1": {"close": [0, 0, -1], "tol": 1e-9}}},
    {"call": "nx_measure_angle", "args": {"first": "$c2.data.curves.0.curve.id", "second": "$xface.data.items.0.id"},
     "expect": {"data.angle": {"close": 30, "tol": 1e-6}}},
    {"call": "nx_measure_angle", "args": {"first": "$yedge.data.items.0.id", "second": "$top.data.items.0.id"},
     "expect": {"data.angle": {"close": 90, "tol": 1e-9}}},
    {"call": "nx_measure_angle", "args": {"first": "$a.data.bodies.0.id", "second": "$top.data.items.0.id"},
     "expect": {"error.category": "wrong_kind", "mutation_outcome": "not_applicable"}},
    {"call": "nx_measure_mass", "args": {"bodies": ["$a.data.bodies.0.id"]},
     "expect": {"data.volume": {"close": 8000, "tol": 1e-6}, "data.area": {"close": 2800, "tol": 1e-6},
                "data.mass": {"close": 0.008, "tol": 1e-9},
                "data.center_of_gravity": {"close": [20, 10, 5], "tol": 1e-6},
                "data.inertia.0.0": {"close": 0.333333333333, "tol": 1e-6},
                "data.inertia.1.1": {"close": 1.133333333333, "tol": 1e-6},
                "data.inertia.2.2": {"close": 1.333333333333, "tol": 1e-6},
                "data.inertia.0.1": {"close": 0, "tol": 1e-9},
                "data.bodies": {"count": 1}}},
    {"call": "nx_measure_mass", "args": {"scope": "part"},
     "expect": {"data.volume": {"close": 9000, "tol": 1e-6}, "data.mass": {"close": 0.009, "tol": 1e-9},
                "data.center_of_gravity.0": {"close": 23.888888888889, "tol": 1e-6}, "data.bodies": {"count": 2}}},
    {"call": "nx_measure_bounds", "args": {"precision": "exact"},
     "expect": {"data.min": {"close": [0, 0, 0], "tol": 1e-6}, "data.max": {"close": [60, 20, 10], "tol": 1e-6},
                "data.size": {"close": [60, 20, 10], "tol": 1e-6}, "data.bodies": {"count": 2}, "data.precision": "exact"}},
    {"call": "nx_measure_bounds", "args": {"bodies": ["$b.data.feature.id"]},
     "expect": {"data.min": {"close": [50, 0, 0], "tol": 1e-6}, "data.max": {"close": [60, 10, 10], "tol": 1e-6},
                "data.precision": "conservative"}},
    {"call": "nx_measure_wall_thickness",
     "args": {"body": "$a.data.bodies.0.id", "faces": ["$top.data.items.0.id"], "samples_per_axis": 3},
     "expect": {"data.measured": 9, "data.minimum": {"close": 10, "tol": 1e-6}, "data.maximum": {"close": 10, "tol": 1e-6},
                "data.samples.0.status": "measured", "data.samples.0.opposite_face.kind": "face", "data.unresolved": 0}},
    {"call": "nx_measure_wall_thickness", "args": {"body": "$a.data.bodies.0.id", "samples_per_axis": 1},
     "expect": {"data.measured": 6, "data.minimum": {"close": 10, "tol": 1e-6}, "data.maximum": {"close": 40, "tol": 1e-6}}},
    {"call": "nx_measure_wall_thickness",
     "args": {"body": "$a.data.bodies.0.id", "faces": ["$b.data.bodies.0.id"]},
     "expect": {"error.category": "wrong_kind"}},
    {"call": "nx_measure_mass", "args": {"bodies": ["$sk.data.sketch.id"]},
     "expect": {"error.category": "wrong_kind", "mutation_outcome": "not_applicable"}}
  ]
}
