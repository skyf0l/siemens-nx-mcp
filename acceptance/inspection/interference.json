{
  "covers": {"nx_check_interference": [], "nx_export_inspection_report": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$run/insp/insp_box10.prt", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [10, 10]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_save_part", "setup": true, "args": {}},
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_component", "setup": true, "save": "A", "args": {"part": "$part", "path": "$run/insp/insp_box10.prt", "name": "A"}},
    {"call": "nx_create_component", "setup": true, "save": "B",
     "args": {"part": "$part", "path": "$run/insp/insp_box10.prt", "name": "B", "pose": {"translation": [15, 0, 0]}}},
    {"call": "nx_create_component", "setup": true, "save": "C",
     "args": {"part": "$part", "path": "$run/insp/insp_box10.prt", "name": "C", "pose": {"translation": [5, 5, 5]}}},
    {"call": "nx_create_component", "setup": true, "save": "D",
     "args": {"part": "$part", "path": "$run/insp/insp_box10.prt", "name": "D", "pose": {"translation": [0, 0, 10]}}},
    {"call": "nx_check_interference", "args": {"part": "$part"},
     "expect": {"mutation_outcome": "not_applicable", "data.bodies": 4, "data.pair_count": 6,
                "data.checked_pairs": 4, "data.skipped_pairs": 2,
                "data.counts": {"equals": {"penetration": 2, "contact": 2, "below_clearance": 0, "clear": 2}},
                "data.pairs": {"count": 4}, "data.pairs.0.classification": "penetration",
                "data.pairs.0.overlap_volume": {"close": 125, "tol": 1e-6}, "data.pairs.0.distance": {"close": 0, "tol": 1e-7},
                "data.pairs.1.classification": "contact", "data.pairs.3.overlap_volume": {"close": 125, "tol": 1e-6}}},
    {"call": "nx_list_objects", "args": {"part": "$part", "kind": "body"},
     "expect": {"page.total": 0}},
    {"call": "nx_check_interference", "args": {"part": "$part", "include_contact": false},
     "expect": {"data.pairs": {"count": 2}, "data.counts.contact": 2}},
    {"call": "nx_check_interference", "args": {"objects": ["$A.data.component.id", "$B.data.component.id"], "clearance": 6},
     "expect": {"data.pair_count": 1, "data.counts.below_clearance": 1, "data.pairs.0.classification": "below_clearance",
                "data.pairs.0.distance": {"close": 5, "tol": 1e-6}, "data.pairs.0.points.0.0": {"close": 10, "tol": 1e-6},
                "data.pairs.0.points.1.0": {"close": 15, "tol": 1e-6}, "data.clearance": 6}},
    {"call": "nx_check_interference", "args": {"objects": ["$A.data.component.id", "$B.data.component.id"], "clearance": "1 mm"},
     "expect": {"data.pairs": {"count": 0}, "data.skipped_pairs": 1, "data.checked_pairs": 0, "data.counts.clear": 1}},
    {"call": "nx_check_interference", "args": {"objects": ["$A.data.component.id", "$B.data.component.id"], "include_clear": true},
     "expect": {"data.pairs.0.classification": "clear", "data.checked_pairs": 1}},
    {"call": "nx_check_interference", "args": {"part": "$part", "max_pairs": 3},
     "expect": {"error.code": "NX_TOO_MANY_OBJECTS", "error.field": "/max_pairs", "error.details.native_pairs": 4,
                "error.details.pairs": 6, "mutation_outcome": "not_applicable"}},
    {"call": "nx_check_interference", "args": {"objects": ["$A.data.component.id", "$A.data.component.id"]},
     "expect": {"error.category": "invalid_argument", "error.field": "/objects"}},
    {"call": "nx_check_interference", "args": {"part": "$part", "clearance": -1},
     "expect": {"error.field": "/clearance"}},
    {"call": "nx_export_inspection_report",
     "args": {"part": "$part", "path": "$run/insp/report.zip", "section_planes": [{"origin": [5, 5, 5], "normal": [0, 0, 1]}]},
     "expect": {"mutation_outcome": "committed", "data.captures": 6, "data.files": {"count": 9},
                "data.files.8": "manifest.json", "data.sha256": {"matches": "^[0-9a-f]{64}$"},
                "data.counts.penetration": 2, "data.path": {"matches": "report[.]zip$"}}},
    {"call": "nx_export_inspection_report", "args": {"part": "$part", "path": "$run/insp/plain.zip", "capture": false, "clearance": 6},
     "expect": {"data.captures": 0, "data.files": {"count": 3}, "data.counts.below_clearance": 2}},
    {"call": "nx_export_inspection_report", "args": {"part": "$part", "path": "$run/insp/report.zip"},
     "expect": {"error.category": "already_exists", "mutation_outcome": "not_started"}},
    {"call": "nx_export_inspection_report",
     "args": {"part": "$part", "path": "$run/insp/bad.zip", "capture": false, "section_planes": [{"origin": [0, 0, 0], "normal": [0, 0, 1]}]},
     "expect": {"error.field": "/section_planes", "mutation_outcome": "not_started"}},
    {"call": "nx_export_inspection_report", "args": {"part": "$part", "path": "$run/insp/bad.txt"},
     "expect": {"error.category": "unsupported", "error.field": "/path", "mutation_outcome": "not_started"}},
    {"call": "nx_list_objects", "args": {"part": "$part", "kind": "body"},
     "expect": {"page.total": 0}}
  ]
}
