{
  "covers": {"nx_check_interference": [], "nx_export_inspection_report": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sa", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sa.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [10, 10]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sa.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "a",
     "args": {"sketch": "$sa.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_sketch", "setup": true, "save": "sb", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sb.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [5, 0], "corner2": [15, 10]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sb.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "b",
     "args": {"sketch": "$sb.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_create_sketch", "setup": true, "save": "s1", "args": {"placement": {"principal": "xy", "origin": [0, 0, 20]}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$s1.data.sketch.id", "curves": [{"type": "line", "start": [0, 0], "end": [10, 0]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s1.data.sketch.id"}},
    {"call": "nx_create_sketch", "setup": true, "save": "s2", "args": {"placement": {"principal": "xy", "origin": [0, 0, 30]}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$s2.data.sketch.id", "curves": [{"type": "line", "start": [0, 0], "end": [10, 0]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$s2.data.sketch.id"}},
    {"call": "nx_create_loft", "setup": true, "save": "sheet",
     "args": {"sections": ["$s1.data.sketch.id", "$s2.data.sketch.id"], "solid": false}},
    {"call": "nx_check_interference", "args": {},
     "expect": {"mutation_outcome": "not_applicable", "data.bodies": 2, "data.pair_count": 1,
                "data.counts.penetration": 1, "data.pairs.0.classification": "penetration",
                "data.pairs.0.overlap_volume": {"close": 500, "tol": 1e-6},
                "data.pairs.0.overlap_box.min": {"close": [5, 0, 0], "tol": 1e-3},
                "data.pairs.0.overlap_box.max": {"close": [10, 10, 10], "tol": 1e-3},
                "data.skipped_sheet_bodies": {"count": 1},
                "data.skipped_sheet_bodies.0.kind": "body"}},
    {"call": "nx_check_interference", "args": {"objects": ["$a.data.bodies.0.id", "$sheet.data.bodies.0.id"]},
     "expect": {"error.code": "NX_WRONG_GEOMETRY", "error.field": "/objects/1",
                "error.message": {"contains": "sheet body"}, "error.details.sheet_bodies": {"count": 1},
                "mutation_outcome": "not_applicable"}},
    {"call": "nx_check_interference", "args": {"objects": ["$a.data.bodies.0.id", "$b.data.bodies.0.id"], "clearance": "2mm"},
     "expect": {"data.counts.penetration": 1, "data.clearance": 2, "data.skipped_sheet_bodies": {"count": 0}}},
    {"call": "nx_export_inspection_report", "args": {"path": "$run/insp_sheets/report.zip", "capture": false},
     "expect": {"mutation_outcome": "committed", "data.captures": 0, "data.files": {"count": 3},
                "data.counts.penetration": 1}},
    {"call": "nx_list_objects", "args": {"kind": "body"},
     "expect": {"page.total": 3}}
  ]
}
