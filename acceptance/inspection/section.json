{
 "covers": {"nx_measure_section": []},
 "fixture": null,
 "part": "new",
 "steps": [
  {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
  {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xz"}}},
  {"call": "nx_create_sketch_curves", "setup": true, "args": {"sketch": "$sk.data.sketch.id", "curves": [
   {"type": "rectangle", "corner1": [5, 0], "corner2": [20, 40]},
   {"type": "rectangle", "corner1": [8, 10], "corner2": [15, 30]}]}},
  {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
  {"call": "nx_create_revolve", "setup": true, "save": "rv", "args": {"sketch": "$sk.data.sketch.id", "axis": {"principal": "z"}}},
  {"call": "nx_save_part", "setup": true, "args": {}},
  {"call": "nx_get_model_summary", "args": {},
   "expect": {"data.modified": false, "data.counts": {"equals": {"bodies": 1, "features": 4, "sketches": 1, "expressions": 2, "components": 0}}}},
  {"call": "nx_measure_section", "args": {"plane": "xz"},
   "expect": {"mutation_outcome": "not_applicable", "data.area": {"close": 920, "tol": 1e-6}, "data.loops.3.closed": true,
              "data.frame.u": {"close": [1, 0, 0], "tol": 0}, "data.frame.v": {"close": [0, 0, 1], "tol": 0},
              "data.loops": {"contains": {"role": "outer", "closed": true, "area": 600.0, "min": [5.0, 0.0], "max": [20.0, 40.0]}},
              "data.loops.0.segments": {"count": 4}}},
  {"call": "nx_measure_section", "args": {"plane": "xy", "offset": 20},
   "expect": {"data.area": {"close": 672.3008278, "tol": 1e-4}, "data.loops": {"count": 4},
              "data.loops.0.segments.0.type": "arc", "data.frame.origin": {"close": [0, 0, 20], "tol": 0}}},
  {"call": "nx_measure_section", "args": {"origin": [0, 0, 20], "normal": [0, 0, 1]},
   "expect": {"data.area": {"close": 672.3008278, "tol": 1e-4}}},
  {"call": "nx_measure_section", "args": {"radial_axis": "z", "at": [5, 20]},
   "expect": {"data.profile.0.spans": {"count": 1}, "data.profile.0.min": {"close": 5, "tol": 1e-9},
              "data.profile.0.max": {"close": 20, "tol": 1e-9}, "data.profile.1.spans": {"count": 2},
              "data.profile.1.spans.0": {"close": [5, 8], "tol": 1e-9}, "data.profile.1.spans.1": {"close": [15, 20], "tol": 1e-9}}},
  {"call": "nx_measure_section", "args": {"radial_axis": "z", "stations": 4},
   "expect": {"data.profile": {"count": 4}, "data.profile.1.at": {"close": 15, "tol": 1e-9}, "data.profile.1.spans": {"count": 2}}},
  {"call": "nx_measure_section", "args": {"plane": "xy", "offset": 99},
   "expect": {"data.loops": {"count": 0}, "data.area": 0, "warnings.0.message": {"matches": "no loops"}}},
  {"call": "nx_measure_section", "args": {"plane": "xy", "at": [1]},
   "expect": {"error.field": "/at"}},
  {"call": "nx_get_model_summary", "args": {},
   "expect": {"data.modified": false, "data.counts": {"equals": {"bodies": 1, "features": 4, "sketches": 1, "expressions": 2, "components": 0}}}},
  {"call": "nx_check_model", "args": {}, "expect": {"data.errors": 0, "data.features_checked": 4}}
 ]
}
