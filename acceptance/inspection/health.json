{
  "covers": {"nx_check_model": [], "nx_get_model_summary": []},
  "fixture": null,
  "part": "new",
  "steps": [
    {"call": "nx_create_part", "setup": true, "args": {"path": "$part", "units": "mm"}},
    {"call": "nx_create_sketch", "setup": true, "save": "sk", "args": {"placement": {"principal": "xy"}}},
    {"call": "nx_create_sketch_curves", "setup": true,
     "args": {"sketch": "$sk.data.sketch.id", "curves": [{"type": "rectangle", "corner1": [0, 0], "corner2": [40, 20]}]}},
    {"call": "nx_finish_sketch", "setup": true, "args": {"sketch": "$sk.data.sketch.id"}},
    {"call": "nx_create_extrude", "setup": true, "save": "ext",
     "args": {"sketch": "$sk.data.sketch.id", "end": {"type": "distance", "value": 10}}},
    {"call": "nx_set_expression", "setup": true, "args": {"name": "insp_wall", "formula": "2.5", "units": "mm"}},
    {"call": "nx_check_model", "args": {},
     "expect": {"mutation_outcome": "not_applicable", "data.healthy": true, "data.errors": 0, "data.warnings": 0,
                "data.parts_checked": 1, "data.bodies_checked": 1, "page.total": 0}},
    {"call": "nx_get_model_summary", "save": "over", "args": {},
     "expect": {"data.section": "overview", "data.counts.bodies": 1, "data.counts.sketches": 1, "data.counts.components": 0,
                "data.bounds.min": {"close": [0, 0, 0], "tol": 1e-6}, "data.bounds.max": {"close": [40, 20, 10], "tol": 1e-6},
                "data.bounds.size": {"close": [40, 20, 10], "tol": 1e-6}, "data.health.healthy": true,
                "data.modified": true, "data.part.kind": "part"}},
    {"call": "nx_get_model_summary", "args": {"section": "features"},
     "expect": {"data.items": {"contains": {"type": "extrude", "suppressed": false}}}},
    {"call": "nx_get_model_summary", "args": {"section": "expressions", "limit": 200},
     "expect": {"data.items": {"contains": {"name": "insp_wall", "formula": "2.5", "value": 2.5, "units": "mm"}}}},
    {"call": "nx_get_model_summary", "args": {"section": "sketches"},
     "expect": {"page.total": 1, "data.items.0.curves": 4, "data.items.0.kind": "sketch"}},
    {"call": "nx_get_model_summary", "args": {"section": "components"},
     "expect": {"page.total": 0, "data.items": {"count": 0}}},
    {"call": "nx_get_model_summary", "args": {"section": "features", "limit": 1},
     "expect": {"data.items": {"count": 1}, "page.next_offset": 1}},
    {"call": "nx_set_feature_suppression", "setup": true, "args": {"features": ["$ext.data.feature.id"], "suppressed": true}},
    {"call": "nx_check_model", "args": {},
     "expect": {"data.healthy": true, "data.issues": {"contains": {"severity": "info", "kind": "suppressed_feature"}},
                "page.total": 1, "data.issues.0.object.kind": "feature", "data.issues.0.object.name": {"matches": "^EXTRUDE"}}},
    {"call": "nx_check_model", "args": {"scope": "assembly"},
     "expect": {"data.parts_checked": 1, "page.total": 1}},
    {"call": "nx_check_model", "args": {"scope": "everything"},
     "expect": {"error.category": "invalid_argument", "error.field": "/scope", "mutation_outcome": "not_started"}},
    {"call": "nx_get_model_summary", "args": {"section": "features", "limit": 0},
     "expect": {"error.field": "/limit"}}
  ]
}
